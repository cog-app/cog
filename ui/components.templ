package ui

// Card renders a card wrapper with an optional title.
templ Card(title string) {
	<div class="card">
		if title != "" {
			<div class="card-title">{ title }</div>
		}
		{ children... }
	</div>
}

// Alert renders a styled, dismissable alert message.
templ Alert(kind string, msg string) {
	if msg != "" {
		<div class={ "alert alert-" + kind } style="position:relative">
			<button type="button" class="alert-dismiss" onclick="this.parentElement.remove()" aria-label="Close">&times;</button>
			{ msg }
		</div>
	}
}

// AlertWithCopy renders an alert with a copyable URL shown beneath the message.
templ AlertWithCopy(kind string, msg string, url string) {
	if msg != "" {
		<div class={ "alert alert-" + kind } style="position:relative">
			<button type="button" class="alert-dismiss" onclick="this.parentElement.remove()" aria-label="Close">&times;</button>
			<div>{ msg }</div>
			if url != "" {
				<div style="margin-top:0.5rem;display:flex;align-items:center;gap:0.5rem">
					<code style="font-size:0.85rem;word-break:break-all">{ url }</code>
					<button class="btn btn-outline btn-sm" style="white-space:nowrap;padding:0.2rem 0.5rem;font-size:0.8rem" onclick={ copyAlertURL(url) }>Copy Link</button>
				</div>
			}
		</div>
	}
}

script copyAlertURL(text string) {
	navigator.clipboard.writeText(text).then(function() {
		var btn = event.currentTarget;
		var orig = btn.textContent;
		btn.textContent = "Copied!";
		setTimeout(function() { btn.textContent = orig; }, 1500);
	});
}

// Button renders a styled button. Kind can be "primary", "danger", or "secondary" (default).
templ Button(kind string, label string) {
	if kind == "" {
		<button class="btn btn-secondary">{ label }</button>
	} else {
		<button class={ "btn btn-" + kind }>{ label }</button>
	}
}

// FormField renders a labeled input field.
templ FormField(label, name, typ, value, placeholder string) {
	<div class="form-group">
		<label for={ name }>{ label }</label>
		<input class="form-control" type={ typ } id={ name } name={ name } value={ value } placeholder={ placeholder }/>
	</div>
}

// Upload renders a file upload button that uploads immediately on selection.
// It looks like a styled button; clicking opens the file picker, and selecting
// a file submits the form automatically.
templ Upload(action, name, accept, csrfToken, label, btnClass string) {
	<form method="post" action={ templ.SafeURL(action) } enctype="multipart/form-data" style="display:inline">
		<input type="hidden" name="csrf_token" value={ csrfToken }/>
		<label class={ uploadBtnClass(btnClass) } style="cursor:pointer">
			{ label }
			<input type="file" name={ name } accept={ accept } style="display:none" onchange="this.form.submit()"/>
		</label>
	</form>
}

func uploadBtnClass(btnClass string) string {
	if btnClass == "" {
		return "btn btn-primary btn-sm"
	}
	return btnClass
}

// ShareLink renders a copyable share link with a copy button.
// If displayText is non-empty, it is shown instead of the full URL.
templ ShareLink(url, displayText string) {
	<div class="share-link">
		if displayText != "" {
			<code style="font-size:0.85rem">{ displayText }</code>
		} else {
			<code style="font-size:0.85rem;word-break:break-all">{ url }</code>
		}
		<button class="btn btn-outline btn-sm" style="white-space:nowrap;padding:0.2rem 0.5rem;font-size:0.8rem" onclick={ copyShareLink(url) }>Copy</button>
	</div>
}

script copyShareLink(text string) {
	navigator.clipboard.writeText(text).then(function() {
		var btn = event.currentTarget;
		var orig = btn.textContent;
		btn.textContent = "Copied!";
		setTimeout(function() { btn.textContent = orig; }, 1500);
	});
}
