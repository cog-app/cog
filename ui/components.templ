package ui

import "fmt"

// Card renders a card wrapper with an optional title.
templ Card(title string) {
	<div class="card">
		if title != "" {
			<h2 class="card-title">{ title }</h2>
		}
		{ children... }
	</div>
}

// Alert renders a styled, dismissable alert message.
templ Alert(kind string, msg string) {
	if msg != "" {
		<div class={ "alert alert-" + kind } role={ alertRole(kind) }>
			<button type="button" class="alert-dismiss" onclick="this.parentElement.remove()" aria-label="Dismiss">&times;</button>
			{ msg }
		</div>
	}
}

// alertRole makes errors interrupt a screen reader and everything else wait.
func alertRole(kind string) string {
	if kind == "error" {
		return "alert"
	}
	return "status"
}

// AlertWithCopy renders an alert with a copyable URL shown beneath the message.
templ AlertWithCopy(kind string, msg string, url string) {
	if msg != "" {
		<div class={ "alert alert-" + kind } role={ alertRole(kind) }>
			<button type="button" class="alert-dismiss" onclick="this.parentElement.remove()" aria-label="Dismiss">&times;</button>
			<div>{ msg }</div>
			if url != "" {
				<div class="secret-box">
					<code>{ url }</code>
					<button type="button" class="btn btn-secondary btn-sm" onclick={ copyAlertURL(url) }>Copy link</button>
				</div>
			}
		</div>
	}
}

// SecretAlert shows a value the user must copy now because it will not be
// shown again (an app password, a backup code list), with a Copy button.
templ SecretAlert(msg, secret string) {
	<div class="alert alert-success" role="status">
		<div class="alert-title">{ msg }</div>
		<div class="secret-box">
			<code>{ secret }</code>
			<button type="button" class="btn btn-secondary btn-sm" onclick={ copyAlertURL(secret) }>Copy</button>
		</div>
	</div>
}

// copyAlertURL and copyShareLink both hand a server-known string to cogCopy in
// cog-share.js, which owns the one clipboard implementation: the secure-context
// check, the plain-HTTP fallback, and the button feedback.

script copyAlertURL(text string) {
	cogCopy(event.currentTarget, text);
}

// Button renders a styled button. Kind can be "primary", "danger", or "secondary" (default).
templ Button(kind string, label string) {
	if kind == "" {
		<button class="btn btn-secondary">{ label }</button>
	} else {
		<button class={ "btn btn-" + kind }>{ label }</button>
	}
}

// FormField renders a labeled input field.
templ FormField(label, name, typ, value, placeholder string) {
	<div class="form-group">
		<label for={ name }>{ label }</label>
		<input class="form-control" type={ typ } id={ name } name={ name } value={ value } placeholder={ placeholder } autocomplete={ fieldAutocomplete(name, typ) }/>
	</div>
}

// fieldAutocomplete tells password managers which password field is which:
// one they should fill, or one they should offer to generate.
func fieldAutocomplete(name, typ string) string {
	if typ != "password" {
		return ""
	}
	switch name {
	case "current_password", "password":
		return "current-password"
	}
	return "new-password"
}

// Upload renders a file upload button that uploads immediately on selection.
// It looks like a styled button; clicking opens the file picker, and selecting
// a file submits the form automatically. The input stays focusable, so the
// button works from the keyboard.
templ Upload(action, name, accept, csrfToken, label, btnClass string) {
	<form method="post" action={ templ.SafeURL(action) } enctype="multipart/form-data" class="upload-form">
		<input type="hidden" name="csrf_token" value={ csrfToken }/>
		<label class={ uploadBtnClass(btnClass) }>
			{ label }
			<input type="file" class="sr-only" name={ name } accept={ accept } multiple onchange="this.form.submit()"/>
		</label>
	</form>
}

func uploadBtnClass(btnClass string) string {
	if btnClass == "" {
		return "btn btn-primary btn-sm"
	}
	return btnClass
}

// ShareLink renders a copyable share link with a copy button.
// If displayText is non-empty, it is shown instead of the full URL.
templ ShareLink(url, displayText string) {
	<div class="share-link">
		if displayText != "" {
			<code>{ displayText }</code>
		} else {
			<code>{ url }</code>
		}
		<button type="button" class="btn btn-secondary btn-sm" onclick={ copyShareLink(url) }>Copy</button>
	</div>
}

script copyShareLink(text string) {
	cogCopy(event.currentTarget, text);
}

// Star renders a favorite star button. The postURL receives a POST when clicked;
// the response should be an updated Star component for HTMX swap.
templ Star(active bool, postURL string) {
	<button
		type="button"
		class={ StarClass(active) }
		hx-post={ postURL }
		hx-swap="outerHTML"
		title="Toggle star"
		aria-label="Star"
		aria-pressed={ fmt.Sprint(active) }
	>
		@StarIcon()
	</button>
}

// StarIcon renders the star SVG. Active/inactive styling is controlled by CSS on the parent.
templ StarIcon() {
	<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
	</svg>
}

// StarClass returns the CSS class for a star button.
func StarClass(active bool) string {
	if active {
		return "btn-star active"
	}
	return "btn-star"
}

// Crumb is one step of a breadcrumb trail. The last crumb is the current page
// and needs no URL.
type Crumb struct {
	Label string
	URL   string
}

// Breadcrumbs renders a trail of links ending at the current page.
templ Breadcrumbs(crumbs []Crumb) {
	if len(crumbs) > 0 {
		<nav class="breadcrumbs" aria-label="Breadcrumb">
			<ol>
				for i, c := range crumbs {
					<li>
						if i == len(crumbs)-1 || c.URL == "" {
							<span aria-current="page">{ c.Label }</span>
						} else {
							<a href={ templ.SafeURL(c.URL) }>{ c.Label }</a>
						}
					</li>
				}
			</ol>
		</nav>
	}
}

// PageHeader renders the page title, an optional breadcrumb trail above it,
// and the page's actions (the children) to its right. On a narrow screen the
// actions wrap below the title.
//
//	@ui.PageHeader("Users", nil) {
//		<a class="btn btn-primary" href="/admin/users/new">New user</a>
//	}
//
// crumbs lead to the page: pass the ancestors only, the title is the last step.
templ PageHeader(title string, crumbs []Crumb) {
	<header class="page-header">
		<div class="page-heading">
			if len(crumbs) > 0 {
				@Breadcrumbs(append(crumbs, Crumb{Label: title}))
			}
			<h1>{ title }</h1>
		</div>
		<div class="page-actions">
			{ children... }
		</div>
	</header>
}

// EmptyState fills a list or page that has nothing in it yet: a title, one
// line on what goes here, and the action that adds the first item (children).
templ EmptyState(title, body string) {
	<div class="empty-state">
		if title != "" {
			<div class="empty-state-title">{ title }</div>
		}
		if body != "" {
			<p>{ body }</p>
		}
		<div class="empty-state-actions">
			{ children... }
		</div>
	</div>
}

// WidgetEmptyMarker is the attribute ui.WidgetEmpty puts on its output. The
// dashboard looks for it to tell an empty widget from one with content.
const WidgetEmptyMarker = "data-widget-empty"

// WidgetEmpty is what a dashboard widget renders when it has nothing to show:
// a line of text and, optionally, the action that adds the first item.
templ WidgetEmpty(text, actionLabel, actionURL string) {
	<div class="widget-empty" data-widget-empty>
		<p class="text-muted">{ text }</p>
		if actionLabel != "" {
			<a class="btn btn-secondary btn-sm mt-1" href={ templ.SafeURL(actionURL) }>{ actionLabel }</a>
		}
	</div>
}

// Modal renders a dialog with a title and a close button. The children are
// the rest of the dialog: a .modal-body and usually a .modal-footer, or a
// <form> holding both. Open it with <button data-modal-open={ id }> or
// cogModal.open(id) from script; Esc, the close button and a click outside it
// close it.
templ Modal(id, title string) {
	<dialog class="modal" id={ id } aria-labelledby={ id + "-title" }>
		<div class="modal-header">
			<h2 class="modal-title" id={ id + "-title" }>{ title }</h2>
			<button type="button" class="btn-icon modal-close" data-modal-close aria-label="Close">
				@Icon("x")
			</button>
		</div>
		{ children... }
	</dialog>
}

// Icon renders one of the shared stroke icons at 18px. Unknown names render
// nothing. Icons are decorative: give the button around one an aria-label.
templ Icon(name string) {
	switch name {
		case "search":
			@icon() {
				<circle cx="11" cy="11" r="7"></circle>
				<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
			}
		case "grid":
			@icon() {
				<rect x="3" y="3" width="7" height="7"></rect>
				<rect x="14" y="3" width="7" height="7"></rect>
				<rect x="3" y="14" width="7" height="7"></rect>
				<rect x="14" y="14" width="7" height="7"></rect>
			}
		case "bell":
			@icon() {
				<path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
				<path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
			}
		case "settings":
			@icon() {
				<line x1="4" y1="21" x2="4" y2="14"></line>
				<line x1="4" y1="10" x2="4" y2="3"></line>
				<line x1="12" y1="21" x2="12" y2="12"></line>
				<line x1="12" y1="8" x2="12" y2="3"></line>
				<line x1="20" y1="21" x2="20" y2="16"></line>
				<line x1="20" y1="12" x2="20" y2="3"></line>
				<line x1="1" y1="14" x2="7" y2="14"></line>
				<line x1="9" y1="8" x2="15" y2="8"></line>
				<line x1="17" y1="16" x2="23" y2="16"></line>
			}
		case "shield":
			@icon() {
				<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
			}
		case "x":
			@icon() {
				<line x1="18" y1="6" x2="6" y2="18"></line>
				<line x1="6" y1="6" x2="18" y2="18"></line>
			}
		case "plus":
			@icon() {
				<line x1="12" y1="5" x2="12" y2="19"></line>
				<line x1="5" y1="12" x2="19" y2="12"></line>
			}
		case "trash":
			@icon() {
				<polyline points="3 6 5 6 21 6"></polyline>
				<path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path>
				<path d="M10 11v6"></path>
				<path d="M14 11v6"></path>
				<path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"></path>
			}
		case "edit":
			@icon() {
				<path d="M12 20h9"></path>
				<path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4z"></path>
			}
		case "download":
			@icon() {
				<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
				<polyline points="7 10 12 15 17 10"></polyline>
				<line x1="12" y1="15" x2="12" y2="3"></line>
			}
		case "upload":
			@icon() {
				<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
				<polyline points="17 8 12 3 7 8"></polyline>
				<line x1="12" y1="3" x2="12" y2="15"></line>
			}
		case "folder":
			@icon() {
				<path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
			}
		case "file":
			@icon() {
				<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
				<polyline points="14 2 14 8 20 8"></polyline>
			}
		case "lock":
			@icon() {
				<rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
				<path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
			}
		case "more":
			@icon() {
				<circle cx="12" cy="12" r="1"></circle>
				<circle cx="19" cy="12" r="1"></circle>
				<circle cx="5" cy="12" r="1"></circle>
			}
		case "arrow-up":
			@icon() {
				<line x1="12" y1="19" x2="12" y2="5"></line>
				<polyline points="5 12 12 5 19 12"></polyline>
			}
		case "arrow-down":
			@icon() {
				<line x1="12" y1="5" x2="12" y2="19"></line>
				<polyline points="19 12 12 19 5 12"></polyline>
			}
		case "external":
			@icon() {
				<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
				<polyline points="15 3 21 3 21 9"></polyline>
				<line x1="10" y1="14" x2="21" y2="3"></line>
			}
		case "check-circle":
			@icon() {
				<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
				<polyline points="22 4 12 14.01 9 11.01"></polyline>
			}
		case "x-circle":
			@icon() {
				<circle cx="12" cy="12" r="10"></circle>
				<line x1="15" y1="9" x2="9" y2="15"></line>
				<line x1="9" y1="9" x2="15" y2="15"></line>
			}
		case "inbox":
			@icon() {
				<polyline points="22 12 16 12 14 15 10 15 8 12 2 12"></polyline>
				<path d="M5.45 5.11L2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"></path>
			}
	}
}

templ icon() {
	<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		{ children... }
	</svg>
}
