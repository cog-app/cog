package ui

import "fmt"

// PickerItem represents a selectable user or group in the picker.
type PickerItem struct {
	ID        string
	Name      string // display name
	Sub       string // secondary text (e.g. username)
	AvatarURL string // optional avatar URL
}

// Picker renders a searchable user/group picker.
// searchURL is the endpoint returning PickerResults HTML (e.g. "/api/picker/search?type=user").
// name is the form field name for selected IDs.
// multi enables multi-select with chips.
templ Picker(searchURL, name, placeholder string, multi bool) {
	<div class="picker" data-name={ name } data-multi={ fmt.Sprint(multi) }>
		<input
			type="search"
			class="form-control picker-input"
			placeholder={ placeholder }
			autocomplete="off"
			hx-get={ searchURL }
			hx-trigger="input changed delay:200ms"
			hx-target={ fmt.Sprintf("next .picker-results") }
			name="q"
		/>
		<div class="picker-results"></div>
		if multi {
			<div class="picker-chips"></div>
		}
		if !multi {
			<input type="hidden" name={ name } class="picker-value"/>
		}
		<script>
			(function () {
				var el = document.currentScript.parentElement;
				var input = el.querySelector(".picker-input");
				var results = el.querySelector(".picker-results");
				var isMulti = el.dataset.multi === "true";
				var fieldName = el.dataset.name;
				var chips = el.querySelector(".picker-chips");
				var hiddenSingle = el.querySelector(".picker-value");

				// Close results when clicking outside.
				document.addEventListener("click", function (e) {
					if (!el.contains(e.target)) results.innerHTML = "";
				});

				// Handle result click via event delegation.
				results.addEventListener("click", function (e) {
					var opt = e.target.closest(".picker-option");
					if (!opt) return;
					var id = opt.dataset.id;
					var name = opt.dataset.name;
					if (isMulti) {
						// Check if already selected.
						if (el.querySelector('input[value="' + id + '"]')) {
							results.innerHTML = "";
							input.value = "";
							return;
						}
						var chip = document.createElement("span");
						chip.className = "picker-chip";
						chip.innerHTML =
							name +
							'<input type="hidden" name="' +
							fieldName +
							'" value="' +
							id +
							'"/>' +
							'<button type="button" onclick="this.parentElement.remove()">&times;</button>';
						chips.appendChild(chip);
					} else {
						hiddenSingle.value = id;
						input.value = name;
					}
					results.innerHTML = "";
					if (isMulti) input.value = "";
				});

				// Keyboard navigation.
				input.addEventListener("keydown", function (e) {
					var opts = results.querySelectorAll(".picker-option");
					if (!opts.length) return;
					var cur = results.querySelector(".picker-option.active");
					var idx = cur ? Array.prototype.indexOf.call(opts, cur) : -1;
					if (e.key === "ArrowDown") {
						e.preventDefault();
						if (cur) cur.classList.remove("active");
						idx = (idx + 1) % opts.length;
						opts[idx].classList.add("active");
					} else if (e.key === "ArrowUp") {
						e.preventDefault();
						if (cur) cur.classList.remove("active");
						idx = idx <= 0 ? opts.length - 1 : idx - 1;
						opts[idx].classList.add("active");
					} else if (e.key === "Enter") {
						e.preventDefault();
						if (cur) cur.click();
					} else if (e.key === "Escape") {
						results.innerHTML = "";
					}
				});
			})();
		</script>
	</div>
}

// PickerResults renders search results for the picker dropdown.
templ PickerResults(items []PickerItem) {
	for _, item := range items {
		<div class="picker-option" data-id={ item.ID } data-name={ item.Name }>
			if item.AvatarURL != "" {
				<img class="avatar-sm" src={ item.AvatarURL } alt=""/>
			}
			<div>
				<span class="picker-option-name">{ item.Name }</span>
				if item.Sub != "" {
					<span class="picker-option-sub">{ item.Sub }</span>
				}
			</div>
		</div>
	}
	if len(items) == 0 {
		<div class="picker-empty">No matches</div>
	}
}
