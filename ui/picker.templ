package ui

import "fmt"

// PickerItem represents a selectable user or group in the picker.
type PickerItem struct {
	ID        string
	Name      string // display name
	Sub       string // secondary text (e.g. username)
	AvatarURL string // optional avatar URL
}

// Picker renders a searchable user/group picker.
// searchURL is the endpoint returning PickerResults HTML (e.g. "/api/picker/search?type=user").
// name is the form field name for selected IDs.
// multi enables multi-select with chips.
templ Picker(searchURL, name, placeholder string, multi bool) {
	<div class="picker" data-name={ name } data-multi={ fmt.Sprint(multi) }>
		<input
			type="search"
			class="form-control picker-input"
			placeholder={ placeholder }
			autocomplete="off"
			hx-get={ searchURL }
			hx-trigger="input changed delay:200ms"
			hx-target="next .picker-results"
			hx-swap="innerHTML"
			name="q"
		/>
		<div class="picker-results"></div>
		if multi {
			<div class="picker-chips"></div>
		}
		if !multi {
			<input type="hidden" name={ name } class="picker-value"/>
		}
	</div>
}

// PickerResults renders search results for the picker dropdown.
templ PickerResults(items []PickerItem) {
	for _, item := range items {
		<div class="picker-option" data-id={ item.ID } data-name={ item.Name }>
			if item.AvatarURL != "" {
				<img class="avatar-sm" src={ item.AvatarURL } alt=""/>
			}
			<div>
				<span class="picker-option-name">{ item.Name }</span>
				if item.Sub != "" {
					<span class="picker-option-sub">{ item.Sub }</span>
				}
			</div>
		</div>
	}
	if len(items) == 0 {
		<div class="picker-empty">No matches</div>
	}
}
