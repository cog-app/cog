package ui

// PluginFrame embeds a process plugin's page from its own origin. The frame
// is sandboxed; what it may do to the host is only what it posts: its
// height, and a request to navigate the host to a host URL.
templ PluginFrame(src string, origin string) {
	<iframe class="plugin-frame" src={ templ.SafeURL(src) } data-origin={ origin } sandbox="allow-scripts allow-forms allow-same-origin allow-popups allow-downloads allow-modals" referrerpolicy="origin" title="Plugin"></iframe>
	<script src={ Static.URL("plugin-host.js") }></script>
}

// FrameDoc is the document a plugin's page renders as on its own origin:
// the host's styles and scripts, the fragment, and the script that reports
// its height and hands host links to the shell.
templ FrameDoc(title, host, prefix, csrf string, body templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } — Cog</title>
			<link rel="stylesheet" href={ templ.SafeURL(host + Static.URL("style.css")) }/>
			<script src={ templ.SafeURL(host + Static.URL("cog.js")) }></script>
			<script src={ templ.SafeURL(host + Static.URL("htmx.min.js")) }></script>
		</head>
		<body class="plugin-frame-body" data-cog-host={ host } data-cog-prefix={ prefix } hx-headers={ "{\"X-CSRF-Token\":\"" + csrf + "\"}" }>
			<main class="content">
				@body
			</main>
			<script src={ templ.SafeURL(host + Static.URL("plugin-frame.js")) }></script>
		</body>
	</html>
}

// FrameEscape is served on a plugin origin for any path that is not the
// plugin's: a redirect out of the plugin lands here, and the shell is asked
// to navigate instead.
templ FrameEscape(host, path string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<title>Cog</title>
		</head>
		<body data-cog-host={ host } data-cog-path={ path }>
			<script src={ templ.SafeURL(host + Static.URL("plugin-frame.js")) }></script>
		</body>
	</html>
}
