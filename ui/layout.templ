package ui

import (
	"fmt"
	"strings"

	"git.duckfam.us/jj-software/cog/internal/search"
)

// docHead renders what every page's <head> holds. cog.js is loaded
// synchronously because the navbar calls into it while the page is parsing.
templ docHead(title, favicon string) {
	<meta charset="utf-8"/>
	<meta name="viewport" content="width=device-width, initial-scale=1"/>
	<title>{ title } — Cog</title>
	<link rel="stylesheet" href={ Static.URL("style.css") }/>
	<link rel="icon" href={ templ.SafeURL(favicon) } type="image/svg+xml"/>
	<script src={ Static.URL("cog.js") }></script>
}

// Base renders the full HTML page with navbar and content area.
templ Base(pd PageData) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			@docHead(pd.Title, pd.FaviconURL())
			<script src={ Static.URL("htmx.min.js") }></script>
			<script src={ Static.URL("cog-share.js") } defer></script>
		</head>
		<body hx-headers={ fmt.Sprintf(`{"X-CSRF-Token":"%s"}`, pd.CSRFToken) }>
			@navbar(pd)
			<main
				class="content"
				if pd.PluginID != "" {
					data-plugin={ pd.PluginID }
				}
			>
				@pageFlash(pd)
				{ children... }
			</main>
		</body>
	</html>
}

// Shell renders the full HTML shell around a body component.
// Used by the plugin shell middleware to wrap fragment handlers.
templ Shell(pd PageData, body templ.Component) {
	@Base(pd) {
		@body
	}
}

// navbar renders the top bar: brand, app links (which collapse into the apps
// menu when they do not fit), search, notifications and the account menu.
templ navbar(pd PageData) {
	<nav class="navbar" aria-label="Main">
		<a class="navbar-brand" href="/" aria-label="Cog home">
			@CogIcon(20)
			<span class="brand-text">Cog</span>
		</a>
		<ul class="navbar-nav">
			for _, item := range pd.Nav {
				<li>
					<a
						href={ templ.SafeURL(item.URL) }
						title={ item.Label }
						if item.Active {
							class="active"
							aria-current="page"
						}
					>
						if item.Icon != "" {
							@templ.Raw(item.Icon)
						}
						<span class="nav-label">{ item.Label }</span>
					</a>
				</li>
			}
		</ul>
		if len(pd.Nav) > 0 {
			<div class="dropdown navbar-apps">
				<button type="button" class="btn-icon" data-dropdown-toggle aria-expanded="false" aria-controls="apps-menu" aria-label="Apps">
					@Icon("grid")
				</button>
				<div class="dropdown-menu" id="apps-menu">
					for _, item := range pd.Nav {
						<a
							href={ templ.SafeURL(item.URL) }
							if item.Active {
								class="active"
								aria-current="page"
							}
						>
							if item.Icon != "" {
								@templ.Raw(item.Icon)
							}
							{ item.Label }
						</a>
					}
					if pd.User != nil {
						<div class="dropdown-divider"></div>
						<button type="button" data-search-open>
							@Icon("search")
							Search
						</button>
						<a href="/settings/profile" class={ dropdownActive(pd.RequestPath, "/settings") }>
							@Icon("settings")
							Settings
						</a>
						if pd.User.IsAdmin {
							<a href="/admin/" class={ dropdownActive(pd.RequestPath, "/admin") }>
								@Icon("shield")
								Admin
							</a>
						}
					}
				</div>
			</div>
		}
		<div class="navbar-spacer"></div>
		if pd.User != nil {
			<div class="navbar-search" role="search">
				<label class="sr-only" for="search-box">Search</label>
				<input
					type="search"
					name="q"
					placeholder="Search (/)…"
					id="search-box"
					class="form-control search-input"
					hx-get="/api/search/partial"
					hx-trigger="input changed delay:200ms, search"
					hx-target="#search-results"
					autocomplete="off"
					aria-controls="search-results"
				/>
				<div id="search-results" class="search-results" aria-live="polite"></div>
			</div>
			<button type="button" class="btn-icon search-toggle" data-search-open aria-label="Search" aria-expanded="false" aria-controls="search-box">
				@Icon("search")
			</button>
		}
		<div class="navbar-end">
			if pd.User != nil {
				@notificationTray()
				@UserDropdown(pd)
			}
		</div>
	</nav>
	<script>cog.fitNavbar();</script>
}

// notificationTray renders the bell and its panel. cog.js fills the panel:
// messages the page raised (a failed request, a reminder) above the user's
// recent activity, which can be narrowed to notifications or one app. The
// badge counts notifications not yet seen.
templ notificationTray() {
	<div class="dropdown notif-dropdown" id="notif">
		<button type="button" class="btn-icon" data-dropdown-toggle aria-expanded="false" aria-controls="notif-panel" aria-label="Notifications">
			@Icon("bell")
			<span id="notif-badge" class="notif-badge" hidden></span>
		</button>
		<div class="dropdown-menu" id="notif-panel">
			<div id="tray-notices" class="tray-notices" hidden>
				<div class="tray-heading">
					Notifications
					<button type="button" class="tray-clear" data-tray-clear>Clear</button>
				</div>
				<div id="tray-notice-list"></div>
			</div>
			<div class="tray-heading">
				<label for="tray-filter">Recent activity</label>
				<select id="tray-filter" class="tray-filter" aria-label="Show">
					<option value="">All</option>
					<option value="notifications">Notifications</option>
				</select>
			</div>
			<div id="tray-activity">
				<p class="tray-empty">No activity yet.</p>
			</div>
			<label class="tray-desktop" id="tray-desktop-row" hidden>
				<input type="checkbox" id="tray-desktop"/>
				Show notifications on the desktop
			</label>
		</div>
	</div>
}

// AdminSidebarPage renders a page with the admin sidebar, a divider, and plugin settings items.
templ AdminSidebarPage(pd PageData, active string) {
	@Base(pd) {
		<div class="sidebar-layout">
			<nav class="sidebar" aria-label="Administration">
				@sidebarItems(adminSidebarItems(active))
				if len(pd.PluginSettingsNav) > 0 {
					<div class="sidebar-heading">Apps</div>
					@sidebarItems(pd.PluginSettingsNav)
				}
			</nav>
			<div class="sidebar-content">
				{ children... }
			</div>
		</div>
	}
}

func adminSidebarItems(active string) []SidebarItem {
	return []SidebarItem{
		{Label: "General", URL: "/admin/settings", Active: active == "settings"},
		{Label: "Email", URL: "/admin/email", Active: active == "email"},
		{Label: "Users", URL: "/admin/users", Active: active == "users"},
		{Label: "Groups", URL: "/admin/groups", Active: active == "groups"},
		{Label: "Volumes", URL: "/admin/volumes", Active: active == "volumes"},
		{Label: "Plugins", URL: "/admin/plugins", Active: active == "plugins"},
		{Label: "Logs", URL: "/admin/logs", Active: active == "logs"},
	}
}

// sidebarItems renders a list of sidebar items.
templ sidebarItems(items []SidebarItem) {
	for _, item := range items {
		if len(item.Children) > 0 {
			<span class="sidebar-group">{ item.Label }</span>
			for _, child := range item.Children {
				@sidebarLink(child, "sidebar-item sidebar-child")
			}
		} else {
			@sidebarLink(item, "sidebar-item")
		}
	}
}

templ sidebarLink(item SidebarItem, class string) {
	<a
		href={ templ.SafeURL(item.URL) }
		if item.Active {
			class={ class + " active" }
			aria-current="page"
		} else {
			class={ class }
		}
	>{ item.Label }</a>
}

// SidebarPage renders a page with a sidebar and main content area.
templ SidebarPage(pd PageData, sidebar []SidebarItem) {
	@Base(pd) {
		<div class="sidebar-layout">
			<nav class="sidebar" aria-label="Section">
				@sidebarItems(sidebar)
			</nav>
			<div class="sidebar-content">
				{ children... }
			</div>
		</div>
	}
}

// dropdownActive returns "active" if the current request path matches or starts with the given URL.
func dropdownActive(requestPath, url string) string {
	if requestPath == url || strings.HasPrefix(requestPath, url+"/") || (url != "/" && strings.HasPrefix(requestPath, url)) {
		return "active"
	}
	return ""
}

func userLabel(pd PageData) string {
	if pd.User.DisplayName != "" {
		return pd.User.DisplayName
	}
	return pd.User.Username
}

// UserDropdown renders the account menu in the navbar.
templ UserDropdown(pd PageData) {
	<div class="dropdown">
		<button
			type="button"
			class="dropdown-toggle"
			data-dropdown-toggle
			aria-expanded="false"
			aria-controls="user-menu"
			aria-label={ "Account menu for " + userLabel(pd) }
		>
			<img class="avatar-sm" src={ pd.User.AvatarURL() } alt=""/>
			<span class="dropdown-username">{ userLabel(pd) }</span>
			<span class="dropdown-caret" aria-hidden="true">&#9662;</span>
		</button>
		<div class="dropdown-menu" id="user-menu">
			<div class="dropdown-header">
				<strong>{ userLabel(pd) }</strong>
				if pd.User.DisplayName != "" {
					{ pd.User.Username }
				}
			</div>
			<div class="dropdown-divider"></div>
			<a href="/settings/profile" class={ dropdownActive(pd.RequestPath, "/settings/profile") }>Profile</a>
			<a href="/settings/security" class={ dropdownActive(pd.RequestPath, "/settings/security") }>Security</a>
			<a href="/settings/storage" class={ dropdownActive(pd.RequestPath, "/settings/storage") }>Storage</a>
			<a href="/settings/groups" class={ dropdownActive(pd.RequestPath, "/settings/groups") }>Groups</a>
			<a href="/settings/data" class={ dropdownActive(pd.RequestPath, "/settings/data") }>Import and export</a>
			if pd.User.IsAdmin {
				<div class="dropdown-divider"></div>
				<a href="/admin/" class={ dropdownActive(pd.RequestPath, "/admin") }>Admin</a>
			}
			<div class="dropdown-divider"></div>
			<form method="post" action="/logout">
				<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
				<button type="submit">Log out</button>
			</form>
		</div>
	</div>
}

// CogIcon renders a cog/gear SVG at the given pixel size.
templ CogIcon(size int) {
	<svg width={ fmt.Sprint(size) } height={ fmt.Sprint(size) } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<circle cx="12" cy="12" r="3"></circle>
		<path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
	</svg>
}

// hitURL returns the appropriate link URL for a search hit.
func hitURL(hit search.Hit) string {
	source := hit.Source

	// Use the stored _id field if available (actual DB primary key),
	// otherwise fall back to extracting from the document ID (rowid-based).
	idPart, _ := hit.Fields["_id"].(string)
	if idPart == "" {
		idPart = hit.ID
		if i := strings.Index(hit.ID, ":"); i >= 0 {
			idPart = hit.ID[i+1:]
		}
	}

	switch source {
	case "files":
		if sub, ok := hit.Fields["subtext"].(string); ok && sub != "" {
			return "/apps/files" + sub
		}
		return "/apps/files/"
	case "users":
		return "/admin/users/" + idPart
	case "groups":
		return "/admin/groups/" + idPart
	case "volumes":
		return "/admin/volumes/" + idPart
	case "rss":
		if sub, ok := hit.Fields["subtext"].(string); ok && sub != "" {
			return sub
		}
		return "/apps/rss/"
	case "calendar":
		return "/apps/calendar/"
	default:
		return "/"
	}
}

// hitName returns the display name for a search hit.
func hitName(hit search.Hit) string {
	if name, ok := hit.Fields["name"].(string); ok {
		return name
	}
	return hit.ID
}

// hitSubtext returns the subtext for a search hit.
func hitSubtext(hit search.Hit) string {
	if sub, ok := hit.Fields["subtext"].(string); ok {
		return sub
	}
	return ""
}

// SearchResults renders the search results dropdown partial.
templ SearchResults(query string, pages []PageLink, userHits, systemHits []search.Hit, isAdmin bool) {
	if len(pages) == 0 && len(userHits) == 0 && len(systemHits) == 0 {
		<div class="search-empty">
			No results for <strong>“{ query }”</strong>
		</div>
	}
	if len(pages) > 0 {
		<div class="search-section">Pages</div>
		for _, page := range pages {
			<a class="search-hit" href={ templ.SafeURL(page.URL) }>
				<span class="search-hit-name">{ page.Label }</span>
				if page.Section != "" {
					<span class="search-hit-sub">{ page.Section }</span>
				}
			</a>
		}
	}
	if len(userHits) > 0 {
		<div class="search-section">My Resources</div>
		for _, hit := range userHits {
			<a class="search-hit" href={ templ.SafeURL(hitURL(hit)) }>
				<span class="search-hit-name">{ hitName(hit) }</span>
				if hitSubtext(hit) != "" {
					<span class="search-hit-sub">{ hitSubtext(hit) }</span>
				}
			</a>
		}
	}
	if isAdmin && len(systemHits) > 0 {
		<div class="search-section">System</div>
		for _, hit := range systemHits {
			<a class="search-hit" href={ templ.SafeURL(hitURL(hit)) }>
				<span class="search-hit-name">{ hitName(hit) }</span>
				<span class="badge badge-admin">{ hit.Source }</span>
			</a>
		}
	}
}

// pageFlash renders the message a redirect carried, if any. A page that reads
// the flash itself and renders it in its own layout leaves PageData.Flash nil,
// so nothing shows twice.
templ pageFlash(pd PageData) {
	if pd.Flash != nil && pd.Flash.Message != "" {
		<div data-page-flash>
			if pd.Flash.URL != "" {
				@AlertWithCopy(pd.Flash.Kind, pd.Flash.Message, pd.Flash.URL)
			} else {
				@Alert(pd.Flash.Kind, pd.Flash.Message)
			}
		</div>
	}
}
