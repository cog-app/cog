package ui

import "fmt"

// Base renders the full HTML page with navbar and content area.
templ Base(pd PageData) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		<title>{ pd.Title } — Cog</title>
		<link rel="stylesheet" href="/static/style.css"/>
		<script src="/static/htmx.min.js"></script>
	</head>
	<body hx-headers={ fmt.Sprintf(`{"X-CSRF-Token":"%s"}`, pd.CSRFToken) }>
		<nav class="navbar">
			<a class="navbar-brand" href="/">Cog</a>
			<ul class="navbar-nav">
				for _, item := range pd.Nav {
					<li>
						if item.Active {
							<a href={ templ.SafeURL(item.URL) } class="active">{ item.Label }</a>
						} else {
							<a href={ templ.SafeURL(item.URL) }>{ item.Label }</a>
						}
					</li>
				}
			</ul>
			<div class="navbar-end">
				if pd.User != nil {
					@UserDropdown(pd)
				}
			</div>
		</nav>
		<main class="content">
			{ children... }
		</main>
	</body>
	</html>
}

// UserDropdown renders the user menu in the navbar.
templ UserDropdown(pd PageData) {
	<div class="dropdown" tabindex="0">
		<button class="dropdown-toggle" type="button">
			if pd.User.DisplayName != "" {
				{ pd.User.DisplayName }
			} else {
				{ pd.User.Username }
			}
			<span>&#9662;</span>
		</button>
		<div class="dropdown-menu">
			<a href="/settings">Settings</a>
			if pd.User.IsAdmin {
				<a href="/admin/users">Admin</a>
			}
			<div class="dropdown-divider"></div>
			<form method="post" action="/logout">
				<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
				<button type="submit">Log out</button>
			</form>
		</div>
	</div>
}

// LoginPage renders the standalone login page (no navbar).
templ LoginPage(errMsg string, csrfToken string) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		<title>Login — Cog</title>
		<link rel="stylesheet" href="/static/style.css"/>
	</head>
	<body>
		<div class="login-container">
			<div class="card login-card">
				<div class="login-title">Cog</div>
				if errMsg != "" {
					<div class="alert alert-error">{ errMsg }</div>
				}
				<form method="post" action="/login">
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					<div class="form-group">
						<label for="username">Username</label>
						<input class="form-control" type="text" id="username" name="username" required autofocus/>
					</div>
					<div class="form-group">
						<label for="password">Password</label>
						<input class="form-control" type="password" id="password" name="password" required/>
					</div>
					<button class="btn btn-primary" type="submit" style="width:100%;margin-top:0.5rem">Log in</button>
				</form>
			</div>
		</div>
	</body>
	</html>
}
