package ui

import (
	"fmt"
	"strings"

	"git.duckfam.us/jj-software/cog/internal/search"
)

// Base renders the full HTML page with navbar and content area.
templ Base(pd PageData) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ pd.Title } — Cog</title>
			<link rel="stylesheet" href="/static/style.css"/>
			<script src="/static/htmx.min.js"></script>
		</head>
		<body hx-headers={ fmt.Sprintf(`{"X-CSRF-Token":"%s"}`, pd.CSRFToken) }>
			<nav class="navbar">
				<a class="navbar-brand" href="/">Cog</a>
				<ul class="navbar-nav">
					for _, item := range pd.Nav {
						<li>
							if item.Active {
								<a href={ templ.SafeURL(item.URL) } class="active">{ item.Label }</a>
							} else {
								<a href={ templ.SafeURL(item.URL) }>{ item.Label }</a>
							}
						</li>
					}
				</ul>
				if pd.User != nil {
					<div class="navbar-search">
						<input
							type="search"
							name="q"
							placeholder="Search (/)..."
							id="search-box"
							class="form-control search-input"
							hx-get="/api/search/partial"
							hx-trigger="input changed delay:200ms, search"
							hx-target="#search-results"
							autocomplete="off"
						/>
						<div id="search-results" class="search-results"></div>
					</div>
				}
				<div class="navbar-end">
					if pd.User != nil {
						<div id="notif-bell" style="position:relative;cursor:pointer;padding:0 0.5rem;display:none" onclick="toggleNotifPanel()" title="Notifications">
							<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
							<span id="notif-badge" class="notif-badge" style="display:none"></span>
						</div>
						<div id="notif-panel" class="dropdown-menu" style="display:none;position:absolute;right:4rem;top:3rem;min-width:280px;max-height:300px;overflow:auto;z-index:100"></div>
						@UserDropdown(pd)
					}
				</div>
			</nav>
			<main class="content">
				{ children... }
			</main>
			<script>
		// Notification polling
		(function() {
			var bell = document.getElementById("notif-bell");
			var badge = document.getElementById("notif-badge");
			var panel = document.getElementById("notif-panel");
			if (!bell) return;
			var pending = [];

			function checkNotifications() {
				fetch("/apps/calendar/notifications")
					.then(function(r) { return r.ok ? r.json() : []; })
					.then(function(data) {
						if (!data || !data.length) return;
						pending = pending.concat(data);
						bell.style.display = "";
						badge.style.display = "";
						badge.textContent = pending.length;
						// Show browser notification if permitted
						if (Notification.permission === "granted") {
							data.forEach(function(n) {
								new Notification("Reminder: " + n.summary, { body: "Starting " + new Date(n.start).toLocaleString() });
							});
						} else if (Notification.permission !== "denied") {
							Notification.requestPermission();
						}
					}).catch(function() {});
			}

			window.toggleNotifPanel = function() {
				if (panel.style.display === "none") {
					panel.style.display = "block";
					panel.innerHTML = "";
					if (!pending.length) {
						panel.innerHTML = '<div style="padding:0.75rem;color:var(--color-text-muted)">No notifications</div>';
					} else {
						pending.forEach(function(n) {
							var d = document.createElement("a");
							d.href = "/apps/calendar/?date=" + n.start.slice(0,10);
							d.className = "search-hit";
							d.innerHTML = '<span class="search-hit-name">' + n.summary + '</span><span class="search-hit-sub">' + new Date(n.start).toLocaleString() + '</span>';
							panel.appendChild(d);
						});
					}
				} else {
					panel.style.display = "none";
				}
			};

			// Poll every 60 seconds
			setInterval(checkNotifications, 60000);
			// Initial check after 5 seconds
			setTimeout(checkNotifications, 5000);
		})();
		</script>
			<script>
		(function() {
			var box = document.getElementById("search-box");
			if (!box) return;
			var results = document.getElementById("search-results");

			document.addEventListener("keydown", function(e) {
				if (e.key === "/" && !e.ctrlKey && !e.metaKey &&
					!["INPUT","TEXTAREA","SELECT"].includes(document.activeElement.tagName) &&
					!document.activeElement.isContentEditable) {
					e.preventDefault();
					box.focus();
					box.select();
				}
			});

			box.addEventListener("keydown", function(e) {
				var hits = results.querySelectorAll(".search-hit");
				if (!hits.length) {
					if (e.key === "Escape") { box.blur(); }
					return;
				}
				var cur = results.querySelector(".search-hit-active");
				var idx = cur ? Array.prototype.indexOf.call(hits, cur) : -1;

				if (e.key === "ArrowDown") {
					e.preventDefault();
					if (cur) cur.classList.remove("search-hit-active");
					idx = (idx + 1) % hits.length;
					hits[idx].classList.add("search-hit-active");
					hits[idx].scrollIntoView({block:"nearest"});
				} else if (e.key === "ArrowUp") {
					e.preventDefault();
					if (cur) cur.classList.remove("search-hit-active");
					idx = idx <= 0 ? hits.length - 1 : idx - 1;
					hits[idx].classList.add("search-hit-active");
					hits[idx].scrollIntoView({block:"nearest"});
				} else if (e.key === "Enter") {
					if (cur) {
						e.preventDefault();
						cur.click();
					}
				} else if (e.key === "Escape") {
					box.blur();
				}
			});

			new MutationObserver(function() {
				var hits = results.querySelectorAll(".search-hit");
				hits.forEach(function(h) { h.classList.remove("search-hit-active"); });
				if (hits.length) hits[0].classList.add("search-hit-active");
			}).observe(results, {childList: true});
		})();
		</script>
		</body>
	</html>
}

// Shell renders the full HTML shell around a body component.
// Used by the plugin shell middleware to wrap fragment handlers.
templ Shell(pd PageData, body templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ pd.Title } — Cog</title>
			<link rel="stylesheet" href="/static/style.css"/>
			<script src="/static/htmx.min.js"></script>
		</head>
		<body hx-headers={ fmt.Sprintf(`{"X-CSRF-Token":"%s"}`, pd.CSRFToken) }>
			<nav class="navbar">
				<a class="navbar-brand" href="/">Cog</a>
				<ul class="navbar-nav">
					for _, item := range pd.Nav {
						<li>
							if item.Active {
								<a href={ templ.SafeURL(item.URL) } class="active">{ item.Label }</a>
							} else {
								<a href={ templ.SafeURL(item.URL) }>{ item.Label }</a>
							}
						</li>
					}
				</ul>
				if pd.User != nil {
					<div class="navbar-search">
						<input
							type="search"
							name="q"
							placeholder="Search (/)..."
							id="search-box"
							class="form-control search-input"
							hx-get="/api/search/partial"
							hx-trigger="input changed delay:200ms, search"
							hx-target="#search-results"
							autocomplete="off"
						/>
						<div id="search-results" class="search-results"></div>
					</div>
				}
				<div class="navbar-end">
					if pd.User != nil {
						<div id="notif-bell" style="position:relative;cursor:pointer;padding:0 0.5rem;display:none" onclick="toggleNotifPanel()" title="Notifications">
							<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
							<span id="notif-badge" class="notif-badge" style="display:none"></span>
						</div>
						<div id="notif-panel" class="dropdown-menu" style="display:none;position:absolute;right:4rem;top:3rem;min-width:280px;max-height:300px;overflow:auto;z-index:100"></div>
						@UserDropdown(pd)
					}
				</div>
			</nav>
			<main class="content">
				@body
			</main>
			<script>
		// Notification polling
		(function() {
			var bell = document.getElementById("notif-bell");
			var badge = document.getElementById("notif-badge");
			var panel = document.getElementById("notif-panel");
			if (!bell) return;
			var pending = [];

			function checkNotifications() {
				fetch("/apps/calendar/notifications")
					.then(function(r) { return r.ok ? r.json() : []; })
					.then(function(data) {
						if (!data || !data.length) return;
						pending = pending.concat(data);
						bell.style.display = "";
						badge.style.display = "";
						badge.textContent = pending.length;
						// Show browser notification if permitted
						if (Notification.permission === "granted") {
							data.forEach(function(n) {
								new Notification("Reminder: " + n.summary, { body: "Starting " + new Date(n.start).toLocaleString() });
							});
						} else if (Notification.permission !== "denied") {
							Notification.requestPermission();
						}
					}).catch(function() {});
			}

			window.toggleNotifPanel = function() {
				if (panel.style.display === "none") {
					panel.style.display = "block";
					panel.innerHTML = "";
					if (!pending.length) {
						panel.innerHTML = '<div style="padding:0.75rem;color:var(--color-text-muted)">No notifications</div>';
					} else {
						pending.forEach(function(n) {
							var d = document.createElement("a");
							d.href = "/apps/calendar/?date=" + n.start.slice(0,10);
							d.className = "search-hit";
							d.innerHTML = '<span class="search-hit-name">' + n.summary + '</span><span class="search-hit-sub">' + new Date(n.start).toLocaleString() + '</span>';
							panel.appendChild(d);
						});
					}
				} else {
					panel.style.display = "none";
				}
			};

			// Poll every 60 seconds
			setInterval(checkNotifications, 60000);
			// Initial check after 5 seconds
			setTimeout(checkNotifications, 5000);
		})();
		</script>
			<script>
		(function() {
			var box = document.getElementById("search-box");
			if (!box) return;
			var results = document.getElementById("search-results");

			document.addEventListener("keydown", function(e) {
				if (e.key === "/" && !e.ctrlKey && !e.metaKey &&
					!["INPUT","TEXTAREA","SELECT"].includes(document.activeElement.tagName) &&
					!document.activeElement.isContentEditable) {
					e.preventDefault();
					box.focus();
					box.select();
				}
			});

			box.addEventListener("keydown", function(e) {
				var hits = results.querySelectorAll(".search-hit");
				if (!hits.length) {
					if (e.key === "Escape") { box.blur(); }
					return;
				}
				var cur = results.querySelector(".search-hit-active");
				var idx = cur ? Array.prototype.indexOf.call(hits, cur) : -1;

				if (e.key === "ArrowDown") {
					e.preventDefault();
					if (cur) cur.classList.remove("search-hit-active");
					idx = (idx + 1) % hits.length;
					hits[idx].classList.add("search-hit-active");
					hits[idx].scrollIntoView({block:"nearest"});
				} else if (e.key === "ArrowUp") {
					e.preventDefault();
					if (cur) cur.classList.remove("search-hit-active");
					idx = idx <= 0 ? hits.length - 1 : idx - 1;
					hits[idx].classList.add("search-hit-active");
					hits[idx].scrollIntoView({block:"nearest"});
				} else if (e.key === "Enter") {
					if (cur) {
						e.preventDefault();
						cur.click();
					}
				} else if (e.key === "Escape") {
					box.blur();
				}
			});

			new MutationObserver(function() {
				var hits = results.querySelectorAll(".search-hit");
				hits.forEach(function(h) { h.classList.remove("search-hit-active"); });
				if (hits.length) hits[0].classList.add("search-hit-active");
			}).observe(results, {childList: true});
		})();
		</script>
		</body>
	</html>
}

// SidebarPage renders a page with a sidebar and main content area.
templ SidebarPage(pd PageData, sidebar []SidebarItem) {
	@Base(pd) {
		<div class="sidebar-layout">
			<nav class="sidebar">
				for _, item := range sidebar {
					if item.Active {
						<a href={ templ.SafeURL(item.URL) } class="sidebar-item active">{ item.Label }</a>
					} else {
						<a href={ templ.SafeURL(item.URL) } class="sidebar-item">{ item.Label }</a>
					}
				}
			</nav>
			<div class="sidebar-content">
				{ children... }
			</div>
		</div>
	}
}

// dropdownActive returns "active" if the current request path matches or starts with the given URL.
func dropdownActive(requestPath, url string) string {
	if requestPath == url || strings.HasPrefix(requestPath, url+"/") || (url != "/" && strings.HasPrefix(requestPath, url)) {
		return "active"
	}
	return ""
}

// UserDropdown renders the user menu in the navbar.
templ UserDropdown(pd PageData) {
	<div class="dropdown" tabindex="0">
		<button class="dropdown-toggle" type="button">
			<img class="avatar-sm" src={ pd.User.AvatarURL() }/>
			if pd.User.DisplayName != "" {
				{ pd.User.DisplayName }
			} else {
				{ pd.User.Username }
			}
			<span>&#9662;</span>
		</button>
		<div class="dropdown-menu">
			<a href="/settings/profile" class={ dropdownActive(pd.RequestPath, "/settings/profile") }>Profile</a>
			<a href="/settings/security" class={ dropdownActive(pd.RequestPath, "/settings/security") }>Security</a>
			<a href="/settings/storage" class={ dropdownActive(pd.RequestPath, "/settings/storage") }>Storage</a>
			<a href="/settings/groups" class={ dropdownActive(pd.RequestPath, "/settings/groups") }>Groups</a>
			if pd.User.IsAdmin {
				<div class="dropdown-divider"></div>
				<a href="/admin/" class={ dropdownActive(pd.RequestPath, "/admin") }>Admin</a>
			}
			<div class="dropdown-divider"></div>
			<form method="post" action="/logout">
				<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
				<button type="submit">Log out</button>
			</form>
		</div>
	</div>
}

var defaultUsername, defaultPassword string

// LoginPage renders the standalone login page (no navbar).
templ LoginPage(errMsg string, csrfToken string, next string, registrationEnabled bool) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Login — Cog</title>
			<link rel="stylesheet" href="/static/style.css"/>
		</head>
		<body>
			<div class="login-container">
				<div class="card login-card">
					<div class="login-title">Cog</div>
					if errMsg != "" {
						<div class="alert alert-error">{ errMsg }</div>
					}
					<form method="post" action="/login">
						<input type="hidden" name="csrf_token" value={ csrfToken }/>
						if next != "" {
							<input type="hidden" name="next" value={ next }/>
						}
						<div class="form-group">
							<label for="username">Username</label>
							<input class="form-control" type="text" id="username" name="username" value={ defaultUsername } required autofocus/>
						</div>
						<div class="form-group">
							<label for="password">Password</label>
							<input class="form-control" type="password" id="password" name="password" value={ defaultPassword } required/>
						</div>
						<button class="btn btn-primary" type="submit" style="width:100%;margin-top:0.5rem">Log in</button>
					</form>
					if registrationEnabled {
						<p style="text-align:center;margin-top:1rem">
							Don't have an account?
							if next != "" {
								<a href={ templ.SafeURL("/register?next=" + next) }>Register</a>
							} else {
								<a href="/register">Register</a>
							}
						</p>
					}
				</div>
			</div>
		</body>
	</html>
}

// RegisterPage renders the standalone registration page.
templ RegisterPage(errMsg string, next string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Register — Cog</title>
			<link rel="stylesheet" href="/static/style.css"/>
		</head>
		<body>
			<div class="login-container">
				<div class="card login-card">
					<div class="login-title">Cog</div>
					if errMsg != "" {
						<div class="alert alert-error">{ errMsg }</div>
					}
					<form method="post" action="/register">
						if next != "" {
							<input type="hidden" name="next" value={ next }/>
						}
						<div class="form-group">
							<label for="username">Username</label>
							<input class="form-control" type="text" id="username" name="username" required autofocus/>
						</div>
						<div class="form-group">
							<label for="password">Password</label>
							<input class="form-control" type="password" id="password" name="password" required/>
						</div>
						<div class="form-group">
							<label for="confirm">Confirm Password</label>
							<input class="form-control" type="password" id="confirm" name="confirm" required/>
						</div>
						<button class="btn btn-primary" type="submit" style="width:100%;margin-top:0.5rem">Register</button>
					</form>
					<p style="text-align:center;margin-top:1rem">
						Already have an account?
						if next != "" {
							<a href={ templ.SafeURL("/login?next=" + next) }>Log in</a>
						} else {
							<a href="/login">Log in</a>
						}
					</p>
				</div>
			</div>
		</body>
	</html>
}

// hitURL returns the appropriate link URL for a search hit.
func hitURL(hit search.Hit) string {
	source := hit.Source

	// Use the stored _id field if available (actual DB primary key),
	// otherwise fall back to extracting from the document ID (rowid-based).
	idPart, _ := hit.Fields["_id"].(string)
	if idPart == "" {
		idPart = hit.ID
		if i := strings.Index(hit.ID, ":"); i >= 0 {
			idPart = hit.ID[i+1:]
		}
	}

	switch source {
	case "files":
		if sub, ok := hit.Fields["subtext"].(string); ok && sub != "" {
			return "/apps/files" + sub
		}
		return "/apps/files/"
	case "users":
		return "/admin/users/" + idPart
	case "groups":
		return "/admin/groups/" + idPart
	case "volumes":
		return "/admin/volumes/" + idPart
	case "rss":
		if sub, ok := hit.Fields["subtext"].(string); ok && sub != "" {
			return sub
		}
		return "/apps/rss/"
	case "calendar":
		return "/apps/calendar/"
	default:
		return "/"
	}
}

// hitName returns the display name for a search hit.
func hitName(hit search.Hit) string {
	if name, ok := hit.Fields["name"].(string); ok {
		return name
	}
	return hit.ID
}

// hitSubtext returns the subtext for a search hit.
func hitSubtext(hit search.Hit) string {
	if sub, ok := hit.Fields["subtext"].(string); ok {
		return sub
	}
	return ""
}

// SearchResults renders the search results dropdown partial.
templ SearchResults(pages []PageLink, userHits, systemHits []search.Hit, isAdmin bool) {
	if len(pages) == 0 && len(userHits) == 0 && len(systemHits) == 0 {
		<div class="search-empty">No results</div>
	}
	if len(pages) > 0 {
		<div class="search-section">Pages</div>
		for _, page := range pages {
			<a class="search-hit" href={ templ.SafeURL(page.URL) }>
				<span class="search-hit-name">{ page.Label }</span>
				<span class="search-hit-sub">{ page.URL }</span>
			</a>
		}
	}
	if len(userHits) > 0 {
		<div class="search-section">My Resources</div>
		for _, hit := range userHits {
			<a class="search-hit" href={ templ.SafeURL(hitURL(hit)) }>
				<span class="search-hit-name">{ hitName(hit) }</span>
				if hitSubtext(hit) != "" {
					<span class="search-hit-sub">{ hitSubtext(hit) }</span>
				}
			</a>
		}
	}
	if isAdmin && len(systemHits) > 0 {
		<div class="search-section">System</div>
		for _, hit := range systemHits {
			<a class="search-hit" href={ templ.SafeURL(hitURL(hit)) }>
				<span class="search-hit-name">{ hitName(hit) }</span>
				<span class="badge badge-admin">{ hit.Source }</span>
			</a>
		}
	}
}
