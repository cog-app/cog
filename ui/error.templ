package ui

// AppErrorPage renders a standalone page for an app that could not serve a
// request: a process plugin that is down, or one that reported a fault.
//
// It is a whole document rather than a fragment for the shell to wrap, because
// the shell passes any response of 300 or more straight through — and because
// the app this page stands in for is the broken thing, so the less of it this
// page depends on, the better. Only the stylesheet is shared.
//
// retryURL is the path to offer as "Try again", usually the one that failed.
// Leave it empty for a failure that repeating will not fix.
templ AppErrorPage(appName, heading, message, retryURL string) {
	@AuthPage(appName) {
		<h1 class="login-heading">{ heading }</h1>
		<p class="login-lead">{ message }</p>
		<div class="btn-group justify-center">
			if retryURL != "" {
				<a class="btn btn-primary" href={ templ.SafeURL(retryURL) }>Try again</a>
			}
			<a class="btn btn-secondary" href="/">Back to Cog</a>
		</div>
	}
}

// NotFoundPage is the page for a URL that matches nothing, inside the normal
// shell so the user can navigate on from it.
templ NotFoundPage(pd PageData) {
	@Base(pd) {
		<div class="card content--narrow error-card">
			@EmptyState("Page not found", "The page you were looking for doesn't exist, or it has moved.") {
				<a class="btn btn-primary" href="/">Back to dashboard</a>
			}
		</div>
	}
}
