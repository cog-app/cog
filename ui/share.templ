package ui

import (
	"fmt"
	"strconv"
)

// SharePanel renders the sharing UI panel that can be embedded in any plugin's settings page.
// panelID scopes the element IDs so multiple panels can coexist on one page.
// Use <cog-share resource="type" resource-id="id"> or <cog-share-button> web components
// instead of calling this template directly.
templ SharePanel(panelID, resourceType, resourceID, csrfToken string, shares []ShareDisplayItem, levels []PermissionLevelChoice) {
	<div id={ panelID } class="share-panel">
		<h3>Sharing</h3>
		if len(shares) > 0 {
			<div class="table-wrap mb-2">
				<table class="table table-sm">
					<thead>
						<tr>
							<th>Shared with</th>
							<th class="col-shrink">Permissions</th>
							<th class="col-actions"><span class="sr-only">Actions</span></th>
						</tr>
					</thead>
					<tbody>
						for _, s := range shares {
							<tr>
								<td class="break-anywhere">
									if s.SubjectType == "PUBLIC" {
										<span title="Public link">{ s.SubjectName }</span>
										if s.Token != "" {
											<div><code class="text-xs text-muted">{ s.LinkPath }</code></div>
										}
									} else {
										{ s.SubjectName }
									}
								</td>
								<td class="nowrap">{ s.PermLabel }</td>
								<td class="col-actions">
									<button
										type="button"
										class="btn-icon btn-icon-sm btn-icon-danger"
										aria-label={ "Stop sharing with " + s.SubjectName }
										title="Remove share"
										hx-delete={ fmt.Sprintf("/api/shares/%s/delete", s.ID) }
										hx-headers={ fmt.Sprintf(`{"X-CSRF-Token":"%s"}`, csrfToken) }
										hx-target={ "#" + panelID }
										hx-get={ fmt.Sprintf("/api/shares/panel?type=%s&id=%s&scope=%s", resourceType, resourceID, panelID) }
										hx-swap="outerHTML"
										hx-trigger="click"
									>
										@Icon("x")
									</button>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		} else {
			<p class="empty-state empty-state-sm">Not shared with anyone yet.</p>
		}
		<details class="share-option">
			<summary>Share with a user</summary>
			<form hx-post="/api/shares/create" hx-target={ "#" + panelID } hx-swap="outerHTML" class="form-row mb-0">
				@shareHidden(csrfToken, resourceType, resourceID, panelID)
				<div class="form-group">
					<label class="form-label">User</label>
					@Picker("/api/picker/search?type=user", "subject_id", "Search users…", false)
				</div>
				@sharePermission(panelID+"-user-perm", levels)
				<button type="submit" class="btn btn-primary">Share</button>
			</form>
		</details>
		<details class="share-option">
			<summary>Share with everyone on this server</summary>
			<form hx-post="/api/shares/create" hx-target={ "#" + panelID } hx-swap="outerHTML" class="form-row mb-0">
				@shareHidden(csrfToken, resourceType, resourceID, panelID)
				<input type="hidden" name="subject_type" value="INSTANCE"/>
				<input type="hidden" name="subject_id" value=""/>
				@sharePermission(panelID+"-all-perm", levels)
				<button type="submit" class="btn btn-primary">Share with everyone</button>
			</form>
		</details>
		<details class="share-option">
			<summary>Share with someone on another server</summary>
			<form hx-post="/api/shares/federated" hx-target={ "#" + panelID } hx-swap="outerHTML" class="form-row mb-0">
				@shareHidden(csrfToken, resourceType, resourceID, panelID)
				<div class="form-group">
					<label class="form-label" for={ panelID + "-remote" }>Their address</label>
					<input type="text" id={ panelID + "-remote" } name="share_with" class="form-control" placeholder="user@cloud.example.com" required/>
				</div>
				@sharePermission(panelID+"-remote-perm", levels)
				<button type="submit" class="btn btn-primary">Share</button>
			</form>
		</details>
		<details class="share-option">
			<summary>Create a link anyone can open</summary>
			<form hx-post="/api/shares/public-link-form" hx-target={ "#" + panelID } hx-swap="outerHTML" class="form-row mb-0">
				@shareHidden(csrfToken, resourceType, resourceID, panelID)
				@sharePermission(panelID+"-link-perm", levels)
				<button type="submit" class="btn btn-primary">Create link</button>
			</form>
		</details>
	</div>
}

templ shareHidden(csrfToken, resourceType, resourceID, panelID string) {
	<input type="hidden" name="csrf_token" value={ csrfToken }/>
	<input type="hidden" name="resource_type" value={ resourceType }/>
	<input type="hidden" name="resource_id" value={ resourceID }/>
	<input type="hidden" name="panel_id" value={ panelID }/>
}

templ sharePermission(id string, levels []PermissionLevelChoice) {
	<div class="form-group form-group-auto">
		<label class="form-label" for={ id }>Permission</label>
		<select id={ id } name="permissions" class="form-control">
			for _, l := range levels {
				<option value={ strconv.FormatUint(uint64(l.Permissions), 10) }>{ l.Label }</option>
			}
		</select>
	</div>
}
