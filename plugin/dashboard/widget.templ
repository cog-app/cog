package dashboard

import (
	"fmt"

	"git.duckfam.us/jj-software/cog/internal/plugin"
)

templ groupsWidget(groups []plugin.GroupInfo) {
	if len(groups) == 0 {
		<p class="text-muted">You are not in any groups.</p>
	} else {
		for _, g := range groups {
			<div style="padding:0.4rem 0;border-bottom:1px solid var(--color-border)">
				<a href={ templ.SafeURL(fmt.Sprintf("/settings/groups/%s", g.ID)) } style="font-weight:500">
					{ g.Name }
				</a>
			</div>
		}
	}
}
