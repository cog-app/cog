package dashboard

import (
	"fmt"

	"git.duckfam.us/jj-software/cog/internal/plugin"
	"git.duckfam.us/jj-software/cog/ui"
)

templ groupsWidget(groups []plugin.GroupInfo) {
	if len(groups) == 0 {
		@ui.WidgetEmpty("You are not in any groups.", "Create a group", "/settings/groups")
	} else {
		<ul class="widget-list">
			for _, g := range groups {
				<li>
					<a class="font-medium" href={ templ.SafeURL(fmt.Sprintf("/settings/groups/%s", g.ID)) }>{ g.Name }</a>
				</li>
			}
		</ul>
	}
}
