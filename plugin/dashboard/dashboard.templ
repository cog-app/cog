package dashboard

import (
	"fmt"
	"strconv"

	"git.duckfam.us/jj-software/cog/internal/plugin"
	"git.duckfam.us/jj-software/cog/ui"
)

// shownWidget is a widget already rendered for this user.
type shownWidget struct {
	Title string
	URL   string
	HTML  string
	Empty bool // rendered ui.WidgetEmpty: folded into the "nothing yet" line
}

templ dashboardPage(pd ui.PageData, apps []AppLink, widgets []shownWidget, columns int) {
	@ui.Base(pd) {
		@ui.PageHeader("Dashboard", nil) {
			<a href="/dashboard/edit" class="btn btn-secondary">
				@ui.Icon("settings")
				Customize
			</a>
		}
		if len(apps) > 0 {
			<nav class="app-grid" aria-label="Apps">
				for _, app := range apps {
					<a href={ templ.SafeURL(app.URL) } class="card app-card">
						<span class="app-card-icon" aria-hidden="true">
							@appIcon(app.Icon)
						</span>
						<span class="app-card-label">{ app.Label }</span>
					</a>
				}
			</nav>
		}
		if hasContent(widgets) {
			<div class={ fmt.Sprintf("widget-grid widget-grid-%d", columns) }>
				for _, w := range widgets {
					if !w.Empty {
						<section class="card widget">
							<div class="card-header">
								<h2 class="card-title">{ w.Title }</h2>
								if w.URL != "" {
									<a class="text-sm" href={ templ.SafeURL(w.URL) }>View all</a>
								}
							</div>
							@templ.Raw(w.HTML)
						</section>
					}
				}
			</div>
		}
		if empties := emptyWidgets(widgets); len(empties) > 0 {
			<div class="card widget-empties mt-2">
				<span class="text-sm text-muted">Nothing here yet:</span>
				for _, w := range empties {
					if w.URL != "" {
						<a class="chip" href={ templ.SafeURL(w.URL) }>{ w.Title }</a>
					} else {
						<span class="chip">{ w.Title }</span>
					}
				}
			</div>
		}
		if len(apps) == 0 && len(widgets) == 0 {
			@ui.Card("") {
				@ui.EmptyState("Welcome, "+pd.User.Username, "No apps are enabled yet. An administrator can turn them on under Admin › Plugins.")
			}
		}
	}
}

func hasContent(ws []shownWidget) bool {
	for _, w := range ws {
		if !w.Empty {
			return true
		}
	}
	return false
}

func emptyWidgets(ws []shownWidget) []shownWidget {
	var out []shownWidget
	for _, w := range ws {
		if w.Empty {
			out = append(out, w)
		}
	}
	return out
}

templ dashboardEditPage(pd ui.PageData, allWidgets []plugin.Widget, layout *Layout, enabledSet map[string]bool) {
	@ui.Base(pd) {
		@ui.PageHeader("Customize dashboard", []ui.Crumb{{Label: "Dashboard", URL: "/"}})
		<form method="post" action="/dashboard/layout">
			<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
			@ui.Card("Layout") {
				<fieldset>
					<legend>Columns</legend>
					<div class="chip-group">
						for _, n := range []int{1, 2, 3} {
							<label class="chip">
								<input type="radio" name="columns" value={ strconv.Itoa(n) } checked?={ n == layout.Columns }/>
								{ strconv.Itoa(n) }
							</label>
						}
					</div>
				</fieldset>
			}
			@ui.Card("Widgets") {
				<p class="card-desc">Choose the widgets to show and put them in order.</p>
				<div id="widget-list">
					for _, w := range allWidgets {
						<div class="widget-row">
							<input type="checkbox" id={ "widget-" + w.Title } name="widget_order" value={ w.Title } checked?={ enabledSet[w.Title] }/>
							<label class="widget-row-title" for={ "widget-" + w.Title }>{ w.Title }</label>
							<button type="button" class="btn-icon btn-icon-sm" aria-label={ "Move " + w.Title + " up" } onclick="moveWidget(this.closest('.widget-row'),-1)">
								@ui.Icon("arrow-up")
							</button>
							<button type="button" class="btn-icon btn-icon-sm" aria-label={ "Move " + w.Title + " down" } onclick="moveWidget(this.closest('.widget-row'),1)">
								@ui.Icon("arrow-down")
							</button>
						</div>
					}
				</div>
			}
			<div class="page-actions-bar">
				<a href="/" class="btn btn-secondary">Cancel</a>
				<button type="submit" class="btn btn-primary">Save</button>
			</div>
		</form>
		<script>
			function moveWidget(el, dir) {
				var parent = el.parentNode;
				if (dir === -1 && el.previousElementSibling) {
					parent.insertBefore(el, el.previousElementSibling);
				} else if (dir === 1 && el.nextElementSibling) {
					parent.insertBefore(el.nextElementSibling, el);
				}
				el.querySelector("button[aria-label*='" + (dir < 0 ? "up" : "down") + "']").focus();
			}
		</script>
	}
}

templ appIcon(icon string) {
	if icon != "" {
		<span class="app-icon">
			@templ.Raw(icon)
		</span>
	} else {
		<svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
		</svg>
	}
}
