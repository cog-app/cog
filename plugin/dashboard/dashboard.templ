package dashboard

import (
	"context"
	"fmt"
	"io"
	"strconv"

	"git.duckfam.us/jj-software/cog/internal/plugin"
	"git.duckfam.us/jj-software/cog/ui"
)

templ dashboardPage(pd ui.PageData, apps []AppLink, widgets []plugin.Widget, userID string, columns int) {
	@ui.Base(pd) {
		<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem">
			<h1 style="margin:0">Dashboard</h1>
			<a href="/dashboard/edit" class="btn btn-outline btn-sm">Customize</a>
		</div>
		if len(apps) > 0 {
			<div class="app-grid">
				for _, app := range apps {
					<a href={ templ.SafeURL(app.URL) } class="card app-card">
						<div style="margin-bottom:0.5rem">
							@appIcon(app.Icon)
						</div>
						<div class="app-card-label">{ app.Label }</div>
					</a>
				}
			</div>
		}
		if len(widgets) > 0 {
			<div style={ fmt.Sprintf("margin-top:1.5rem;display:grid;grid-template-columns:repeat(%d,1fr);gap:1rem", columns) }>
				for _, w := range widgets {
					@ui.Card(w.Title) {
						@widgetContent(w, userID)
					}
				}
			</div>
		}
		if len(apps) == 0 && len(widgets) == 0 {
			<div class="card">
				<p>
					You are logged in as <strong>{ pd.User.Username }</strong>.
				</p>
			</div>
		}
	}
}

templ dashboardEditPage(pd ui.PageData, allWidgets []plugin.Widget, layout *Layout, enabledSet map[string]bool) {
	@ui.Base(pd) {
		<h1 style="margin-bottom:1rem">Customize Dashboard</h1>
		<form method="post" action="/dashboard/layout">
			<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
			@ui.Card("Layout") {
				<div style="margin-bottom:0.5rem">
					<label style="font-weight:500">Columns</label>
				</div>
				<div style="display:flex;gap:1rem">
					for _, n := range []int{1, 2, 3} {
						<label style="display:flex;align-items:center;gap:0.25rem">
							if n == layout.Columns {
								<input type="radio" name="columns" value={ strconv.Itoa(n) } checked/>
							} else {
								<input type="radio" name="columns" value={ strconv.Itoa(n) }/>
							}
							{ strconv.Itoa(n) }
						</label>
					}
				</div>
			}
			@ui.Card("Widgets") {
				<p style="color:var(--color-text-muted);margin-bottom:0.75rem">Check widgets to show. Use the arrows to reorder.</p>
				<div id="widget-list">
					for _, w := range allWidgets {
						<div style="display:flex;align-items:center;gap:0.75rem;padding:0.5rem;border:1px solid var(--color-border);border-radius:var(--radius);margin-bottom:0.5rem">
							if enabledSet[w.Title] {
								<input type="checkbox" name="widget_order" value={ w.Title } checked/>
							} else {
								<input type="checkbox" name="widget_order" value={ w.Title }/>
							}
							<span style="flex:1;font-weight:500">{ w.Title }</span>
							<button type="button" class="btn btn-outline btn-sm" onclick="moveWidget(this.closest('[style]'),-1)">Up</button>
							<button type="button" class="btn btn-outline btn-sm" onclick="moveWidget(this.closest('[style]'),1)">Down</button>
						</div>
					}
				</div>
			}
			<div style="display:flex;gap:0.5rem;justify-content:flex-end;margin-top:1rem">
				<a href="/" class="btn">Cancel</a>
				<button type="submit" class="btn btn-primary">Save</button>
			</div>
		</form>
		<script>
		function moveWidget(el, dir) {
			var parent = el.parentNode;
			if (dir === -1 && el.previousElementSibling) {
				parent.insertBefore(el, el.previousElementSibling);
			} else if (dir === 1 && el.nextElementSibling) {
				parent.insertBefore(el.nextElementSibling, el);
			}
		}
		</script>
	}
}

templ widgetContent(w plugin.Widget, userID string) {
	@widgetAdapter(w, userID)
}

func widgetAdapter(w plugin.Widget, userID string) templ.Component {
	return templ.ComponentFunc(func(ctx context.Context, wr io.Writer) error {
		return w.Render(ctx, wr, userID)
	})
}

templ appIcon(icon string) {
	if icon != "" {
		<span class="app-icon">
			@templ.Raw(icon)
		</span>
	} else {
		<svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
		</svg>
	}
}
