package feed

import (
	"strconv"

	"git.duckfam.us/jj-software/cog/ui"
)

templ feedWidget(unread int64, recent []Item) {
	if len(recent) == 0 {
		@ui.WidgetEmpty("No unread articles.", "Add a subscription", "/apps/feed/settings/subscriptions")
	} else {
		<p class="text-muted text-sm mb-1">{ strconv.FormatInt(unread, 10) } unread</p>
		<ul class="widget-list">
			for _, it := range recent {
				<li>
					<a href={ templ.SafeURL("/apps/feed/items/" + strconv.FormatInt(it.ID, 10)) } class="font-medium">{ it.Title }</a>
				</li>
			}
		</ul>
	}
}
