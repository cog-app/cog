package feed

import "strconv"

templ feedWidget(unread int64, recent []Item) {
	if len(recent) == 0 {
		<p class="text-muted">No recent items.</p>
	} else {
		<div style="padding:0.2rem 0;margin-bottom:0.4rem">
			<span class="badge">{ strconv.FormatInt(unread, 10) } unread</span>
		</div>
		for _, it := range recent {
			<div style="padding:0.4rem 0;border-bottom:1px solid var(--color-border)">
				<a href={ templ.SafeURL("/apps/feed/items/" + strconv.FormatInt(it.ID, 10)) } style="font-weight:500">
					{ it.Title }
				</a>
				<div class="text-muted" style="font-size:0.85rem">{ it.Type }</div>
			</div>
		}
	}
}
