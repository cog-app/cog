package feed

import (
	"fmt"
	"net/url"
	"strconv"
	"strings"
	"time"

	"git.duckfam.us/jj-software/cog/ui"
)

// sidebarData holds all data needed to render the feed sidebar.
type sidebarData struct {
	Folders       []Folder
	Subscriptions []Subscription
	Tags          []string
	Playlists     []Playlist
	ActivePath    string
	TotalUnread   int
	StarredCount  int
	UnreadCounts  map[int64]int // by subscription_id
	FolderUnread  map[int64]int // by folder_id
	HideEmpty     bool
}

templ feedSidebar(sb sidebarData) {
	<nav class="sidebar" id="feed-sidebar">
		<label class="sidebar-hide-empty" style="display:flex;align-items:center;gap:0.4rem;padding:0.25rem 0.5rem;font-size:0.8rem;color:var(--color-text-muted)">
			<input
				type="checkbox"
				name="hide_empty"
				checked?={ sb.HideEmpty }
				hx-post="/apps/feed/player/prefs"
				hx-vals={ `js:{hide_empty: event.target.checked ? "1" : "0"}` }
				hx-target="#feed-sidebar"
				hx-swap="outerHTML"
			/>
			Hide read
		</label>
		<a href="/apps/feed/" class={ feedSidebarClass(sb.ActivePath, "/apps/feed/") }>
			All
			if sb.TotalUnread > 0 {
				<span class="badge">{ strconv.Itoa(sb.TotalUnread) }</span>
			}
		</a>
		<a href="/apps/feed/starred" class={ feedSidebarClass(sb.ActivePath, "/apps/feed/starred") }>
			Starred
			if sb.StarredCount > 0 {
				<span class="badge">{ strconv.Itoa(sb.StarredCount) }</span>
			}
		</a>
		<a href="/apps/feed/history" class={ feedSidebarClass(sb.ActivePath, "/apps/feed/history") }>History</a>
		<div class="sidebar-divider"></div>
		for _, folder := range sb.Folders {
			if !sb.HideEmpty || sb.FolderUnread[folder.ID] > 0 {
				<details class="sidebar-folder" data-folder-id={ strconv.FormatInt(folder.ID, 10) } open?={ isFeedFolderActive(folder, sb) }>
					<summary class="sidebar-group-label">
						<a
							href={ templ.SafeURL(fmt.Sprintf("/apps/feed/folder/%d", folder.ID)) }
							style="color:inherit;text-decoration:none"
							onclick="event.stopPropagation()"
						>{ folder.Name }</a>
						if sb.FolderUnread[folder.ID] > 0 {
							<span class="badge">{ strconv.Itoa(sb.FolderUnread[folder.ID]) }</span>
						}
					</summary>
					for _, sub := range sb.Subscriptions {
						if sub.FolderID.Valid && sub.FolderID.Int64 == folder.ID {
							if !sb.HideEmpty || sb.UnreadCounts[sub.ID] > 0 {
								@feedSidebarSubLink(sub, sb)
							}
						}
					}
				</details>
			}
		}
		for _, sub := range sb.Subscriptions {
			if !sub.FolderID.Valid {
				if !sb.HideEmpty || sb.UnreadCounts[sub.ID] > 0 {
					@feedSidebarSubLink(sub, sb)
				}
			}
		}
		if len(sb.Tags) > 0 {
			<div class="sidebar-divider"></div>
			<span class="sidebar-group-label" style="font-size:0.8rem;color:var(--color-text-muted)">Tags</span>
			for _, tag := range sb.Tags {
				<a
					href={ templ.SafeURL("/apps/feed/tag/" + url.PathEscape(tag)) }
					class={ feedSidebarClass(sb.ActivePath, "/apps/feed/tag/"+tag) }
					style="padding-left:1.5rem;font-size:0.9rem"
				>{ tag }</a>
			}
		}
		if len(sb.Playlists) > 0 {
			<div class="sidebar-divider"></div>
			<span class="sidebar-group-label" style="font-size:0.8rem;color:var(--color-text-muted)">Playlists</span>
			for _, pl := range sb.Playlists {
				<a
					href={ templ.SafeURL(fmt.Sprintf("/apps/feed/playlists/%d", pl.ID)) }
					class={ feedSidebarClass(sb.ActivePath, fmt.Sprintf("/apps/feed/playlists/%d", pl.ID)) }
					style="padding-left:1.5rem;font-size:0.9rem"
				>{ pl.Name }</a>
			}
		}
		<hr class="sidebar-divider"/>
		<div class="sidebar-group-label" style="font-size:0.8rem;color:var(--color-text-muted);padding:0.25rem 0.5rem">Settings</div>
		<a href="/apps/feed/settings/subscriptions" class={ feedSidebarClass(sb.ActivePath, "/apps/feed/settings/subscriptions") } style="padding-left:1.5rem;font-size:0.9rem">Subscriptions</a>
		<a href="/apps/feed/settings/filters" class={ feedSidebarClass(sb.ActivePath, "/apps/feed/settings/filters") } style="padding-left:1.5rem;font-size:0.9rem">Filters</a>
		<a href="/apps/feed/settings/playlists" class={ feedSidebarClass(sb.ActivePath, "/apps/feed/settings/playlists") } style="padding-left:1.5rem;font-size:0.9rem">Playlists</a>
	</nav>
	<script>
		// Preserve folder open/closed state across HTMX sidebar refreshes.
		(function () {
			var openFolders = new Set();
			document.addEventListener("htmx:beforeSwap", function (e) {
				if (e.detail.target && e.detail.target.id === "feed-sidebar") {
					openFolders.clear();
					e.detail.target
						.querySelectorAll("details[data-folder-id]")
						.forEach(function (d) {
							if (d.open) openFolders.add(d.getAttribute("data-folder-id"));
						});
				}
			});
			document.addEventListener("htmx:afterSwap", function (e) {
				if (e.detail.target && e.detail.target.id === "feed-sidebar") {
					e.detail.target
						.querySelectorAll("details[data-folder-id]")
						.forEach(function (d) {
							if (openFolders.has(d.getAttribute("data-folder-id")))
								d.open = true;
						});
				}
			});
		})();
	</script>
}

templ feedSidebarSubLink(sub Subscription, sb sidebarData) {
	<a
		href={ templ.SafeURL(fmt.Sprintf("/apps/feed/subscription/%d", sub.ID)) }
		class={ feedSidebarSubClass(sub, sb) }
		style="padding-left:1.5rem;font-size:0.9rem;display:flex;align-items:center;gap:0.25rem"
	>
		@feedSubIcon(sub)
		<span class="sidebar-item-text">{ subscriptionDisplayTitle(sub) }</span>
		if sub.LastError != "" {
			<span class="text-danger" title={ sub.LastError }>!</span>
		}
		if sb.UnreadCounts[sub.ID] > 0 {
			<span class="badge">{ strconv.Itoa(sb.UnreadCounts[sub.ID]) }</span>
		}
	</a>
}

templ feedIndexPage(sb sidebarData, items []ItemWithSubscription, q string, csrfToken string, vctx string) {
	<div class="sidebar-layout">
		@feedSidebar(sb)
		<div class="sidebar-content">
			<div class="flex items-center gap-1 mb-2" style="justify-content:space-between;flex-wrap:wrap">
				<h1 style="margin:0">All Articles</h1>
				<div class="flex gap-1 items-center">
					<form method="get" action="/apps/feed/">
						<div class="flex gap-1">
							<input class="form-control" type="search" name="q" value={ q } placeholder="Search feeds…" style="max-width:280px" title="Search — see ▾ for syntax"/>
							<button class="btn btn-outline btn-sm" type="submit">Go</button>
						</div>
						<details class="feed-search-help" style="margin-top:0.25rem;font-size:0.8rem;color:var(--color-text-muted)">
							<summary style="cursor:pointer;user-select:none">Search help</summary>
							<div style="margin-top:0.4rem;line-height:1.6;background:var(--color-bg);border:1px solid var(--color-border);border-radius:4px;padding:0.5rem 0.75rem">
								<code>term</code> — title / author / content
								<br/>
								<code>&ldquo;exact phrase&rdquo;</code> — phrase match
								<br/>
								<code>:type=audio</code> / <code>:type=video</code> / <code>:type=text</code>
								<br/>
								<code>is:unread</code> &nbsp;<code>is:starred</code> &nbsp;<code>is:downloaded</code>
								<br/>
								<code>:tag=name</code> &nbsp;<code>:folder=name</code> &nbsp;<code>:subscription=name</code>
								<br/>
								<code>:published&gt;2026-01-01</code> &nbsp;<code>:published&gt;-7d</code> &nbsp;<code>:published&lt;2026-06-01</code>
								<br/>
								<code>:duration&gt;600</code> — duration in seconds
								<br/>
								combine: <code>is:unread :type=audio &ldquo;deep dive&rdquo;</code> &nbsp;&bull;&nbsp; <code>OR</code> &nbsp;<code>NOT</code> &nbsp;<code>( )</code>
							</div>
						</details>
					</form>
					if sb.TotalUnread > 0 {
						<form method="post" action="/apps/feed/items/read-all">
							<input type="hidden" name="csrf_token" value={ csrfToken }/>
							<button class="btn btn-outline btn-sm" type="submit">Mark all read</button>
						</form>
					}
				</div>
			</div>
			if len(items) == 0 {
				@ui.Card("") {
					<p class="text-muted">No articles yet. Subscribe to feeds in Settings.</p>
				}
			} else {
				@feedItemList(items, csrfToken, vctx)
			}
		</div>
	</div>
}

templ feedSubscriptionPage(sb sidebarData, sub *Subscription, items []ItemWithSubscription, csrfToken string, vctx string) {
	<div class="sidebar-layout">
		@feedSidebar(sb)
		<div class="sidebar-content">
			<div class="flex items-center gap-1 mb-2" style="justify-content:space-between">
				<h1 style="margin:0;display:flex;align-items:center;gap:0.5rem">
					@feedSubIcon(*sub)
					{ subscriptionDisplayTitle(*sub) }
				</h1>
				<div class="flex gap-1">
					<form method="post" action={ templ.SafeURL(fmt.Sprintf("/apps/feed/subscriptions/%d/refresh", sub.ID)) }>
						<input type="hidden" name="csrf_token" value={ csrfToken }/>
						<button class="btn btn-outline btn-sm" type="submit">Refresh</button>
					</form>
					<form method="post" action={ templ.SafeURL(fmt.Sprintf("/apps/feed/subscriptions/%d/read-all", sub.ID)) }>
						<input type="hidden" name="csrf_token" value={ csrfToken }/>
						<button class="btn btn-outline btn-sm" type="submit">Mark all read</button>
					</form>
					<a href={ templ.SafeURL(fmt.Sprintf("/apps/feed/subscription/%d/settings", sub.ID)) } class="btn btn-outline btn-sm">Settings</a>
				</div>
			</div>
			if sub.LastError != "" {
				@ui.Alert("error", fmt.Sprintf("Last fetch failed: %s (errors in a row: %d)", sub.LastError, sub.ErrorCount))
			}
			if len(items) == 0 {
				@ui.Card("") {
					<p class="text-muted">No articles in this subscription yet.</p>
				}
			} else {
				@feedItemList(items, csrfToken, vctx)
			}
		</div>
	</div>
}

templ feedFolderPage(sb sidebarData, folder *Folder, items []ItemWithSubscription, csrfToken string, vctx string) {
	<div class="sidebar-layout">
		@feedSidebar(sb)
		<div class="sidebar-content">
			<div class="flex items-center gap-1 mb-2" style="justify-content:space-between">
				<h1 style="margin:0">{ folder.Name }</h1>
				<form method="post" action={ templ.SafeURL(fmt.Sprintf("/apps/feed/folders/%d/read-all", folder.ID)) }>
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					<button class="btn btn-outline btn-sm" type="submit">Mark all read</button>
				</form>
			</div>
			if len(items) == 0 {
				@ui.Card("") {
					<p class="text-muted">No articles in this folder.</p>
				}
			} else {
				@feedItemList(items, csrfToken, vctx)
			}
		</div>
	</div>
}

templ feedStarredPage(sb sidebarData, items []ItemWithSubscription, csrfToken string, vctx string) {
	<div class="sidebar-layout">
		@feedSidebar(sb)
		<div class="sidebar-content">
			<h1>Starred</h1>
			if len(items) == 0 {
				@ui.Card("") {
					<p class="text-muted">No starred articles.</p>
				}
			} else {
				@feedItemList(items, csrfToken, vctx)
			}
		</div>
	</div>
}

templ feedTagPage(sb sidebarData, tag string, items []ItemWithSubscription, csrfToken string, vctx string) {
	<div class="sidebar-layout">
		@feedSidebar(sb)
		<div class="sidebar-content">
			<h1>Tag: { tag }</h1>
			if len(items) == 0 {
				@ui.Card("") {
					<p class="text-muted">No articles with this tag.</p>
				}
			} else {
				@feedItemList(items, csrfToken, vctx)
			}
		</div>
	</div>
}

templ feedPlaylistPage(sb sidebarData, pl Playlist, items []ItemWithSubscription, csrfToken string, vctx string) {
	<div class="sidebar-layout">
		@feedSidebar(sb)
		<div class="sidebar-content">
			<div class="flex items-center gap-1 mb-2" style="justify-content:space-between">
				<h1 style="margin:0">{ pl.Name }</h1>
				<code class="text-muted" style="font-size:0.85rem">{ pl.Query }</code>
			</div>
			if len(items) == 0 {
				@ui.Card("") {
					<p class="text-muted">No items match this playlist's query.</p>
				}
			} else {
				@feedItemList(items, csrfToken, vctx)
			}
		</div>
	</div>
}

templ feedItemList(items []ItemWithSubscription, csrfToken string, vctx string) {
	<style>
		/* The head bleeds out to the row edges so a read item's tint spans the
		   full width, while the expanded body keeps the surface background. */
		.feed-item-head {
			margin: -0.75rem -1rem;
			padding: 0.75rem 1rem;
		}
		.feed-item-detail {
			margin-top: 0.75rem;
		}
		.feed-item-read .feed-item-head {
			background: rgba(0, 0, 0, 0.07);
		}
		.feed-item-read .feed-item-head a:not(.btn),
		.feed-item-read .feed-item-head .feed-item-summary-line {
			opacity: 0.75;
		}
	</style>
	<div id="item-list">
		for _, item := range items {
			@feedItemRow(item, csrfToken, vctx)
		}
	</div>
	<script>
		function toggleArticle(id) {
			var el = document.getElementById("detail-" + id);
			var row = document.getElementById("item-" + id);
			var summary = document.getElementById("summary-" + id);
			if (!el) return;
			var isOpen = el.style.display !== "none";
			// Close all open details.
			document.querySelectorAll(".feed-item-detail").forEach(function (d) {
				d.style.display = "none";
			});
			document.querySelectorAll(".feed-item-active").forEach(function (r) {
				r.classList.remove("feed-item-active");
			});
			document
				.querySelectorAll(".feed-item-summary-line")
				.forEach(function (s) {
					s.style.display = "";
				});
			if (!isOpen) {
				el.style.display = "";
				row.classList.add("feed-item-active");
				if (summary) summary.style.display = "none";
				// Mark as read visually and on the server.
				if (!row.classList.contains("feed-item-read")) {
					row.classList.add("feed-item-read");
					var readBtn = row.querySelector('[title="Toggle read"]');
					if (readBtn) readBtn.innerHTML = "○";
				}
				fetch("/apps/feed/items/" + id + "/mark-read", {
					method: "POST",
					headers: {
						"X-CSRF-Token": document.querySelector("[name=csrf_token]")
							? document.querySelector("[name=csrf_token]").value
							: "",
					},
				});
			}
		}
		(function () {
			document.addEventListener("keydown", function (e) {
				if (
					e.target.tagName === "INPUT" ||
					e.target.tagName === "TEXTAREA" ||
					e.target.tagName === "SELECT"
				)
					return;
				var items = Array.from(document.querySelectorAll(".feed-item"));
				var active = document.querySelector(".feed-item-active");
				var idx = active ? items.indexOf(active) : -1;
				if (e.key === "j") {
					e.preventDefault();
					var next = idx + 1;
					if (next < items.length) {
						var id = items[next].id.replace("item-", "");
						toggleArticle(id);
						items[next].scrollIntoView({
							block: "nearest",
							behavior: "smooth",
						});
					}
				} else if (e.key === "k") {
					e.preventDefault();
					var prev = idx - 1;
					if (prev >= 0) {
						var id = items[prev].id.replace("item-", "");
						toggleArticle(id);
						items[prev].scrollIntoView({
							block: "nearest",
							behavior: "smooth",
						});
					}
				} else if (e.key === "o" || e.key === "Enter") {
					if (active) {
						var link = active.querySelector(
							".feed-item-detail a[target=_blank]",
						);
						if (link) {
							e.preventDefault();
							window.open(link.href, "_blank");
						}
					}
				}
			});
		})();
	</script>
}

templ feedItemRow(item ItemWithSubscription, csrfToken string, vctx string) {
	if item.Type == "audio" || item.Type == "video" {
		@feedMediaItemRow(item, csrfToken, vctx)
	} else {
		@feedTextItemRow(item, csrfToken, vctx)
	}
}

templ feedTextItemRow(item ItemWithSubscription, csrfToken string, vctx string) {
	<div id={ fmt.Sprintf("item-%d", item.ID) } class={ feedItemRowClass(item.IsRead) } style="padding:0.75rem 1rem;border-bottom:1px solid var(--color-border, #e0e0e0)">
		<div class="feed-item-head flex items-center gap-1" style="justify-content:space-between;cursor:pointer" onclick={ templ.ComponentScript{Call: fmt.Sprintf("toggleArticle(%d)", item.ID)} }>
			<div style="min-width:0;flex:1">
				<div class="flex items-center gap-1" style="flex-wrap:wrap">
					<a
						href={ templ.SafeURL(fmt.Sprintf("/apps/feed/subscription/%d", item.SubscriptionID)) }
						class="text-muted"
						style="font-size:0.8rem"
						onclick="event.stopPropagation()"
					>{ item.SubscriptionTitle }</a>
					if item.Author != "" {
						<span class="text-muted" style="font-size:0.8rem">&middot; { item.Author }</span>
					}
					<span class="text-muted" style="font-size:0.8rem">&middot; { feedFormatTime(item.PublishedAt) }</span>
				</div>
				<a
					href={ templ.SafeURL(itemHref(item.ID, vctx)) }
					style="font-weight:500;color:inherit;text-decoration:none"
					onclick="event.stopPropagation()"
				>{ item.Title }</a>
				if feedItemSummary(item.ContentHTML) != "" {
					<div id={ fmt.Sprintf("summary-%d", item.ID) } class="feed-item-summary-line">
						{ feedItemSummary(item.ContentHTML) }
					</div>
				}
			</div>
			<div class="flex gap-1" style="flex-shrink:0" onclick="event.stopPropagation()">
				if item.URL != "" {
					<a
						href={ templ.SafeURL(item.URL) }
						target="_blank"
						rel="noopener"
						class="btn btn-outline btn-sm"
						title="Open article"
					>&#8599;</a>
				}
				@ui.Star(item.IsStarred, fmt.Sprintf("/apps/feed/items/%d/star", item.ID))
				<button
					class="btn btn-outline btn-sm"
					hx-post={ fmt.Sprintf("/apps/feed/items/%d/read", item.ID) }
					hx-target={ fmt.Sprintf("#item-%d", item.ID) }
					hx-swap="outerHTML"
					title="Toggle read"
				>
					if item.IsRead {
						&#9675;
					} else {
						&#9679;
					}
				</button>
			</div>
		</div>
		<div id={ fmt.Sprintf("detail-%d", item.ID) } class="feed-item-detail" style="display:none">
			if feedItemPreviewImage(item.ContentHTML) != "" {
				<img class="feed-item-preview-img" src={ feedItemPreviewImage(item.ContentHTML) } alt=""/>
			}
			if item.ContentHTML != "" {
				<div class="feed-item-content">
					@templ.Raw(item.ContentHTML)
				</div>
			} else if feedItemSummary(item.ContentHTML) != "" {
				<p class="feed-item-summary">{ feedItemSummary(item.ContentHTML) }</p>
			}
			<div style="margin-top:0.75rem;clear:both">
				if item.URL != "" {
					<a href={ templ.SafeURL(item.URL) } target="_blank" rel="noopener" class="btn btn-outline btn-sm">Open article</a>
				}
			</div>
		</div>
	</div>
}

templ feedMediaItemRow(item ItemWithSubscription, csrfToken string, vctx string) {
	<div id={ fmt.Sprintf("item-%d", item.ID) } class={ feedItemRowClass(item.IsRead) } style="padding:0.75rem 1rem;border-bottom:1px solid var(--color-border, #e0e0e0)">
		<div class="feed-item-head flex items-center gap-1" style="justify-content:space-between">
			<div style="min-width:0;flex:1">
				<div class="flex items-center gap-1" style="flex-wrap:wrap">
					<a
						href={ templ.SafeURL(fmt.Sprintf("/apps/feed/subscription/%d", item.SubscriptionID)) }
						class="text-muted"
						style="font-size:0.8rem"
					>{ item.SubscriptionTitle }</a>
					if item.Author != "" {
						<span class="text-muted" style="font-size:0.8rem">&middot; { item.Author }</span>
					}
					<span class="text-muted" style="font-size:0.8rem">&middot; { feedFormatTime(item.PublishedAt) }</span>
					if item.DurationSec > 0 {
						<span class="text-muted" style="font-size:0.8rem">&middot; { feedFormatDuration(item.DurationSec) }</span>
					}
				</div>
				<a
					href={ templ.SafeURL(itemHref(item.ID, vctx)) }
					style="font-weight:500;color:inherit;text-decoration:none"
				>{ item.Title }</a>
			</div>
			<div class="flex gap-1" style="flex-shrink:0">
				<a
					href={ templ.SafeURL(itemHref(item.ID, vctx)) }
					class="btn btn-outline btn-sm"
					title={ "Play " + item.Type }
				>&#9654; Play</a>
				if item.URL != "" {
					<a
						href={ templ.SafeURL(item.URL) }
						target="_blank"
						rel="noopener"
						class="btn btn-outline btn-sm"
						title="Open original"
					>&#8599;</a>
				}
				@ui.Star(item.IsStarred, fmt.Sprintf("/apps/feed/items/%d/star", item.ID))
				<button
					class="btn btn-outline btn-sm"
					hx-post={ fmt.Sprintf("/apps/feed/items/%d/read", item.ID) }
					hx-target={ fmt.Sprintf("#item-%d", item.ID) }
					hx-swap="outerHTML"
					title="Toggle read"
				>
					if item.IsRead {
						&#9675;
					} else {
						&#9679;
					}
				</button>
			</div>
		</div>
	</div>
}

// feedFilterPreviewResults renders a short list of matched items for the filter preview API.
templ feedFilterPreviewResults(items []ItemWithSubscription) {
	if len(items) == 0 {
		<p class="text-muted">No items match.</p>
	} else {
		<ul style="margin:0.5rem 0;padding-left:0;list-style:none">
			for _, it := range items {
				<li style="padding:0.2rem 0;font-size:0.9rem">
					<span class="badge" style="margin-right:0.3rem">{ it.Type }</span>
					{ it.Title }
					<span class="text-muted" style="font-size:0.8rem">&mdash; { it.SubscriptionTitle }</span>
				</li>
			}
		</ul>
	}
}

templ feedSettingsSubscriptionsPage(sb sidebarData, subs []Subscription, folders []Folder, flashMsg string, flashKind string, csrfToken string) {
	<div class="sidebar-layout">
		@feedSidebar(sb)
		<div class="sidebar-content">
			@ui.Alert(flashKind, flashMsg)
			@ui.Card("Subscriptions") {
				<form id="add-subscription" method="post" action="/apps/feed/subscriptions">
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					<div class="form-group">
						<label for="sub-url">URL</label>
						<input class="form-control" type="url" id="sub-url" name="url" required placeholder="https://example.com/feed.xml"/>
						<small class="text-muted">Type auto-detected from the URL (RSS / YouTube / generic page).</small>
					</div>
					<div class="form-group">
						<label for="sub-folder">Folder</label>
						<select id="sub-folder" name="folder_id" class="form-control">
							<option value="">(none)</option>
							for _, f := range folders {
								<option value={ strconv.FormatInt(f.ID, 10) }>{ f.Name }</option>
							}
						</select>
					</div>
					@ui.Button("primary", "Add subscription")
				</form>
				<details class="subscription-list-collapse" style="margin-top:1rem">
					<summary style="cursor:pointer;font-weight:500">Subscriptions ({ strconv.Itoa(len(subs)) })</summary>
					<ul id="subscription-list" style="margin-top:0.5rem;padding-left:0;list-style:none">
						for _, s := range subs {
							<li style="display:flex;align-items:center;gap:0.5rem;padding:0.4rem 0;border-bottom:1px solid var(--color-border)">
								<span style="flex:1">{ subscriptionDisplayTitle(s) }</span>
								<code>{ s.URL }</code>
								<span class="badge">{ s.Kind }</span>
								<form method="post" action={ templ.SafeURL("/apps/feed/subscriptions/" + strconv.FormatInt(s.ID, 10) + "/delete") } style="margin:0">
									<input type="hidden" name="csrf_token" value={ csrfToken }/>
									@ui.Button("danger", "Delete")
								</form>
							</li>
						}
					</ul>
				</details>
				<div style="margin-top:1rem;display:flex;gap:0.5rem;flex-wrap:wrap">
					@ui.Upload("/apps/feed/opml/import", "opml", ".opml,.xml,application/xml", csrfToken, "Import OPML", "btn-secondary btn-sm")
					<a class="btn btn-secondary btn-sm" href="/apps/feed/opml/export">Export OPML</a>
				</div>
				<form method="post" action="/apps/feed/import" enctype="multipart/form-data" style="margin-top:0.5rem;display:flex;gap:0.5rem;flex-wrap:wrap">
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					<label class="btn btn-secondary btn-sm" style="cursor:pointer">
						Import AntennaPod
						<input type="hidden" name="format" value="antennapod"/>
						<input type="file" name="file" accept=".db,.sqlite" style="display:none" onchange="this.form.submit()"/>
					</label>
				</form>
				<form method="post" action="/apps/feed/import" enctype="multipart/form-data" style="margin-top:0.5rem">
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					<label class="btn btn-secondary btn-sm" style="cursor:pointer">
						Import NewPipe
						<input type="hidden" name="format" value="newpipe"/>
						<input type="file" name="file" accept=".zip" style="display:none" onchange="this.form.submit()"/>
					</label>
				</form>
				<form method="post" action="/apps/feed/import" enctype="multipart/form-data" style="margin-top:0.5rem">
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					<label class="btn btn-secondary btn-sm" style="cursor:pointer">
						Import YouTube Takeout
						<input type="hidden" name="format" value="youtube-csv"/>
						<input type="file" name="file" accept=".csv" style="display:none" onchange="this.form.submit()"/>
					</label>
				</form>
			}
			@ui.Card("Folders") {
				<form id="add-folder" method="post" action="/apps/feed/folders" class="flex gap-1 items-center">
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					<input class="form-control" type="text" id="folder-name" name="name" placeholder="Folder name" required style="max-width:300px"/>
					@ui.Button("primary", "Add folder")
				</form>
				<ul style="margin-top:1rem;padding-left:0;list-style:none">
					for _, f := range folders {
						<li style="display:flex;align-items:center;gap:0.5rem;padding:0.4rem 0;border-bottom:1px solid var(--color-border)">
							<span style="flex:1">{ f.Name }</span>
							<form method="post" action={ templ.SafeURL("/apps/feed/folders/" + strconv.FormatInt(f.ID, 10) + "/delete") } style="margin:0">
								<input type="hidden" name="csrf_token" value={ csrfToken }/>
								@ui.Button("danger", "Delete")
							</form>
						</li>
					}
				</ul>
			}
		</div>
	</div>
}

templ feedSettingsFiltersPage(sb sidebarData, filters []Filter, flashMsg string, flashKind string, csrfToken string) {
	<div class="sidebar-layout">
		@feedSidebar(sb)
		<div class="sidebar-content">
			@ui.Alert(flashKind, flashMsg)
			@ui.Card("Filters") {
				<form id="add-filter" method="post" action="/apps/feed/filters">
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					<div class="form-group">
						<label for="filter-query">Query</label>
						<input
							class="form-control"
							type="text"
							id="filter-query"
							name="query"
							required
							hx-get="/apps/feed/filter-preview"
							hx-target="#filter-preview-results"
							hx-trigger="keyup changed delay:500ms"
							hx-include="this"
						/>
						<div id="filter-preview-results" style="margin-top:0.5rem"></div>
					</div>
					<div class="form-group">
						<label for="filter-action">Action</label>
						<select id="filter-action" name="action" class="form-control">
							<option value="skip">Skip</option>
							<option value="tag">Tag</option>
							<option value="download">Download</option>
							<option value="mute_profanity">Mute profanity</option>
							<option value="transcribe">Transcribe</option>
						</select>
					</div>
					<div class="form-group">
						<label for="filter-action-value">Tag (for &ldquo;Tag&rdquo; action)</label>
						<input class="form-control" type="text" id="filter-action-value" name="action_value"/>
					</div>
					@ui.Button("primary", "Add filter")
				</form>
				<ul style="margin-top:1rem;padding-left:0;list-style:none">
					for _, fl := range filters {
						<li style="display:flex;align-items:center;gap:0.5rem;padding:0.4rem 0;border-bottom:1px solid var(--color-border)">
							<code style="flex:1">{ fl.Query }</code>
							<span>&#8594; { fl.Action }</span>
							if fl.ActionValue != "" {
								<span class="badge">{ fl.ActionValue }</span>
							}
							<form method="post" action={ templ.SafeURL("/apps/feed/filters/" + strconv.FormatInt(fl.ID, 10) + "/delete") } style="margin:0">
								<input type="hidden" name="csrf_token" value={ csrfToken }/>
								@ui.Button("danger", "Delete")
							</form>
						</li>
					}
				</ul>
			}
		</div>
	</div>
}

templ feedSettingsPlaylistsPage(sb sidebarData, playlists []Playlist, flashMsg string, flashKind string, csrfToken string) {
	<div class="sidebar-layout">
		@feedSidebar(sb)
		<div class="sidebar-content">
			@ui.Alert(flashKind, flashMsg)
			@ui.Card("Playlists") {
				<form id="add-playlist" method="post" action="/apps/feed/playlists">
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					@ui.FormField("Name", "name", "text", "", "Playlist name")
					@ui.FormField("Query", "query", "text", "", "e.g. type:audio")
					@ui.Button("primary", "Add playlist")
				</form>
				<ul style="margin-top:1rem;padding-left:0;list-style:none">
					for _, pl := range playlists {
						<li style="display:flex;align-items:center;gap:0.5rem;padding:0.4rem 0;border-bottom:1px solid var(--color-border)">
							<span style="flex:1">{ pl.Name }</span>
							<code>{ pl.Query }</code>
							<form method="post" action={ templ.SafeURL("/apps/feed/playlists/" + strconv.FormatInt(pl.ID, 10) + "/delete") } style="margin:0">
								<input type="hidden" name="csrf_token" value={ csrfToken }/>
								@ui.Button("danger", "Delete")
							</form>
						</li>
					}
				</ul>
			}
		</div>
	</div>
}

// feedItemTagRow renders the tag pills plus an add-tag form for HTMX swap.
templ feedItemTagRow(itemID int64, tags []string, csrfToken string) {
	<div id={ "item-tags-" + strconv.FormatInt(itemID, 10) } class="mb-2">
		for _, tg := range tags {
			<span class="badge" style="margin-right:0.25rem;display:inline-flex;align-items:center;gap:0.25rem">
				{ tg }
				<form
					method="post"
					action={ templ.SafeURL(fmt.Sprintf("/apps/feed/items/%d/tag/%s/delete", itemID, url.PathEscape(tg))) }
					style="margin:0;display:inline"
					hx-post={ fmt.Sprintf("/apps/feed/items/%d/tag/%s/delete", itemID, url.PathEscape(tg)) }
					hx-target={ "#item-tags-" + strconv.FormatInt(itemID, 10) }
					hx-swap="outerHTML"
				>
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					<button type="submit" style="background:none;border:none;cursor:pointer;padding:0;line-height:1;font-size:0.75rem;color:inherit;opacity:0.7" title="Remove tag">&times;</button>
				</form>
			</span>
		}
		<form
			method="post"
			action={ templ.SafeURL(fmt.Sprintf("/apps/feed/items/%d/tag", itemID)) }
			style="display:inline-flex;align-items:center;gap:0.25rem;margin-left:0.25rem"
			hx-post={ fmt.Sprintf("/apps/feed/items/%d/tag", itemID) }
			hx-target={ "#item-tags-" + strconv.FormatInt(itemID, 10) }
			hx-swap="outerHTML"
		>
			<input type="hidden" name="csrf_token" value={ csrfToken }/>
			<input type="text" name="tag" placeholder="add tag" style="width:7rem;font-size:0.8rem;padding:0.1rem 0.3rem;border:1px solid var(--color-border);border-radius:4px;background:var(--color-bg)"/>
			<button type="submit" class="btn btn-outline btn-sm" style="padding:0.1rem 0.4rem;font-size:0.8rem">+</button>
		</form>
	</div>
}

templ feedItemContextBar(nav itemNav) {
	<div class="feed-context-bar" style="display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-bottom:1rem">
		<span class="text-muted">{ nav.Label }</span>
		<div class="flex gap-1">
			if nav.PrevID != 0 {
				<a class="btn btn-outline btn-sm" href={ templ.SafeURL(itemHref(nav.PrevID, nav.Ctx)) } title={ nav.PrevTitle }>&#8592; Prev</a>
			} else {
				<span class="btn btn-outline btn-sm" style="opacity:0.5">&#8592; Prev</span>
			}
			if nav.NextID != 0 {
				<a class="btn btn-outline btn-sm" href={ templ.SafeURL(itemHref(nav.NextID, nav.Ctx)) } title={ nav.NextTitle }>Next &#8594;</a>
			} else {
				<span class="btn btn-outline btn-sm" style="opacity:0.5">Next &#8594;</span>
			}
		</div>
	</div>
}

templ feedItemDetail(sb sidebarData, nav itemNav, ip ItemPlayback, tags []string, prefs PlayerPrefs, artwork string, csrfToken string) {
	<div class="sidebar-layout">
		@feedSidebar(sb)
		<div class="sidebar-content">
			@feedItemContextBar(nav)
			@ui.Card(ip.Title) {
				<div class="text-muted" style="font-size:0.85rem;margin-bottom:0.5rem">
					{ ip.SubscriptionTitle }
					if ip.Author != "" {
						&middot; { ip.Author }
					}
				</div>
				@feedItemTagRow(ip.ID, tags, csrfToken)
				if ip.Type == "text" {
					<div class="note-content prose">
						@templ.Raw(ip.ContentHTML)
					</div>
				} else {
					@feedPlayer(ip, prefs, artwork, csrfToken, nav)
				}
				if ip.URL != "" {
					<p style="margin-top:1rem">
						<a href={ templ.SafeURL(ip.URL) } target="_blank" rel="noopener">Original</a>
					</p>
				}
			}
		</div>
	</div>
}

templ feedPlayer(ip ItemPlayback, prefs PlayerPrefs, artwork string, csrfToken string, nav itemNav) {
	<div
		id="feed-player"
		class="card feed-player"
		data-item-id={ strconv.FormatInt(ip.ID, 10) }
		data-media-type={ ip.Type }
		data-source-kind={ ip.SourceKind }
		data-resume={ strconv.FormatFloat(ip.ProgressSec, 'f', 1, 64) }
		data-csrf={ csrfToken }
		data-title={ ip.Title }
		data-subscription={ ip.SubscriptionTitle }
		data-artwork={ artwork }
		data-speed={ strconv.FormatFloat(prefs.Speed, 'f', -1, 64) }
		data-skip-back={ strconv.Itoa(prefs.SkipBackSec) }
		data-skip-fwd={ strconv.Itoa(prefs.SkipFwdSec) }
		data-volume={ strconv.FormatFloat(prefs.Volume, 'f', -1, 64) }
		data-autoplay-next={ strconv.FormatBool(prefs.AutoplayNext) }
		data-skip-silence={ strconv.FormatBool(prefs.SkipSilence) }
		data-ctx={ nav.Ctx }
		data-bar-prev-id={ strconv.FormatInt(nav.PrevID, 10) }
		data-bar-prev-title={ nav.PrevTitle }
		data-bar-next-id={ strconv.FormatInt(nav.NextID, 10) }
		data-bar-next-title={ nav.NextTitle }
	>
		<style>
			.feed-player .player-surface {
				position: relative;
				background: #000;
				border-radius: 8px;
				overflow: hidden;
				margin-bottom: 0.5rem;
			}
			.feed-player .player-surface video {
				width: 100%;
				max-height: 480px;
				display: block;
			}
			.feed-player .player-center {
				position: absolute;
				inset: 0;
				margin: auto;
				width: 72px;
				height: 72px;
				border: 0;
				border-radius: 50%;
				background: rgba(0, 0, 0, 0.55);
				display: flex;
				align-items: center;
				justify-content: center;
				cursor: pointer;
				transition: opacity 0.2s;
			}
			.feed-player .player-next-overlay {
				position: absolute;
				inset: 0;
				margin: auto;
				display: none;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				gap: 0.5rem;
				width: 140px;
				height: 96px;
				border: 0;
				border-radius: 12px;
				background: rgba(0, 0, 0, 0.7);
				color: #fff;
				font-size: 0.85rem;
				cursor: pointer;
			}
			.feed-player .player-next-overlay.show {
				display: flex;
			}
			.feed-player .player-nav {
				display: inline-flex;
				align-items: center;
				justify-content: center;
			}
			.feed-player .player-spinner {
				position: absolute;
				inset: 0;
				margin: auto;
				width: 56px;
				height: 56px;
				display: none;
				align-items: center;
				justify-content: center;
				pointer-events: none;
			}
			.feed-player .player-spinner svg,
			.feed-player #icon-spinner {
				animation: feed-spin 0.8s linear infinite;
			}
			@keyframes feed-spin {
				to {
					transform: rotate(360deg);
				}
			}
			.feed-player .player-track {
				position: relative;
				height: 7px;
				border-radius: 3px;
				background: rgba(127, 127, 127, 0.3);
				margin: 0.25rem 0 0.75rem;
				cursor: pointer;
			}
			.feed-player .player-buffered,
			.feed-player .player-played {
				position: absolute;
				left: 0;
				top: 0;
				bottom: 0;
				border-radius: 3px;
			}
			.feed-player .player-buffered {
				width: 0;
				background: rgba(127, 127, 127, 0.5);
			}
			.feed-player .player-played {
				width: 0;
				background: var(--color-primary);
			}
			.feed-player .player-handle {
				position: absolute;
				left: 0;
				top: 50%;
				transform: translate(-50%, -50%);
				width: 12px;
				height: 12px;
				border-radius: 50%;
				background: #fff;
				box-shadow: 0 0 3px rgba(0, 0, 0, 0.5);
				opacity: 1;
			}
			.feed-player .player-markers {
				position: absolute;
				inset: 0;
				pointer-events: none;
			}
			.feed-player .feed-marker-mute {
				background: rgba(220, 80, 80, 0.7);
			}
			.feed-player .feed-marker-skip {
				background: rgba(120, 120, 120, 0.7);
			}
			.feed-player .player-bar {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				flex-wrap: wrap;
			}
			.feed-player .player-round {
				width: 36px;
				height: 36px;
				padding: 0;
				border-radius: 50%;
				display: inline-flex;
				align-items: center;
				justify-content: center;
			}
			.feed-player .player-volume {
				width: 80px;
			}
			.feed-player .player-gear-menu {
				position: absolute;
				right: 0;
				bottom: calc(100% + 4px);
				z-index: 10;
				background: var(--color-surface);
				border: 1px solid var(--color-border);
				border-radius: 8px;
				padding: 0.5rem;
				min-width: 180px;
				box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
			}
			.feed-player .player-gear-label {
				font-size: 0.75rem;
				text-transform: uppercase;
				opacity: 0.6;
				margin-bottom: 0.25rem;
			}
			.feed-player .player-gear-speeds {
				display: flex;
				gap: 0.25rem;
				flex-wrap: wrap;
				margin-bottom: 0.5rem;
			}
			.feed-player .player-gear-toggle {
				display: block;
				width: 100%;
				text-align: left;
				padding: 0.35rem 0.5rem;
				border: 0;
				background: none;
				cursor: pointer;
				border-radius: 4px;
			}
			.feed-player .player-gear-toggle[aria-pressed="true"] {
				background: var(--color-primary);
				color: #fff;
			}
			.feed-player.controls-hidden .player-bar,
			.feed-player.controls-hidden .player-track {
				opacity: 0;
				transition: opacity 0.3s;
			}
			.feed-player.controls-hidden .player-center {
				opacity: 0;
			}
		</style>
		<div style="font-weight:600;margin-bottom:0.25rem">{ ip.Title }</div>
		<div class="text-muted" style="font-size:0.85rem;margin-bottom:0.5rem">{ ip.SubscriptionTitle }</div>
		if ip.Type == "video" {
			<div id="player-surface" class="player-surface">
				<video
					id="player-el"
					preload="metadata"
					playsinline
					if ip.SourceKind != "youtube" {
						src={ "/apps/feed/items/" + strconv.FormatInt(ip.ID, 10) + "/media" }
					}
				></video>
				<button id="player-center" class="player-center" title="Play/Pause" type="button">
					<svg width="34" height="34" viewBox="0 0 24 24" fill="#fff"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
				</button>
				<button id="player-next-overlay" class="player-next-overlay" title="Play next" type="button">
					<svg width="32" height="32" viewBox="0 0 24 24" fill="#fff"><polygon points="5 4 15 12 5 20 5 4"></polygon><rect x="17" y="4" width="3" height="16"></rect></svg>
					Play next
				</button>
				<div id="player-spinner" class="player-spinner">
					<svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"></path></svg>
				</div>
			</div>
		} else {
			<audio
				id="player-el"
				preload="metadata"
				if ip.SourceKind != "youtube" {
					src={ "/apps/feed/items/" + strconv.FormatInt(ip.ID, 10) + "/media" }
				}
			></audio>
		}
		<div id="player-track" class="player-track">
			<div id="player-buffered" class="player-buffered"></div>
			<div id="player-played" class="player-played"></div>
			<div id="player-markers" class="player-markers"></div>
			<div id="player-handle" class="player-handle"></div>
		</div>
		<div class="player-bar">
			<button id="player-prev" class="btn btn-outline btn-sm player-nav" title="Previous" type="button">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><polygon points="19 20 9 12 19 4 19 20"></polygon><rect x="5" y="4" width="3" height="16"></rect></svg>
			</button>
			<button id="player-play" class="btn btn-primary btn-sm player-round" title="Play/Pause" type="button">
				<svg id="icon-play" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
				<svg id="icon-pause" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" style="display:none"><rect x="6" y="4" width="4" height="16"></rect><rect x="14" y="4" width="4" height="16"></rect></svg>
				<svg id="icon-spinner" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" style="display:none"><path d="M21 12a9 9 0 1 1-6.219-8.56"></path></svg>
			</button>
			<button id="player-next" class="btn btn-outline btn-sm player-nav" title="Next" type="button">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 4 15 12 5 20 5 4"></polygon><rect x="16" y="4" width="3" height="16"></rect></svg>
			</button>
			<button id="player-back" class="btn btn-outline btn-sm" title="Skip back" type="button">&#8630;</button>
			<button id="player-fwd" class="btn btn-outline btn-sm" title="Skip forward" type="button">&#8631;</button>
			<span id="player-time" class="text-muted" style="font-size:0.85rem;font-variant-numeric:tabular-nums">0:00 / 0:00</span>
			<span style="margin-left:auto"></span>
			<button id="player-speed" class="btn btn-outline btn-sm" title="Speed" type="button">1&times;</button>
			<button id="player-mute" class="btn btn-outline btn-sm" title="Mute" type="button">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path></svg>
			</button>
			<input id="player-volume" class="player-volume" type="range" min="0" max="1" step="0.05" title="Volume"/>
			<div style="position:relative">
				<button id="player-gear" class="btn btn-outline btn-sm" title="Settings" type="button">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
				</button>
				<div id="player-gear-menu" class="player-gear-menu" style="display:none">
					<div class="player-gear-label">Speed</div>
					<div class="player-gear-speeds">
						<button class="btn btn-outline btn-sm" data-speed="0.75" type="button">0.75&times;</button>
						<button class="btn btn-outline btn-sm" data-speed="1" type="button">1&times;</button>
						<button class="btn btn-outline btn-sm" data-speed="1.25" type="button">1.25&times;</button>
						<button class="btn btn-outline btn-sm" data-speed="1.5" type="button">1.5&times;</button>
						<button class="btn btn-outline btn-sm" data-speed="2" type="button">2&times;</button>
					</div>
					<button class="player-gear-toggle" data-toggle="skip_silence" type="button" aria-pressed={ strconv.FormatBool(prefs.SkipSilence) }>Skip silence</button>
					<button class="player-gear-toggle" data-toggle="autoplay_next" type="button" aria-pressed={ strconv.FormatBool(prefs.AutoplayNext) }>Autoplay next</button>
				</div>
			</div>
			<button id="player-fullscreen" class="btn btn-outline btn-sm" title="Fullscreen" type="button">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"></path></svg>
			</button>
		</div>
		<div id="player-upnext" class="text-muted" style="display:none;font-size:0.8rem;margin-top:0.5rem">Up next&hellip;</div>
		<script src={ playerAssetURL() } defer></script>
	</div>
}

templ feedSystemSettingsPage(model string, modelsDir string, cliPath string, flash string, flashKind string) {
	@ui.Alert(flashKind, flash)
	@ui.Card("Transcription (whisper.cpp)") {
		<form method="post" action="">
			<div class="form-group">
				<label for="whisper_model">Model</label>
				<select name="whisper_model" id="whisper_model" class="form-control">
					<option value="none" selected?={ model == "none" }>None (disable transcription)</option>
					<option value="tiny.en" selected?={ model == "tiny.en" }>tiny.en (~75 MB)</option>
					<option value="base.en" selected?={ model == "base.en" }>base.en (~140 MB) — default</option>
					<option value="small.en" selected?={ model == "small.en" }>small.en (~470 MB)</option>
					<option value="medium.en" selected?={ model == "medium.en" }>medium.en (~1.5 GB)</option>
					<option value="large-v3" selected?={ model == "large-v3" }>large-v3 (~3 GB)</option>
				</select>
			</div>
			@ui.FormField("Models directory", "whisper_models_dir", "text", modelsDir, "(auto: plugin data dir)")
			@ui.FormField("whisper-cli binary", "whisper_cli_path", "text", cliPath, "(auto: search PATH)")
			@ui.Button("primary", "Save")
		</form>
	}
}

// feedHistoryPage renders the playback history list.
templ feedHistoryPage(sb sidebarData, items []PlayedItem, csrfToken string) {
	<div class="sidebar-layout">
		@feedSidebar(sb)
		<div class="sidebar-content">
			<h1>History</h1>
			if len(items) == 0 {
				@ui.Card("") {
					<p class="text-muted">No playback history yet.</p>
				}
			} else {
				@ui.Card("") {
					<table style="width:100%;border-collapse:collapse">
						<thead>
							<tr style="font-size:0.85rem;color:var(--color-text-muted);text-align:left">
								<th style="padding:0.4rem 0.5rem">Title</th>
								<th style="padding:0.4rem 0.5rem">Feed</th>
								<th style="padding:0.4rem 0.5rem">Progress</th>
								<th style="padding:0.4rem 0.5rem">Played</th>
							</tr>
						</thead>
						<tbody>
							for _, pi := range items {
								<tr style="border-top:1px solid var(--color-border)">
									<td style="padding:0.5rem">
										<a href={ templ.SafeURL(fmt.Sprintf("/apps/feed/items/%d", pi.ID)) }>{ pi.Title }</a>
									</td>
									<td style="padding:0.5rem;font-size:0.85rem;color:var(--color-text-muted)">{ pi.SubscriptionTitle }</td>
									<td style="padding:0.5rem;font-size:0.85rem">
										if pi.Completed {
											<span class="badge" style="background:var(--color-success,#22c55e)">Done</span>
										} else if pi.ProgressSec > 0 {
											{ feedFormatDuration(int64(pi.ProgressSec)) }
										} else {
											<span class="text-muted">—</span>
										}
									</td>
									<td style="padding:0.5rem;font-size:0.85rem;color:var(--color-text-muted)">{ feedFormatTime(pi.LastPlayedAt) }</td>
								</tr>
							}
						</tbody>
					</table>
				}
			}
		</div>
	</div>
}

// feedSubscriptionSettingsPage renders per-subscription settings.
templ feedSubscriptionSettingsPage(sb sidebarData, sub Subscription, folders []Folder, flashMsg string, flashKind string, csrfToken string) {
	<div class="sidebar-layout">
		@feedSidebar(sb)
		<div class="sidebar-content">
			<div id="feed-sub-settings">
				@ui.Alert(flashKind, flashMsg)
				@ui.Card("Subscription settings") {
					<form method="post" action={ templ.SafeURL(fmt.Sprintf("/apps/feed/subscription/%d/settings", sub.ID)) }>
						<input type="hidden" name="csrf_token" value={ csrfToken }/>
						<div class="form-group">
							<label>
								<input type="checkbox" name="paused" checked?={ sub.Paused }/>
								{ " Paused" }
							</label>
							<small class="text-muted">When paused the subscription will not be polled.</small>
						</div>
						<div class="form-group">
							<label for="poll_interval_sec">Poll interval (seconds)</label>
							<input class="form-control" type="number" id="poll_interval_sec" name="poll_interval_sec" value={ strconv.FormatInt(sub.PollIntervalSec, 10) } min="60" style="max-width:160px"/>
						</div>
						<div class="form-group">
							<label for="folder_id">Folder</label>
							<select id="folder_id" name="folder_id" class="form-control">
								<option value="" selected?={ !sub.FolderID.Valid }>(none)</option>
								for _, f := range folders {
									<option value={ strconv.FormatInt(f.ID, 10) } selected?={ sub.FolderID.Valid && sub.FolderID.Int64 == f.ID }>{ f.Name }</option>
								}
							</select>
						</div>
						@ui.Button("primary", "Save")
					</form>
				}
				@ui.Card("Danger zone") {
					<form method="post" action={ templ.SafeURL(fmt.Sprintf("/apps/feed/subscriptions/%d/delete", sub.ID)) } onsubmit="return confirm('Delete this subscription and all its items?')">
						<input type="hidden" name="csrf_token" value={ csrfToken }/>
						@ui.Button("danger", "Delete subscription")
					</form>
				}
			</div>
		</div>
	</div>
}

// feedAdminStatusPage renders orchestrator status and cache controls.
// --- Template helpers ---

// itemHref builds an item-detail URL carrying the view context.
func itemHref(id int64, ctx string) string {
	if ctx == "" {
		return fmt.Sprintf("/apps/feed/items/%d", id)
	}
	return fmt.Sprintf("/apps/feed/items/%d?%s", id, ctx)
}

func subscriptionDisplayTitle(s Subscription) string {
	if s.Title != "" {
		return s.Title
	}
	return s.URL
}

// subscriptionIconURL returns the best available icon image URL for a
// subscription: an explicit favicon, else the channel/feed image. Empty when
// neither is present (caller falls back to a generic kind icon).
func subscriptionIconURL(s Subscription) string {
	if s.FaviconURL != "" {
		return s.FaviconURL
	}
	return s.ImageURL
}

// feedSubIcon renders a 16x16 subscription icon. It prefers the remote image
// (favicon or channel art); if that's absent or fails to load, a generic gray
// icon for the subscription kind is shown.
templ feedSubIcon(sub Subscription) {
	<span class="feed-sub-icon" style="display:inline-flex;width:16px;height:16px;flex-shrink:0;align-items:center;justify-content:center">
		if url := subscriptionIconURL(sub); url != "" {
			<img
				src={ url }
				alt=""
				style="width:16px;height:16px;border-radius:2px;object-fit:cover"
				onerror="this.style.display='none';this.nextElementSibling.style.display='inline-flex'"
			/>
			<span style="display:none;align-items:center;justify-content:center">
				@feedKindIcon(sub.Kind)
			</span>
		} else {
			@feedKindIcon(sub.Kind)
		}
	</span>
}

// feedKindIcon renders a generic gray icon for a subscription kind.
templ feedKindIcon(kind string) {
	switch kind {
		case "youtube":
			<svg width="16" height="16" viewBox="0 0 24 24" fill="#888" aria-hidden="true"><path d="M23 7a3 3 0 0 0-2.1-2.1C19 4.4 12 4.4 12 4.4s-7 0-8.9.5A3 3 0 0 0 1 7a31 31 0 0 0 0 10 3 3 0 0 0 2.1 2.1c1.9.5 8.9.5 8.9.5s7 0 8.9-.5A3 3 0 0 0 23 17a31 31 0 0 0 0-10zM10 15.5v-7l6 3.5z"></path></svg>
		case "url":
			<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#888" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15 15 0 0 1 0 20 15 15 0 0 1 0-20z"></path></svg>
		default:
			<svg width="16" height="16" viewBox="0 0 24 24" fill="#888" aria-hidden="true"><path d="M4 11a9 9 0 0 1 9 9h2.5A11.5 11.5 0 0 0 4 8.5z"></path><path d="M4 4a16 16 0 0 1 16 16h2.5A18.5 18.5 0 0 0 4 1.5z"></path><circle cx="5.5" cy="18.5" r="2.5"></circle></svg>
	}
}

func feedSidebarClass(activePath, itemPath string) string {
	if activePath == itemPath {
		return "sidebar-item active"
	}
	return "sidebar-item"
}

func feedSidebarSubClass(sub Subscription, sb sidebarData) string {
	base := feedSidebarClass(sb.ActivePath, fmt.Sprintf("/apps/feed/subscription/%d", sub.ID))
	if sub.LastError != "" {
		return base + " text-danger"
	}
	return base
}

func isFeedFolderActive(folder Folder, sb sidebarData) bool {
	if sb.ActivePath == fmt.Sprintf("/apps/feed/folder/%d", folder.ID) {
		return true
	}
	for _, sub := range sb.Subscriptions {
		if sub.FolderID.Valid && sub.FolderID.Int64 == folder.ID {
			if sb.ActivePath == fmt.Sprintf("/apps/feed/subscription/%d", sub.ID) {
				return true
			}
		}
	}
	return false
}

func feedItemRowClass(isRead bool) string {
	if isRead {
		return "feed-item feed-item-read"
	}
	return "feed-item"
}

func feedFormatTime(unix int64) string {
	if unix == 0 {
		return ""
	}
	t := time.Unix(unix, 0)
	now := time.Now()
	if t.Year() == now.Year() && t.YearDay() == now.YearDay() {
		return t.Format("15:04")
	}
	if t.Year() == now.Year() {
		return t.Format("Jan 2")
	}
	return t.Format("2006-01-02")
}

func feedFormatDuration(sec int64) string {
	h := sec / 3600
	m := (sec % 3600) / 60
	s := sec % 60
	if h > 0 {
		return fmt.Sprintf("%d:%02d:%02d", h, m, s)
	}
	return fmt.Sprintf("%d:%02d", m, s)
}

func feedItemPreviewImage(html string) string {
	idx := strings.Index(html, "<img")
	if idx == -1 {
		return ""
	}
	rest := html[idx:]
	srcIdx := strings.Index(rest, `src="`)
	if srcIdx == -1 {
		srcIdx = strings.Index(rest, "src='")
		if srcIdx == -1 {
			return ""
		}
		rest = rest[srcIdx+5:]
		end := strings.Index(rest, "'")
		if end == -1 {
			return ""
		}
		return rest[:end]
	}
	rest = rest[srcIdx+5:]
	end := strings.Index(rest, `"`)
	if end == -1 {
		return ""
	}
	return rest[:end]
}

func feedItemSummary(html string) string {
	var b strings.Builder
	inTag := false
	count := 0
	for _, r := range html {
		if r == '<' {
			inTag = true
			continue
		}
		if r == '>' {
			inTag = false
			continue
		}
		if !inTag {
			b.WriteRune(r)
			count++
			if count >= 300 {
				b.WriteString("...")
				break
			}
		}
	}
	return b.String()
}
