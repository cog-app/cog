package feed

import (
	"fmt"
	"net/url"
	"strconv"
	"strings"
	"time"

	"git.duckfam.us/jj-software/cog/ui"
)

// sidebarData holds all data needed to render the feed sidebar.
type sidebarData struct {
	Folders       []Folder
	Subscriptions []Subscription
	Tags          []string
	Playlists     []Playlist
	ActivePath    string
	TotalUnread   int
	StarredCount  int
	UnreadCounts  map[int64]int // by subscription_id
	FolderUnread  map[int64]int // by folder_id
	HideEmpty     bool
	// OOB renders the sidebar as an out-of-band swap, so a row action can
	// bring the unread and starred counts up to date along with the row.
	OOB bool
}

// rowOpts is how a list renders its rows.
type rowOpts struct {
	Ctx     string    // encoded view context, carried to the reader
	HideSub bool      // the list is one subscription: rows need not repeat its name
	Now     time.Time // the plugin clock, for relative dates
}

templ feedSidebar(sb sidebarData) {
	<nav
		class="sidebar"
		id="feed-sidebar"
		aria-label="Feed"
		if sb.OOB {
			hx-swap-oob="true"
		}
	>
		@feedLink(sb.ActivePath, "/apps/feed/", "All articles", sb.TotalUnread)
		@feedLink(sb.ActivePath, "/apps/feed/starred", "Starred", sb.StarredCount)
		@feedLink(sb.ActivePath, "/apps/feed/history", "History", 0)
		<div class="sidebar-heading feed-sidebar-heading">
			<span>Feeds</span>
			<label class="feed-hide-read">
				<input
					type="checkbox"
					name="hide_empty"
					checked?={ sb.HideEmpty }
					hx-post="/apps/feed/player/prefs"
					hx-vals={ `js:{hide_empty: event.target.checked ? "1" : "0"}` }
					hx-target="#feed-sidebar"
					hx-swap="outerHTML"
				/>
				Unread only
			</label>
		</div>
		for _, folder := range sb.Folders {
			if !sb.HideEmpty || sb.FolderUnread[folder.ID] > 0 {
				<details class="sidebar-folder" data-folder-id={ strconv.FormatInt(folder.ID, 10) } open?={ isFeedFolderActive(folder, sb) }>
					<summary
						if sb.ActivePath == fmt.Sprintf("/apps/feed/folder/%d", folder.ID) {
							class="sidebar-item active"
						} else {
							class="sidebar-item"
						}
					>
						<a
							href={ templ.SafeURL(fmt.Sprintf("/apps/feed/folder/%d", folder.ID)) }
							class="feed-folder-link"
							onclick="event.stopPropagation()"
						>{ folder.Name }</a>
						if sb.FolderUnread[folder.ID] > 0 {
							<span class="count">{ strconv.Itoa(sb.FolderUnread[folder.ID]) }</span>
						}
					</summary>
					for _, sub := range sb.Subscriptions {
						if sub.FolderID.Valid && sub.FolderID.Int64 == folder.ID {
							if !sb.HideEmpty || sb.UnreadCounts[sub.ID] > 0 {
								@feedSidebarSubLink(sub, sb, true)
							}
						}
					}
				</details>
			}
		}
		for _, sub := range sb.Subscriptions {
			if !sub.FolderID.Valid {
				if !sb.HideEmpty || sb.UnreadCounts[sub.ID] > 0 {
					@feedSidebarSubLink(sub, sb, false)
				}
			}
		}
		if len(sb.Tags) > 0 {
			<div class="sidebar-heading">Tags</div>
			for _, tag := range sb.Tags {
				@feedLink(sb.ActivePath, "/apps/feed/tag/"+url.PathEscape(tag), tag, 0)
			}
		}
		if len(sb.Playlists) > 0 {
			<div class="sidebar-heading">Playlists</div>
			for _, pl := range sb.Playlists {
				@feedLink(sb.ActivePath, fmt.Sprintf("/apps/feed/playlists/%d", pl.ID), pl.Name, 0)
			}
		}
		<div class="sidebar-heading">Settings</div>
		@feedLink(sb.ActivePath, "/apps/feed/settings/subscriptions", "Subscriptions", 0)
		@feedLink(sb.ActivePath, "/apps/feed/settings/filters", "Filters", 0)
		@feedLink(sb.ActivePath, "/apps/feed/settings/playlists", "Playlists", 0)
	</nav>
}

templ feedLink(activePath, href, label string, count int) {
	<a
		href={ templ.SafeURL(href) }
		if activePath == href {
			class="sidebar-item active"
			aria-current="page"
		} else {
			class="sidebar-item"
		}
	>
		<span class="break-anywhere">{ label }</span>
		if count > 0 {
			<span class="count">{ strconv.Itoa(count) }</span>
		}
	</a>
}

// feedSidebarSubLink is one subscription. A failing one keeps its name in the
// normal colour and shows a warning in the icon slot; the full name and the
// error are in its title.
templ feedSidebarSubLink(sub Subscription, sb sidebarData, child bool) {
	<a
		href={ templ.SafeURL(fmt.Sprintf("/apps/feed/subscription/%d", sub.ID)) }
		class={ feedSidebarSubClass(sub, sb, child) }
		title={ feedSubTooltip(sub) }
		if sb.ActivePath == fmt.Sprintf("/apps/feed/subscription/%d", sub.ID) {
			aria-current="page"
		}
	>
		if sub.LastError != "" {
			<span class="feed-sub-icon feed-sub-failing" role="img" aria-label="Fetch failing">
				@warningIcon()
			</span>
		} else {
			@feedSubIcon(sub)
		}
		<span class="feed-sub-name">{ subscriptionDisplayTitle(sub) }</span>
		if sb.UnreadCounts[sub.ID] > 0 {
			<span class="count">{ strconv.Itoa(sb.UnreadCounts[sub.ID]) }</span>
		}
	</a>
}

// feedSidebarScript keeps folders the user opened open when the sidebar is
// re-rendered (the unread-only toggle, or a row action's count update).
templ feedSidebarScript() {
	<script>
		(function () {
			if (window.feedSidebarKeepsFolders) return;
			window.feedSidebarKeepsFolders = true;
			var openFolders = new Set();
			function remember() {
				var sb = document.getElementById("feed-sidebar");
				if (!sb) return;
				openFolders.clear();
				sb.querySelectorAll("details[data-folder-id]").forEach(function (d) {
					if (d.open) openFolders.add(d.getAttribute("data-folder-id"));
				});
			}
			function restore() {
				var sb = document.getElementById("feed-sidebar");
				if (!sb) return;
				sb.querySelectorAll("details[data-folder-id]").forEach(function (d) {
					if (openFolders.has(d.getAttribute("data-folder-id"))) d.open = true;
				});
			}
			document.addEventListener("htmx:beforeSwap", remember);
			document.addEventListener("htmx:oobBeforeSwap", remember);
			document.addEventListener("htmx:afterSwap", restore);
			document.addEventListener("htmx:oobAfterSwap", restore);
		})();
	</script>
}

templ feedLayout(sb sidebarData) {
	<div class="sidebar-layout">
		@feedSidebar(sb)
		<div class="sidebar-content">
			{ children... }
		</div>
	</div>
	@feedSidebarScript()
}

templ markReadButton(action string, csrfToken string) {
	<form method="post" action={ templ.SafeURL(action) }>
		<input type="hidden" name="csrf_token" value={ csrfToken }/>
		<button class="btn" type="submit">
			@ui.Icon("check-circle")
			Mark all read
		</button>
	</form>
}

templ feedIndexPage(sb sidebarData, items []ItemWithSubscription, q, qErr string, csrfToken string, o rowOpts) {
	@feedLayout(sb) {
		@ui.PageHeader("All articles", nil) {
			if sb.TotalUnread > 0 {
				@markReadButton("/apps/feed/items/read-all", csrfToken)
			}
		}
		<form method="get" action="/apps/feed/" class="feed-search" role="search">
			<div class="form-inline">
				<label class="sr-only" for="feed-q">Search articles</label>
				if qErr != "" {
					<input class="form-control" type="search" id="feed-q" name="q" value={ q } placeholder="Search articles" aria-invalid="true" aria-describedby="feed-q-error feed-search-help"/>
				} else {
					<input class="form-control" type="search" id="feed-q" name="q" value={ q } placeholder="Search articles" aria-describedby="feed-search-help"/>
				}
				<button class="btn" type="submit" aria-label="Search">
					@ui.Icon("search")
					<span class="hide-mobile">Search</span>
				</button>
			</div>
			if qErr != "" {
				<p class="form-error" id="feed-q-error" role="alert">This search could not be understood: { qErr }. See the search syntax below.</p>
			}
			<details class="feed-search-help" id="feed-search-help" open?={ qErr != "" }>
				<summary>Search syntax</summary>
				<dl class="feed-search-help-body">
					<dt><code>term</code></dt>
					<dd>title, author or content</dd>
					<dt><code>"exact phrase"</code></dt>
					<dd>phrase match</dd>
					<dt><code>:type=audio</code></dt>
					<dd>also <code>video</code>, <code>text</code></dd>
					<dt><code>is:unread</code></dt>
					<dd>also <code>is:starred</code>, <code>is:downloaded</code></dd>
					<dt><code>:tag=name</code></dt>
					<dd>also <code>:folder=</code>, <code>:subscription=</code></dd>
					<dt><code>:published&gt;-7d</code></dt>
					<dd>or a date: <code>:published&lt;2026-06-01</code></dd>
					<dt><code>:duration&gt;600</code></dt>
					<dd>length in seconds</dd>
					<dt><code>OR</code> <code>NOT</code> <code>( )</code></dt>
					<dd>combine terms</dd>
				</dl>
			</details>
		</form>
		// A search that did not parse shows its error above and no list:
		// "no matches" would claim the search ran.
		if qErr == "" && len(items) == 0 {
			<div class="list">
				if q != "" {
					@ui.EmptyState("No matches", "No article matches “"+q+"”.")
				} else {
					@ui.EmptyState("No articles yet", "Subscribe to a feed, a podcast or a YouTube channel and its new posts appear here.") {
						<a class="btn btn-primary" href="/apps/feed/settings/subscriptions">
							@ui.Icon("plus")
							Add a subscription
						</a>
					}
				}
			</div>
		} else if qErr == "" {
			@feedItemList(items, o)
		}
	}
}

templ feedSubscriptionPage(sb sidebarData, sub *Subscription, items []ItemWithSubscription, csrfToken string, o rowOpts) {
	@feedLayout(sb) {
		<header class="page-header">
			<div class="page-heading">
				@feedAncestors([]ui.Crumb{{Label: "Feed", URL: "/apps/feed/"}})
				<h1 class="feed-sub-title">
					@feedSubIcon(*sub)
					<span>{ subscriptionDisplayTitle(*sub) }</span>
				</h1>
				<p class="page-subtitle break-anywhere">{ sub.URL }</p>
			</div>
			<div class="page-actions">
				if sb.UnreadCounts[sub.ID] > 0 {
					@markReadButton(fmt.Sprintf("/apps/feed/subscriptions/%d/read-all", sub.ID), csrfToken)
				}
				<div class="dropdown">
					<button type="button" class="btn btn-square" data-dropdown-toggle aria-expanded="false" aria-controls="sub-menu" aria-label="Subscription actions">
						@ui.Icon("more")
					</button>
					<div class="dropdown-menu" id="sub-menu">
						<form method="post" action={ templ.SafeURL(fmt.Sprintf("/apps/feed/subscriptions/%d/refresh", sub.ID)) }>
							<input type="hidden" name="csrf_token" value={ csrfToken }/>
							<button type="submit">
								@ui.Icon("download")
								Check for new posts
							</button>
						</form>
						<a href={ templ.SafeURL(fmt.Sprintf("/apps/feed/subscription/%d/settings", sub.ID)) }>
							@ui.Icon("settings")
							Settings
						</a>
					</div>
				</div>
			</div>
		</header>
		if sub.LastError != "" {
			<div class="alert alert-warning" role="status">
				<div class="alert-title">Last fetch failed</div>
				<div class="break-anywhere">{ sub.LastError }</div>
				<div class="text-sm">{ fmt.Sprintf("Failed %d times in a row. ", sub.ErrorCount) }It will be tried again on its schedule.</div>
			</div>
		}
		if len(items) == 0 {
			<div class="list">
				@ui.EmptyState("No articles yet", "New posts appear here once the subscription is checked.")
			</div>
		} else {
			@feedItemList(items, o)
		}
	}
}

templ feedFolderPage(sb sidebarData, folder *Folder, items []ItemWithSubscription, csrfToken string, o rowOpts) {
	@feedLayout(sb) {
		@ui.PageHeader(folder.Name, []ui.Crumb{{Label: "Feed", URL: "/apps/feed/"}}) {
			if sb.FolderUnread[folder.ID] > 0 {
				@markReadButton(fmt.Sprintf("/apps/feed/folders/%d/read-all", folder.ID), csrfToken)
			}
		}
		if len(items) == 0 {
			<div class="list">
				@ui.EmptyState("No articles in this folder", "")
			</div>
		} else {
			@feedItemList(items, o)
		}
	}
}

templ feedStarredPage(sb sidebarData, items []ItemWithSubscription, o rowOpts) {
	@feedLayout(sb) {
		@ui.PageHeader("Starred", []ui.Crumb{{Label: "Feed", URL: "/apps/feed/"}})
		if len(items) == 0 {
			<div class="list">
				@ui.EmptyState("No starred articles", "Star an article to keep it here.")
			</div>
		} else {
			@feedItemList(items, o)
		}
	}
}

templ feedTagPage(sb sidebarData, tag string, items []ItemWithSubscription, o rowOpts) {
	@feedLayout(sb) {
		@ui.PageHeader("Tagged “"+tag+"”", []ui.Crumb{{Label: "Feed", URL: "/apps/feed/"}})
		if len(items) == 0 {
			<div class="list">
				@ui.EmptyState("No articles with this tag", "")
			</div>
		} else {
			@feedItemList(items, o)
		}
	}
}

templ feedPlaylistPage(sb sidebarData, pl Playlist, items []ItemWithSubscription, o rowOpts) {
	@feedLayout(sb) {
		<header class="page-header">
			<div class="page-heading">
				@feedAncestors([]ui.Crumb{{Label: "Feed", URL: "/apps/feed/"}})
				<h1>{ pl.Name }</h1>
				if pl.Query != "" {
					<p class="page-subtitle"><code class="break-anywhere">{ pl.Query }</code></p>
				}
			</div>
		</header>
		if len(items) == 0 {
			<div class="list">
				@ui.EmptyState("Nothing matches this playlist", "")
			</div>
		} else {
			@feedItemList(items, o)
		}
	}
}

// feedAncestors is a breadcrumb trail of the pages above this one, for a
// page whose own title is the heading right below it.
templ feedAncestors(crumbs []ui.Crumb) {
	<nav class="breadcrumbs" aria-label="Breadcrumb">
		<ol>
			for _, c := range crumbs {
				<li><a href={ templ.SafeURL(c.URL) }>{ c.Label }</a></li>
			}
		</ol>
	</nav>
}

// feedItemList is the list of articles. A text row opens inline (click its
// summary or press j/k); its title opens the reader.
templ feedItemList(items []ItemWithSubscription, o rowOpts) {
	<ul class="list" id="item-list">
		for _, item := range items {
			@feedItemRow(item, o)
		}
	</ul>
	@feedListScript()
}

templ feedListScript() {
	<script>
		(function () {
			if (window.feedToggleArticle) return;
			function csrf() {
				try {
					return JSON.parse(document.body.getAttribute("hx-headers") || "{}")["X-CSRF-Token"] || "";
				} catch (e) {
					return "";
				}
			}
			function toggleArticle(id) {
				var row = document.getElementById("item-" + id);
				var detail = document.getElementById("detail-" + id);
				if (!row || !detail) return;
				var opening = detail.hidden;
				document.querySelectorAll(".feed-item-active").forEach(function (r) {
					r.classList.remove("feed-item-active");
					var d = r.querySelector(".feed-item-detail");
					if (d) d.hidden = true;
					var h = r.querySelector("[data-feed-toggle]");
					if (h) h.setAttribute("aria-expanded", "false");
				});
				if (!opening) return;
				detail.hidden = false;
				row.classList.add("feed-item-active");
				var head = row.querySelector("[data-feed-toggle]");
				if (head) head.setAttribute("aria-expanded", "true");
				if (!row.classList.contains("feed-item-read")) {
					row.classList.add("feed-item-read");
					fetch("/apps/feed/items/" + id + "/mark-read", {
						method: "POST",
						headers: { "X-CSRF-Token": csrf() },
					}).catch(function (e) {
						console.error("feed: mark read", e);
					});
				}
			}
			window.feedToggleArticle = toggleArticle;
			document.addEventListener("click", function (e) {
				var head = e.target.closest("[data-feed-toggle]");
				if (!head || e.target.closest("a, button, form")) return;
				toggleArticle(head.getAttribute("data-feed-toggle"));
			});
			document.addEventListener("keydown", function (e) {
				var t = e.target;
				if (t.closest && t.closest("[data-feed-toggle]") && (e.key === "Enter" || e.key === " ")) {
					e.preventDefault();
					toggleArticle(t.closest("[data-feed-toggle]").getAttribute("data-feed-toggle"));
					return;
				}
				if (t.tagName === "INPUT" || t.tagName === "TEXTAREA" || t.tagName === "SELECT") return;
				var items = Array.from(document.querySelectorAll(".feed-item"));
				var active = document.querySelector(".feed-item-active");
				var idx = active ? items.indexOf(active) : -1;
				var step = e.key === "j" ? 1 : e.key === "k" ? -1 : 0;
				if (step !== 0) {
					var target = items[idx + step];
					if (!target) return;
					e.preventDefault();
					toggleArticle(target.id.replace("item-", ""));
					target.scrollIntoView({ block: "nearest", behavior: "smooth" });
				} else if ((e.key === "o" || e.key === "Enter") && active) {
					var link = active.querySelector("[data-feed-original]");
					if (link) {
						e.preventDefault();
						window.open(link.href, "_blank");
					}
				}
			});
		})();
	</script>
}

templ feedItemRow(item ItemWithSubscription, o rowOpts) {
	<li id={ fmt.Sprintf("item-%d", item.ID) } class={ feedItemRowClass(item) }>
		if item.Type == "audio" || item.Type == "video" {
			<div class="feed-item-head">
				@feedRowMain(item, o)
				<div class="list-row-actions">
					<a class="btn btn-sm" href={ templ.SafeURL(itemHref(item.ID, o.Ctx)) } aria-label={ "Play " + item.Title }>
						@playIcon()
						<span class="hide-mobile">Play</span>
					</a>
					@feedRowActions(item)
				</div>
			</div>
		} else {
			<div class="feed-item-head" data-feed-toggle={ strconv.FormatInt(item.ID, 10) } tabindex="0" role="button" aria-expanded="false" aria-controls={ fmt.Sprintf("detail-%d", item.ID) }>
				@feedRowMain(item, o)
				<div class="list-row-actions">
					@feedRowActions(item)
				</div>
			</div>
			<div id={ fmt.Sprintf("detail-%d", item.ID) } class="feed-item-detail" hidden>
				if item.ContentHTML != "" {
					<div class="feed-item-content prose">
						@templ.Raw(item.ContentHTML)
					</div>
				}
				<div class="feed-item-detail-actions">
					<a class="btn btn-sm" href={ templ.SafeURL(itemHref(item.ID, o.Ctx)) }>Open in reader</a>
					if item.URL != "" {
						<a class="btn btn-sm" href={ templ.URL(item.URL) } target="_blank" rel="noopener" data-feed-original>
							@ui.Icon("external")
							Original
						</a>
					}
				</div>
			</div>
		}
	</li>
}

// feedRowMain is a row's unread dot, title, meta line and summary.
templ feedRowMain(item ItemWithSubscription, o rowOpts) {
	<span class="feed-unread-dot" title="Unread">
		if !item.IsRead {
			<span class="sr-only">Unread</span>
		}
	</span>
	<div class="list-row-main">
		<a class="feed-item-title" href={ templ.SafeURL(itemHref(item.ID, o.Ctx)) }>
			{ item.Title }
		</a>
		<div class="list-row-meta">{ feedItemMeta(item, o) }</div>
		if item.Type != "audio" && item.Type != "video" {
			if s := feedItemSummary(item.ContentHTML); s != "" {
				<div class="feed-item-summary-line">{ s }</div>
			}
		}
	</div>
}

// feedRowActions are the row's own buttons. On a phone only the star stays;
// the reader has the rest.
templ feedRowActions(item ItemWithSubscription) {
	if item.URL != "" {
		<a class="btn-icon btn-icon-sm hide-mobile" href={ templ.URL(item.URL) } target="_blank" rel="noopener" aria-label={ "Open original of " + item.Title } title="Open original">
			@ui.Icon("external")
		</a>
	}
	@ui.Star(item.IsStarred, fmt.Sprintf("/apps/feed/items/%d/star", item.ID))
	<button
		type="button"
		class="btn-icon btn-icon-sm hide-mobile"
		hx-post={ fmt.Sprintf("/apps/feed/items/%d/read", item.ID) }
		hx-target={ fmt.Sprintf("#item-%d", item.ID) }
		hx-swap="outerHTML"
		if item.IsRead {
			aria-label={ "Mark " + item.Title + " as unread" }
			title="Mark as unread"
		} else {
			aria-label={ "Mark " + item.Title + " as read" }
			title="Mark as read"
		}
	>
		if item.IsRead {
			@circleIcon()
		} else {
			@ui.Icon("check-circle")
		}
	</button>
}

// feedRowUpdate answers a row action: the swapped element, then the sidebar
// with its new counts, out of band.
templ feedRowUpdate(swapped templ.Component, sb sidebarData) {
	@swapped
	@feedSidebar(sb)
}

templ playIcon() {
	<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="6 4 20 12 6 20 6 4"></polygon></svg>
}

templ circleIcon() {
	<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle></svg>
}

templ warningIcon() {
	<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
}

// feedFilterPreviewResults renders a short list of matched items for the filter preview API.
templ feedFilterPreviewResults(items []ItemWithSubscription) {
	if len(items) == 0 {
		<p class="form-help">Nothing matches yet.</p>
	} else {
		<ul class="divided-list feed-filter-preview">
			for _, it := range items {
				<li>
					<span class="badge">{ it.Type }</span>
					{ it.Title }
					<span class="text-muted text-sm">&mdash; { it.SubscriptionTitle }</span>
				</li>
			}
		</ul>
	}
}

templ feedSettingsSubscriptionsPage(sb sidebarData, subs []Subscription, folders []Folder, csrfToken string) {
	@feedLayout(sb) {
		@ui.PageHeader("Subscriptions", []ui.Crumb{{Label: "Feed", URL: "/apps/feed/"}})
		<section class="card">
			<h2 class="card-title">Add a subscription</h2>
			<form id="add-subscription" method="post" action="/apps/feed/subscriptions">
				<input type="hidden" name="csrf_token" value={ csrfToken }/>
				<div class="form-row">
					<div class="form-group">
						<label for="sub-url">URL</label>
						<input class="form-control" type="url" id="sub-url" name="url" required placeholder="https://example.com/feed.xml"/>
					</div>
					if len(folders) > 0 {
						<div class="form-group form-group-auto">
							<label for="sub-folder">Folder</label>
							<select id="sub-folder" name="folder_id" class="form-control">
								<option value="">No folder</option>
								for _, f := range folders {
									<option value={ strconv.FormatInt(f.ID, 10) }>{ f.Name }</option>
								}
							</select>
						</div>
					}
					<button class="btn btn-primary" type="submit">Subscribe</button>
				</div>
				<p class="form-help">An RSS or Atom feed, a podcast, a YouTube channel, or any page that links to a feed.</p>
			</form>
		</section>
		<section class="card">
			<h2 class="card-title">Add talks from a page</h2>
			<form id="talks-scan" method="post" action="/apps/feed/talks/preview" hx-post="/apps/feed/talks/preview" hx-target="#talks-preview" hx-swap="innerHTML" hx-disabled-elt="find button">
				<input type="hidden" name="csrf_token" value={ csrfToken }/>
				<div class="form-row">
					<div class="form-group">
						<label for="talks-url">Page</label>
						<input class="form-control" type="url" id="talks-url" name="url" required placeholder="https://example.com/conference/2026/04"/>
					</div>
					<button class="btn" type="submit">Find talks</button>
				</div>
				<p class="form-help">A conference or playlist page that links to a page for each talk. Choose the talks to download.</p>
			</form>
			<div id="talks-preview" aria-live="polite"></div>
		</section>
		<section class="card">
			<details class="feed-sub-details" id="subscription-details" open?={ len(subs) < 20 }>
				<summary class="card-title">Your subscriptions <span class="count">{ strconv.Itoa(len(subs)) }</span></summary>
				if len(subs) == 0 {
					<p class="empty-state empty-state-sm">No subscriptions yet.</p>
				} else {
					<ul class="feed-sub-list" id="subscription-list">
						for _, s := range subs {
							<li>
								<div class="feed-sub-list-main">
									<a class="font-medium" href={ templ.SafeURL(fmt.Sprintf("/apps/feed/subscription/%d", s.ID)) }>{ subscriptionDisplayTitle(s) }</a>
									<div class="feed-sub-list-meta">
										<span class="badge badge-outline">{ s.Kind }</span>
										<code>{ s.URL }</code>
									</div>
								</div>
								<div class="list-row-actions">
									<a class="btn-icon btn-icon-sm" href={ templ.SafeURL(fmt.Sprintf("/apps/feed/subscription/%d/settings", s.ID)) } aria-label={ "Settings for " + subscriptionDisplayTitle(s) } title="Settings">
										@ui.Icon("settings")
									</a>
									<form method="post" action={ templ.SafeURL("/apps/feed/subscriptions/" + strconv.FormatInt(s.ID, 10) + "/delete") } onsubmit={ feedConfirm(fmt.Sprintf("Unsubscribe from “%s” and delete its articles?", subscriptionDisplayTitle(s))) }>
										<input type="hidden" name="csrf_token" value={ csrfToken }/>
										<button type="submit" class="btn-icon btn-icon-sm btn-icon-danger" aria-label={ "Delete " + subscriptionDisplayTitle(s) } title="Delete">
											@ui.Icon("trash")
										</button>
									</form>
								</div>
							</li>
						}
					</ul>
				}
			</details>
		</section>
		<section class="card">
			<h2 class="card-title">Import and export</h2>
			<p class="card-desc">Bring subscriptions from another app, or take them with you as OPML.</p>
			<div class="btn-group">
				@feedImportButton("/apps/feed/opml/import", "opml", "", ".opml,.xml,application/xml", "Import OPML", csrfToken)
				@feedImportButton("/apps/feed/import", "file", "antennapod", ".db,.sqlite", "Import AntennaPod", csrfToken)
				@feedImportButton("/apps/feed/import", "file", "newpipe", ".zip", "Import NewPipe", csrfToken)
				@feedImportButton("/apps/feed/import", "file", "youtube-csv", ".csv", "Import YouTube Takeout", csrfToken)
				<a class="btn" href="/apps/feed/opml/export">
					@ui.Icon("download")
					Export OPML
				</a>
			</div>
		</section>
		<section class="card">
			<h2 class="card-title">Folders</h2>
			<form id="add-folder" method="post" action="/apps/feed/folders" class="form-inline">
				<input type="hidden" name="csrf_token" value={ csrfToken }/>
				<label class="sr-only" for="folder-name">Folder name</label>
				<input class="form-control" type="text" id="folder-name" name="name" placeholder="Folder name" required/>
				<button class="btn" type="submit">Add folder</button>
			</form>
			if len(folders) > 0 {
				<ul class="divided-list feed-folder-list">
					for _, f := range folders {
						<li>
							<span>{ f.Name }</span>
							<form method="post" action={ templ.SafeURL("/apps/feed/folders/" + strconv.FormatInt(f.ID, 10) + "/delete") } onsubmit={ feedConfirm(fmt.Sprintf("Delete the folder “%s”? Its subscriptions are kept.", f.Name)) }>
								<input type="hidden" name="csrf_token" value={ csrfToken }/>
								<button type="submit" class="btn-icon btn-icon-sm btn-icon-danger" aria-label={ "Delete folder " + f.Name } title="Delete">
									@ui.Icon("trash")
								</button>
							</form>
						</li>
					}
				</ul>
			}
		</section>
	}
}

// feedImportButton uploads a file as soon as it is chosen. The label is the
// button; the file input stays focusable (sr-only), so it works from the
// keyboard.
// feedTalksMessage is a talks preview that found nothing to choose from.
templ feedTalksMessage(kind, msg string) {
	<div class={ "alert", "alert-" + kind } role="status">{ msg }</div>
}

// feedTalksPreview lists the talks a page of talks links to, ticked, for the
// user to choose which to add. A talk with no media is listed but cannot be
// chosen, and a talk page that failed to load is listed with its error.
templ feedTalksPreview(pageURL string, scan *TalksScan, folders []Folder, csrfToken string) {
	if len(scan.Talks) == 0 && len(scan.Failed) == 0 {
		@feedTalksMessage("error", "No talks found on that page.")
	} else {
		<form id="talks-add" method="post" action="/apps/feed/talks">
			<input type="hidden" name="csrf_token" value={ csrfToken }/>
			<input type="hidden" name="page_url" value={ pageURL }/>
			<div class="form-row">
				<div class="form-group">
					<label for="talks-title">Name</label>
					<input class="form-control" type="text" id="talks-title" name="title" value={ scan.Title }/>
				</div>
				if len(folders) > 0 {
					<div class="form-group form-group-auto">
						<label for="talks-folder">Folder</label>
						<select id="talks-folder" name="folder_id" class="form-control">
							<option value="">No folder</option>
							for _, f := range folders {
								<option value={ strconv.FormatInt(f.ID, 10) }>{ f.Name }</option>
							}
						</select>
					</div>
				}
			</div>
			if len(scan.Talks) > 0 {
				<ul class="feed-talks-list">
					for i, t := range scan.Talks {
						<li data-talk-page={ t.PageURL }>
							if t.Type == "" {
								<label class="form-check" aria-disabled="true">
									<input type="checkbox" disabled/>
									<span>{ t.Title }</span>
									if t.Speaker != "" {
										<span class="text-muted">{ t.Speaker }</span>
									}
									<span class="badge badge-warning">No media found</span>
								</label>
							} else {
								<label class="form-check">
									<input type="checkbox" name="talk" value={ strconv.Itoa(i) } checked/>
									<span>{ t.Title }</span>
									if t.Speaker != "" {
										<span class="text-muted">{ t.Speaker }</span>
									}
									<span class="badge badge-outline">{ t.Type }</span>
								</label>
								<input type="hidden" name={ "page_" + strconv.Itoa(i) } value={ t.PageURL }/>
								<input type="hidden" name={ "title_" + strconv.Itoa(i) } value={ t.Title }/>
								<input type="hidden" name={ "speaker_" + strconv.Itoa(i) } value={ t.Speaker }/>
								<input type="hidden" name={ "media_" + strconv.Itoa(i) } value={ t.MediaURL }/>
								<input type="hidden" name={ "type_" + strconv.Itoa(i) } value={ t.Type }/>
							}
						</li>
					}
				</ul>
			}
			if len(scan.Failed) > 0 {
				<div class="alert alert-warning" role="status">
					<div class="alert-title">
						if len(scan.Failed) == 1 {
							1 talk page could not be loaded
						} else {
							{ strconv.Itoa(len(scan.Failed)) } talk pages could not be loaded
						}
					</div>
					<ul class="feed-talks-failed">
						for _, f := range scan.Failed {
							<li><code>{ f.URL }</code>: { f.Err }</li>
						}
					</ul>
				</div>
			}
			if len(scan.Talks) > 0 {
				<button class="btn btn-primary" type="submit">Add chosen talks</button>
			}
		</form>
	}
}

templ feedImportButton(action, field, format, accept, label, csrfToken string) {
	<form method="post" action={ templ.SafeURL(action) } enctype="multipart/form-data" class="upload-form">
		<input type="hidden" name="csrf_token" value={ csrfToken }/>
		if format != "" {
			<input type="hidden" name="format" value={ format }/>
		}
		<label class="btn">
			@ui.Icon("upload")
			{ label }
			<input type="file" class="sr-only" name={ field } accept={ accept } onchange="this.form.submit()"/>
		</label>
	</form>
}

script feedConfirm(msg string) {
	if (!confirm(msg)) { event.preventDefault(); }
}

templ feedSettingsFiltersPage(sb sidebarData, filters []Filter, csrfToken string) {
	@feedLayout(sb) {
		@ui.PageHeader("Filters", []ui.Crumb{{Label: "Feed", URL: "/apps/feed/"}})
		<section class="card">
			<h2 class="card-title">Add a filter</h2>
			<p class="card-desc">A filter acts on every new article that matches its query, as it arrives.</p>
			<form id="add-filter" method="post" action="/apps/feed/filters">
				<input type="hidden" name="csrf_token" value={ csrfToken }/>
				<div class="form-group">
					<label for="filter-query">Query</label>
					<input
						class="form-control mono"
						type="text"
						id="filter-query"
						name="query"
						required
						placeholder=":type=audio is:unread"
						hx-get="/apps/feed/filter-preview"
						hx-target="#filter-preview-results"
						hx-trigger="keyup changed delay:500ms"
						hx-include="this"
					/>
					<div id="filter-preview-results" aria-live="polite"></div>
				</div>
				<div class="form-row">
					<div class="form-group">
						<label for="filter-action">Action</label>
						<select id="filter-action" name="action" class="form-control">
							<option value="skip">Skip</option>
							<option value="tag">Tag</option>
							<option value="download">Download</option>
							<option value="mute_profanity">Mute profanity</option>
							<option value="transcribe">Transcribe</option>
						</select>
					</div>
					<div class="form-group">
						<label for="filter-action-value">Tag</label>
						<input class="form-control" type="text" id="filter-action-value" name="action_value" placeholder="For the Tag action"/>
					</div>
					<button class="btn btn-primary" type="submit">Add filter</button>
				</div>
			</form>
		</section>
		<section class="card">
			<h2 class="card-title">Your filters</h2>
			if len(filters) == 0 {
				<p class="empty-state empty-state-sm">No filters yet.</p>
			} else {
				<ul class="divided-list feed-rule-list">
					for _, fl := range filters {
						<li>
							<code>{ fl.Query }</code>
							<span class="feed-rule-action">
								&rarr; { fl.Action }
								if fl.ActionValue != "" {
									<span class="badge">{ fl.ActionValue }</span>
								}
							</span>
							<form method="post" action={ templ.SafeURL("/apps/feed/filters/" + strconv.FormatInt(fl.ID, 10) + "/delete") }>
								<input type="hidden" name="csrf_token" value={ csrfToken }/>
								<button type="submit" class="btn-icon btn-icon-sm btn-icon-danger" aria-label={ "Delete filter " + fl.Query } title="Delete">
									@ui.Icon("trash")
								</button>
							</form>
						</li>
					}
				</ul>
			}
		</section>
	}
}

templ feedSettingsPlaylistsPage(sb sidebarData, playlists []Playlist, csrfToken string) {
	@feedLayout(sb) {
		@ui.PageHeader("Playlists", []ui.Crumb{{Label: "Feed", URL: "/apps/feed/"}})
		<section class="card">
			<h2 class="card-title">Add a playlist</h2>
			<p class="card-desc">A playlist is a saved search; it appears in the sidebar.</p>
			<form id="add-playlist" method="post" action="/apps/feed/playlists">
				<input type="hidden" name="csrf_token" value={ csrfToken }/>
				<div class="form-row">
					<div class="form-group">
						<label for="name">Name</label>
						<input class="form-control" type="text" id="name" name="name" placeholder="Commute"/>
					</div>
					<div class="form-group">
						<label for="query">Query</label>
						<input class="form-control mono" type="text" id="query" name="query" placeholder=":type=audio is:unread"/>
					</div>
					<div class="form-group">
						<label for="order">Order</label>
						@feedPlayOrderSelect("order", OrderNewest)
					</div>
					<label class="form-check">
						<input type="checkbox" name="listen_only"/>
						Listen only
					</label>
					<button class="btn btn-primary" type="submit">Add playlist</button>
				</div>
			</form>
		</section>
		<section class="card">
			<h2 class="card-title">Your playlists</h2>
			if len(playlists) == 0 {
				<p class="empty-state empty-state-sm">No playlists yet.</p>
			} else {
				<ul class="divided-list feed-rule-list">
					for _, pl := range playlists {
						<li class="feed-playlist">
							<div class="feed-playlist-head">
								<a class="font-medium" href={ templ.SafeURL(fmt.Sprintf("/apps/feed/playlists/%d", pl.ID)) }>{ pl.Name }</a>
								<code>{ pl.Query }</code>
							</div>
							<form method="post" action={ templ.SafeURL("/apps/feed/playlists/" + strconv.FormatInt(pl.ID, 10) + "/delete") }>
								<input type="hidden" name="csrf_token" value={ csrfToken }/>
								<button type="submit" class="btn-icon btn-icon-sm btn-icon-danger" aria-label={ "Delete playlist " + pl.Name } title="Delete">
									@ui.Icon("trash")
								</button>
							</form>
							<form class="feed-playlist-play" method="post" action={ templ.SafeURL("/apps/feed/playlists/" + strconv.FormatInt(pl.ID, 10) + "/play") }>
								<input type="hidden" name="csrf_token" value={ csrfToken }/>
								@feedPlayOrderSelect("order-"+strconv.FormatInt(pl.ID, 10), pl.Order)
								<label class="form-check">
									<input type="checkbox" name="listen_only" checked?={ pl.ListenOnly }/>
									Listen only
								</label>
								<button class="btn btn-sm" type="submit">Save</button>
								if pl.Order == OrderShuffled {
									<button class="btn btn-sm" type="submit" name="reshuffle" value="1">Reshuffle</button>
								}
							</form>
						</li>
					}
				</ul>
			}
		</section>
	}
}

// feedPlayOrderSelect picks a playlist's order; its field is "order".
templ feedPlayOrderSelect(id string, cur PlayOrder) {
	<select class="form-control" id={ id } name="order" aria-label="Order">
		for _, o := range PlayOrders {
			<option value={ string(o) } selected?={ o == cur }>{ o.Label() }</option>
		}
	</select>
}

// feedItemTagRow renders the tag chips plus an add-tag form for HTMX swap.
templ feedItemTagRow(itemID int64, tags []string, csrfToken string) {
	<div id={ "item-tags-" + strconv.FormatInt(itemID, 10) } class="feed-item-tags">
		for _, tg := range tags {
			<span class="chip">
				<a href={ templ.SafeURL("/apps/feed/tag/" + url.PathEscape(tg)) }>{ tg }</a>
				<form
					method="post"
					action={ templ.SafeURL(fmt.Sprintf("/apps/feed/items/%d/tag/%s/delete", itemID, url.PathEscape(tg))) }
					hx-post={ fmt.Sprintf("/apps/feed/items/%d/tag/%s/delete", itemID, url.PathEscape(tg)) }
					hx-target={ "#item-tags-" + strconv.FormatInt(itemID, 10) }
					hx-swap="outerHTML"
				>
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					<button type="submit" class="chip-remove" aria-label={ "Remove tag " + tg }>&times;</button>
				</form>
			</span>
		}
		<form
			class="feed-tag-add"
			method="post"
			action={ templ.SafeURL(fmt.Sprintf("/apps/feed/items/%d/tag", itemID)) }
			hx-post={ fmt.Sprintf("/apps/feed/items/%d/tag", itemID) }
			hx-target={ "#item-tags-" + strconv.FormatInt(itemID, 10) }
			hx-swap="outerHTML"
		>
			<input type="hidden" name="csrf_token" value={ csrfToken }/>
			<label class="sr-only" for={ fmt.Sprintf("tag-%d", itemID) }>Add a tag</label>
			<input class="form-control form-control-sm" type="text" id={ fmt.Sprintf("tag-%d", itemID) } name="tag" placeholder="Add a tag" required/>
			<button type="submit" class="btn btn-sm">Add</button>
		</form>
	</div>
}

// feedItemContextBar names the list the item was opened from, its place in
// it, and steps to its neighbours. The reader shows it above and below the
// article; player.js rewires its Prev/Next links when it swaps items.
templ feedItemContextBar(nav itemNav, bottom bool) {
	<nav
		if bottom {
			class="feed-context-bar feed-context-bar-bottom"
		} else {
			class="feed-context-bar"
		}
		aria-label="Article navigation"
	>
		if !bottom {
			<a class="feed-context-label" href={ templ.SafeURL(nav.Path) }>
				{ nav.Label }
				if nav.Total > 0 {
					<span class="text-muted">{ fmt.Sprintf(" · %d of %d", nav.Pos, nav.Total) }</span>
				}
			</a>
		}
		<div class="btn-group">
			if nav.PrevID != 0 {
				<a class="btn btn-sm" href={ templ.SafeURL(itemHref(nav.PrevID, nav.Ctx)) } title={ nav.PrevTitle }>&larr; Prev</a>
			} else {
				<span class="btn btn-sm" aria-disabled="true">&larr; Prev</span>
			}
			if nav.NextID != 0 {
				<a class="btn btn-sm" href={ templ.SafeURL(itemHref(nav.NextID, nav.Ctx)) } title={ nav.NextTitle }>Next &rarr;</a>
			} else {
				<span class="btn btn-sm" aria-disabled="true">Next &rarr;</span>
			}
		</div>
	</nav>
}

templ feedItemDetail(sb sidebarData, nav itemNav, ip ItemPlayback, tags []string, prefs PlayerPrefs, artwork string, csrfToken string, now time.Time) {
	@feedLayout(sb) {
		@feedItemContextBar(nav, false)
		<header class="page-header feed-reader-header">
			<div class="page-heading">
				<h1 data-feed-item-title>{ ip.Title }</h1>
				<p class="page-subtitle">{ feedReaderMeta(ip, now) }</p>
			</div>
			<div class="page-actions">
				@ui.Star(ip.IsStarred, fmt.Sprintf("/apps/feed/items/%d/star", ip.ID))
				if ip.Type != "text" && ip.MediaURL != "" {
					@feedDownloadControl(ip, nav, csrfToken)
				}
				if ip.URL != "" {
					<a class="btn" href={ templ.URL(ip.URL) } target="_blank" rel="noopener">
						@ui.Icon("external")
						Open original
					</a>
				}
			</div>
		</header>
		@feedItemTagRow(ip.ID, tags, csrfToken)
		if ip.Type == "text" {
			<article class="card">
				<div class="prose feed-article">
					@templ.Raw(ip.ContentHTML)
				</div>
			</article>
		} else {
			@feedPlayer(ip, prefs, artwork, csrfToken, nav)
		}
		@feedItemContextBar(nav, true)
	}
}

// feedDownloadControl shows where an item's download stands and offers to
// start it, or to retry one that failed. A queued or running download is
// "Preparing" until the media and any preprocessing its filters ask for are
// done.
templ feedDownloadControl(ip ItemPlayback, nav itemNav, csrfToken string) {
	switch ip.DownloadState {
		case "ready":
			<span class="badge badge-success" data-download-state="ready">Downloaded</span>
		case "queued", "downloading":
			<span class="badge badge-neutral" data-download-state={ ip.DownloadState }>Preparing…</span>
		default:
			<form method="post" action={ templ.SafeURL(itemActionHref(ip.ID, "download", nav.Ctx)) }>
				<input type="hidden" name="csrf_token" value={ csrfToken }/>
				if ip.DownloadState == "error" {
					<span class="badge badge-danger" data-download-state="error" title={ ip.DownloadError }>Download failed</span>
					<button class="btn" type="submit">
						@ui.Icon("download")
						Retry
					</button>
				} else {
					<button class="btn" type="submit">
						@ui.Icon("download")
						Download
					</button>
				}
			</form>
	}
}

templ feedPlayer(ip ItemPlayback, prefs PlayerPrefs, artwork string, csrfToken string, nav itemNav) {
	<div
		id="feed-player"
		class="card feed-player"
		data-item-id={ strconv.FormatInt(ip.ID, 10) }
		data-media-type={ playerType(ip, nav) }
		data-source-kind={ ip.SourceKind }
		if nav.ListenOnly {
			data-variant="audio"
		}
		data-resume={ strconv.FormatFloat(ip.ProgressSec, 'f', 1, 64) }
		data-csrf={ csrfToken }
		data-title={ ip.Title }
		data-subscription={ ip.SubscriptionTitle }
		data-artwork={ artwork }
		data-speed={ strconv.FormatFloat(prefs.Speed, 'f', -1, 64) }
		data-skip-back={ strconv.Itoa(prefs.SkipBackSec) }
		data-skip-fwd={ strconv.Itoa(prefs.SkipFwdSec) }
		data-volume={ strconv.FormatFloat(prefs.Volume, 'f', -1, 64) }
		data-autoplay-next={ strconv.FormatBool(prefs.AutoplayNext) }
		data-skip-silence={ strconv.FormatBool(prefs.SkipSilence) }
		data-ctx={ nav.Ctx }
		data-bar-prev-id={ strconv.FormatInt(nav.PrevID, 10) }
		data-bar-prev-title={ nav.PrevTitle }
		data-bar-next-id={ strconv.FormatInt(nav.NextID, 10) }
		data-bar-next-title={ nav.NextTitle }
	>
		<style>
			.feed-player .player-surface {
				position: relative;
				background: #000;
				border-radius: 8px;
				overflow: hidden;
				margin-bottom: 0.5rem;
			}
			.feed-player .player-surface video {
				width: 100%;
				max-height: 480px;
				display: block;
			}
			.feed-player .player-center {
				position: absolute;
				inset: 0;
				margin: auto;
				width: 72px;
				height: 72px;
				border: 0;
				border-radius: 50%;
				background: rgba(0, 0, 0, 0.55);
				display: flex;
				align-items: center;
				justify-content: center;
				cursor: pointer;
				transition: opacity 0.2s;
			}
			.feed-player .player-next-overlay {
				position: absolute;
				inset: 0;
				margin: auto;
				display: none;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				gap: 0.5rem;
				width: 140px;
				height: 96px;
				border: 0;
				border-radius: 12px;
				background: rgba(0, 0, 0, 0.7);
				color: #fff;
				font-size: 0.85rem;
				cursor: pointer;
			}
			.feed-player .player-next-overlay.show {
				display: flex;
			}
			.feed-player .player-nav {
				display: inline-flex;
				align-items: center;
				justify-content: center;
			}
			.feed-player .player-spinner {
				position: absolute;
				inset: 0;
				margin: auto;
				width: 56px;
				height: 56px;
				display: none;
				align-items: center;
				justify-content: center;
				pointer-events: none;
			}
			.feed-player .player-spinner svg,
			.feed-player #icon-spinner {
				animation: feed-spin 0.8s linear infinite;
			}
			@keyframes feed-spin {
				to {
					transform: rotate(360deg);
				}
			}
			.feed-player .player-track {
				position: relative;
				height: 7px;
				border-radius: 3px;
				background: rgba(127, 127, 127, 0.3);
				margin: 0.25rem 0 0.75rem;
				cursor: pointer;
			}
			.feed-player .player-buffered,
			.feed-player .player-played {
				position: absolute;
				left: 0;
				top: 0;
				bottom: 0;
				border-radius: 3px;
			}
			.feed-player .player-buffered {
				width: 0;
				background: rgba(127, 127, 127, 0.5);
			}
			.feed-player .player-played {
				width: 0;
				background: var(--color-primary);
			}
			.feed-player .player-handle {
				position: absolute;
				left: 0;
				top: 50%;
				transform: translate(-50%, -50%);
				width: 12px;
				height: 12px;
				border-radius: 50%;
				background: #fff;
				box-shadow: 0 0 3px rgba(0, 0, 0, 0.5);
				opacity: 1;
			}
			.feed-player .player-markers {
				position: absolute;
				inset: 0;
				pointer-events: none;
			}
			.feed-player .feed-marker-mute {
				background: rgba(220, 80, 80, 0.7);
			}
			.feed-player .feed-marker-skip {
				background: rgba(120, 120, 120, 0.7);
			}
			.feed-player .player-bar {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				flex-wrap: wrap;
			}
			.feed-player .player-round {
				width: 36px;
				height: 36px;
				padding: 0;
				border-radius: 50%;
				display: inline-flex;
				align-items: center;
				justify-content: center;
			}
			.feed-player .player-volume {
				width: 80px;
			}
			.feed-player .player-gear-menu {
				position: absolute;
				right: 0;
				bottom: calc(100% + 4px);
				z-index: 10;
				background: var(--color-surface);
				border: 1px solid var(--color-border);
				border-radius: 8px;
				padding: 0.5rem;
				min-width: 180px;
				box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
			}
			.feed-player .player-gear-label {
				font-size: 0.75rem;
				text-transform: uppercase;
				opacity: 0.6;
				margin-bottom: 0.25rem;
			}
			.feed-player .player-gear-speeds {
				display: flex;
				gap: 0.25rem;
				flex-wrap: wrap;
				margin-bottom: 0.5rem;
			}
			.feed-player .player-gear-toggle {
				display: block;
				width: 100%;
				text-align: left;
				padding: 0.35rem 0.5rem;
				border: 0;
				background: none;
				cursor: pointer;
				border-radius: 4px;
			}
			.feed-player .player-gear-toggle[aria-pressed="true"] {
				background: var(--color-primary);
				color: #fff;
			}
			.feed-player.controls-hidden .player-bar,
			.feed-player.controls-hidden .player-track {
				opacity: 0;
				transition: opacity 0.3s;
			}
			.feed-player.controls-hidden .player-center {
				opacity: 0;
			}
		</style>
		<div style="font-weight:600;margin-bottom:0.25rem">{ ip.Title }</div>
		<div class="text-muted" style="font-size:0.85rem;margin-bottom:0.5rem">{ ip.SubscriptionTitle }</div>
		if playerType(ip, nav) == "video" {
			<div id="player-surface" class="player-surface">
				<video
					id="player-el"
					preload="metadata"
					playsinline
					if ip.SourceKind != "youtube" {
						src={ "/apps/feed/items/" + strconv.FormatInt(ip.ID, 10) + "/media" }
					}
				></video>
				<button id="player-center" class="player-center" title="Play/Pause" type="button">
					<svg width="34" height="34" viewBox="0 0 24 24" fill="#fff"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
				</button>
				<button id="player-next-overlay" class="player-next-overlay" title="Play next" type="button">
					<svg width="32" height="32" viewBox="0 0 24 24" fill="#fff"><polygon points="5 4 15 12 5 20 5 4"></polygon><rect x="17" y="4" width="3" height="16"></rect></svg>
					Play next
				</button>
				<div id="player-spinner" class="player-spinner">
					<svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"></path></svg>
				</div>
			</div>
		} else {
			<audio
				id="player-el"
				preload="metadata"
				if ip.SourceKind != "youtube" {
					src={ "/apps/feed/items/" + strconv.FormatInt(ip.ID, 10) + "/media" }
				}
			></audio>
		}
		<div id="player-track" class="player-track">
			<div id="player-buffered" class="player-buffered"></div>
			<div id="player-played" class="player-played"></div>
			<div id="player-markers" class="player-markers"></div>
			<div id="player-handle" class="player-handle"></div>
		</div>
		<div class="player-bar">
			<button id="player-prev" class="btn btn-outline btn-sm player-nav" title="Previous" type="button">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><polygon points="19 20 9 12 19 4 19 20"></polygon><rect x="5" y="4" width="3" height="16"></rect></svg>
			</button>
			<button id="player-play" class="btn btn-primary btn-sm player-round" title="Play/Pause" type="button">
				<svg id="icon-play" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
				<svg id="icon-pause" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" style="display:none"><rect x="6" y="4" width="4" height="16"></rect><rect x="14" y="4" width="4" height="16"></rect></svg>
				<svg id="icon-spinner" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" style="display:none"><path d="M21 12a9 9 0 1 1-6.219-8.56"></path></svg>
			</button>
			<button id="player-next" class="btn btn-outline btn-sm player-nav" title="Next" type="button">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 4 15 12 5 20 5 4"></polygon><rect x="16" y="4" width="3" height="16"></rect></svg>
			</button>
			<button id="player-back" class="btn btn-outline btn-sm" title="Skip back" type="button">&#8630;</button>
			<button id="player-fwd" class="btn btn-outline btn-sm" title="Skip forward" type="button">&#8631;</button>
			<span id="player-time" class="text-muted" style="font-size:0.85rem;font-variant-numeric:tabular-nums">0:00 / 0:00</span>
			<span style="margin-left:auto"></span>
			<button id="player-speed" class="btn btn-outline btn-sm" title="Speed" type="button">1&times;</button>
			<button id="player-mute" class="btn btn-outline btn-sm" title="Mute" type="button">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path></svg>
			</button>
			<input id="player-volume" class="player-volume" type="range" min="0" max="1" step="0.05" title="Volume"/>
			<div style="position:relative">
				<button id="player-gear" class="btn btn-outline btn-sm" title="Settings" type="button">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
				</button>
				<div id="player-gear-menu" class="player-gear-menu" style="display:none">
					<div class="player-gear-label">Speed</div>
					<div class="player-gear-speeds">
						<button class="btn btn-outline btn-sm" data-speed="0.75" type="button">0.75&times;</button>
						<button class="btn btn-outline btn-sm" data-speed="1" type="button">1&times;</button>
						<button class="btn btn-outline btn-sm" data-speed="1.25" type="button">1.25&times;</button>
						<button class="btn btn-outline btn-sm" data-speed="1.5" type="button">1.5&times;</button>
						<button class="btn btn-outline btn-sm" data-speed="2" type="button">2&times;</button>
					</div>
					<button class="player-gear-toggle" data-toggle="skip_silence" type="button" aria-pressed={ strconv.FormatBool(prefs.SkipSilence) }>Skip silence</button>
					<button class="player-gear-toggle" data-toggle="autoplay_next" type="button" aria-pressed={ strconv.FormatBool(prefs.AutoplayNext) }>Autoplay next</button>
				</div>
			</div>
			<button id="player-fullscreen" class="btn btn-outline btn-sm" title="Fullscreen" type="button">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"></path></svg>
			</button>
		</div>
		<div id="player-upnext" class="text-muted" style="display:none;font-size:0.8rem;margin-top:0.5rem">Up next&hellip;</div>
		<script src={ playerAssetURL() } defer></script>
	</div>
}

templ feedSystemSettingsPage(model string, modelsDir string, cliPath string) {
	@ui.Card("Transcription (whisper.cpp)") {
		<form method="post" action="">
			<div class="form-group">
				<label for="whisper_model">Model</label>
				<select name="whisper_model" id="whisper_model" class="form-control">
					<option value="none" selected?={ model == "none" }>None (disable transcription)</option>
					<option value="tiny.en" selected?={ model == "tiny.en" }>tiny.en (~75 MB)</option>
					<option value="base.en" selected?={ model == "base.en" }>base.en (~140 MB) — default</option>
					<option value="small.en" selected?={ model == "small.en" }>small.en (~470 MB)</option>
					<option value="medium.en" selected?={ model == "medium.en" }>medium.en (~1.5 GB)</option>
					<option value="large-v3" selected?={ model == "large-v3" }>large-v3 (~3 GB)</option>
				</select>
			</div>
			@ui.FormField("Models directory", "whisper_models_dir", "text", modelsDir, "(auto: plugin data dir)")
			@ui.FormField("whisper-cli binary", "whisper_cli_path", "text", cliPath, "(auto: search PATH)")
			@ui.Button("primary", "Save")
		</form>
	}
}

// feedHistoryPage renders the playback history list.
templ feedHistoryPage(sb sidebarData, items []PlayedItem, now time.Time) {
	@feedLayout(sb) {
		@ui.PageHeader("History", []ui.Crumb{{Label: "Feed", URL: "/apps/feed/"}})
		if len(items) == 0 {
			<div class="list">
				@ui.EmptyState("Nothing played yet", "Episodes and videos you play are listed here, with how far you got.")
			</div>
		} else {
			<div class="card card-flush">
				<div class="table-wrap">
					<table class="table">
						<thead>
							<tr>
								<th>Title</th>
								<th class="hide-mobile">Feed</th>
								<th class="col-shrink">Progress</th>
								<th class="col-shrink hide-mobile">Played</th>
							</tr>
						</thead>
						<tbody>
							for _, pi := range items {
								<tr>
									<td>
										<a class="row-link" href={ templ.SafeURL(fmt.Sprintf("/apps/feed/items/%d", pi.ID)) }>{ pi.Title }</a>
										<div class="text-muted text-sm show-mobile">{ pi.SubscriptionTitle }</div>
									</td>
									<td class="text-muted text-sm hide-mobile">{ pi.SubscriptionTitle }</td>
									<td class="col-shrink text-sm">
										if pi.Completed {
											<span class="badge badge-success">Done</span>
										} else if pi.ProgressSec > 0 {
											{ feedFormatDuration(int64(pi.ProgressSec)) }
										} else {
											<span class="text-muted">—</span>
										}
									</td>
									<td class="col-shrink text-muted text-sm hide-mobile">{ feedFormatTime(pi.LastPlayedAt, now) }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		}
	}
}

// feedSubscriptionSettingsPage renders per-subscription settings.
templ feedSubscriptionSettingsPage(sb sidebarData, sub Subscription, folders []Folder, csrfToken string) {
	@feedLayout(sb) {
		@ui.PageHeader("Subscription settings", []ui.Crumb{{Label: "Feed", URL: "/apps/feed/"}, {Label: shorten(subscriptionDisplayTitle(sub), 40), URL: fmt.Sprintf("/apps/feed/subscription/%d", sub.ID)}})
		<div id="feed-sub-settings">
			<form class="card" method="post" action={ templ.SafeURL(fmt.Sprintf("/apps/feed/subscription/%d/settings", sub.ID)) }>
				<input type="hidden" name="csrf_token" value={ csrfToken }/>
				<div class="form-group">
					<label class="form-check">
						<input type="checkbox" name="paused" checked?={ sub.Paused }/>
						Paused
					</label>
					<p class="form-help">A paused subscription is not checked for new posts.</p>
				</div>
				<div class="form-row">
					<div class="form-group form-group-auto">
						<label for="poll_interval_sec">Check every (seconds)</label>
						<input class="form-control w-sm" type="number" id="poll_interval_sec" name="poll_interval_sec" value={ strconv.FormatInt(sub.PollIntervalSec, 10) } min="60"/>
					</div>
					<div class="form-group">
						<label for="folder_id">Folder</label>
						<select id="folder_id" name="folder_id" class="form-control">
							<option value="" selected?={ !sub.FolderID.Valid }>No folder</option>
							for _, f := range folders {
								<option value={ strconv.FormatInt(f.ID, 10) } selected?={ sub.FolderID.Valid && sub.FolderID.Int64 == f.ID }>{ f.Name }</option>
							}
						</select>
					</div>
				</div>
				<div class="form-actions">
					<button class="btn btn-primary" type="submit">Save</button>
				</div>
			</form>
			<section class="card card-danger">
				<h2 class="card-title">Danger zone</h2>
				<p class="card-desc">Unsubscribing deletes every article from this subscription, with its tags and playback history.</p>
				<form method="post" action={ templ.SafeURL(fmt.Sprintf("/apps/feed/subscriptions/%d/delete", sub.ID)) } onsubmit={ feedConfirm("Delete this subscription and all its items?") }>
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					<button class="btn btn-danger" type="submit">Delete subscription</button>
				</form>
			</section>
		</div>
	}
}

// --- Template helpers ---

// itemHref builds an item-detail URL carrying the view context.
func itemHref(id int64, ctx string) string {
	if ctx == "" {
		return fmt.Sprintf("/apps/feed/items/%d", id)
	}
	return fmt.Sprintf("/apps/feed/items/%d?%s", id, ctx)
}

// itemActionHref builds the URL of an action on an item, carrying the view
// context so the action can send the browser back to the same view.
func itemActionHref(id int64, action, ctx string) string {
	if ctx == "" {
		return fmt.Sprintf("/apps/feed/items/%d/%s", id, action)
	}
	return fmt.Sprintf("/apps/feed/items/%d/%s?%s", id, action, ctx)
}

func subscriptionDisplayTitle(s Subscription) string {
	if s.Title != "" {
		return s.Title
	}
	return s.URL
}

// subscriptionIconURL returns the best available icon image URL for a
// subscription: an explicit favicon, else the channel/feed image. Empty when
// neither is present (caller falls back to a generic kind icon).
func subscriptionIconURL(s Subscription) string {
	if s.FaviconURL != "" {
		return s.FaviconURL
	}
	return s.ImageURL
}

// feedSubIcon renders a 16x16 subscription icon. It prefers the remote image
// (favicon or channel art); if that's absent or fails to load, a generic gray
// icon for the subscription kind is shown.
templ feedSubIcon(sub Subscription) {
	<span class="feed-sub-icon">
		if url := subscriptionIconURL(sub); url != "" {
			<img
				src={ url }
				alt=""
				onerror="this.hidden=true;this.nextElementSibling.hidden=false"
			/>
			<span hidden>
				@feedKindIcon(sub.Kind)
			</span>
		} else {
			@feedKindIcon(sub.Kind)
		}
	</span>
}

// feedKindIcon renders a generic gray icon for a subscription kind.
templ feedKindIcon(kind string) {
	switch kind {
		case "youtube":
			<svg width="16" height="16" viewBox="0 0 24 24" fill="#888" aria-hidden="true"><path d="M23 7a3 3 0 0 0-2.1-2.1C19 4.4 12 4.4 12 4.4s-7 0-8.9.5A3 3 0 0 0 1 7a31 31 0 0 0 0 10 3 3 0 0 0 2.1 2.1c1.9.5 8.9.5 8.9.5s7 0 8.9-.5A3 3 0 0 0 23 17a31 31 0 0 0 0-10zM10 15.5v-7l6 3.5z"></path></svg>
		case "url":
			<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#888" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15 15 0 0 1 0 20 15 15 0 0 1 0-20z"></path></svg>
		default:
			<svg width="16" height="16" viewBox="0 0 24 24" fill="#888" aria-hidden="true"><path d="M4 11a9 9 0 0 1 9 9h2.5A11.5 11.5 0 0 0 4 8.5z"></path><path d="M4 4a16 16 0 0 1 16 16h2.5A18.5 18.5 0 0 0 4 1.5z"></path><circle cx="5.5" cy="18.5" r="2.5"></circle></svg>
	}
}

func feedSidebarSubClass(sub Subscription, sb sidebarData, child bool) string {
	c := "sidebar-item feed-sub"
	if child {
		c += " sidebar-child"
	}
	if sb.ActivePath == fmt.Sprintf("/apps/feed/subscription/%d", sub.ID) {
		c += " active"
	}
	return c
}

// feedSubTooltip is a subscription's full name, and why it is failing.
func feedSubTooltip(sub Subscription) string {
	if sub.LastError != "" {
		return subscriptionDisplayTitle(sub) + " — fetch failing: " + sub.LastError
	}
	return subscriptionDisplayTitle(sub)
}

func isFeedFolderActive(folder Folder, sb sidebarData) bool {
	if sb.ActivePath == fmt.Sprintf("/apps/feed/folder/%d", folder.ID) {
		return true
	}
	for _, sub := range sb.Subscriptions {
		if sub.FolderID.Valid && sub.FolderID.Int64 == folder.ID {
			if sb.ActivePath == fmt.Sprintf("/apps/feed/subscription/%d", sub.ID) {
				return true
			}
		}
	}
	return false
}

func feedItemRowClass(item ItemWithSubscription) string {
	c := "list-row feed-item"
	if item.IsRead {
		c += " feed-item-read"
	}
	return c
}

// feedItemMeta is a row's second line as one run of text: subscription (left
// out on the subscription's own page), author, date, length.
func feedItemMeta(item ItemWithSubscription, o rowOpts) string {
	var parts []string
	if !o.HideSub && item.SubscriptionTitle != "" {
		parts = append(parts, item.SubscriptionTitle)
	}
	if item.Author != "" {
		parts = append(parts, item.Author)
	}
	if t := feedFormatTime(item.PublishedAt, o.Now); t != "" {
		parts = append(parts, t)
	}
	if item.DurationSec > 0 {
		parts = append(parts, feedFormatDuration(item.DurationSec))
	}
	return strings.Join(parts, " · ")
}

// feedReaderMeta is the reader's line under the title.
func feedReaderMeta(ip ItemPlayback, now time.Time) string {
	parts := []string{ip.SubscriptionTitle}
	if ip.Author != "" {
		parts = append(parts, ip.Author)
	}
	if t := feedFormatTime(ip.PublishedAt, now); t != "" {
		parts = append(parts, t)
	}
	if ip.DurationSec > 0 {
		parts = append(parts, feedFormatDuration(ip.DurationSec))
	}
	return strings.Join(parts, " · ")
}

// feedFormatTime shows a time relative to now: the time of day for today,
// the date without a year for this year, the full date otherwise. now comes
// from the plugin's clock, so the output does not depend on the wall clock.
func feedFormatTime(unix int64, now time.Time) string {
	if unix == 0 {
		return ""
	}
	t := time.Unix(unix, 0).In(now.Location())
	if t.Year() == now.Year() && t.YearDay() == now.YearDay() {
		return t.Format("15:04")
	}
	if t.Year() == now.Year() {
		return t.Format("Jan 2")
	}
	return t.Format("Jan 2, 2006")
}

// shorten cuts s to at most n characters, for a breadcrumb.
func shorten(s string, n int) string {
	r := []rune(s)
	if len(r) <= n {
		return s
	}
	return strings.TrimSpace(string(r[:n-1])) + "…"
}

func feedFormatDuration(sec int64) string {
	h := sec / 3600
	m := (sec % 3600) / 60
	s := sec % 60
	if h > 0 {
		return fmt.Sprintf("%d:%02d:%02d", h, m, s)
	}
	return fmt.Sprintf("%d:%02d", m, s)
}

func feedItemSummary(html string) string {
	var b strings.Builder
	inTag := false
	count := 0
	for _, r := range html {
		if r == '<' {
			inTag = true
			continue
		}
		if r == '>' {
			inTag = false
			continue
		}
		if !inTag {
			b.WriteRune(r)
			count++
			if count >= 300 {
				b.WriteString("...")
				break
			}
		}
	}
	return strings.Join(strings.Fields(b.String()), " ")
}
