package feed

import (
	"fmt"
	"net/url"
	"strconv"
	"strings"
	"time"

	"git.duckfam.us/jj-software/cog/ui"
)

// sidebarData holds all data needed to render the feed sidebar.
type sidebarData struct {
	Folders       []Folder
	Subscriptions []Subscription
	Tags          []string
	Playlists     []Playlist
	ActivePath    string
	TotalUnread   int
	StarredCount  int
	UnreadCounts  map[int64]int // by subscription_id
	FolderUnread  map[int64]int // by folder_id
}

templ feedSidebar(sb sidebarData) {
	<nav class="sidebar" id="feed-sidebar">
		<a href="/apps/feed/" class={ feedSidebarClass(sb.ActivePath, "/apps/feed/") }>
			All
			if sb.TotalUnread > 0 {
				<span class="badge">{ strconv.Itoa(sb.TotalUnread) }</span>
			}
		</a>
		<a href="/apps/feed/starred" class={ feedSidebarClass(sb.ActivePath, "/apps/feed/starred") }>
			Starred
			if sb.StarredCount > 0 {
				<span class="badge">{ strconv.Itoa(sb.StarredCount) }</span>
			}
		</a>
		<div class="sidebar-divider"></div>
		for _, folder := range sb.Folders {
			<details class="sidebar-folder" data-folder-id={ strconv.FormatInt(folder.ID, 10) } open?={ isFeedFolderActive(folder, sb) }>
				<summary class="sidebar-group-label">
					<a
						href={ templ.SafeURL(fmt.Sprintf("/apps/feed/folder/%d", folder.ID)) }
						style="color:inherit;text-decoration:none"
						onclick="event.stopPropagation()"
					>{ folder.Name }</a>
					if sb.FolderUnread[folder.ID] > 0 {
						<span class="badge">{ strconv.Itoa(sb.FolderUnread[folder.ID]) }</span>
					}
				</summary>
				for _, sub := range sb.Subscriptions {
					if sub.FolderID.Valid && sub.FolderID.Int64 == folder.ID {
						@feedSidebarSubLink(sub, sb)
					}
				}
			</details>
		}
		for _, sub := range sb.Subscriptions {
			if !sub.FolderID.Valid {
				@feedSidebarSubLink(sub, sb)
			}
		}
		if len(sb.Tags) > 0 {
			<div class="sidebar-divider"></div>
			<span class="sidebar-group-label" style="font-size:0.8rem;color:var(--color-muted)">Tags</span>
			for _, tag := range sb.Tags {
				<a
					href={ templ.SafeURL("/apps/feed/tag/" + url.PathEscape(tag)) }
					class={ feedSidebarClass(sb.ActivePath, "/apps/feed/tag/"+tag) }
					style="padding-left:1.5rem;font-size:0.9rem"
				>{ tag }</a>
			}
		}
		if len(sb.Playlists) > 0 {
			<div class="sidebar-divider"></div>
			<span class="sidebar-group-label" style="font-size:0.8rem;color:var(--color-muted)">Playlists</span>
			for _, pl := range sb.Playlists {
				<a
					href={ templ.SafeURL("/apps/feed/?q=" + url.QueryEscape(pl.Query)) }
					class="sidebar-item"
					style="padding-left:1.5rem;font-size:0.9rem"
				>{ pl.Name }</a>
			}
		}
		<div class="sidebar-divider"></div>
		<a href="/apps/feed/settings" class={ feedSidebarClass(sb.ActivePath, "/apps/feed/settings") }>Settings</a>
	</nav>
	<script>
		// Preserve folder open/closed state across HTMX sidebar refreshes.
		(function () {
			var openFolders = new Set();
			document.addEventListener("htmx:beforeSwap", function (e) {
				if (e.detail.target && e.detail.target.id === "feed-sidebar") {
					openFolders.clear();
					e.detail.target
						.querySelectorAll("details[data-folder-id]")
						.forEach(function (d) {
							if (d.open) openFolders.add(d.getAttribute("data-folder-id"));
						});
				}
			});
			document.addEventListener("htmx:afterSwap", function (e) {
				if (e.detail.target && e.detail.target.id === "feed-sidebar") {
					e.detail.target
						.querySelectorAll("details[data-folder-id]")
						.forEach(function (d) {
							if (openFolders.has(d.getAttribute("data-folder-id")))
								d.open = true;
						});
				}
			});
		})();
	</script>
}

templ feedSidebarSubLink(sub Subscription, sb sidebarData) {
	<a
		href={ templ.SafeURL(fmt.Sprintf("/apps/feed/subscription/%d", sub.ID)) }
		class={ feedSidebarSubClass(sub, sb) }
		style="padding-left:1.5rem;font-size:0.9rem;display:flex;align-items:center;gap:0.25rem"
	>
		<span class="sidebar-item-text">{ subscriptionDisplayTitle(sub) }</span>
		if sub.LastError != "" {
			<span class="text-danger" title={ sub.LastError }>!</span>
		}
		if sb.UnreadCounts[sub.ID] > 0 {
			<span class="badge">{ strconv.Itoa(sb.UnreadCounts[sub.ID]) }</span>
		}
	</a>
}

templ feedIndexPage(sb sidebarData, items []ItemWithSubscription, q string, csrfToken string) {
	<div class="sidebar-layout">
		@feedSidebar(sb)
		<div class="sidebar-content">
			<div class="flex items-center gap-1 mb-2" style="justify-content:space-between;flex-wrap:wrap">
				<h1 style="margin:0">All Articles</h1>
				<div class="flex gap-1 items-center">
					<form method="get" action="/apps/feed/">
						<div class="flex gap-1">
							<input class="form-control" type="search" name="q" value={ q } placeholder="Search feeds…" style="max-width:280px"/>
							<button class="btn btn-outline btn-sm" type="submit">Go</button>
						</div>
					</form>
					if sb.TotalUnread > 0 {
						<form method="post" action="/apps/feed/items/read-all">
							<input type="hidden" name="csrf_token" value={ csrfToken }/>
							<button class="btn btn-outline btn-sm" type="submit">Mark all read</button>
						</form>
					}
				</div>
			</div>
			if len(items) == 0 {
				@ui.Card("") {
					<p class="text-muted">No articles yet. Subscribe to feeds in Settings.</p>
				}
			} else {
				@feedItemList(items, csrfToken)
			}
		</div>
	</div>
}

templ feedSubscriptionPage(sb sidebarData, sub *Subscription, items []ItemWithSubscription, csrfToken string) {
	<div class="sidebar-layout">
		@feedSidebar(sb)
		<div class="sidebar-content">
			<div class="flex items-center gap-1 mb-2" style="justify-content:space-between">
				<h1 style="margin:0">{ subscriptionDisplayTitle(*sub) }</h1>
				<div class="flex gap-1">
					<form method="post" action={ templ.SafeURL(fmt.Sprintf("/apps/feed/subscriptions/%d/refresh", sub.ID)) }>
						<input type="hidden" name="csrf_token" value={ csrfToken }/>
						<button class="btn btn-outline btn-sm" type="submit">Refresh</button>
					</form>
					<form method="post" action={ templ.SafeURL(fmt.Sprintf("/apps/feed/subscriptions/%d/read-all", sub.ID)) }>
						<input type="hidden" name="csrf_token" value={ csrfToken }/>
						<button class="btn btn-outline btn-sm" type="submit">Mark all read</button>
					</form>
				</div>
			</div>
			if sub.LastError != "" {
				@ui.Alert("error", sub.LastError)
			}
			if len(items) == 0 {
				@ui.Card("") {
					<p class="text-muted">No articles in this subscription yet.</p>
				}
			} else {
				@feedItemList(items, csrfToken)
			}
		</div>
	</div>
}

templ feedFolderPage(sb sidebarData, folder *Folder, items []ItemWithSubscription, csrfToken string) {
	<div class="sidebar-layout">
		@feedSidebar(sb)
		<div class="sidebar-content">
			<div class="flex items-center gap-1 mb-2" style="justify-content:space-between">
				<h1 style="margin:0">{ folder.Name }</h1>
				<form method="post" action={ templ.SafeURL(fmt.Sprintf("/apps/feed/folders/%d/read-all", folder.ID)) }>
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					<button class="btn btn-outline btn-sm" type="submit">Mark all read</button>
				</form>
			</div>
			if len(items) == 0 {
				@ui.Card("") {
					<p class="text-muted">No articles in this folder.</p>
				}
			} else {
				@feedItemList(items, csrfToken)
			}
		</div>
	</div>
}

templ feedStarredPage(sb sidebarData, items []ItemWithSubscription, csrfToken string) {
	<div class="sidebar-layout">
		@feedSidebar(sb)
		<div class="sidebar-content">
			<h1>Starred</h1>
			if len(items) == 0 {
				@ui.Card("") {
					<p class="text-muted">No starred articles.</p>
				}
			} else {
				@feedItemList(items, csrfToken)
			}
		</div>
	</div>
}

templ feedTagPage(sb sidebarData, tag string, items []ItemWithSubscription, csrfToken string) {
	<div class="sidebar-layout">
		@feedSidebar(sb)
		<div class="sidebar-content">
			<h1>Tag: { tag }</h1>
			if len(items) == 0 {
				@ui.Card("") {
					<p class="text-muted">No articles with this tag.</p>
				}
			} else {
				@feedItemList(items, csrfToken)
			}
		</div>
	</div>
}

templ feedItemList(items []ItemWithSubscription, csrfToken string) {
	<div id="item-list">
		for _, item := range items {
			@feedItemRow(item, csrfToken)
		}
	</div>
	<script>
		function toggleArticle(id) {
			var el = document.getElementById("detail-" + id);
			var row = document.getElementById("item-" + id);
			var summary = document.getElementById("summary-" + id);
			if (!el) return;
			var isOpen = el.style.display !== "none";
			// Close all open details.
			document.querySelectorAll(".feed-item-detail").forEach(function (d) {
				d.style.display = "none";
			});
			document.querySelectorAll(".feed-item-active").forEach(function (r) {
				r.classList.remove("feed-item-active");
			});
			document
				.querySelectorAll(".feed-item-summary-line")
				.forEach(function (s) {
					s.style.display = "";
				});
			if (!isOpen) {
				el.style.display = "";
				row.classList.add("feed-item-active");
				if (summary) summary.style.display = "none";
				// Mark as read visually and on the server.
				if (!row.classList.contains("feed-item-read")) {
					row.classList.add("feed-item-read");
					var readBtn = row.querySelector('[title="Toggle read"]');
					if (readBtn) readBtn.innerHTML = "○";
				}
				fetch("/apps/feed/items/" + id + "/mark-read", {
					method: "POST",
					headers: {
						"X-CSRF-Token": document.querySelector("[name=csrf_token]")
							? document.querySelector("[name=csrf_token]").value
							: "",
					},
				});
			}
		}
		(function () {
			document.addEventListener("keydown", function (e) {
				if (
					e.target.tagName === "INPUT" ||
					e.target.tagName === "TEXTAREA" ||
					e.target.tagName === "SELECT"
				)
					return;
				var items = Array.from(document.querySelectorAll(".feed-item"));
				var active = document.querySelector(".feed-item-active");
				var idx = active ? items.indexOf(active) : -1;
				if (e.key === "j") {
					e.preventDefault();
					var next = idx + 1;
					if (next < items.length) {
						var id = items[next].id.replace("item-", "");
						toggleArticle(id);
						items[next].scrollIntoView({
							block: "nearest",
							behavior: "smooth",
						});
					}
				} else if (e.key === "k") {
					e.preventDefault();
					var prev = idx - 1;
					if (prev >= 0) {
						var id = items[prev].id.replace("item-", "");
						toggleArticle(id);
						items[prev].scrollIntoView({
							block: "nearest",
							behavior: "smooth",
						});
					}
				} else if (e.key === "o" || e.key === "Enter") {
					if (active) {
						var link = active.querySelector(
							".feed-item-detail a[target=_blank]",
						);
						if (link) {
							e.preventDefault();
							window.open(link.href, "_blank");
						}
					}
				}
			});
		})();
	</script>
}

templ feedItemRow(item ItemWithSubscription, csrfToken string) {
	if item.Type == "audio" || item.Type == "video" {
		@feedMediaItemRow(item, csrfToken)
	} else {
		@feedTextItemRow(item, csrfToken)
	}
}

templ feedTextItemRow(item ItemWithSubscription, csrfToken string) {
	<div id={ fmt.Sprintf("item-%d", item.ID) } class={ feedItemRowClass(item.IsRead) } style="padding:0.75rem 1rem;border-bottom:1px solid var(--color-border, #e0e0e0)">
		<div class="flex items-center gap-1" style="justify-content:space-between;cursor:pointer" onclick={ templ.ComponentScript{Call: fmt.Sprintf("toggleArticle(%d)", item.ID)} }>
			<div style="min-width:0;flex:1">
				<div class="flex items-center gap-1" style="flex-wrap:wrap">
					<span class="text-muted" style="font-size:0.8rem">{ item.SubscriptionTitle }</span>
					if item.Author != "" {
						<span class="text-muted" style="font-size:0.8rem">&middot; { item.Author }</span>
					}
					<span class="text-muted" style="font-size:0.8rem">&middot; { feedFormatTime(item.PublishedAt) }</span>
				</div>
				<div style="font-weight:500">{ item.Title }</div>
				if feedItemSummary(item.ContentHTML) != "" {
					<div id={ fmt.Sprintf("summary-%d", item.ID) } class="feed-item-summary-line">
						{ feedItemSummary(item.ContentHTML) }
					</div>
				}
			</div>
			<div class="flex gap-1" style="flex-shrink:0" onclick="event.stopPropagation()">
				if item.URL != "" {
					<a
						href={ templ.SafeURL(item.URL) }
						target="_blank"
						rel="noopener"
						class="btn btn-outline btn-sm"
						title="Open article"
					>&#8599;</a>
				}
				@ui.Star(item.IsStarred, fmt.Sprintf("/apps/feed/items/%d/star", item.ID))
				<button
					class="btn btn-outline btn-sm"
					hx-post={ fmt.Sprintf("/apps/feed/items/%d/read", item.ID) }
					hx-target={ fmt.Sprintf("#item-%d", item.ID) }
					hx-swap="outerHTML"
					title="Toggle read"
				>
					if item.IsRead {
						&#9675;
					} else {
						&#9679;
					}
				</button>
			</div>
		</div>
		<div id={ fmt.Sprintf("detail-%d", item.ID) } class="feed-item-detail" style="display:none">
			if feedItemPreviewImage(item.ContentHTML) != "" {
				<img class="feed-item-preview-img" src={ feedItemPreviewImage(item.ContentHTML) } alt=""/>
			}
			if item.ContentHTML != "" {
				<div class="feed-item-content">
					@templ.Raw(item.ContentHTML)
				</div>
			} else if feedItemSummary(item.ContentHTML) != "" {
				<p class="feed-item-summary">{ feedItemSummary(item.ContentHTML) }</p>
			}
			<div style="margin-top:0.75rem;clear:both">
				if item.URL != "" {
					<a href={ templ.SafeURL(item.URL) } target="_blank" rel="noopener" class="btn btn-outline btn-sm">Open article</a>
				}
			</div>
		</div>
	</div>
}

templ feedMediaItemRow(item ItemWithSubscription, csrfToken string) {
	<div id={ fmt.Sprintf("item-%d", item.ID) } class={ feedItemRowClass(item.IsRead) } style="padding:0.75rem 1rem;border-bottom:1px solid var(--color-border, #e0e0e0)">
		<div class="flex items-center gap-1" style="justify-content:space-between">
			<div style="min-width:0;flex:1">
				<div class="flex items-center gap-1" style="flex-wrap:wrap">
					<span class="text-muted" style="font-size:0.8rem">{ item.SubscriptionTitle }</span>
					if item.Author != "" {
						<span class="text-muted" style="font-size:0.8rem">&middot; { item.Author }</span>
					}
					<span class="text-muted" style="font-size:0.8rem">&middot; { feedFormatTime(item.PublishedAt) }</span>
					if item.DurationSec > 0 {
						<span class="text-muted" style="font-size:0.8rem">&middot; { feedFormatDuration(item.DurationSec) }</span>
					}
				</div>
				<div style="font-weight:500">{ item.Title }</div>
			</div>
			<div class="flex gap-1" style="flex-shrink:0">
				<a
					href={ templ.SafeURL(fmt.Sprintf("/apps/feed/items/%d", item.ID)) }
					class="btn btn-outline btn-sm"
					title={ "Play " + item.Type }
				>&#9654; Play</a>
				if item.URL != "" {
					<a
						href={ templ.SafeURL(item.URL) }
						target="_blank"
						rel="noopener"
						class="btn btn-outline btn-sm"
						title="Open original"
					>&#8599;</a>
				}
				@ui.Star(item.IsStarred, fmt.Sprintf("/apps/feed/items/%d/star", item.ID))
				<button
					class="btn btn-outline btn-sm"
					hx-post={ fmt.Sprintf("/apps/feed/items/%d/read", item.ID) }
					hx-target={ fmt.Sprintf("#item-%d", item.ID) }
					hx-swap="outerHTML"
					title="Toggle read"
				>
					if item.IsRead {
						&#9675;
					} else {
						&#9679;
					}
				</button>
			</div>
		</div>
	</div>
}

templ feedSettingsPage(subs []Subscription, folders []Folder, filters []Filter, playlists []Playlist, flashMsg string, flashKind string, csrfToken string) {
	<div id="feed-settings">
		@ui.Alert(flashKind, flashMsg)
		@ui.Card("Subscriptions") {
			<form id="add-subscription" method="post" action="/apps/feed/subscriptions">
				<input type="hidden" name="csrf_token" value={ csrfToken }/>
				<div class="form-group">
					<label for="sub-kind">Kind</label>
					<select id="sub-kind" name="kind" class="form-control">
						<option value="rss">RSS / Atom (incl. podcasts)</option>
						<option value="youtube">YouTube channel</option>
						<option value="url">Single URL (polled)</option>
					</select>
				</div>
				<div class="form-group">
					<label for="sub-url">URL</label>
					<input class="form-control" type="url" id="sub-url" name="url" required/>
				</div>
				<div class="form-group">
					<label for="sub-folder">Folder</label>
					<select id="sub-folder" name="folder_id" class="form-control">
						<option value="">(none)</option>
						for _, f := range folders {
							<option value={ strconv.FormatInt(f.ID, 10) }>{ f.Name }</option>
						}
					</select>
				</div>
				@ui.Button("primary", "Add subscription")
			</form>
			<ul id="subscription-list" style="margin-top:1rem;padding-left:0;list-style:none">
				for _, s := range subs {
					<li style="display:flex;align-items:center;gap:0.5rem;padding:0.4rem 0;border-bottom:1px solid var(--color-border)">
						<span style="flex:1">{ subscriptionDisplayTitle(s) }</span>
						<code>{ s.URL }</code>
						<span class="badge">{ s.Kind }</span>
						<form method="post" action={ templ.SafeURL("/apps/feed/subscriptions/" + strconv.FormatInt(s.ID, 10) + "/delete") } style="margin:0">
							<input type="hidden" name="csrf_token" value={ csrfToken }/>
							@ui.Button("danger", "Delete")
						</form>
					</li>
				}
			</ul>
			<div style="margin-top:1rem;display:flex;gap:0.5rem;flex-wrap:wrap">
				@ui.Upload("/apps/feed/opml/import", "opml", ".opml,.xml,application/xml", csrfToken, "Import OPML", "btn-secondary btn-sm")
				<a class="btn btn-secondary btn-sm" href="/apps/feed/opml/export">Export OPML</a>
			</div>
		}
		@ui.Card("Folders") {
			<form id="add-folder" method="post" action="/apps/feed/folders" class="flex gap-1 items-center">
				<input type="hidden" name="csrf_token" value={ csrfToken }/>
				<input class="form-control" type="text" id="folder-name" name="name" placeholder="Folder name" required style="max-width:300px"/>
				@ui.Button("primary", "Add folder")
			</form>
			<ul style="margin-top:1rem;padding-left:0;list-style:none">
				for _, f := range folders {
					<li style="display:flex;align-items:center;gap:0.5rem;padding:0.4rem 0;border-bottom:1px solid var(--color-border)">
						<span style="flex:1">{ f.Name }</span>
						<form method="post" action={ templ.SafeURL("/apps/feed/folders/" + strconv.FormatInt(f.ID, 10) + "/delete") } style="margin:0">
							<input type="hidden" name="csrf_token" value={ csrfToken }/>
							@ui.Button("danger", "Delete")
						</form>
					</li>
				}
			</ul>
		}
		@ui.Card("Filters") {
			<form id="add-filter" method="post" action="/apps/feed/filters">
				<input type="hidden" name="csrf_token" value={ csrfToken }/>
				<div class="form-group">
					<label for="filter-query">Query</label>
					<input class="form-control" type="text" id="filter-query" name="query" required/>
				</div>
				<div class="form-group">
					<label for="filter-action">Action</label>
					<select id="filter-action" name="action" class="form-control">
						<option value="skip">Skip</option>
						<option value="tag">Tag</option>
						<option value="download">Download</option>
						<option value="mute_profanity">Mute profanity</option>
						<option value="transcribe">Transcribe</option>
					</select>
				</div>
				<div class="form-group">
					<label for="filter-action-value">Tag (for &ldquo;Tag&rdquo; action)</label>
					<input class="form-control" type="text" id="filter-action-value" name="action_value"/>
				</div>
				@ui.Button("primary", "Add filter")
			</form>
			<ul style="margin-top:1rem;padding-left:0;list-style:none">
				for _, fl := range filters {
					<li style="display:flex;align-items:center;gap:0.5rem;padding:0.4rem 0;border-bottom:1px solid var(--color-border)">
						<code style="flex:1">{ fl.Query }</code>
						<span>&#8594; { fl.Action }</span>
						if fl.ActionValue != "" {
							<span class="badge">{ fl.ActionValue }</span>
						}
						<form method="post" action={ templ.SafeURL("/apps/feed/filters/" + strconv.FormatInt(fl.ID, 10) + "/delete") } style="margin:0">
							<input type="hidden" name="csrf_token" value={ csrfToken }/>
							@ui.Button("danger", "Delete")
						</form>
					</li>
				}
			</ul>
		}
		@ui.Card("Playlists") {
			<form id="add-playlist" method="post" action="/apps/feed/playlists">
				<input type="hidden" name="csrf_token" value={ csrfToken }/>
				@ui.FormField("Name", "name", "text", "", "Playlist name")
				@ui.FormField("Query", "query", "text", "", "e.g. type:audio")
				@ui.Button("primary", "Add playlist")
			</form>
			<ul style="margin-top:1rem;padding-left:0;list-style:none">
				for _, pl := range playlists {
					<li style="display:flex;align-items:center;gap:0.5rem;padding:0.4rem 0;border-bottom:1px solid var(--color-border)">
						<span style="flex:1">{ pl.Name }</span>
						<code>{ pl.Query }</code>
						<form method="post" action={ templ.SafeURL("/apps/feed/playlists/" + strconv.FormatInt(pl.ID, 10) + "/delete") } style="margin:0">
							<input type="hidden" name="csrf_token" value={ csrfToken }/>
							@ui.Button("danger", "Delete")
						</form>
					</li>
				}
			</ul>
		}
	</div>
}

templ feedItemDetail(ip ItemPlayback, tags []string, csrfToken string) {
	@ui.Card(ip.Title) {
		<div class="text-muted" style="font-size:0.85rem;margin-bottom:0.5rem">
			{ ip.SubscriptionTitle }
			if ip.Author != "" {
				&middot; { ip.Author }
			}
		</div>
		<div class="mb-2">
			for _, tg := range tags {
				<span class="badge" style="margin-right:0.25rem">{ tg }</span>
			}
		</div>
		if ip.Type == "text" {
			<div class="note-content">
				@templ.Raw(ip.ContentHTML)
			</div>
		} else {
			@feedPlayer(ip, csrfToken)
		}
		if ip.URL != "" {
			<p style="margin-top:1rem">
				<a href={ templ.SafeURL(ip.URL) } target="_blank" rel="noopener">Original</a>
			</p>
		}
	}
}

templ feedPlayer(ip ItemPlayback, csrfToken string) {
	<div
		id="feed-player"
		class="card"
		style="padding:1rem"
		data-item-id={ strconv.FormatInt(ip.ID, 10) }
		data-resume={ fmt.Sprintf("%.1f", ip.ProgressSec) }
		data-media-type={ ip.Type }
		data-source-kind={ ip.SourceKind }
	>
		<div style="font-weight:600;margin-bottom:0.5rem">{ ip.Title }</div>
		<div class="text-muted" style="font-size:0.85rem;margin-bottom:0.5rem">{ ip.SubscriptionTitle }</div>
		if ip.Type == "video" {
			<video
				id="player-el"
				style="width:100%;max-height:480px;background:#000;margin-bottom:0.5rem"
				preload="metadata"
				if ip.SourceKind != "youtube" {
					src={ "/apps/feed/items/" + strconv.FormatInt(ip.ID, 10) + "/media" }
				}
			></video>
		} else {
			<audio
				id="player-el"
				style="width:100%;margin-bottom:0.5rem"
				preload="metadata"
				if ip.SourceKind != "youtube" {
					src={ "/apps/feed/items/" + strconv.FormatInt(ip.ID, 10) + "/media" }
				}
			></audio>
		}
		<div class="flex items-center gap-1" style="flex-wrap:wrap">
			<button class="btn btn-outline btn-sm" onclick="playerSkip(-15)" title="Back 15s">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"></polyline><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path></svg>
			</button>
			<button class="btn btn-primary btn-sm" id="player-play-btn" onclick="playerToggle()" title="Play" style="display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;padding:0;border-radius:50%">
				<svg id="icon-play" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
				<svg id="icon-pause" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" style="display:none"><rect x="6" y="4" width="4" height="16"></rect><rect x="14" y="4" width="4" height="16"></rect></svg>
			</button>
			<button class="btn btn-outline btn-sm" onclick="playerSkip(30)" title="Forward 30s">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"></polyline><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path></svg>
			</button>
			<span id="player-time" class="text-muted" style="font-size:0.85rem;margin-left:0.5rem">0:00 / 0:00</span>
			<button
				class="btn btn-outline btn-sm"
				style="margin-left:auto"
				hx-post={ fmt.Sprintf("/apps/feed/items/%d/complete", ip.ID) }
				hx-target="#feed-player"
				hx-swap="outerHTML"
			>
				<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
				Done
			</button>
		</div>
		<input type="hidden" name="csrf_token" value={ csrfToken }/>
		@feedPlayerScript()
	</div>
}

templ feedPlayerScript() {
	<script>
		(function () {
			var player = document.getElementById("feed-player");
			if (!player) return;
			var el = document.getElementById("player-el");
			if (!el) return;
			var itemID = player.dataset.itemId;
			var resume = parseFloat(player.dataset.resume) || 0;
			var sourceKind = player.dataset.sourceKind;
			var playBtn = document.getElementById("player-play-btn");
			var timeSpan = document.getElementById("player-time");
			var csrfToken = player.querySelector("[name=csrf_token]").value;
			var lastSaved = 0;

			function formatTime(sec) {
				sec = Math.floor(sec);
				var h = Math.floor(sec / 3600);
				var m = Math.floor((sec % 3600) / 60);
				var s = sec % 60;
				if (h > 0)
					return (
						h + ":" + (m < 10 ? "0" : "") + m + ":" + (s < 10 ? "0" : "") + s
					);
				return m + ":" + (s < 10 ? "0" : "") + s;
			}

			if (sourceKind === "youtube") {
				fetch("/apps/feed/api/stream-url/" + itemID, {
					headers: { "X-CSRF-Token": csrfToken },
				})
					.then(function (r) {
						return r.json();
					})
					.then(function (data) {
						if (data.url) {
							el.src = data.url;
							if (resume > 0) el.currentTime = resume;
							el.play().catch(function () {});
						}
					})
					.catch(function () {});
			} else {
				el.addEventListener(
					"loadedmetadata",
					function () {
						if (resume > 0) el.currentTime = resume;
						el.play().catch(function () {});
					},
					{ once: true },
				);
			}

			// Fetch clean audio ranges (profanity muting).
			var muteRanges = [];
			fetch("/apps/feed/api/clean-audio/" + itemID, {
				headers: { "X-CSRF-Token": csrfToken },
			})
				.then(function (r) {
					return r.json();
				})
				.then(function (data) {
					if (data.ranges) muteRanges = data.ranges;
				})
				.catch(function () {});

			var wasMuted = false;
			var originalVolume = 1;

			el.addEventListener("timeupdate", function () {
				timeSpan.textContent =
					formatTime(el.currentTime) + " / " + formatTime(el.duration || 0);

				// Apply profanity muting.
				var t = el.currentTime;
				var shouldMute = false;
				for (var i = 0; i < muteRanges.length; i++) {
					if (t >= muteRanges[i].Start && t <= muteRanges[i].End) {
						shouldMute = true;
						break;
					}
				}
				if (shouldMute && !wasMuted) {
					originalVolume = el.volume;
					el.volume = 0;
					wasMuted = true;
				} else if (!shouldMute && wasMuted) {
					el.volume = originalVolume;
					wasMuted = false;
				}

				// Save progress every 15 seconds of playback.
				var now = el.currentTime;
				if (Math.abs(now - lastSaved) >= 15) {
					lastSaved = now;
					fetch("/apps/feed/items/" + itemID + "/progress", {
						method: "POST",
						headers: {
							"Content-Type": "application/x-www-form-urlencoded",
							"X-CSRF-Token": csrfToken,
						},
						body: "progress=" + now.toFixed(1),
					});
				}
			});

			el.addEventListener("ended", function () {
				// Mark complete; v1 returns empty body so the player stays until the user navigates.
				fetch("/apps/feed/items/" + itemID + "/complete", {
					method: "POST",
					headers: {
						"Content-Type": "application/x-www-form-urlencoded",
						"X-CSRF-Token": csrfToken,
					},
				}).catch(function () {});
			});

			var iconPlay = document.getElementById("icon-play");
			var iconPause = document.getElementById("icon-pause");
			el.addEventListener("play", function () {
				if (iconPlay) iconPlay.style.display = "none";
				if (iconPause) iconPause.style.display = "";
				playBtn.title = "Pause";
			});
			el.addEventListener("pause", function () {
				if (iconPlay) iconPlay.style.display = "";
				if (iconPause) iconPause.style.display = "none";
				playBtn.title = "Play";
			});

			window.playerToggle = function () {
				if (el.paused) el.play();
				else el.pause();
			};
			window.playerSkip = function (sec) {
				el.currentTime = Math.max(0, el.currentTime + sec);
			};
		})();
	</script>
}

templ feedSystemSettingsPage(model string, modelsDir string, cliPath string, flash string, flashKind string) {
	@ui.Alert(flashKind, flash)
	@ui.Card("Transcription (whisper.cpp)") {
		<form method="post" action="">
			<div class="form-group">
				<label for="whisper_model">Model</label>
				<select name="whisper_model" id="whisper_model" class="form-control">
					<option value="none" selected?={ model == "none" }>None (disable transcription)</option>
					<option value="tiny.en" selected?={ model == "tiny.en" }>tiny.en (~75 MB)</option>
					<option value="base.en" selected?={ model == "base.en" }>base.en (~140 MB) — default</option>
					<option value="small.en" selected?={ model == "small.en" }>small.en (~470 MB)</option>
					<option value="medium.en" selected?={ model == "medium.en" }>medium.en (~1.5 GB)</option>
					<option value="large-v3" selected?={ model == "large-v3" }>large-v3 (~3 GB)</option>
				</select>
			</div>
			@ui.FormField("Models directory", "whisper_models_dir", "text", modelsDir, "(auto: plugin data dir)")
			@ui.FormField("whisper-cli binary", "whisper_cli_path", "text", cliPath, "(auto: search PATH)")
			@ui.Button("primary", "Save")
		</form>
	}
}

// --- Template helpers ---

func subscriptionDisplayTitle(s Subscription) string {
	if s.Title != "" {
		return s.Title
	}
	return s.URL
}

func feedSidebarClass(activePath, itemPath string) string {
	if activePath == itemPath {
		return "sidebar-item active"
	}
	return "sidebar-item"
}

func feedSidebarSubClass(sub Subscription, sb sidebarData) string {
	base := feedSidebarClass(sb.ActivePath, fmt.Sprintf("/apps/feed/subscription/%d", sub.ID))
	if sub.LastError != "" {
		return base + " text-danger"
	}
	return base
}

func isFeedFolderActive(folder Folder, sb sidebarData) bool {
	if sb.ActivePath == fmt.Sprintf("/apps/feed/folder/%d", folder.ID) {
		return true
	}
	for _, sub := range sb.Subscriptions {
		if sub.FolderID.Valid && sub.FolderID.Int64 == folder.ID {
			if sb.ActivePath == fmt.Sprintf("/apps/feed/subscription/%d", sub.ID) {
				return true
			}
		}
	}
	return false
}

func feedItemRowClass(isRead bool) string {
	if isRead {
		return "feed-item feed-item-read"
	}
	return "feed-item"
}

func feedFormatTime(unix int64) string {
	if unix == 0 {
		return ""
	}
	t := time.Unix(unix, 0)
	now := time.Now()
	if t.Year() == now.Year() && t.YearDay() == now.YearDay() {
		return t.Format("15:04")
	}
	if t.Year() == now.Year() {
		return t.Format("Jan 2")
	}
	return t.Format("2006-01-02")
}

func feedFormatDuration(sec int64) string {
	h := sec / 3600
	m := (sec % 3600) / 60
	s := sec % 60
	if h > 0 {
		return fmt.Sprintf("%d:%02d:%02d", h, m, s)
	}
	return fmt.Sprintf("%d:%02d", m, s)
}

func feedItemPreviewImage(html string) string {
	idx := strings.Index(html, "<img")
	if idx == -1 {
		return ""
	}
	rest := html[idx:]
	srcIdx := strings.Index(rest, `src="`)
	if srcIdx == -1 {
		srcIdx = strings.Index(rest, "src='")
		if srcIdx == -1 {
			return ""
		}
		rest = rest[srcIdx+5:]
		end := strings.Index(rest, "'")
		if end == -1 {
			return ""
		}
		return rest[:end]
	}
	rest = rest[srcIdx+5:]
	end := strings.Index(rest, `"`)
	if end == -1 {
		return ""
	}
	return rest[:end]
}

func feedItemSummary(html string) string {
	var b strings.Builder
	inTag := false
	count := 0
	for _, r := range html {
		if r == '<' {
			inTag = true
			continue
		}
		if r == '>' {
			inTag = false
			continue
		}
		if !inTag {
			b.WriteRune(r)
			count++
			if count >= 300 {
				b.WriteString("...")
				break
			}
		}
	}
	return b.String()
}
