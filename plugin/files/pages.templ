package files

import (
	"fmt"
	"git.duckfam.us/jj-software/cog/ui"
	"strconv"
	"time"
)

templ filesPage(pd ui.PageData, dirPath string, items []FileMeta) {
	@ui.Base(pd) {
		<h1 style="margin-bottom:0.5rem">Files</h1>
		@filesBreadcrumbs(dirPath)
		@ui.Card("") {
			<div class="flex gap-1 items-end mb-2" style="flex-wrap:wrap">
				<form method="post" action={ templ.SafeURL("/apps/files" + dirPath) } class="flex gap-1 items-end">
					<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
					<input class="form-control" type="text" name="name" placeholder="New folder" required style="max-width:200px" data-testid="new-folder-name"/>
					<button class="btn btn-outline btn-sm" type="submit" data-testid="new-folder-submit">Create Folder</button>
				</form>
				@ui.Upload("/apps/files"+dirPath, "file", "", pd.CSRFToken, "Upload", "btn btn-primary btn-sm")
				<button id="bulk-delete-btn" class="btn btn-danger btn-sm" style="display:none" onclick="bulkDelete()">Delete Selected</button>
			</div>
			<div id="drop-overlay" style="display:none;position:fixed;inset:0;background:rgba(0,100,200,0.15);z-index:1000;pointer-events:none;border:3px dashed var(--color-primary,#0082c9);margin:8px">
				<div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);font-size:1.5rem;font-weight:600;color:var(--color-primary,#0082c9);background:var(--color-bg,#fff);padding:1rem 2rem;border-radius:8px">
					Drop files to upload
				</div>
			</div>
			<table class="table" id="files-table">
				<thead>
					<tr>
						<th style="width:2rem"><input type="checkbox" id="select-all" onchange="toggleSelectAll(this)"/></th>
						<th>Name</th>
						<th>Size</th>
						<th>Modified</th>
						<th class="text-right">Actions</th>
					</tr>
				</thead>
				<tbody>
					if dirPath != "/" {
						<tr>
							<td></td>
							<td>
								<a href={ templ.SafeURL("/apps/files" + parentDir(dirPath)) }>../</a>
							</td>
							<td></td>
							<td></td>
							<td></td>
						</tr>
					}
					for _, f := range items {
						<tr
							id={ "file-" + safeDomID(f.Path) }
							if f.IsDir {
								data-dir={ f.Path }
							}
						>
							<td><input type="checkbox" class="file-check" value={ f.Path } onchange="updateBulkBtn()"/></td>
							<td>
								<div style="display:flex;align-items:center;gap:0.5rem">
									if isImageFile(f.MimeType) {
										<img
											src={ "/apps/files" + f.Path + "?preview=1&size=36" }
											alt=""
											width="18"
											height="18"
											style="object-fit:cover;border-radius:2px"
											loading="lazy"
										/>
									} else {
										@fileIcon(f.MimeType, f.IsDir)
									}
									if f.IsDir {
										<a href={ templ.SafeURL("/apps/files" + f.Path) }>{ f.Name }/</a>
									} else {
										<a href={ templ.SafeURL("/apps/files" + f.Path) }>{ f.Name }</a>
									}
								</div>
							</td>
							<td>
								if !f.IsDir {
									{ formatSize(f.Size) }
								}
							</td>
							<td>
								if f.MTime > 0 {
									{ time.Unix(f.MTime, 0).Format("2006-01-02 15:04") }
								}
							</td>
							<td class="text-right" style="white-space:nowrap">
								@favoriteButton(f.Path, f.Favorite)
								<button
									class="btn btn-outline btn-sm"
									onclick={ renameFile(f.Path, f.Name) }
								>Rename</button>
								<button
									class="btn btn-danger btn-sm"
									hx-delete={ "/apps/files" + f.Path }
									hx-target={ "#file-" + safeDomID(f.Path) }
									hx-swap="outerHTML"
									hx-confirm={ "Delete " + f.Name + "?" }
								>Delete</button>
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
		@filesDragDrop(dirPath, pd.CSRFToken)
		@filesActions(pd.CSRFToken)
	}
}

script renameFile(filePath string, currentName string) {
	var newName = prompt('Rename to:', currentName);
	if (!newName || newName === currentName) return;
	var parentPath = filePath.substring(0, filePath.length - currentName.length);
	var newPath = parentPath + newName;
	var csrf = document.querySelector('meta[name="csrf-token"]');
	var token = csrf ? csrf.content : document.querySelector('input[name="csrf_token"]').value;
	fetch('/api/files/rename', {
		method: 'POST',
		headers: {'Content-Type': 'application/json', 'X-CSRF-Token': token},
		body: JSON.stringify({old_path: filePath, new_path: newPath})
	}).then(function(resp) {
		if (resp.ok) window.location.reload();
		else resp.text().then(function(t) { alert('Rename failed: ' + t); });
	});
}

templ favoriteButton(filePath string, isFavorite bool) {
	<button
		class="btn btn-sm"
		style={ favoriteStyle(isFavorite) }
		onclick={ toggleFavorite(filePath, !isFavorite) }
		title={ favoriteTitle(isFavorite) }
	>
		if isFavorite {
			&#9733;
		} else {
			&#9734;
		}
	</button>
}

script toggleFavorite(filePath string, setFav bool) {
	fetch('/api/files/favorite', {
		method: 'POST',
		headers: {'Content-Type': 'application/json'},
		body: JSON.stringify({path: filePath, favorite: setFav})
	}).then(function(resp) {
		if (resp.ok) window.location.reload();
		else resp.text().then(function(t) { alert('Failed: ' + t); });
	});
}

templ filesActions(csrfToken string) {
	<script type="text/javascript">
	function toggleSelectAll(el) {
		document.querySelectorAll('.file-check').forEach(function(cb) { cb.checked = el.checked; });
		updateBulkBtn();
	}
	function updateBulkBtn() {
		var checked = document.querySelectorAll('.file-check:checked');
		document.getElementById('bulk-delete-btn').style.display = checked.length > 0 ? '' : 'none';
	}
	function bulkDelete() {
		var checked = document.querySelectorAll('.file-check:checked');
		if (!checked.length) return;
		if (!confirm('Delete ' + checked.length + ' item(s)?')) return;
		var csrf = {{ csrfToken }};
		var pending = checked.length;
		var errors = [];
		checked.forEach(function(cb) {
			fetch('/apps/files' + cb.value, {
				method: 'DELETE',
				headers: {'X-CSRF-Token': csrf}
			}).then(function(resp) {
				if (resp.ok) {
					var row = cb.closest('tr');
					if (row) row.remove();
				} else {
					errors.push(cb.value);
				}
				pending--;
				if (pending === 0) {
					if (errors.length > 0) alert('Failed to delete: ' + errors.join(', '));
					updateBulkBtn();
					document.getElementById('select-all').checked = false;
				}
			}).catch(function() {
				errors.push(cb.value);
				pending--;
				if (pending === 0) {
					if (errors.length > 0) alert('Failed to delete: ' + errors.join(', '));
					updateBulkBtn();
				}
			});
		});
	}
	</script>
}

templ filesDragDrop(dirPath string, csrfToken string) {
	<script type="text/javascript">
	(function() {
		var basePath = {{ dirPath }};
		var csrf = {{ csrfToken }};
		var overlay = document.getElementById('drop-overlay');
		var dragCount = 0;

		document.addEventListener('dragenter', function(e) {
			if (!e.dataTransfer.types.includes('Files')) return;
			e.preventDefault();
			dragCount++;
			overlay.style.display = '';
		});

		document.addEventListener('dragleave', function(e) {
			dragCount--;
			if (dragCount <= 0) {
				dragCount = 0;
				overlay.style.display = 'none';
			}
		});

		document.addEventListener('dragover', function(e) {
			if (!e.dataTransfer.types.includes('Files')) return;
			e.preventDefault();
			// Highlight folder row if hovering over one.
			var row = e.target.closest('tr[data-dir]');
			document.querySelectorAll('tr[data-dir]').forEach(function(r) {
				r.style.background = '';
			});
			if (row) {
				row.style.background = 'var(--color-primary-light, rgba(0,130,201,0.1))';
			}
		});

		document.addEventListener('drop', function(e) {
			e.preventDefault();
			dragCount = 0;
			overlay.style.display = 'none';
			document.querySelectorAll('tr[data-dir]').forEach(function(r) {
				r.style.background = '';
			});

			var files = e.dataTransfer.files;
			if (!files.length) return;

			// Determine upload target: folder row or current directory.
			var row = e.target.closest('tr[data-dir]');
			var uploadPath = row ? row.getAttribute('data-dir') : basePath;

			var pending = files.length;
			var errors = [];

			for (var i = 0; i < files.length; i++) {
				var fd = new FormData();
				fd.append('csrf_token', csrf);
				fd.append('file', files[i]);
				fetch('/apps/files' + uploadPath, {
					method: 'POST',
					body: fd,
					redirect: 'manual'
				}).then(function(resp) {
					if (resp.status >= 400) {
						errors.push('Upload failed: ' + resp.statusText);
					}
					pending--;
					if (pending === 0) {
						if (errors.length > 0) alert(errors.join('\n'));
						window.location.reload();
					}
				}).catch(function(err) {
					errors.push(err.message);
					pending--;
					if (pending === 0) {
						if (errors.length > 0) alert(errors.join('\n'));
						window.location.reload();
					}
				});
			}
		});
	})();
	</script>
}

templ filesBreadcrumbs(dirPath string) {
	<nav style="margin-bottom:1rem">
		<a href="/apps/files/">root</a>
		for _, seg := range breadcrumbSegments(dirPath) {
			<span>/ </span>
			<a href={ templ.SafeURL("/apps/files" + seg.Path) }>{ seg.Name }</a>
		}
	</nav>
}

templ fileIcon(mimeType string, isDir bool) {
	switch fileIconName(mimeType, isDir) {
		case "folder":
			<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
			</svg>
		case "image":
			<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
				<circle cx="8.5" cy="8.5" r="1.5"></circle>
				<polyline points="21 15 16 10 5 21"></polyline>
			</svg>
		case "text":
			<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
				<polyline points="14 2 14 8 20 8"></polyline>
				<line x1="16" y1="13" x2="8" y2="13"></line>
				<line x1="16" y1="17" x2="8" y2="17"></line>
			</svg>
		case "audio":
			<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<path d="M9 18V5l12-2v13"></path>
				<circle cx="6" cy="18" r="3"></circle>
				<circle cx="18" cy="16" r="3"></circle>
			</svg>
		case "video":
			<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<polygon points="23 7 16 12 23 17 23 7"></polygon>
				<rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
			</svg>
		default:
			<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
				<polyline points="14 2 14 8 20 8"></polyline>
			</svg>
	}
}

templ fileViewPage(pd ui.PageData, fp string, meta *FileMeta, kind string, textContent string, flashMsg string, flashKind string) {
	@ui.Base(pd) {
		@filesBreadcrumbs(parentDir(fp))
		if flashMsg != "" {
			@ui.Alert(flashKind, flashMsg)
		}
		@ui.Card(meta.Name) {
			<div class="flex gap-1 items-center mb-2">
				<span class="text-muted">{ meta.MimeType }</span>
				<span class="text-muted">{ formatSize(meta.Size) }</span>
				<a href={ templ.SafeURL("/apps/files" + fp + "?dl=1") } class="btn btn-primary btn-sm">Download</a>
				<cog-share-button resource={ fileResourceType(meta.IsDir) } resource-id={ strconv.FormatInt(meta.ID, 10) }>Share</cog-share-button>
				<button
					class="btn btn-danger btn-sm"
					hx-delete={ "/apps/files" + fp }
					hx-confirm={ "Delete " + meta.Name + "?" }
					hx-on::after-request="if(event.detail.successful) window.location=this.getAttribute('data-back')"
					data-back={ "/apps/files" + parentDir(fp) }
				>Delete</button>
			</div>
			if kind == "image" {
				<div style="text-align:center">
					<img
						src={ imageViewURL(fp, meta.MimeType) }
						alt={ meta.Name }
						style="max-width:100%;max-height:80vh"
					/>
				</div>
			}
			if kind == "text" {
				<form method="post" action={ templ.SafeURL("/apps/files" + fp + "?save=1") }>
					<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
					<textarea
						name="content"
						class="form-control"
						style="width:100%;min-height:400px;font-family:monospace;font-size:0.85rem;white-space:pre;tab-size:4"
					>{ textContent }</textarea>
					<div style="margin-top:0.5rem">
						<button class="btn btn-primary btn-sm" type="submit">Save</button>
					</div>
				</form>
			}
			if kind == "video" {
				<video controls style="max-width:100%;max-height:80vh">
					<source src={ "/apps/files" + fp + "?raw=1" } type={ meta.MimeType }/>
				</video>
			}
			if kind == "audio" {
				<audio controls style="width:100%">
					<source src={ "/apps/files" + fp + "?raw=1" } type={ meta.MimeType }/>
				</audio>
			}
			if kind == "pdf" {
				<iframe
					src={ "/apps/files" + fp + "?raw=1" }
					style="width:100%;height:80vh;border:1px solid var(--color-border)"
				></iframe>
			}
			if kind == "office" {
				<iframe
					src={ "/apps/files" + fp + "?pdfpreview=1" }
					style="width:100%;height:80vh;border:1px solid var(--color-border)"
				></iframe>
			}
			if kind == "binary" {
				<p class="text-muted">
					{ fmt.Sprintf("No preview available for %s.", meta.MimeType) }
				</p>
			}
		}
	}
}

templ favoritesPage(pd ui.PageData, items []FileMeta) {
	@ui.Base(pd) {
		<h1 style="margin-bottom:0.5rem">Favorites</h1>
		@ui.Card("") {
			if len(items) == 0 {
				<p class="text-muted">No favorites yet. Star files to see them here.</p>
			} else {
				<table class="table">
					<thead>
						<tr>
							<th>Name</th>
							<th>Path</th>
							<th>Size</th>
							<th>Modified</th>
						</tr>
					</thead>
					<tbody>
						for _, f := range items {
							<tr>
								<td>
									<div style="display:flex;align-items:center;gap:0.5rem">
										@fileIcon(f.MimeType, f.IsDir)
										<a href={ templ.SafeURL("/apps/files" + f.Path) }>{ f.Name }</a>
									</div>
								</td>
								<td class="text-muted">{ f.ParentPath }</td>
								<td>
									if !f.IsDir {
										{ formatSize(f.Size) }
									}
								</td>
								<td>
									if f.MTime > 0 {
										{ time.Unix(f.MTime, 0).Format("2006-01-02 15:04") }
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			}
		}
	}
}
