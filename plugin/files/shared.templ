package files

import (
	"git.duckfam.us/jj-software/cog/ui"
	"time"
)

templ sharedIcon() {
	<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
		<circle cx="9" cy="7" r="4"></circle>
		<path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
		<path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
	</svg>
}

// sharedPage lists what others shared with the user, by owner.
templ sharedPage(pd ui.PageData, owners []SharedOwner) {
	@filesLayout(pd, "shared") {
		@ui.PageHeader("Shared with me", nil)
		if len(owners) == 0 {
			<div class="card">
				@ui.EmptyState("Nothing is shared with you yet", "Folders, files and volumes others share with you appear here.")
			</div>
		}
		for _, o := range owners {
			<section class="card card-flush" data-shared-owner={ o.User.Username }>
				<h2 class="card-title">{ ownerLabel(o.User) }</h2>
				<table class="table">
					<thead>
						<tr>
							<th>Name</th>
							<th class="hide-mobile">In your files</th>
							<th class="col-shrink hide-mobile">Access</th>
						</tr>
					</thead>
					<tbody>
						for _, e := range o.Entries {
							<tr>
								<td>
									<a class="row-link files-name" href={ templ.SafeURL(sharedURL(o.User.Username, e.Name, "/")) }>
										<span class="files-thumb" aria-hidden="true">
											if e.Kind == SharedVolume {
												@volumeIcon()
											} else if e.File != nil {
												@fileIcon(e.File.MimeType, e.File.IsDir, "")
											}
										</span>
										<span class="files-name-text">
											<span class="files-name-label">{ e.Name }</span>
										</span>
									</a>
								</td>
								<td class="text-muted hide-mobile">
									for i, at := range e.MountedAt {
										if i > 0 {
											{ ", " }
										}
										<a href={ templ.SafeURL(fileURL(at)) }>{ at }</a>
									}
								</td>
								<td class="text-muted nowrap hide-mobile">{ sharedAccess(&e) }</td>
							</tr>
						}
					</tbody>
				</table>
			</section>
		}
	}
}

// sharedFolderPage is a folder shared with the user, or one inside it.
templ sharedFolderPage(pd ui.PageData, e *SharedEntry, rel string, items []FileMeta, now time.Time) {
	@filesLayout(pd, "shared") {
		@ui.PageHeader(sharedTitle(e, rel), sharedCrumbs(e, rel)) {
			if rel == "/" && len(e.MountedAt) == 0 {
				<button type="button" class="btn" data-modal-open="shared-mount" data-testid="shared-mount-open">
					@ui.Icon("plus")
					Add to my files
				</button>
			}
			if e.Writable() {
				<button type="button" class="btn" data-modal-open="shared-new-folder">
					@ui.Icon("plus")
					New folder
				</button>
				@ui.Upload(sharedURL(e.Owner.Username, e.Name, rel), "file", "", pd.CSRFToken, "Upload", "btn btn-primary")
			}
		}
		<p class="text-muted">
			{ "Shared by " + ownerLabel(e.Owner) + " · " + sharedAccess(e) }
			for _, at := range e.MountedAt {
				{ " · In your files at " }
				<a href={ templ.SafeURL(fileURL(at)) }>{ at }</a>
			}
		</p>
		if len(items) == 0 {
			<div class="card">
				@ui.EmptyState("This folder is empty", "")
			</div>
		} else {
			<div class="card card-flush files-card">
				<table class="table">
					<thead>
						<tr>
							<th>Name</th>
							<th class="col-shrink text-right hide-mobile">Size</th>
							<th class="col-shrink hide-mobile">Modified</th>
							if e.Writable() {
								<th class="col-actions"><span class="sr-only">Actions</span></th>
							}
						</tr>
					</thead>
					<tbody>
						for _, f := range items {
							<tr>
								<td>
									<a class="row-link files-name" href={ templ.SafeURL(sharedURL(e.Owner.Username, e.Name, sharedRel(e, f.Path))) } title={ f.Name }>
										<span class="files-thumb" aria-hidden="true">
											@fileIcon(f.MimeType, f.IsDir, "")
										</span>
										<span class="files-name-text">
											<span class="files-name-label">{ f.Name }</span>
											<span class="files-meta show-mobile">{ metaLine(f, now) }</span>
										</span>
									</a>
								</td>
								<td class="text-right nowrap text-muted hide-mobile">
									if !f.IsDir {
										{ formatSize(f.Size) }
									}
								</td>
								<td class="nowrap text-muted hide-mobile" title={ fullTime(f.MTime) }>{ shortTime(f.MTime, now) }</td>
								if e.Writable() {
									<td class="col-actions">
										<form method="post" action={ templ.SafeURL(sharedURL(e.Owner.Username, e.Name, rel)) }>
											<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
											<input type="hidden" name="action" value="delete"/>
											<input type="hidden" name="name" value={ f.Name }/>
											<button type="submit" class="btn-icon btn-icon-sm" aria-label={ "Delete " + f.Name } title="Delete">
												@ui.Icon("trash")
											</button>
										</form>
									</td>
								}
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
		if e.Writable() {
			@ui.Modal("shared-new-folder", "New folder") {
				<form method="post" action={ templ.SafeURL(sharedURL(e.Owner.Username, e.Name, rel)) }>
					<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
					<input type="hidden" name="action" value="mkdir"/>
					<div class="modal-body">
						<div class="form-group mb-0">
							<label for="shared-new-folder-name">Folder name</label>
							<input class="form-control" type="text" id="shared-new-folder-name" name="name" required autocomplete="off"/>
						</div>
					</div>
					<div class="modal-footer">
						<button type="button" class="btn" data-modal-close>Cancel</button>
						<button class="btn btn-primary" type="submit">Create folder</button>
					</div>
				</form>
			}
		}
		@mountModal(pd, "shared-mount", "Add to my files", sharedURL(e.Owner.Username, e.Name, "/"), "mount", suggestedMount(e),
			"“"+e.Name+"” will appear in your files at this folder, for the web, sync apps and SSH alike. It stays "+ownerLabel(e.Owner)+"’s: removing it from your files later leaves it as it is.")
	}
}

// sharedVolumePage is a volume shared with the user: the areas they keep
// on a storage volume, or where they can mount a raw one.
templ sharedVolumePage(pd ui.PageData, e *SharedEntry) {
	@filesLayout(pd, "shared") {
		@ui.PageHeader(e.Name, []ui.Crumb{{Label: "Shared with me", URL: "/apps/files/shared"}}) {
			if e.IsStorage() {
				<button type="button" class="btn btn-primary" data-modal-open="shared-area" data-testid="shared-area-open">
					@ui.Icon("plus")
					Add storage
				</button>
			}
		}
		<div class="card">
			if e.Volume.Description != "" {
				<p>{ e.Volume.Description }</p>
			}
			if e.IsStorage() {
				<p>{ "Storage on “" + e.Name + "” is yours alone: each folder you add keeps its files on this volume, and nobody else sees them unless you share them." }</p>
				if len(e.MountedAt) == 0 {
					<p class="text-muted">You have no storage here yet.</p>
				} else {
					<ul>
						for _, at := range e.MountedAt {
							<li><a href={ templ.SafeURL(fileURL(at)) }>{ at }</a></li>
						}
					</ul>
				}
			} else {
				<p>{ "“" + e.Name + "” is shared with you whole (" + sharedAccess(e) + "). Mount it in your files from " }<a href="/settings/storage">Storage settings</a>.</p>
			}
		</div>
		if e.IsStorage() {
			@mountModal(pd, "shared-area", "Add storage", sharedURL(e.Owner.Username, e.Name, "/"), "area", "/"+e.Name,
				"A new folder in your files whose contents are kept on “"+e.Name+"”. Its name is the folder’s; use the same name again to bring back storage you removed.")
		}
	}
}

// mountModal asks where in the user's files something should go.
templ mountModal(pd ui.PageData, id, title, action, kind, suggested, note string) {
	@ui.Modal(id, title) {
		<form method="post" action={ templ.SafeURL(action) }>
			<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
			<input type="hidden" name="action" value={ kind }/>
			<div class="modal-body">
				<p class="text-muted">{ note }</p>
				<div class="form-group mb-0">
					<label for={ id + "-path" }>Folder in your files</label>
					<input class="form-control" type="text" id={ id + "-path" } name="path" value={ suggested } required autocomplete="off" data-testid={ id + "-path" }/>
				</div>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn" data-modal-close>Cancel</button>
				<button class="btn btn-primary" type="submit" data-testid={ id + "-submit" }>{ title }</button>
			</div>
		</form>
	}
}
