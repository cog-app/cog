package files

import (
	"time"

	"git.duckfam.us/jj-software/cog/ui"
)

templ recentFilesWidget(files []FileMeta, now time.Time) {
	if len(files) == 0 {
		@ui.WidgetEmpty("No files yet.", "Upload files", "/apps/files/")
	} else {
		<ul class="widget-list">
			for _, f := range files {
				<li>
					<a href={ templ.SafeURL(fileURL(f.Path)) } class="file-name font-medium">
						@fileIcon(f.MimeType, f.IsDir, "")
						<span>{ f.Name }</span>
					</a>
					<div class="text-muted text-sm">
						{ formatSize(f.Size) } · { dirTitle(f.ParentPath) } · <span title={ fullTime(f.MTime) }>{ shortTime(f.MTime, now) }</span>
					</div>
				</li>
			}
		</ul>
	}
}
