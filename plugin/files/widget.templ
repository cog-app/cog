package files

import (
	"path/filepath"
	"time"
)

templ recentFilesWidget(files []FileMeta) {
	if len(files) == 0 {
		<p class="text-muted">No files yet.</p>
	} else {
		for _, f := range files {
			<div style="padding:0.4rem 0;border-bottom:1px solid var(--color-border)">
				<a href={ templ.SafeURL("/apps/files" + filepath.Dir(f.Path)) } style="font-weight:500">
					{ f.Name }
				</a>
				<div class="text-muted" style="font-size:0.85rem">
					{ formatSize(f.Size) } — { time.Unix(f.MTime, 0).UTC().Format("Jan 2, 15:04") }
				</div>
			</div>
		}
	}
}
