package rss

import "fmt"

templ unreadArticlesWidget(items []ItemWithFeed) {
	if len(items) == 0 {
		<p class="text-muted">No unread articles.</p>
	} else {
		for _, it := range items {
			<div style="padding:0.4rem 0;border-bottom:1px solid var(--color-border)">
				<a href={ templ.SafeURL(fmt.Sprintf("/apps/rss/feed/%d", it.FeedID)) } style="font-weight:500">
					{ it.Title }
				</a>
				<div class="text-muted" style="font-size:0.85rem">{ it.FeedTitle }</div>
			</div>
		}
	}
}
