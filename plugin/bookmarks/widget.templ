package bookmarks

import "git.duckfam.us/jj-software/cog/ui"

templ recentBookmarksWidget(bms []Bookmark) {
	if len(bms) == 0 {
		@ui.WidgetEmpty("No bookmarks yet.", "Add bookmark", "/apps/bookmarks/new")
	} else {
		<ul class="widget-list">
			for _, bm := range bms {
				<li>
					<a href={ templ.SafeURL(openURL(bm.ID)) } target="_blank" rel="noopener" class="font-medium">{ bm.Title }</a>
					<div class="text-muted text-sm">{ displayDomain(bm.URL) }</div>
				</li>
			}
		</ul>
	}
}
