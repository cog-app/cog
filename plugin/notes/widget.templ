package notes

import (
	"fmt"

	"git.duckfam.us/jj-software/cog/ui"
)

templ recentNotesWidget(notes []Note) {
	if len(notes) == 0 {
		@ui.WidgetEmpty("No notes yet.", "New note", "/apps/notes/new")
	} else {
		<ul class="widget-list">
			for _, n := range notes {
				<li>
					<a href={ templ.SafeURL(fmt.Sprintf("/apps/notes/note/%d", n.ID)) } class="font-medium">{ n.Title() }</a>
					if n.Category != "" {
						<div class="text-muted text-sm">{ n.Category }</div>
					}
				</li>
			}
		</ul>
	}
}
