package notes

import "fmt"

templ recentNotesWidget(notes []Note) {
	if len(notes) == 0 {
		<p class="text-muted">No notes yet.</p>
	} else {
		for _, n := range notes {
			<div style="padding:0.4rem 0;border-bottom:1px solid var(--color-border)">
				<a href={ templ.SafeURL(fmt.Sprintf("/apps/notes/note/%d", n.ID)) } style="font-weight:500">
					{ n.Title() }
				</a>
				if n.Category != "" {
					<div class="text-muted" style="font-size:0.85rem">{ n.Category }</div>
				}
			</div>
		}
	}
}
