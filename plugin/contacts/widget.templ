package contacts

import "git.duckfam.us/jj-software/cog/ui"

templ starredContactsWidget(cards []CardWithBook) {
	if len(cards) == 0 {
		@ui.WidgetEmpty("No starred contacts.", "Open contacts", "/apps/contacts/")
	} else {
		<ul class="widget-list">
			for _, c := range cards {
				<li class="contact-widget-row">
					@contactAvatar(&c.Card, c.BookColor, false)
					<div class="contact-widget-text">
						<a class="contact-widget-name" href={ templ.SafeURL(contactHref("/apps/contacts/starred", c.ID)) }>{ c.FN }</a>
						if line := contactSubtext(c); line != "" {
							<div class="contact-sub">{ line }</div>
						}
					</div>
				</li>
			}
		</ul>
	}
}

// contactSubtext is the line under a contact's name where there is room for
// one: their email, or phone.
func contactSubtext(c CardWithBook) string {
	if c.Email != "" {
		return c.Email
	}
	return c.Tel
}
