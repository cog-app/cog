package media

import "fmt"

templ upNextWidget(queue []EpisodeView) {
	if len(queue) == 0 {
		<p class="text-muted">Your queue is empty.</p>
	} else {
		for _, ep := range queue {
			<div style="padding:0.4rem 0;border-bottom:1px solid var(--color-border);display:flex;align-items:center;gap:0.5rem">
				if ep.ThumbnailURL != "" {
					if ep.MediaType == MediaVideo {
						<img src={ ep.ThumbnailURL } alt="" style="width:64px;height:36px;object-fit:cover;border-radius:3px;flex-shrink:0"/>
					} else {
						<img src={ ep.ThumbnailURL } alt="" style="width:36px;height:36px;object-fit:cover;border-radius:3px;flex-shrink:0"/>
					}
				}
				<div style="min-width:0">
					<a href={ templ.SafeURL(fmt.Sprintf("/apps/media/episode/%d", ep.ID)) } style="font-weight:500">
						{ ep.Title }
					</a>
					<div class="text-muted" style="font-size:0.85rem">
						{ ep.SourceTitle }
						if ep.DurationSec > 0 {
							<span>· { FormatDuration(ep.DurationSec) }</span>
						}
					</div>
				</div>
			</div>
		}
	}
}
