package tasks

import (
	"fmt"
	"strconv"
	"time"

	"git.duckfam.us/jj-software/cog/ui"
)

templ tasksSidebar(sb sidebarData, csrfToken string) {
	<nav class="sidebar" id="tasks-sidebar" aria-label="Task lists">
		<div class="sidebar-heading">Lists</div>
		for _, list := range sb.Lists {
			<a
				href={ templ.SafeURL(listURL(list.ID)) }
				class={ sidebarClass(sb.ActiveList, list.ID) }
				if sb.ActiveList == list.ID {
					aria-current="page"
				}
			>
				<span class="color-dot" style={ "background:" + list.Color }></span>
				{ list.Name }
			</a>
		}
		<div class="sidebar-divider"></div>
		<form method="post" action="/apps/tasks/list" class="task-new-list">
			<input type="hidden" name="csrf_token" value={ csrfToken }/>
			<label class="sr-only" for="new-list-name">New list</label>
			<input class="form-control form-control-sm" type="text" id="new-list-name" name="name" placeholder="New list…" required data-testid="new-list-name"/>
			<button class="btn btn-sm btn-square" type="submit" aria-label="Create list" title="Create list" data-testid="new-list-submit">
				@ui.Icon("plus")
			</button>
		</form>
	</nav>
}

templ tasksIndexPage(sb sidebarData, csrfToken string) {
	<div class="sidebar-layout">
		@tasksSidebar(sb, csrfToken)
		<div class="sidebar-content">
			@ui.PageHeader("Tasks", nil)
			<div class="card">
				@ui.EmptyState("No task lists yet", "A list holds related tasks: a project, errands, a shopping list. Lists sync with any CalDAV app.") {
					<form method="post" action="/apps/tasks/list" class="form-inline justify-center">
						<input type="hidden" name="csrf_token" value={ csrfToken }/>
						<label class="sr-only" for="first-list-name">List name</label>
						<input class="form-control" type="text" id="first-list-name" name="name" placeholder="List name" required/>
						<button class="btn btn-primary" type="submit">Create list</button>
					</form>
				}
			</div>
		</div>
	</div>
}

templ tasksListPage(sb sidebarData, list *TaskList, allTasks []Task, now time.Time, csrfToken string) {
	<div class="sidebar-layout">
		@tasksSidebar(sb, csrfToken)
		<div class="sidebar-content">
			<header class="page-header">
				<h1 class="task-list-title">
					<span class="color-dot" style={ "background:" + list.Color }></span>
					{ list.Name }
				</h1>
				<div class="page-actions">
					<a href={ templ.SafeURL(listURL(list.ID) + "/settings") } class="btn">
						@ui.Icon("settings")
						Settings
					</a>
				</div>
			</header>
			<form method="post" action="/apps/tasks/task" class="form-inline task-quick-add">
				<input type="hidden" name="csrf_token" value={ csrfToken }/>
				<input type="hidden" name="list_id" value={ strconv.FormatInt(list.ID, 10) }/>
				<label class="sr-only" for="new-task-summary">New task</label>
				<input class="form-control" type="text" id="new-task-summary" name="summary" placeholder="Add a task…" required data-testid="new-task-summary"/>
				<button class="btn btn-primary" type="submit" data-testid="new-task-submit">
					@ui.Icon("plus")
					Add
				</button>
			</form>
			<div id="task-tree" class="task-tree">
				@taskGroup("task-open", false, openRoots(allTasks), allTasks, 0, list, now, csrfToken)
				<div class="task-empty">
					@ui.EmptyState("No tasks yet", "Add your first task above.")
				</div>
				<p class="task-all-done">
					@ui.Icon("check-circle")
					All done. Nothing left on this list.
				</p>
				// Always present, so a task ticked in the list has somewhere to
				// go; the stylesheet hides it while it holds nothing.
				<details class="task-completed" id="task-completed">
					<summary>
						Completed
						@completedCount(len(doneRoots(allTasks)), false)
					</summary>
					@taskGroup("task-done", false, doneRoots(allTasks), allTasks, 0, list, now, csrfToken)
				</details>
			</div>
		</div>
	</div>
	@sortableScript()
}

templ completedCount(n int, oob bool) {
	<span
		class="count"
		id="task-completed-count"
		if oob {
			hx-swap-oob="true"
		}
	>{ strconv.Itoa(n) }</span>
}

// rootGroupsSwap is the answer to ticking a top-level task: both root groups
// and the completed count, swapped in out of band, which moves the task
// between the open list and "Completed" without touching whether that
// section is expanded.
templ rootGroupsSwap(allTasks []Task, list *TaskList, now time.Time, csrfToken string) {
	@taskGroup("task-open", true, openRoots(allTasks), allTasks, 0, list, now, csrfToken)
	@completedCount(len(doneRoots(allTasks)), true)
	@taskGroup("task-done", true, doneRoots(allTasks), allTasks, 0, list, now, csrfToken)
}

// taskGroup is one level of the tree: a list's top-level tasks, or one
// task's subtasks. Groups are what drag and drop reorders within and moves
// between. The two root groups have an id, which an out-of-band swap
// replaces them by.
templ taskGroup(id string, oob bool, tasks []Task, allTasks []Task, depth int, list *TaskList, now time.Time, csrfToken string) {
	<div
		if id != "" {
			id={ id }
		}
		if oob {
			hx-swap-oob="true"
		}
		class={ "task-group", templ.KV("task-subgroup", depth > 0) }
		data-task-group
		data-parent-id={ parentIDAttr(tasks) }
		data-list-id={ strconv.FormatInt(list.ID, 10) }
	>
		for i := range tasks {
			@taskItem(&tasks[i], allTasks, depth, list, now, csrfToken)
		}
	</div>
}

templ taskItem(task *Task, allTasks []Task, depth int, list *TaskList, now time.Time, csrfToken string) {
	<div
		id={ fmt.Sprintf("task-%d", task.ID) }
		class={ "task-item", templ.KV("completed", task.Done()) }
		data-task-id={ strconv.FormatInt(task.ID, 10) }
	>
		<div class="task-row">
			<span class="task-handle" data-drag-handle title="Drag to reorder" aria-hidden="true">
				<svg width="12" height="18" viewBox="0 0 12 18" fill="currentColor"><circle cx="3" cy="4" r="1.5"></circle><circle cx="9" cy="4" r="1.5"></circle><circle cx="3" cy="9" r="1.5"></circle><circle cx="9" cy="9" r="1.5"></circle><circle cx="3" cy="14" r="1.5"></circle><circle cx="9" cy="14" r="1.5"></circle></svg>
			</span>
			<label class="task-check">
				<input
					type="checkbox"
					checked?={ task.Done() }
					hx-post={ fmt.Sprintf("/apps/tasks/task/%d/toggle", task.ID) }
					hx-target={ fmt.Sprintf("#task-%d", task.ID) }
					hx-swap="outerHTML"
				/>
				<span class="sr-only">Done: { task.Summary }</span>
			</label>
			<div class="task-main">
				<a href={ templ.SafeURL(taskURL(task.ID)) } class="task-summary">{ task.Summary }</a>
				if p := priorityOf(task.Priority); p.Class != "" {
					<span class={ "badge", p.Class } title={ p.Label + " priority" }>{ p.Label }</span>
				}
				if task.RRule != "" {
					<span class="badge badge-outline" title="Repeats">&#8635;<span class="sr-only">Repeats</span></span>
				}
				if task.DueAt != nil {
					<span class={ dueBadgeClass(task, now, list.Zone()) } title="Due">{ formatDueDate(task, now, list.Zone()) }</span>
				}
			</div>
			<div class="dropdown task-menu">
				<button
					type="button"
					class="btn-icon btn-icon-sm"
					data-dropdown-toggle
					aria-expanded="false"
					aria-controls={ fmt.Sprintf("task-%d-menu", task.ID) }
					aria-label={ "Actions for " + task.Summary }
				>
					@ui.Icon("more")
				</button>
				<div class="dropdown-menu" id={ fmt.Sprintf("task-%d-menu", task.ID) }>
					<a href={ templ.SafeURL(taskURL(task.ID)) }>
						@ui.Icon("edit")
						Edit
					</a>
					<button type="button" data-subtask-open={ fmt.Sprintf("task-%d-subtask", task.ID) }>
						@ui.Icon("plus")
						Add subtask
					</button>
					<button
						type="button"
						class="danger"
						hx-delete={ taskURL(task.ID) }
						hx-target={ fmt.Sprintf("#task-%d", task.ID) }
						hx-swap="outerHTML"
						hx-confirm={ fmt.Sprintf("Delete “%s”?", task.Summary) }
					>
						@ui.Icon("trash")
						Delete
					</button>
				</div>
			</div>
		</div>
		<form method="post" action="/apps/tasks/task" class="form-inline task-subtask-form" id={ fmt.Sprintf("task-%d-subtask", task.ID) } data-subtask-form hidden>
			<input type="hidden" name="csrf_token" value={ csrfToken }/>
			<input type="hidden" name="list_id" value={ strconv.FormatInt(task.ListID, 10) }/>
			<input type="hidden" name="parent_id" value={ strconv.FormatInt(task.ID, 10) }/>
			<label class="sr-only" for={ fmt.Sprintf("task-%d-subtask-summary", task.ID) }>Subtask of { task.Summary }</label>
			<input class="form-control form-control-sm" type="text" id={ fmt.Sprintf("task-%d-subtask-summary", task.ID) } name="summary" placeholder="Subtask…" required/>
			<button class="btn btn-primary btn-sm" type="submit">Add</button>
			<button class="btn btn-ghost btn-sm" type="button" data-subtask-cancel>Cancel</button>
		</form>
		if children := ChildrenOf(allTasks, task.ID); len(children) > 0 {
			@taskGroup("", false, children, allTasks, depth+1, list, now, csrfToken)
		}
	</div>
}

templ taskDetailPage(sb sidebarData, task *Task, list *TaskList, lists []TaskList, allTasks []Task, times formTimes, csrfToken string) {
	<div class="sidebar-layout">
		@tasksSidebar(sb, csrfToken)
		<div class="sidebar-content">
			@ui.PageHeader("Edit task", []ui.Crumb{{Label: list.Name, URL: listURL(list.ID)}})
			<div class="card">
				<form method="post" action={ templ.SafeURL(taskURL(task.ID)) } id="task-form">
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					<div class="form-group">
						<label for="summary">Title</label>
						<input class="form-control" type="text" id="summary" name="summary" value={ task.Summary } required/>
					</div>
					<div class="form-group">
						<label for="description">Notes</label>
						<textarea class="form-control" id="description" name="description" rows="4">{ task.Description }</textarea>
					</div>
					<div class="form-row">
						<div class="form-group">
							<label for="status">Status</label>
							<select class="form-control" id="status" name="status" data-task-status>
								for _, s := range statusOptions {
									<option value={ s.Value } selected?={ s.Value == task.StatusOrDefault() }>{ s.Label }</option>
								}
							</select>
						</div>
						<div class="form-group">
							<label for="priority">Priority</label>
							<select class="form-control" id="priority" name="priority">
								for _, p := range priorityOptions(task.Priority) {
									<option value={ strconv.Itoa(p.Value) } selected?={ p.Selected }>{ p.Label }</option>
								}
							</select>
						</div>
						<div class="form-group" data-task-percent hidden?={ task.StatusOrDefault() != "IN-PROCESS" }>
							<label for="percent_complete">Progress (%)</label>
							<input class="form-control" type="number" id="percent_complete" name="percent_complete" min="0" max="100" value={ strconv.Itoa(task.PercentComplete) }/>
						</div>
					</div>
					<div class="form-row">
						<fieldset class="form-group">
							<legend>Due</legend>
							<div class="task-when">
								<label class="sr-only" for="due_date">Due date</label>
								<input class="form-control" type="date" id="due_date" name="due_date" value={ times.DueDate }/>
								<label class="sr-only" for="due_time">Due time</label>
								<input class="form-control" type="time" id="due_time" name="due_time" value={ times.DueTime }/>
							</div>
						</fieldset>
						<fieldset class="form-group">
							<legend>Starts</legend>
							<div class="task-when">
								<label class="sr-only" for="start_date">Start date</label>
								<input class="form-control" type="date" id="start_date" name="start_date" value={ times.StartDate }/>
								<label class="sr-only" for="start_time">Start time</label>
								<input class="form-control" type="time" id="start_time" name="start_time" value={ times.StartTime }/>
							</div>
						</fieldset>
					</div>
					<p class="form-help task-when-help">
						Leave the time empty for something due on a day.
						if times.Zone != "" {
							Times are in { times.Zone }.
						}
					</p>
					<div class="form-row">
						<div class="form-group">
							<label for="list_id">List</label>
							<select class="form-control" id="list_id" name="list_id">
								for _, l := range lists {
									<option value={ strconv.FormatInt(l.ID, 10) } selected?={ l.ID == task.ListID }>{ l.Name }</option>
								}
							</select>
						</div>
						<div class="form-group">
							<label for="parent_id">Subtask of</label>
							<select class="form-control" id="parent_id" name="parent_id">
								<option value="">Nothing (top level)</option>
								for _, t := range allTasks {
									if t.ID != task.ID {
										<option value={ strconv.FormatInt(t.ID, 10) } selected?={ task.ParentID != nil && *task.ParentID == t.ID }>{ t.Summary }</option>
									}
								}
							</select>
						</div>
					</div>
				</form>
				<div class="form-actions">
					<button class="btn btn-primary" type="submit" form="task-form">Save</button>
					<a href={ templ.SafeURL(listURL(task.ListID)) } class="btn">Cancel</a>
					<form method="post" action={ templ.SafeURL(taskURL(task.ID) + "/delete") } class="spacer" onsubmit="return confirm('Delete this task and its subtasks?')">
						<input type="hidden" name="csrf_token" value={ csrfToken }/>
						<button class="btn btn-outline-danger" type="submit">
							@ui.Icon("trash")
							Delete
						</button>
					</form>
				</div>
			</div>
		</div>
	</div>
	<script>
		(function () {
			var status = document.querySelector("[data-task-status]");
			var percent = document.querySelector("[data-task-percent]");
			if (!status || !percent) return;
			status.addEventListener("change", function () {
				percent.hidden = status.value !== "IN-PROCESS";
			});
		})();
	</script>
}

templ taskListSettingsPage(sb sidebarData, list *TaskList, csrfToken string) {
	<div class="sidebar-layout">
		@tasksSidebar(sb, csrfToken)
		<div class="sidebar-content">
			@ui.PageHeader("List settings", []ui.Crumb{{Label: list.Name, URL: listURL(list.ID)}})
			@ui.Card("List") {
				<form method="post" action={ templ.SafeURL(listURL(list.ID)) }>
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					<div class="form-row">
						<div class="form-group">
							<label for="name">Name</label>
							<input class="form-control" type="text" id="name" name="name" value={ list.Name } required/>
						</div>
						<div class="form-group form-group-auto">
							<label for="color">Colour</label>
							<input class="form-control" type="color" id="color" name="color" value={ list.Color }/>
						</div>
					</div>
					<div class="form-actions">
						<button class="btn btn-primary" type="submit">Save</button>
						<a href={ templ.SafeURL(listURL(list.ID)) } class="btn">Cancel</a>
					</div>
				</form>
			}
			<div class="card card-danger">
				<h2 class="card-title">Danger zone</h2>
				<p class="card-desc">Deleting “{ list.Name }” deletes every task in it, on this server and in every app that syncs it.</p>
				<button
					type="button"
					class="btn btn-danger"
					hx-delete={ listURL(list.ID) }
					hx-confirm={ fmt.Sprintf("Delete “%s” and all its tasks?", list.Name) }
				>Delete list</button>
			</div>
		</div>
	</div>
}

// sortableScript wires drag and drop (each [data-task-group] is a Sortable
// list of tasks, moved by [data-drag-handle]) and the "Add subtask" forms.
templ sortableScript() {
	<script src={ ui.Static.URL("vendor/sortable.min.js") }></script>
	<script>
		(function () {
			var csrfToken =
				document.querySelector('input[name="csrf_token"]')?.value || "";
			function save(group) {
				var parentId = group.dataset.parentId || null;
				var ids = Array.from(group.children)
					.filter(function (c) {
						return c.dataset && c.dataset.taskId;
					})
					.map(function (c) {
						return Number(c.dataset.taskId);
					});
				fetch("/apps/tasks/reorder", {
					method: "POST",
					headers: {
						"Content-Type": "application/json",
						"X-CSRF-Token": csrfToken,
					},
					body: JSON.stringify({
						list_id: Number(group.dataset.listId),
						parent_id: parentId ? Number(parentId) : null,
						task_ids: ids,
					}),
				}).then(function (r) {
					if (!r.ok) console.error("reorder tasks", r.status);
				}, function (err) {
					console.error("reorder tasks", err);
				});
			}
			function init(root) {
				root.querySelectorAll("[data-task-group]").forEach(function (el) {
					if (el.closest(".task-completed") || el.dataset.sortable) return;
					el.dataset.sortable = "1";
					new Sortable(el, {
						group: "tasks",
						handle: "[data-drag-handle]",
						animation: 150,
						fallbackOnBody: true,
						swapThreshold: 0.65,
						onEnd: function (evt) {
							save(evt.to);
						},
					});
				});
			}
			init(document);
			document.body.addEventListener("htmx:afterSwap", function (e) {
				init(e.target.parentElement || document);
			});
			// Ticking a top-level task replaces the root groups out of band.
			// The ticked box keeps focus if its row is still on screen.
			var toggled = "";
			document.body.addEventListener("htmx:beforeRequest", function (e) {
				var box = e.target.closest && e.target.closest(".task-check input");
				if (box) toggled = box.closest("[data-task-id]").id;
			});
			document.body.addEventListener("htmx:oobAfterSwap", function () {
				init(document);
				var box = toggled && document.querySelector("#" + toggled + " > .task-row .task-check input");
				if (box && box.offsetParent) box.focus();
			});
			document.addEventListener("click", function (e) {
				var open = e.target.closest("[data-subtask-open]");
				if (open) {
					var form = document.getElementById(open.dataset.subtaskOpen);
					var dd = open.closest(".dropdown");
					if (dd) {
						dd.classList.remove("open");
						var t = dd.querySelector("[data-dropdown-toggle]");
						if (t) t.setAttribute("aria-expanded", "false");
					}
					if (form) {
						form.hidden = false;
						form.querySelector('input[name="summary"]').focus();
					}
					return;
				}
				var cancel = e.target.closest("[data-subtask-cancel]");
				if (cancel) cancel.closest("[data-subtask-form]").hidden = true;
			});
		})();
	</script>
}

func listURL(id int64) string { return "/apps/tasks/list/" + strconv.FormatInt(id, 10) }
func taskURL(id int64) string { return "/apps/tasks/task/" + strconv.FormatInt(id, 10) }

func sidebarClass(activeList, listID int64) string {
	if activeList == listID {
		return "sidebar-item active"
	}
	return "sidebar-item"
}

// openRoots and doneRoots split a list's top-level tasks: the completed ones
// are shown apart, below the rest.
func openRoots(all []Task) []Task {
	var out []Task
	for _, t := range RootTasks(all) {
		if !t.Done() {
			out = append(out, t)
		}
	}
	return out
}

func doneRoots(all []Task) []Task {
	var out []Task
	for _, t := range RootTasks(all) {
		if t.Done() {
			out = append(out, t)
		}
	}
	return out
}

func parentIDAttr(tasks []Task) string {
	if len(tasks) > 0 && tasks[0].ParentID != nil {
		return strconv.FormatInt(*tasks[0].ParentID, 10)
	}
	return ""
}

// option is one choice in a select.
type option struct {
	Value, Label string
}

// statusOptions are the iCalendar statuses a task can have, in words.
var statusOptions = []option{
	{"NEEDS-ACTION", "To do"},
	{"IN-PROCESS", "In progress"},
	{"COMPLETED", "Done"},
	{"CANCELLED", "Cancelled"},
}

// priorityLevel is how a PRIORITY reads: 1–4 high, 5 medium, 6–9 low
// (RFC 5545 §3.8.1.9), 0 none.
type priorityLevel struct {
	Label, Class string
}

func priorityOf(p int) priorityLevel {
	switch {
	case p >= 1 && p <= 4:
		return priorityLevel{"High", "task-prio-high"}
	case p == 5:
		return priorityLevel{"Medium", "task-prio-medium"}
	case p >= 6 && p <= 9:
		return priorityLevel{"Low", "task-prio-low"}
	}
	return priorityLevel{}
}

// priorityChoice is one option of the priority select.
type priorityChoice struct {
	Value    int
	Label    string
	Selected bool
}

// priorityOptions are the priority select's choices. The task's own value
// stands for its level, so saving without touching the select keeps a
// client's 3 a 3 rather than rounding it to 1.
func priorityOptions(current int) []priorityChoice {
	out := []priorityChoice{{0, "None", false}, {1, "High", false}, {5, "Medium", false}, {9, "Low", false}}
	for i := range out {
		if priorityOf(out[i].Value) == priorityOf(current) {
			out[i].Value, out[i].Selected = current, true
		}
	}
	return out
}

// dueIn returns when a task is due, in loc. A due date (stored as midnight
// UTC) is that day, wherever loc is.
func dueIn(task *Task, loc *time.Location) time.Time {
	if loc == nil {
		loc = time.UTC
	}
	t := time.Unix(*task.DueAt, 0)
	if task.DueIsDate {
		u := t.UTC()
		return time.Date(u.Year(), u.Month(), u.Day(), 0, 0, 0, 0, loc)
	}
	return t.In(loc)
}

// formatDueDate says when a task is due, relative to now, in the list's
// zone: "Today", "Tomorrow 14:00", "Mar 28", "Mar 28, 2025".
func formatDueDate(task *Task, now time.Time, loc *time.Location) string {
	if loc == nil {
		loc = time.UTC
	}
	d, n := dueIn(task, loc), now.In(loc)
	today := time.Date(n.Year(), n.Month(), n.Day(), 0, 0, 0, 0, loc)
	day := time.Date(d.Year(), d.Month(), d.Day(), 0, 0, 0, 0, loc)
	var s string
	switch {
	case day.Equal(today):
		s = "Today"
	case day.Equal(today.AddDate(0, 0, 1)):
		s = "Tomorrow"
	case day.Equal(today.AddDate(0, 0, -1)):
		s = "Yesterday"
	case d.Year() == n.Year():
		s = d.Format("Jan 2")
	default:
		s = d.Format("Jan 2, 2006")
	}
	if !task.DueIsDate {
		s += " " + d.Format("15:04")
	}
	return s
}

// dueBadgeClass colours a due date: overdue once it has passed (a due date
// at the end of its day), due soon within a day of it. A finished task is
// due nothing.
func dueBadgeClass(task *Task, now time.Time, loc *time.Location) string {
	if task.Done() || task.Status == "CANCELLED" {
		return "badge badge-outline"
	}
	t := dueIn(task, loc)
	if task.DueIsDate {
		t = t.AddDate(0, 0, 1)
	}
	if !now.Before(t) {
		return "badge badge-overdue"
	}
	if t.Before(now.AddDate(0, 0, 1)) {
		return "badge badge-due-soon"
	}
	return "badge"
}
