package tasks

import (
	"time"

	"git.duckfam.us/jj-software/cog/ui"
)

templ upcomingTasksWidget(tasks []TaskWithList, now time.Time) {
	if len(tasks) == 0 {
		@ui.WidgetEmpty("Nothing due.", "Open tasks", "/apps/tasks/")
	} else {
		<ul class="widget-list">
			for _, t := range tasks {
				<li class="task-widget-row">
					<span class="color-dot" style={ "background:" + t.ListColor } title={ t.ListName }></span>
					<a class="task-widget-title" href={ templ.SafeURL(taskURL(t.ID)) }>{ t.Summary }</a>
					if t.DueAt != nil {
						<span class={ dueBadgeClass(&t.Task, now, t.ListZone) }>{ formatDueDate(&t.Task, now, t.ListZone) }</span>
					}
				</li>
			}
		</ul>
	}
}
