package recipes

import (
	"fmt"

	"git.duckfam.us/jj-software/cog/ui"
)

templ recentRecipesWidget(recipes []Recipe) {
	if len(recipes) == 0 {
		@ui.WidgetEmpty("No recipes yet.", "New recipe", "/apps/recipes/new")
	} else {
		<ul class="widget-list">
			for _, r := range recipes {
				<li>
					<a href={ templ.SafeURL(fmt.Sprintf("/apps/recipes/recipe/%d", r.ID)) } class="font-medium">{ r.Name }</a>
					if meta := recipeMeta(&r, viewAll); meta != "" {
						<div class="text-muted text-sm">{ meta }</div>
					}
				</li>
			}
		</ul>
	}
}
