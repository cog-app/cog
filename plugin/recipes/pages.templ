package recipes

import (
	"fmt"
	"net/url"
	"strconv"
	"strings"

	"git.duckfam.us/jj-software/cog/ui"
)

// sidebarTagLimit is how many tags the sidebar shows before folding the rest
// away; a recipe book collects far more tags than categories.
const sidebarTagLimit = 8

templ recipesSidebar(sb sidebarData) {
	<nav
		class="sidebar"
		id="recipes-sidebar"
		aria-label="Recipes"
		if sb.OOB {
			hx-swap-oob="true"
		}
	>
		@sidebarLink(sb.ActivePath, "/apps/recipes/", "All recipes", sb.RecipeCount)
		if len(sb.Categories) > 0 {
			<div class="sidebar-heading">Categories</div>
			for _, cat := range sb.Categories {
				@sidebarLink(sb.ActivePath, "/apps/recipes/category/"+cat.Name, cat.Name, cat.Count)
			}
		}
		if len(sb.Keywords) > 0 {
			<div class="sidebar-heading">Tags</div>
			for _, kw := range headKeywords(sb) {
				@sidebarLink(sb.ActivePath, "/apps/recipes/keyword/"+kw.Keyword, kw.Keyword, kw.Count)
			}
			if rest := tailKeywords(sb); len(rest) > 0 {
				<details class="recipe-more-tags">
					<summary class="sidebar-item">{ fmt.Sprintf("%d more", len(rest)) }</summary>
					for _, kw := range rest {
						@sidebarLink(sb.ActivePath, "/apps/recipes/keyword/"+kw.Keyword, kw.Keyword, kw.Count)
					}
				</details>
			}
		}
	</nav>
}

templ sidebarLink(activePath, href, label string, count int) {
	<a
		href={ templ.SafeURL(href) }
		if activePath == href {
			class="sidebar-item active"
			aria-current="page"
		} else {
			class="sidebar-item"
		}
	>
		<span class="break-anywhere">{ label }</span>
		if count > 0 {
			<span class="count">{ strconv.Itoa(count) }</span>
		}
	</a>
}

// headKeywords are the tags the sidebar always shows: the first few, plus
// the active one wherever it sorts, so the current page is never hidden.
func headKeywords(sb sidebarData) []KeywordCount {
	var head []KeywordCount
	for i, kw := range sb.Keywords {
		if i < sidebarTagLimit || sb.ActivePath == "/apps/recipes/keyword/"+kw.Keyword {
			head = append(head, kw)
		}
	}
	return head
}

func tailKeywords(sb sidebarData) []KeywordCount {
	var tail []KeywordCount
	for i, kw := range sb.Keywords {
		if i >= sidebarTagLimit && sb.ActivePath != "/apps/recipes/keyword/"+kw.Keyword {
			tail = append(tail, kw)
		}
	}
	return tail
}

templ recipesLayout(sb sidebarData) {
	<div class="sidebar-layout">
		@recipesSidebar(sb)
		<div class="sidebar-content">
			{ children... }
		</div>
	</div>
}

templ recipeHeaderActions() {
	<a href="/apps/recipes/import" class="btn">
		@ui.Icon("download")
		Import
	</a>
	<a href="/apps/recipes/new" class="btn btn-primary">
		@ui.Icon("plus")
		New recipe
	</a>
}

templ recipesIndexPage(sb sidebarData, v listView) {
	@recipesLayout(sb) {
		@ui.PageHeader("All recipes", nil) {
			@recipeHeaderActions()
		}
		@recipeList(v)
	}
}

templ recipesCategoryPage(sb sidebarData, category string, v listView) {
	@recipesLayout(sb) {
		@ui.PageHeader(category, []ui.Crumb{{Label: "Recipes", URL: "/apps/recipes/"}}) {
			@recipeHeaderActions()
		}
		@recipeList(v)
	}
}

templ recipesKeywordPage(sb sidebarData, keyword string, v listView) {
	@recipesLayout(sb) {
		@ui.PageHeader("Tagged “"+keyword+"”", []ui.Crumb{{Label: "Recipes", URL: "/apps/recipes/"}}) {
			@recipeHeaderActions()
		}
		@recipeList(v)
	}
}

templ recipeViewPage(sb sidebarData, d *recipeDetail) {
	@recipesLayout(sb) {
		<header class="page-header">
			<div class="page-heading">
				@ancestors(recipeCrumbs(d.Recipe))
				<h1>{ d.Recipe.Name }</h1>
			</div>
			<div class="page-actions">
				<a href={ templ.SafeURL(fmt.Sprintf("/apps/recipes/recipe/%d/edit", d.Recipe.ID)) } class="btn" aria-label={ "Edit " + d.Recipe.Name }>
					@ui.Icon("edit")
					Edit
				</a>
				<button
					type="button"
					class="btn btn-outline-danger"
					aria-label={ "Delete " + d.Recipe.Name }
					hx-delete={ fmt.Sprintf("/apps/recipes/recipes/%d", d.Recipe.ID) }
					hx-confirm={ fmt.Sprintf("Delete “%s”?", d.Recipe.Name) }
				>
					@ui.Icon("trash")
					Delete
				</button>
			</div>
		</header>
		<article class="card">
			if d.Recipe.ImagePath != "" {
				<img class="recipe-hero" src={ imageURL(d.Recipe.ID) } alt=""/>
			}
			if d.Recipe.Description != "" {
				<p class="recipe-description">{ d.Recipe.Description }</p>
			}
			if stats := recipeStats(d.Recipe); len(stats) > 0 {
				<dl class="recipe-stats">
					for _, st := range stats {
						<div>
							<dt>{ st.Label }</dt>
							<dd>{ st.Value }</dd>
						</div>
					}
				</dl>
			}
			if len(d.Keywords) > 0 {
				<div class="chip-group recipe-tags" aria-label="Tags">
					for _, kw := range d.Keywords {
						<a href={ templ.SafeURL("/apps/recipes/keyword/" + url.PathEscape(kw)) } class="chip">{ kw }</a>
					}
				</div>
			}
			if d.Recipe.SourceURL != "" {
				<p class="recipe-source">
					Source:
					<a href={ templ.SafeURL(d.Recipe.SourceURL) } target="_blank" rel="noopener">{ truncateURL(d.Recipe.SourceURL) }</a>
				</p>
			}
			if len(d.Ingredients) == 0 && len(d.Instructions) == 0 {
				<div class="recipe-empty">
					@ui.EmptyState("No ingredients or steps yet", "Add what goes in and how to make it.") {
						<a class="btn btn-primary" href={ templ.SafeURL(fmt.Sprintf("/apps/recipes/recipe/%d/edit", d.Recipe.ID)) }>
							@ui.Icon("edit")
							Add them
						</a>
					}
				</div>
			} else {
				<div class="recipe-body">
					if len(d.Ingredients) > 0 {
						<section>
							<h2 class="recipe-section-title">Ingredients</h2>
							<ul class="recipe-ingredients">
								for _, ing := range d.Ingredients {
									<li>{ ing.Text }</li>
								}
							</ul>
						</section>
					}
					if len(d.Instructions) > 0 {
						<section>
							<h2 class="recipe-section-title">Method</h2>
							<ol class="recipe-steps">
								for _, step := range d.Instructions {
									<li>{ step.Text }</li>
								}
							</ol>
						</section>
					}
				</div>
			}
		</article>
	}
}

// ancestors is a breadcrumb trail of the pages above this one, for a page
// whose own (long) title is the heading right below it.
templ ancestors(crumbs []ui.Crumb) {
	<nav class="breadcrumbs" aria-label="Breadcrumb">
		<ol>
			for _, c := range crumbs {
				<li><a href={ templ.SafeURL(c.URL) }>{ c.Label }</a></li>
			}
		</ol>
	</nav>
}

// recipeCrumbs leads to a recipe: the recipe list, then its category.
func recipeCrumbs(r *Recipe) []ui.Crumb {
	crumbs := []ui.Crumb{{Label: "Recipes", URL: "/apps/recipes/"}}
	if r.Category != "" {
		crumbs = append(crumbs, ui.Crumb{Label: r.Category, URL: "/apps/recipes/category/" + r.Category})
	}
	return crumbs
}

type recipeStat struct {
	Label, Value string
}

// recipeStats is the recipe's at-a-glance facts, in the order a cook wants
// them, leaving out the ones it does not have.
func recipeStats(r *Recipe) []recipeStat {
	var stats []recipeStat
	add := func(label, value string) {
		if value != "" {
			stats = append(stats, recipeStat{label, value})
		}
	}
	add("Prep", formatDuration(r.PrepTime))
	add("Cook", formatDuration(r.CookTime))
	add("Total", formatDuration(r.TotalTime))
	add("Serves", r.RecipeYield)
	add("Calories", r.Calories)
	add("Cuisine", r.Cuisine)
	return stats
}

templ recipeEditPage(sb sidebarData, d *recipeDetail, form recipeForm, csrfToken string) {
	@recipesLayout(sb) {
		@ui.PageHeader("Edit recipe", append(recipeCrumbs(d.Recipe), ui.Crumb{Label: shorten(d.Recipe.Name, 40), URL: fmt.Sprintf("/apps/recipes/recipe/%d", d.Recipe.ID)}))
		<form class="card" method="post" action={ templ.SafeURL(fmt.Sprintf("/apps/recipes/recipes/%d", d.Recipe.ID)) }>
			<input type="hidden" name="csrf_token" value={ csrfToken }/>
			@recipeFields(sb, form)
			<div class="form-actions form-actions-sticky">
				<button class="btn btn-primary" type="submit">Save</button>
				<a href={ templ.SafeURL(fmt.Sprintf("/apps/recipes/recipe/%d", d.Recipe.ID)) } class="btn">Cancel</a>
			</div>
		</form>
	}
}

templ recipeNewPage(sb sidebarData, form recipeForm, csrfToken string) {
	@recipesLayout(sb) {
		@ui.PageHeader("New recipe", []ui.Crumb{{Label: "Recipes", URL: "/apps/recipes/"}})
		<form class="card" method="post" action="/apps/recipes/recipes">
			<input type="hidden" name="csrf_token" value={ csrfToken }/>
			@recipeFields(sb, form)
			<div class="form-actions form-actions-sticky">
				<button class="btn btn-primary" type="submit">Create recipe</button>
				<a href="/apps/recipes/" class="btn">Cancel</a>
			</div>
		</form>
	}
}

// recipeFields is the form shared by the new and edit pages.
templ recipeFields(sb sidebarData, f recipeForm) {
	<div class="form-group">
		<label for="name">Name</label>
		<input class="form-control" type="text" id="name" name="name" value={ f["name"] } placeholder="Chicken tikka masala" required/>
	</div>
	<div class="form-group">
		<label for="description">Description</label>
		<textarea class="form-control recipe-autosize" id="description" name="description" rows="3" placeholder="Optional">{ f["description"] }</textarea>
	</div>
	<div class="form-row">
		<div class="form-group">
			<label for="category">Category</label>
			<input class="form-control" type="text" id="category" name="category" value={ f["category"] } list="categories" placeholder="e.g. Main course"/>
			<datalist id="categories">
				for _, cat := range sb.Categories {
					<option value={ cat.Name }></option>
				}
			</datalist>
		</div>
		<div class="form-group">
			<label for="cuisine">Cuisine</label>
			<input class="form-control" type="text" id="cuisine" name="cuisine" value={ f["cuisine"] } placeholder="e.g. Italian"/>
		</div>
	</div>
	<div class="recipe-times">
		@durationField(f, "prep", "Prep time")
		@durationField(f, "cook", "Cook time")
		@durationField(f, "total", "Total time")
	</div>
	<div class="form-row">
		<div class="form-group">
			<label for="recipe_yield">Serves</label>
			<input class="form-control" type="text" id="recipe_yield" name="recipe_yield" value={ f["recipe_yield"] } placeholder="e.g. 4 servings"/>
		</div>
		<div class="form-group">
			<label for="calories">Calories</label>
			<input class="form-control" type="text" id="calories" name="calories" value={ f["calories"] } placeholder="e.g. 410 kcal per serving"/>
		</div>
	</div>
	<div class="form-group">
		<label for="keywords">Tags</label>
		<input class="form-control" type="text" id="keywords" name="keywords" value={ f["keywords"] } placeholder="dinner, kid friendly, quick"/>
		<p class="form-help">Separate tags with commas.</p>
	</div>
	<div class="form-group">
		<label for="ingredients">Ingredients</label>
		<textarea class="form-control recipe-autosize" id="ingredients" name="ingredients" rows="8" placeholder={ "2 cups flour\n1 cup sugar\n3 eggs" }>{ f["ingredients"] }</textarea>
		<p class="form-help">One ingredient per line.</p>
	</div>
	<div class="form-group">
		<label for="instructions">Method</label>
		<textarea class="form-control recipe-autosize" id="instructions" name="instructions" rows="8" placeholder={ "Heat the oven to 180°C.\nMix the dry ingredients.\nAdd the eggs." }>{ f["instructions"] }</textarea>
		<p class="form-help">One step per line.</p>
	</div>
}

// durationField is a time as hours and minutes. A stored value that is not
// a plain duration travels in a hidden field until the user replaces it.
templ durationField(f recipeForm, name, label string) {
	{{ h, m, raw := f[name+"_h"], f[name+"_m"], f[name+"_raw"] }}
	<fieldset class="form-group">
		<legend>{ label }</legend>
		<div class="recipe-duration-inputs">
			<input class="form-control" type="number" min="0" inputmode="numeric" id={ name + "_h" } name={ name + "_h" } value={ h } aria-label={ label + ", hours" }/>
			<span aria-hidden="true">hr</span>
			<input class="form-control" type="number" min="0" inputmode="numeric" id={ name + "_m" } name={ name + "_m" } value={ m } aria-label={ label + ", minutes" }/>
			<span aria-hidden="true">min</span>
		</div>
		if raw != "" {
			<input type="hidden" name={ name + "_raw" } value={ raw }/>
			<p class="form-help">Imported as “{ raw }”.</p>
		}
	</fieldset>
}

templ recipeImportPage(sb sidebarData, importURL, csrfToken string) {
	@recipesLayout(sb) {
		@ui.PageHeader("Import recipe", []ui.Crumb{{Label: "Recipes", URL: "/apps/recipes/"}})
		<form class="card" method="post" action="/apps/recipes/recipes/import-url">
			<p class="card-desc">
				Paste the address of a recipe page. Most recipe sites describe their recipes in a
				standard format (schema.org), which is read to fill in the recipe and its photo.
			</p>
			<input type="hidden" name="csrf_token" value={ csrfToken }/>
			<div class="form-group">
				<label for="url">Recipe URL</label>
				<input class="form-control" type="url" id="url" name="url" value={ importURL } placeholder="https://www.example.com/recipes/…" required/>
			</div>
			<div class="form-actions">
				<button class="btn btn-primary" type="submit">
					@ui.Icon("download")
					Import
				</button>
				<a href="/apps/recipes/" class="btn">Cancel</a>
			</div>
		</form>
	}
}

// recipeList is the list, or its empty state. Its id is what a row
// delete's out-of-band empty state replaces.
templ recipeList(v listView) {
	<div id="recipe-list">
		if len(v.Recipes) == 0 {
			@recipeListEmpty(v)
		} else {
			<ul class="list">
				for i := range v.Recipes {
					@recipeRow(&v.Recipes[i], v)
				}
			</ul>
		}
	</div>
}

templ recipeListEmpty(v listView) {
	<div class="list">
		switch v.Kind {
			case viewCategory:
				@ui.EmptyState("No recipes in this category", "")
			case viewKeyword:
				@ui.EmptyState("No recipes with this tag", "")
			default:
				@ui.EmptyState("No recipes yet", "Write one down, or import it from a recipe site.")
		}
	</div>
}

templ recipeRow(recipe *Recipe, v listView) {
	<li class="list-row" id={ recipeRowID(recipe.ID) }>
		if recipe.ImagePath != "" {
			<img class="recipe-thumb" src={ imageURL(recipe.ID) } alt="" loading="lazy"/>
		} else {
			<span class="recipe-thumb recipe-thumb-empty" aria-hidden="true">
				@utensilsIcon()
			</span>
		}
		<div class="list-row-main">
			<a class="list-row-title" href={ templ.SafeURL(fmt.Sprintf("/apps/recipes/recipe/%d", recipe.ID)) }>{ recipe.Name }</a>
			if meta := recipeMeta(recipe, v.Kind); meta != "" {
				<div class="list-row-meta">{ meta }</div>
			}
		</div>
		<div class="list-row-actions">
			<button
				type="button"
				class="btn-icon btn-icon-sm btn-icon-danger"
				aria-label={ "Delete " + recipe.Name }
				title="Delete"
				hx-delete={ fmt.Sprintf("/apps/recipes/recipes/%d", recipe.ID) }
				hx-target="closest li"
				hx-swap="outerHTML"
				hx-confirm={ fmt.Sprintf("Delete “%s”?", recipe.Name) }
			>
				@ui.Icon("trash")
			</button>
		</div>
	</li>
}

// rowDeleted answers a row delete: the row is swapped for nothing, the
// sidebar's counts are refreshed, and an emptied list gets its empty state.
templ rowDeleted(sb sidebarData, empty *listView) {
	@recipesSidebar(sb)
	if empty != nil {
		<div id="recipe-list" hx-swap-oob="true">
			@recipeListEmpty(*empty)
		</div>
	}
}

templ utensilsIcon() {
	<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"></path>
		<path d="M7 2v20"></path>
		<path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"></path>
	</svg>
}

// recipeMeta is a list row's second line: time, servings and (outside a
// category's own page) the category.
func recipeMeta(r *Recipe, kind string) string {
	var parts []string
	if r.TotalTime != "" {
		parts = append(parts, formatDuration(r.TotalTime))
	}
	if r.RecipeYield != "" {
		parts = append(parts, r.RecipeYield)
	}
	if r.Category != "" && kind != viewCategory {
		parts = append(parts, r.Category)
	}
	return strings.Join(parts, " · ")
}

func imageURL(id int64) string {
	return fmt.Sprintf("/apps/recipes/api/recipes/%d/image", id)
}

// shorten cuts s to at most n characters, for a breadcrumb.
func shorten(s string, n int) string {
	r := []rune(s)
	if len(r) <= n {
		return s
	}
	return strings.TrimSpace(string(r[:n-1])) + "…"
}

func truncateURL(u string) string {
	u = strings.TrimPrefix(u, "https://")
	u = strings.TrimPrefix(u, "http://")
	u = strings.TrimPrefix(u, "www.")
	return shorten(u, 60)
}

func joinIngredients(ingredients []Ingredient) string {
	var parts []string
	for _, i := range ingredients {
		parts = append(parts, i.Text)
	}
	return strings.Join(parts, "\n")
}

func joinInstructions(instructions []Instruction) string {
	var parts []string
	for _, i := range instructions {
		parts = append(parts, i.Text)
	}
	return strings.Join(parts, "\n")
}
