package gallery

import "git.duckfam.us/jj-software/cog/ui"

templ recentPhotosWidget(media []Media) {
	if len(media) == 0 {
		@ui.WidgetEmpty("No photos yet.", "Upload photos", "/apps/files/")
	} else {
		<div class="gallery-widget-grid">
			for _, m := range media {
				@photoTile(m)
			}
		</div>
	}
}
