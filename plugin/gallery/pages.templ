package gallery

import (
	"database/sql"
	"fmt"
	"net/url"
	"strconv"
	"strings"
	"time"

	"git.duckfam.us/jj-software/cog/ui"
)

// --- Layout ---

// galleryLayout is the frame of every gallery page: the sidebar of views
// and the page beside it.
templ galleryLayout(activePath string) {
	<div class="sidebar-layout">
		@gallerySidebar(activePath)
		<div class="sidebar-content">
			{ children... }
		</div>
	</div>
	@confirmDialog()
	@galleryScripts()
}

templ gallerySidebar(activePath string) {
	<nav class="sidebar" id="gallery-sidebar" aria-label="Gallery">
		@sidebarLink(activePath, "/apps/gallery/", "Timeline")
		@sidebarLink(activePath, "/apps/gallery/starred", "Starred")
		@sidebarLink(activePath, "/apps/gallery/albums", "Albums")
		@sidebarLink(activePath, "/apps/gallery/people", "People")
		@sidebarLink(activePath, "/apps/gallery/tags", "Tags")
		@sidebarLink(activePath, "/apps/gallery/videos", "Videos")
		@sidebarLink(activePath, "/apps/gallery/duplicates", "Duplicates")
		<div class="sidebar-divider"></div>
		@sidebarLink(activePath, "/apps/gallery/settings", "Settings")
		<div
			hx-get="/apps/gallery/api/user-scan-status"
			hx-trigger="load, every 5s"
			hx-swap="innerHTML"
		></div>
	</nav>
}

templ sidebarLink(activePath, href, label string) {
	if sidebarActive(activePath, href) {
		<a href={ templ.SafeURL(href) } class="sidebar-item active" aria-current="page">{ label }</a>
	} else {
		<a href={ templ.SafeURL(href) } class="sidebar-item">{ label }</a>
	}
}

templ userScanBanner(scan ScanStatus) {
	if scan.Running {
		<div class="gallery-scan-banner" role="status">
			<span class="spinner-sm"></span>
			Scanning…
		</div>
	}
}

// sidebarSections maps a detail page to the list it belongs to, so the
// sidebar (and its phone toggle) names the section a person or album is in.
var sidebarSections = map[string]string{
	"/apps/gallery/album/":  "/apps/gallery/albums",
	"/apps/gallery/person/": "/apps/gallery/people",
	"/apps/gallery/tag/":    "/apps/gallery/tags",
	"/apps/gallery/rename/": "/apps/gallery/settings",
}

func sidebarActive(activePath, itemPath string) bool {
	for prefix, section := range sidebarSections {
		if strings.HasPrefix(activePath, prefix) {
			return section == itemPath
		}
	}
	return activePath == itemPath || (itemPath != "/apps/gallery/" && strings.HasPrefix(activePath, itemPath))
}

// --- URLs and labels ---

func photoURL(id int64) string {
	return fmt.Sprintf("/apps/gallery/photo/%d", id)
}

func thumbURL(id int64, size int) string {
	return fmt.Sprintf("/apps/gallery/api/media/%d/thumbnail?size=%d", id, size)
}

func faceThumbURL(id int64) string {
	return fmt.Sprintf("/apps/gallery/api/face/%d/thumbnail", id)
}

// downloadURL is the full-size file behind a media item. The path is query
// escaped: a name with "&", "#", "+" or "%" in it would otherwise cut the
// path short and load nothing.
func downloadURL(m *Media) string {
	return "/api/files/download?path=" + url.QueryEscape(m.FilePath)
}

// takenAt is when a photo was taken, or failing that when it was indexed.
func takenAt(m *Media) time.Time {
	if m.DateTaken != nil {
		return time.Unix(*m.DateTaken, 0).UTC()
	}
	return time.Unix(m.DateIndexed, 0).UTC()
}

// faceTitle is a face's tooltip: who it is, their estimated age, and how sure
// the detector was. The confidence lives here rather than in the text.
func faceTitle(f Face) string {
	name := "Not assigned to anyone"
	if f.PersonID != nil {
		name = "Unnamed person"
	}
	if f.Name != "" {
		name = f.Name
	}
	if f.EstimatedAge >= 0 {
		name += fmt.Sprintf(", about %d", int(f.EstimatedAge+0.5))
	}
	if f.Confidence > 0 && f.Confidence <= 1 {
		name += fmt.Sprintf(" (%.0f%% sure)", f.Confidence*100)
	}
	return name
}

func faceBoxStyle(f Face) string {
	return fmt.Sprintf("left:%.2f%%;top:%.2f%%;width:%.2f%%;height:%.2f%%", f.X*100, f.Y*100, f.W*100, f.H*100)
}

func overlayBoxStyle(o FaceOverlay) string {
	border := "2px solid rgba(255,255,255,0.3)"
	if o.IsCurrentPerson {
		border = "2px solid rgba(59,130,246,0.8)"
	}
	return fmt.Sprintf(
		"position:absolute;left:%s;top:%s;width:%s;height:%s;border:%s;border-radius:2px;pointer-events:none",
		o.Left, o.Top, o.Width, o.Height, border,
	)
}

// photoFrameStyle sizes a photo's frame to the photo's shape, so face boxes
// placed in percentages land on the faces, and caps its height.
func photoFrameStyle(m *Media) string {
	w, h := m.Width, m.Height
	if w <= 0 || h <= 0 {
		w, h = 4, 3
	}
	return fmt.Sprintf("--ar:%d/%d", w, h)
}

func formatDuration(ms *int64) string {
	if ms == nil {
		return ""
	}
	secs := *ms / 1000
	if secs < 60 {
		return fmt.Sprintf("0:%02d", secs)
	}
	return fmt.Sprintf("%d:%02d", secs/60, secs%60)
}

// --- Thumbnails ---

// photoGrid is the shared grid of square thumbnails.
templ photoGrid(media []Media) {
	<div class="gallery-grid">
		for _, m := range media {
			@photoTile(m)
		}
	</div>
}

// photoTile is one square thumbnail. A thumbnail that fails to load (a
// video without a preview, a deleted file) turns into a neutral tile
// instead of a broken image over a shimmer that never stops.
templ photoTile(m Media) {
	<a href={ templ.SafeURL(photoURL(m.ID)) } class="gallery-thumb" title={ m.FileName() }>
		<img src={ thumbURL(m.ID, 256) } alt={ m.FileName() } loading="lazy" onerror="this.parentElement.classList.add('is-missing')"/>
		if m.IsVideo() {
			<span class="gallery-play" aria-hidden="true">
				@playIcon()
			</span>
			if m.DurationMs != nil {
				<span class="gallery-duration">{ formatDuration(m.DurationMs) }</span>
			}
		}
	</a>
}

templ playIcon() {
	<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
		<polygon points="7 4 20 12 7 20 7 4"></polygon>
	</svg>
}

templ chevron(left bool) {
	<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		if left {
			<polyline points="15 18 9 12 15 6"></polyline>
		} else {
			<polyline points="9 18 15 12 9 6"></polyline>
		}
	</svg>
}

// --- Confirmation ---

// confirmDialog replaces window.confirm for any gallery form marked
// data-confirm="Question?" (and optionally data-confirm-action="Delete").
templ confirmDialog() {
	@ui.Modal("gallery-confirm", "Are you sure?") {
		<div class="modal-body">
			<p data-confirm-message></p>
		</div>
		<div class="modal-footer">
			<button type="button" class="btn" data-modal-close>Cancel</button>
			<button type="button" class="btn btn-danger" data-confirm-ok>Delete</button>
		</div>
	}
}

// galleryScripts holds the gallery's behaviour, all by delegation: the
// confirmation dialog, the lightbox, face boxes, keyboard navigation, the
// person name picker and the folder preview's error message.
templ galleryScripts() {
	<script type="text/javascript">
		(function () {
			if (window.galleryReady) return;
			window.galleryReady = true;

			// --- Confirmation dialog -------------------------------------
			var pending = null;
			document.addEventListener("submit", function (e) {
				var form = e.target;
				if (!form.hasAttribute("data-confirm") || form.dataset.confirmed === "1") return;
				var dlg = document.getElementById("gallery-confirm");
				if (!dlg) return;
				e.preventDefault();
				pending = form;
				dlg.querySelector("[data-confirm-message]").textContent = form.getAttribute("data-confirm");
				dlg.querySelector(".modal-title").textContent = form.getAttribute("data-confirm-title") || "Are you sure?";
				dlg.querySelector("[data-confirm-ok]").textContent = form.getAttribute("data-confirm-action") || "Delete";
				cogModal.open(dlg);
			});
			document.addEventListener("click", function (e) {
				if (e.target.closest("[data-confirm-ok]") && pending) {
					var form = pending;
					pending = null;
					form.dataset.confirmed = "1";
					cogModal.close("gallery-confirm");
					if (form.requestSubmit) form.requestSubmit();
					else form.submit();
					return;
				}
				// A menu item that opens a dialog closes its menu.
				if (e.target.closest(".dropdown [data-modal-open]") && window.cog && cog.closeDropdowns) {
					cog.closeDropdowns();
				}
				var faces = e.target.closest("[data-toggle-faces]");
				if (faces) {
					var frame = document.querySelector(".gallery-photo-frame");
					var on = frame.classList.toggle("show-faces");
					faces.setAttribute("aria-pressed", on ? "true" : "false");
					faces.textContent = on ? "Hide faces" : "Show faces";
				}
				if (e.target.closest("[data-lightbox-open]")) openLightbox();
				var lb = e.target.closest(".gallery-lightbox");
				if (lb) {
					if (e.target.closest("[data-lightbox-close]") || e.target === lb || e.target.classList.contains("gallery-lightbox-stage")) {
						lb.close();
					} else if (e.target.matches("[data-lightbox-img]")) {
						lb.classList.toggle("is-zoomed");
					}
				}
			});

			// --- Album tile menus ----------------------------------------
			// A menu that would run off the left edge (a phone's first
			// column) opens rightwards instead.
			function placeTileMenu(dd) {
				dd.classList.remove("is-start");
				if (dd.querySelector(".dropdown-menu").getBoundingClientRect().left < 8) {
					dd.classList.add("is-start");
				}
			}
			document.addEventListener("cog:dropdown-open", function (e) {
				if (e.target.classList && e.target.classList.contains("gallery-tile-menu")) placeTileMenu(e.target);
			});
			window.addEventListener("resize", function () {
				document.querySelectorAll(".gallery-tile-menu.open").forEach(placeTileMenu);
			});

			// --- Lightbox -------------------------------------------------
			// The full-size image loads only when the lightbox opens. Moving
			// to the next photo keeps the lightbox open (#view).
			function openLightbox() {
				var lb = document.getElementById("gallery-lightbox");
				if (!lb) return;
				var img = lb.querySelector("[data-lightbox-img]");
				if (!img.getAttribute("src")) img.setAttribute("src", img.getAttribute("data-src"));
				lb.showModal();
			}
			function stepPhoto(dir) {
				var link = document.querySelector("a[data-photo-nav=" + dir + "]");
				if (!link) return false;
				var lb = document.getElementById("gallery-lightbox");
				window.location.href = link.getAttribute("href") + (lb && lb.open ? "#view" : "");
				return true;
			}
			document.addEventListener("keydown", function (e) {
				if (e.altKey || e.ctrlKey || e.metaKey) return;
				if (e.target.closest && e.target.closest("input, textarea, select, [contenteditable]")) return;
				var open = document.querySelector("dialog[open]");
				if (open && !open.classList.contains("gallery-lightbox")) return;
				if (e.key === "ArrowLeft" && stepPhoto("newer")) e.preventDefault();
				if (e.key === "ArrowRight" && stepPhoto("older")) e.preventDefault();
			});
			var touchX = null;
			document.addEventListener("touchstart", function (e) {
				touchX = e.target.closest(".gallery-lightbox") ? e.touches[0].clientX : null;
			}, { passive: true });
			document.addEventListener("touchend", function (e) {
				if (touchX === null) return;
				var dx = e.changedTouches[0].clientX - touchX;
				touchX = null;
				if (Math.abs(dx) > 60) stepPhoto(dx > 0 ? "newer" : "older");
			}, { passive: true });
			document.addEventListener("DOMContentLoaded", function () {
				if (window.location.hash === "#view") openLightbox();
			});

			// --- Folder preview -------------------------------------------
			document.addEventListener("htmx:beforeRequest", function (e) {
				var err = e.target.closest("form") && e.target.closest("form").querySelector("[data-preview-error]");
				if (err) err.hidden = true;
			});
			document.addEventListener("htmx:responseError", function (e) {
				var err = e.target.closest("form") && e.target.closest("form").querySelector("[data-preview-error]");
				if (err) err.hidden = false;
			});
			document.addEventListener("htmx:sendError", function (e) {
				var err = e.target.closest("form") && e.target.closest("form").querySelector("[data-preview-error]");
				if (err) err.hidden = false;
			});

			// --- Person name picker ---------------------------------------
			// Choosing a suggestion merges into that person or links that
			// contact; typing a name by hand clears the choice.
			document.addEventListener("click", function (e) {
				var form = e.target.closest("[data-person-form]");
				document.querySelectorAll("[data-person-form] .picker-results").forEach(function (res) {
					if (!form || !form.contains(res)) res.innerHTML = "";
				});
				var opt = e.target.closest("[data-person-form] .picker-option");
				if (!opt) return;
				var id = opt.dataset.id;
				var merge = form.querySelector("[data-merge-target]");
				var contact = form.querySelector("[data-contact-target]");
				if (id.indexOf("contact:") === 0) {
					contact.value = id.substring(8);
					merge.value = "";
				} else {
					merge.value = id;
					contact.value = "";
				}
				form.querySelector("[data-person-name]").value = opt.dataset.name;
				form.querySelector(".picker-results").innerHTML = "";
			});
			document.addEventListener("input", function (e) {
				if (!e.target.matches("[data-person-name]")) return;
				var form = e.target.closest("[data-person-form]");
				form.querySelector("[data-merge-target]").value = "";
				form.querySelector("[data-contact-target]").value = "";
			});
			document.addEventListener("keydown", function (e) {
				if (!e.target.matches || !e.target.matches("[data-person-name]")) return;
				var results = e.target.closest("[data-person-form]").querySelector(".picker-results");
				var opts = results.querySelectorAll(".picker-option");
				if (!opts.length) return;
				var cur = results.querySelector(".picker-option.active");
				var idx = cur ? Array.prototype.indexOf.call(opts, cur) : -1;
				if (e.key === "ArrowDown" || e.key === "ArrowUp") {
					e.preventDefault();
					if (cur) cur.classList.remove("active");
					idx = e.key === "ArrowDown" ? (idx + 1) % opts.length : idx <= 0 ? opts.length - 1 : idx - 1;
					opts[idx].classList.add("active");
				} else if (e.key === "Enter" && cur) {
					e.preventDefault();
					cur.click();
				} else if (e.key === "Escape") {
					e.stopPropagation();
					results.innerHTML = "";
				}
			});
		})();
	</script>
}

// --- Timeline ---
templ timelinePage(activePath string, v timelineView) {
	@galleryLayout(activePath) {
		@ui.PageHeader("Timeline", nil)
		if len(v.Days) == 0 && v.Newer == 0 {
			<div class="card">
				@ui.EmptyState("No photos yet", "Photos and videos you upload to Files show up here once the gallery has scanned them.") {
					<a class="btn btn-primary" href="/apps/files/">Upload photos</a>
					<a class="btn" href="/apps/gallery/settings">Choose folders</a>
				}
			</div>
		} else {
			<div class="gallery-timeline" data-timeline>
				if v.Newer != 0 {
					@timelineMore("after", v.Newer)
				}
				@timelineDays(v.Days)
				if v.Older != 0 {
					@timelineMore("before", v.Older)
				}
			</div>
			@timelineScrubber(scrubMarks(v.Months))
			@timelineScript()
		}
	}
}

// timelineOlderPage is a run of days loaded below the timeline, ending with
// the marker for the run after it.
templ timelineOlderPage(days []photoDay, older int64) {
	@timelineDays(days)
	if older != 0 {
		@timelineMore("before", older)
	}
}

// timelineNewerPage is a run of days loaded above the timeline, starting
// with the marker for the run before it.
templ timelineNewerPage(newer int64, days []photoDay) {
	if newer != 0 {
		@timelineMore("after", newer)
	}
	@timelineDays(days)
}

templ timelineDays(days []photoDay) {
	for _, d := range days {
		<section class="gallery-day" data-month={ d.Month }>
			<h2 class="gallery-day-title">{ d.Label }</h2>
			@photoGrid(d.Media)
		</section>
	}
}

// timelineMore marks where more of the timeline loads, when it comes near
// the screen. dir is the query parameter: "before" loads older photos,
// "after" newer ones.
templ timelineMore(dir string, cursor int64) {
	<div class="gallery-timeline-more" data-timeline-more={ dir } data-src={ fmt.Sprintf("/apps/gallery/api/timeline/page?%s=%d", dir, cursor) } role="status">
		<span class="spinner-sm"></span>
		<span class="sr-only">Loading photos…</span>
	</div>
}

// timelineScrubber is the rail at the side of the timeline: a tick for every
// month, spaced by how many photos it holds, with the month being looked at
// labelled. A month links to the timeline starting there.
templ timelineScrubber(marks []scrubMark) {
	<nav class="gallery-scrubber" aria-label="Months" data-scrubber>
		for _, m := range marks {
			if m.Year != "" {
				<span class="gallery-scrubber-year" style={ m.yearStyle() } aria-hidden="true">{ m.Year }</span>
			}
			<a
				class="gallery-scrubber-month"
				href={ templ.SafeURL(m.Href) }
				style={ m.style() }
				data-month={ m.Key }
				aria-label={ m.Label }
			></a>
		}
		<span class="gallery-scrubber-current" data-scrubber-current hidden></span>
	</nav>
}

templ timelineScript() {
	<script type="text/javascript">
		(function () {
			var timeline = document.querySelector("[data-timeline]");
			if (!timeline) return;

			// --- Infinite scroll ------------------------------------------
			// A marker loads its run of days once it is within a screen or
			// two of the viewport. Days loaded above keep the photos being
			// looked at where they are: the page scrolls by what was added
			// (the timeline opts out of the browser's scroll anchoring, so
			// the two do not both apply).
			var observer = new IntersectionObserver(function (entries) {
				entries.forEach(function (e) {
					if (e.isIntersecting) load(e.target);
				});
			}, { rootMargin: "1500px 0px" });
			function watch(root) {
				if (root.matches && root.matches("[data-timeline-more]")) observer.observe(root);
				root.querySelectorAll("[data-timeline-more]").forEach(function (el) { observer.observe(el); });
			}
			function load(el) {
				if (el.dataset.loading) return;
				el.dataset.loading = "1";
				observer.unobserve(el);
				fetch(el.dataset.src, { credentials: "same-origin" }).then(function (res) {
					if (!res.ok) throw new Error(el.dataset.src + ": " + res.status + " " + res.statusText);
					return res.text();
				}).then(function (html) {
					var tpl = document.createElement("template");
					tpl.innerHTML = html;
					var nodes = Array.prototype.slice.call(tpl.content.children);
					var height = document.documentElement.scrollHeight;
					el.replaceWith(tpl.content);
					if (el.dataset.timelineMore === "after") {
						window.scrollBy(0, document.documentElement.scrollHeight - height);
					}
					nodes.forEach(watch);
					sections = null;
					update();
				}).catch(function (err) {
					console.error("gallery timeline:", err);
					delete el.dataset.loading;
					el.textContent = "Couldn’t load more photos. ";
					var retry = document.createElement("button");
					retry.type = "button";
					retry.className = "btn btn-sm";
					retry.textContent = "Try again";
					retry.addEventListener("click", function () {
						el.innerHTML = '<span class="spinner-sm"></span>';
						load(el);
					});
					el.appendChild(retry);
				});
			}
			// A page that starts partway down the timeline (a month picked on
			// the scrubber) opens with that month at the top, so the days
			// that load above it stay out of view.
			var first = timeline.querySelector(".gallery-day");
			if (first && timeline.querySelector('[data-timeline-more="after"]')) {
				window.scrollTo(0, first.getBoundingClientRect().top + window.scrollY);
			}
			watch(timeline);

			// --- Scrubber --------------------------------------------------
			// The month of the day at the top of the screen is the one
			// labelled. Days are in order, so a binary search finds it.
			var scrubber = document.querySelector("[data-scrubber]");
			var current = scrubber.querySelector("[data-scrubber-current]");
			var sections = null, active = null, ticking = false, drag = null, dragged = false;
			function update() {
				ticking = false;
				if (drag) return;
				sections = sections || timeline.querySelectorAll(".gallery-day");
				var line = 80, lo = 0, hi = sections.length - 1, found = 0;
				while (lo <= hi) {
					var mid = (lo + hi) >> 1;
					if (sections[mid].getBoundingClientRect().top <= line) {
						found = mid;
						lo = mid + 1;
					} else {
						hi = mid - 1;
					}
				}
				var sec = sections[found];
				var tick = sec ? scrubber.querySelector('[data-month="' + sec.dataset.month + '"]') : null;
				if (tick === active) return;
				if (active) active.classList.remove("is-active");
				active = tick;
				current.hidden = !tick;
				if (!tick) return;
				tick.classList.add("is-active");
				current.textContent = tick.getAttribute("aria-label");
				current.style.top = tick.style.top;
			}
			// Phones show the label only while scrolling (see the CSS).
			var idle = 0;
			window.addEventListener("scroll", function () {
				scrubber.classList.add("is-scrolling");
				clearTimeout(idle);
				idle = setTimeout(function () { scrubber.classList.remove("is-scrolling"); }, 1500);
				if (ticking) return;
				ticking = true;
				requestAnimationFrame(update);
			}, { passive: true });
			update();

			// Dragging the rail works like a scrollbar. The point under the
			// pointer names a month and how far through it (each month spans
			// its share of the rail); a month on the page scrolls there as the
			// pointer moves, and letting go over any other opens the timeline
			// at it.
			var ticks = scrubber.querySelectorAll(".gallery-scrubber-month");
			function at(y) {
				var tick = ticks[0];
				for (var i = 1; i < ticks.length && ticks[i].getBoundingClientRect().top <= y; i++) tick = ticks[i];
				var r = tick.getBoundingClientRect();
				return { tick: tick, f: r.height > 0 ? Math.min(1, Math.max(0, (y - r.top) / r.height)) : 0 };
			}
			// seek scrolls to the point f of the way through a month's loaded
			// days, and reports whether the month is on the page.
			function seek(tick, f) {
				var secs = timeline.querySelectorAll('.gallery-day[data-month="' + tick.dataset.month + '"]');
				if (!secs.length) return false;
				var top = secs[0].getBoundingClientRect().top;
				var end = secs[secs.length - 1].getBoundingClientRect().bottom;
				window.scrollTo({ top: top + f * (end - top) + window.scrollY });
				return true;
			}
			function show(p, y) {
				if (active) active.classList.remove("is-active");
				active = p.tick;
				active.classList.add("is-active");
				current.hidden = false;
				current.textContent = p.tick.getAttribute("aria-label");
				current.style.top = (y - scrubber.getBoundingClientRect().top) + "px";
			}
			function move(e) {
				var p = at(e.clientY);
				show(p, e.clientY);
				drag = p;
				seek(p.tick, p.f);
			}
			scrubber.addEventListener("pointerdown", function (e) {
				if (e.button !== 0 || !ticks.length) return;
				e.preventDefault();
				scrubber.setPointerCapture(e.pointerId);
				scrubber.classList.add("is-dragging");
				move(e);
			});
			scrubber.addEventListener("pointermove", function (e) {
				if (drag) move(e);
			});
			function release(cancelled) {
				if (!drag) return;
				var p = drag;
				drag = null;
				// The click that follows comes in the same task.
				dragged = true;
				setTimeout(function () { dragged = false; }, 0);
				scrubber.classList.remove("is-dragging");
				if (!cancelled && !seek(p.tick, p.f)) {
					window.location.href = p.tick.href;
					return;
				}
				active = null;
				update();
			}
			scrubber.addEventListener("pointerup", function (e) { release(false); });
			scrubber.addEventListener("pointercancel", function (e) { release(true); });
			// The click that ends a drag has been handled; a click from the
			// keyboard scrolls to a month on the page or follows the link.
			scrubber.addEventListener("click", function (e) {
				if (dragged) {
					e.preventDefault();
					return;
				}
				var tick = e.target.closest(".gallery-scrubber-month");
				if (tick && seek(tick, 0)) e.preventDefault();
			});
		})();
	</script>
}

// --- Albums ---
templ albumsPage(activePath string, albums []Album, shared []SharedAlbum, csrfToken string) {
	@galleryLayout(activePath) {
		@ui.PageHeader("Albums", nil) {
			<button type="button" class="btn btn-primary" data-modal-open="gallery-new-album">
				@ui.Icon("plus")
				New album
			</button>
		}
		if len(albums) == 0 {
			<div class="card">
				@ui.EmptyState("No albums yet", "Collect photos into an album to keep a trip or an event together.")
			</div>
		} else {
			<div class="gallery-albums">
				for _, a := range albums {
					@albumCard(&a, fmt.Sprintf("/apps/gallery/album/%d", a.ID), coverThumb(&a, ""), "")
				}
			</div>
		}
		if len(shared) > 0 {
			<h2 class="gallery-day-title">Shared with you</h2>
			<div class="gallery-albums">
				for _, a := range shared {
					@albumCard(&a.Album, sharedAlbumURL(a.Owner, a.ID), coverThumb(&a.Album, a.Owner), "From "+a.Owner)
				}
			</div>
		}
		@ui.Modal("gallery-new-album", "New album") {
			<form method="post" action="/apps/gallery/albums">
				<input type="hidden" name="csrf_token" value={ csrfToken }/>
				@albumFields("new-album", "", "")
				<div class="modal-footer">
					<button type="button" class="btn" data-modal-close>Cancel</button>
					<button type="submit" class="btn btn-primary">Create album</button>
				</div>
			</form>
		}
	}
}

// coverThumb is an album's cover thumbnail, from the owner's gallery when
// the album is shared, or "" when the album is empty.
func coverThumb(a *Album, owner string) string {
	if a.CoverMediaID == nil {
		return ""
	}
	if owner != "" {
		return sharedThumbURL(owner, a.ID, *a.CoverMediaID, 256)
	}
	return thumbURL(*a.CoverMediaID, 256)
}

templ albumCard(a *Album, href, cover, from string) {
	<a href={ templ.SafeURL(href) } class="gallery-album">
		if cover != "" {
			<span class="gallery-thumb">
				<img src={ cover } alt="" loading="lazy" onerror="this.parentElement.classList.add('is-missing')"/>
			</span>
		} else {
			<span class="gallery-thumb is-empty"></span>
		}
		<span class="gallery-album-name">{ a.Name }</span>
		<span class="gallery-album-meta">
			{ plural(a.MediaCount, "item", "items") }
			if a.AlbumType > 0 {
				{ " · " + a.AlbumTypeName() }
			}
			if from != "" {
				{ " · " + from }
			}
		</span>
	</a>
}

templ sharedAlbumPage(activePath string, album SharedAlbum, media []Media) {
	@galleryLayout(activePath) {
		@ui.PageHeader(album.Name, []ui.Crumb{{Label: "Albums", URL: "/apps/gallery/albums"}}) {
			<span class="badge badge-outline">{ "Shared by " + album.Owner }</span>
			<a class="btn" href={ templ.SafeURL("/apps/files/shared/" + url.PathEscape(album.Owner) + "/" + url.PathEscape(album.Name)) }>Add to my files</a>
		}
		if album.Description != "" {
			<p class="gallery-description">{ album.Description }</p>
		}
		if len(media) == 0 {
			<div class="card">
				@ui.EmptyState("This album is empty", "Nothing has been added to it yet.")
			</div>
		} else {
			<div class="gallery-grid">
				for _, m := range media {
					<a href={ templ.SafeURL(sharedThumbURL(album.Owner, album.ID, m.ID, 1024)) } class="gallery-thumb" title={ m.FileName() } target="_blank">
						<img src={ sharedThumbURL(album.Owner, album.ID, m.ID, 256) } alt={ m.FileName() } loading="lazy" onerror="this.parentElement.classList.add('is-missing')"/>
						if m.IsVideo() {
							<span class="gallery-play" aria-hidden="true">
								@playIcon()
							</span>
							if m.DurationMs != nil {
								<span class="gallery-duration">{ formatDuration(m.DurationMs) }</span>
							}
						}
					</a>
				}
			</div>
		}
	}
}

templ albumFields(idPrefix, name, description string) {
	<div class="modal-body">
		<div class="form-group">
			<label for={ idPrefix + "-name" }>Name</label>
			<input class="form-control" type="text" id={ idPrefix + "-name" } name="name" value={ name } required autocomplete="off"/>
		</div>
		<div class="form-group mb-0">
			<label for={ idPrefix + "-description" }>Description <span class="text-muted">(optional)</span></label>
			<textarea class="form-control" id={ idPrefix + "-description" } name="description" rows="3">{ description }</textarea>
		</div>
		{ children... }
	</div>
}

templ albumViewPage(activePath string, album *Album, media []Media, candidates []Media, uploads albumUploads, csrfToken string) {
	@galleryLayout(activePath) {
		@ui.PageHeader(album.Name, []ui.Crumb{{Label: "Albums", URL: "/apps/gallery/albums"}}) {
			if album.AlbumType == AlbumManual {
				<button type="button" class="btn btn-primary" data-modal-open="gallery-add-photos">
					@ui.Icon("plus")
					Add photos
				</button>
				<cog-share-button resource="album" resource-id={ strconv.FormatInt(album.ID, 10) } share-title={ album.Name } btn-class="btn">Share</cog-share-button>
				<div class="dropdown">
					<button type="button" class="btn btn-square" data-dropdown-toggle aria-expanded="false" aria-controls="album-menu" aria-label="More album actions">
						@ui.Icon("more")
					</button>
					<div class="dropdown-menu" id="album-menu">
						<button type="button" data-modal-open="gallery-rename-album">
							@ui.Icon("edit")
							Rename
						</button>
						<button type="button" class="danger" data-modal-open="gallery-delete-album">
							@ui.Icon("trash")
							Delete album
						</button>
					</div>
				</div>
			} else {
				<span class="badge badge-outline">{ album.AlbumTypeName() + " album" }</span>
			}
		}
		if album.Description != "" {
			<p class="gallery-description">{ album.Description }</p>
		}
		if len(media) == 0 {
			<div class="card">
				@ui.EmptyState("This album is empty", "Add photos from your gallery to fill it.")
			</div>
		} else {
			<div class="gallery-grid">
				for _, m := range media {
					@albumTile(album, m, csrfToken)
				}
			</div>
		}
		if album.AlbumType == AlbumManual {
			@ui.Modal("gallery-add-photos", "Add photos to “"+album.Name+"”") {
				<form method="post" action={ templ.SafeURL(fmt.Sprintf("/apps/gallery/albums/%d/add", album.ID)) }>
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					<div class="modal-body">
						if len(candidates) == 0 {
							<p class="empty-state empty-state-sm">Every recent photo is already in this album.</p>
						} else {
							<div class="gallery-grid gallery-pick-grid">
								for _, m := range candidates {
									<label class="gallery-thumb gallery-pick" title={ m.FileName() }>
										<input type="checkbox" name="media_id" value={ strconv.FormatInt(m.ID, 10) } aria-label={ m.FileName() }/>
										<img src={ thumbURL(m.ID, 256) } alt="" loading="lazy" onerror="this.parentElement.classList.add('is-missing')"/>
									</label>
								}
							</div>
						}
					</div>
					<div class="modal-footer">
						<button type="button" class="btn" data-modal-close>Cancel</button>
						<button type="submit" class="btn btn-primary" disabled?={ len(candidates) == 0 }>Add selected</button>
					</div>
				</form>
			}
			@ui.Modal("gallery-rename-album", "Rename album") {
				<form method="post" action={ templ.SafeURL(fmt.Sprintf("/apps/gallery/albums/%d/rename", album.ID)) }>
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					@albumFields("rename-album", album.Name, album.Description) {
						<div class="form-group mb-0 mt-2">
							<label for="rename-album-upload-folder">Folder for photos added by others <span class="text-muted">(optional)</span></label>
							<input class="form-control" type="text" id="rename-album-upload-folder" name="upload_folder" value={ uploads.Folder } placeholder={ uploads.Default } autocomplete="off" aria-describedby="rename-album-upload-folder-help"/>
							<p class="form-help" id="rename-album-upload-folder-help">{ "When you share the album with permission to edit, the photos people add go here in your files. Leave it empty to use " + uploads.Default + "." }</p>
						</div>
					}
					<div class="modal-footer">
						<button type="button" class="btn" data-modal-close>Cancel</button>
						<button type="submit" class="btn btn-primary">Save</button>
					</div>
				</form>
			}
			@ui.Modal("gallery-delete-album", "Delete album") {
				<form method="post" action={ templ.SafeURL(fmt.Sprintf("/apps/gallery/albums/%d/delete", album.ID)) }>
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					<div class="modal-body">
						<p>{ "Delete the album “" + album.Name + "”?" }</p>
						<p class="form-help">Its photos stay in your gallery and in Files.</p>
					</div>
					<div class="modal-footer">
						<button type="button" class="btn" data-modal-close>Cancel</button>
						<button type="submit" class="btn btn-danger">Delete album</button>
					</div>
				</form>
			}
		}
	}
}

// albumTile is a photo in an album: its thumbnail, a "Cover" mark on the
// one the album shows, and a menu in the corner to make it the cover or
// (in a manual album) take it out.
templ albumTile(album *Album, m Media, csrfToken string) {
	<div class="gallery-tile">
		@photoTile(m)
		if isAlbumCover(album, m.ID) {
			<span class="gallery-cover-badge">Cover</span>
		}
		if !isAlbumCover(album, m.ID) || album.AlbumType == AlbumManual {
			<div class="dropdown gallery-tile-action gallery-tile-menu">
				<button
					type="button"
					class="gallery-tile-button"
					data-dropdown-toggle
					aria-expanded="false"
					aria-controls={ fmt.Sprintf("album-photo-%d-menu", m.ID) }
					aria-label={ "Actions for " + m.FileName() }
					title="Actions"
				>
					@ui.Icon("more")
				</button>
				<div class="dropdown-menu" id={ fmt.Sprintf("album-photo-%d-menu", m.ID) }>
					if !isAlbumCover(album, m.ID) {
						<form method="post" action={ templ.SafeURL(fmt.Sprintf("/apps/gallery/albums/%d/cover", album.ID)) }>
							<input type="hidden" name="csrf_token" value={ csrfToken }/>
							<input type="hidden" name="media_id" value={ strconv.FormatInt(m.ID, 10) }/>
							<button type="submit" data-set-cover>
								@coverIcon()
								Set as album cover
							</button>
						</form>
					}
					if album.AlbumType == AlbumManual {
						if !isAlbumCover(album, m.ID) {
							<div class="dropdown-divider"></div>
						}
						<form
							method="post"
							action={ templ.SafeURL(fmt.Sprintf("/apps/gallery/albums/%d/remove", album.ID)) }
							data-confirm={ "Remove “" + m.FileName() + "” from “" + album.Name + "”? It stays in your gallery." }
							data-confirm-title="Remove from album"
							data-confirm-action="Remove"
						>
							<input type="hidden" name="csrf_token" value={ csrfToken }/>
							<input type="hidden" name="media_id" value={ strconv.FormatInt(m.ID, 10) }/>
							<button type="submit" class="danger">
								@ui.Icon("x")
								Remove from album
							</button>
						</form>
					}
				</div>
			</div>
		}
	</div>
}

// isAlbumCover reports whether the album shows this photo as its cover: the
// one chosen, or its first photo when none is.
func isAlbumCover(album *Album, mediaID int64) bool {
	return album.CoverMediaID != nil && *album.CoverMediaID == mediaID
}

templ coverIcon() {
	<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
		<circle cx="8.5" cy="8.5" r="1.5"></circle>
		<polyline points="21 15 16 10 5 21"></polyline>
	</svg>
}

// --- Photo ---

// photoView is everything the photo page shows.
type photoView struct {
	Media    *Media
	Tags     []Tag
	Faces    []Face
	Albums   []Album // manual albums, for "Add to album"
	Newer    int64   // the photo before this one in the timeline, or 0
	Older    int64   // the photo after it, or 0
	Favorite bool
}

// photoViewPage leaves out the gallery sidebar so the photo gets the width;
// the breadcrumb leads back.
templ photoViewPage(v photoView, csrfToken string) {
	@ui.PageHeader(v.Media.FileName(), []ui.Crumb{{Label: "Gallery", URL: "/apps/gallery/"}}) {
		@ui.Star(v.Favorite, fmt.Sprintf("/apps/gallery/media/%d/star", v.Media.ID))
		<a class="btn" href={ templ.SafeURL(downloadURL(v.Media)) } download={ v.Media.FileName() }>
			@ui.Icon("download")
			Download
		</a>
		<div class="dropdown">
			<button type="button" class="btn" data-dropdown-toggle aria-expanded="false" aria-controls="add-to-album-menu">
				@ui.Icon("plus")
				Add to album
			</button>
			<div class="dropdown-menu" id="add-to-album-menu">
				for _, a := range v.Albums {
					<form method="post" action={ templ.SafeURL(fmt.Sprintf("/apps/gallery/albums/%d/add", a.ID)) }>
						<input type="hidden" name="csrf_token" value={ csrfToken }/>
						<input type="hidden" name="media_id" value={ strconv.FormatInt(v.Media.ID, 10) }/>
						<input type="hidden" name="return" value={ photoURL(v.Media.ID) }/>
						<button type="submit">{ a.Name }</button>
					</form>
				}
				if len(v.Albums) > 0 {
					<div class="dropdown-divider"></div>
				}
				<a href="/apps/gallery/albums">
					@ui.Icon("plus")
					New album…
				</a>
			</div>
		</div>
		<form method="post" action={ templ.SafeURL(fmt.Sprintf("/apps/gallery/media/%d/delete", v.Media.ID)) } data-confirm={ "Move “" + v.Media.FileName() + "” to the trash? It leaves the gallery and every album." } data-confirm-title="Delete photo">
			<input type="hidden" name="csrf_token" value={ csrfToken }/>
			<button type="submit" class="btn btn-outline-danger">
				@ui.Icon("trash")
				Delete
			</button>
		</form>
	}
	<div class="gallery-photo-layout">
		<div class="gallery-photo-main">
			if v.Media.IsVideo() {
				<video class="gallery-video" controls preload="metadata">
					<source src={ downloadURL(v.Media) } type={ v.Media.MimeType }/>
				</video>
			} else {
				<div class="gallery-photo-frame" style={ photoFrameStyle(v.Media) }>
					<button type="button" class="gallery-photo-open" data-lightbox-open aria-label="View full size">
						<img src={ thumbURL(v.Media.ID, 1024) } alt={ v.Media.FileName() }/>
					</button>
					for _, f := range v.Faces {
						if f.PersonID != nil {
							<a
								href={ templ.SafeURL(fmt.Sprintf("/apps/gallery/person/%d", *f.PersonID)) }
								class="face-box"
								title={ faceTitle(f) }
								style={ faceBoxStyle(f) }
								tabindex="-1"
							></a>
						} else {
							<span class="face-box" title={ faceTitle(f) } style={ faceBoxStyle(f) }></span>
						}
					}
				</div>
			}
			<div class="gallery-photo-toolbar">
				if v.Newer != 0 {
					<a class="btn btn-sm" href={ templ.SafeURL(photoURL(v.Newer)) } data-photo-nav="newer" title="Newer photo (←)">
						@chevron(true)
						Newer
					</a>
				} else {
					<span class="btn btn-sm" aria-disabled="true">
						@chevron(true)
						Newer
					</span>
				}
				if len(v.Faces) > 0 && !v.Media.IsVideo() {
					<button type="button" class="btn btn-sm btn-ghost" data-toggle-faces aria-pressed="false">Show faces</button>
				}
				if v.Older != 0 {
					<a class="btn btn-sm" href={ templ.SafeURL(photoURL(v.Older)) } data-photo-nav="older" title="Older photo (→)">
						Older
						@chevron(false)
					</a>
				} else {
					<span class="btn btn-sm" aria-disabled="true">
						Older
						@chevron(false)
					</span>
				}
			</div>
		</div>
		<div class="gallery-photo-side">
			@ui.Card("Details") {
				<dl class="gallery-meta">
					<dt>File</dt>
					<dd>{ v.Media.FileName() }</dd>
					<dt>Size</dt>
					<dd>{ strconv.Itoa(v.Media.Width) } × { strconv.Itoa(v.Media.Height) }</dd>
					if v.Media.DateTaken != nil {
						<dt>Taken</dt>
						<dd>{ time.Unix(*v.Media.DateTaken, 0).UTC().Format("Jan 2, 2006 3:04 PM") }</dd>
					}
					if v.Media.CameraModel != "" {
						<dt>Camera</dt>
						<dd>{ strings.TrimSpace(v.Media.CameraMake + " " + v.Media.CameraModel) }</dd>
					}
					if v.Media.LensModel != "" {
						<dt>Lens</dt>
						<dd>{ v.Media.LensModel }</dd>
					}
					if v.Media.FNumber != nil {
						<dt>Aperture</dt>
						<dd>f/{ fmt.Sprintf("%.1f", *v.Media.FNumber) }</dd>
					}
					if v.Media.ExposureTime != "" {
						<dt>Shutter</dt>
						<dd>{ v.Media.ExposureTime }</dd>
					}
					if v.Media.ISO != nil {
						<dt>ISO</dt>
						<dd>{ strconv.Itoa(*v.Media.ISO) }</dd>
					}
					if v.Media.FocalLength != nil {
						<dt>Focal length</dt>
						<dd>{ fmt.Sprintf("%.0f mm", *v.Media.FocalLength) }</dd>
					}
					if v.Media.PlaceName != "" {
						<dt>Location</dt>
						<dd>{ v.Media.PlaceName }</dd>
					}
					if v.Media.IsVideo() && v.Media.DurationMs != nil {
						<dt>Duration</dt>
						<dd>{ formatDuration(v.Media.DurationMs) }</dd>
						if v.Media.VideoCodec != "" {
							<dt>Codec</dt>
							<dd>{ v.Media.VideoCodec }</dd>
						}
					}
					if v.Media.Fingerprint != "" && v.Media.Fingerprint != "-" {
						<dt>Fingerprint</dt>
						<dd><code>{ v.Media.Fingerprint }</code></dd>
					}
				</dl>
			}
			@ui.Card("Tags") {
				if len(v.Tags) > 0 {
					<ul class="chip-group gallery-tag-list">
						for _, t := range v.Tags {
							<li class="chip">
								<a href={ templ.SafeURL("/apps/gallery/tag/" + url.PathEscape(t.Name)) }>{ t.Name }</a>
								<form method="post" action={ templ.SafeURL(fmt.Sprintf("/apps/gallery/media/%d/remove-tag", v.Media.ID)) }>
									<input type="hidden" name="csrf_token" value={ csrfToken }/>
									<input type="hidden" name="tag_id" value={ strconv.FormatInt(t.ID, 10) }/>
									<button type="submit" class="chip-remove" aria-label={ "Remove tag " + t.Name } title="Remove tag">
										@ui.Icon("x")
									</button>
								</form>
							</li>
						}
					</ul>
				}
				<form class="gallery-tag-form" method="post" action={ templ.SafeURL(fmt.Sprintf("/apps/gallery/media/%d/tags", v.Media.ID)) }>
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					<label class="sr-only" for="gallery-add-tag">Add a tag</label>
					<input type="text" id="gallery-add-tag" name="tag_name" placeholder="Add a tag…" class="form-control form-control-sm" required autocomplete="off"/>
					<button type="submit" class="btn btn-sm">Add</button>
				</form>
			}
			@ui.Card("Faces") {
				if len(v.Faces) > 0 {
					<ul class="gallery-face-list">
						for _, f := range v.Faces {
							<li>
								<img class="avatar-md" src={ faceThumbURL(f.ID) } alt="" loading="lazy"/>
								<div class="gallery-face-label" title={ faceTitle(f) }>
									if f.PersonID != nil && f.Name != "" {
										<a href={ templ.SafeURL(fmt.Sprintf("/apps/gallery/person/%d", *f.PersonID)) }>{ f.Name }</a>
									} else if f.PersonID != nil {
										<a class="gallery-unnamed" href={ templ.SafeURL(fmt.Sprintf("/apps/gallery/person/%d", *f.PersonID)) }>Unnamed person</a>
									} else {
										<span class="gallery-unnamed">Not assigned</span>
										<form method="post" action={ templ.SafeURL(fmt.Sprintf("/apps/gallery/faces/%d/new-person", f.ID)) }>
											<input type="hidden" name="csrf_token" value={ csrfToken }/>
											<button type="submit" class="btn-link gallery-inline-action">Create person</button>
										</form>
									}
									if f.EstimatedAge >= 0 {
										<div class="text-xs text-muted">{ fmt.Sprintf("About %d years old", int(f.EstimatedAge+0.5)) }</div>
									}
								</div>
								<form method="post" action={ templ.SafeURL(fmt.Sprintf("/apps/gallery/media/%d/delete-face", v.Media.ID)) } data-confirm="Remove this face from the photo? The photo itself is kept." data-confirm-title="Remove face" data-confirm-action="Remove">
									<input type="hidden" name="csrf_token" value={ csrfToken }/>
									<input type="hidden" name="face_id" value={ strconv.FormatInt(f.ID, 10) }/>
									<button type="submit" class="btn-icon btn-icon-sm btn-icon-danger" aria-label="Remove face" title="Remove face">
										@ui.Icon("x")
									</button>
								</form>
							</li>
						}
					</ul>
				} else {
					<p class="empty-state empty-state-sm">No faces found in this photo.</p>
				}
			}
			if strings.TrimSpace(v.Media.OCRText) != "" {
				@ui.Card("Text in the photo") {
					<pre class="gallery-ocr">{ strings.TrimSpace(v.Media.OCRText) }</pre>
				}
			}
		</div>
	</div>
	if !v.Media.IsVideo() {
		<dialog class="gallery-lightbox" id="gallery-lightbox" aria-label={ v.Media.FileName() }>
			<div class="gallery-lightbox-stage">
				<img data-lightbox-img data-src={ downloadURL(v.Media) } alt={ v.Media.FileName() }/>
			</div>
			if v.Newer != 0 {
				<a class="gallery-lightbox-nav gallery-lightbox-prev" href={ templ.SafeURL(photoURL(v.Newer) + "#view") } aria-label="Newer photo">
					@chevron(true)
				</a>
			}
			if v.Older != 0 {
				<a class="gallery-lightbox-nav gallery-lightbox-next" href={ templ.SafeURL(photoURL(v.Older) + "#view") } aria-label="Older photo">
					@chevron(false)
				</a>
			}
			<div class="gallery-lightbox-bar">
				<div class="gallery-lightbox-caption">
					<span class="gallery-lightbox-name">{ v.Media.FileName() }</span>
					<span>{ takenAt(v.Media).Format("Jan 2, 2006") }</span>
				</div>
				<a class="gallery-lightbox-button" href={ templ.SafeURL(downloadURL(v.Media)) } download={ v.Media.FileName() } aria-label="Download" title="Download">
					@ui.Icon("download")
				</a>
				<button type="button" class="gallery-lightbox-button" data-lightbox-close aria-label="Close" title="Close (Esc)" autofocus>
					@ui.Icon("x")
				</button>
			</div>
		</dialog>
	}
	@confirmDialog()
	@galleryScripts()
}

// --- People ---
templ peoplePage(activePath string, people []Person, allCount, unnamedCount int, unnamedOnly bool, admin bool) {
	@galleryLayout(activePath) {
		@ui.PageHeader("People", nil) {
			<cog-share-button resource="people" resource-id="1" share-title="People" btn-class="btn">Share</cog-share-button>
		}
		if allCount > 0 {
			<nav class="gallery-segmented" aria-label="Filter people">
				@segmentLink("/apps/gallery/people", "All", allCount, !unnamedOnly)
				@segmentLink("/apps/gallery/people?filter=unnamed", "Unnamed", unnamedCount, unnamedOnly)
			</nav>
		}
		if len(people) == 0 {
			<div class="card">
				if unnamedOnly {
					@ui.EmptyState("Everyone has a name", "There is nobody left to name.")
				} else {
					@recognitionEmpty("No people yet", "face detection", admin)
				}
			</div>
		} else {
			<div class="gallery-people">
				for _, p := range people {
					<a href={ templ.SafeURL(fmt.Sprintf("/apps/gallery/person/%d", p.ID)) } class="gallery-person">
						if p.BestFaceID != nil {
							<span class="gallery-thumb gallery-thumb-round">
								<img src={ faceThumbURL(*p.BestFaceID) } alt="" loading="lazy" onerror="this.parentElement.classList.add('is-missing')"/>
							</span>
						} else {
							<span class="gallery-thumb gallery-thumb-round is-missing"></span>
						}
						if p.Name == "" {
							<span class="gallery-person-name gallery-unnamed">Unnamed</span>
						} else {
							<span class="gallery-person-name">{ p.Name }</span>
						}
						<span class="gallery-album-meta">{ plural(p.FaceCount, "photo", "photos") }</span>
					</a>
				}
			</div>
		}
	}
}

templ segmentLink(href, label string, count int, active bool) {
	if active {
		<a href={ templ.SafeURL(href) } aria-current="page">{ label } <span class="count">{ strconv.Itoa(count) }</span></a>
	} else {
		<a href={ templ.SafeURL(href) }>{ label } <span class="count">{ strconv.Itoa(count) }</span></a>
	}
}

// recognitionEmpty explains an empty page that recognition fills: an
// administrator gets a link to turn it on, anyone else who to ask.
templ recognitionEmpty(title, feature string, admin bool) {
	if admin {
		@ui.EmptyState(title, "They appear here once "+feature+" is turned on and the gallery has scanned your photos.") {
			<a class="btn btn-primary" href="/admin/plugins/gallery">Open gallery settings</a>
		}
	} else {
		@ui.EmptyState(title, "They appear here once your administrator turns on "+feature+" and the gallery has scanned your photos.")
	}
}

templ personViewPage(activePath string, person *Person, faces []FaceWithMedia, csrfToken string) {
	@galleryLayout(activePath) {
		@ui.PageHeader(person.DisplayName(), []ui.Crumb{{Label: "People", URL: "/apps/gallery/people"}}) {
			<button type="button" class="btn btn-primary" data-modal-open="gallery-name-person">
				@ui.Icon("edit")
				if person.Name == "" {
					Name
				} else {
					Rename
				}
			</button>
			<form method="post" action={ templ.SafeURL(fmt.Sprintf("/apps/gallery/people/%d/hide", person.ID)) } data-confirm={ "Hide " + person.DisplayName() + "? They no longer appear in People; their photos stay in the gallery." } data-confirm-title="Hide person" data-confirm-action="Hide">
				<input type="hidden" name="csrf_token" value={ csrfToken }/>
				<button type="submit" class="btn">Hide</button>
			</form>
		}
		if len(faces) == 0 {
			<div class="card">
				@ui.EmptyState("No photos of this person", "")
			</div>
		} else {
			@personFaceGrid(person, faces, csrfToken)
		}
		@ui.Modal("gallery-name-person", "Name this person") {
			@personNameForm(person, csrfToken)
		}
	}
}

templ personNameForm(person *Person, csrfToken string) {
	<form method="post" action={ templ.SafeURL(fmt.Sprintf("/apps/gallery/people/%d/name", person.ID)) } data-person-form>
		<input type="hidden" name="csrf_token" value={ csrfToken }/>
		<input type="hidden" name="merge_into" value="" data-merge-target/>
		<input type="hidden" name="contact_uid" value="" data-contact-target/>
		<div class="modal-body gallery-name-body">
			<div class="form-group mb-0">
				<label for="gallery-person-name">Name</label>
				<div class="picker">
					<input
						type="text"
						id="gallery-person-name"
						name="name"
						value={ person.Name }
						placeholder="Type a name"
						class="form-control"
						autocomplete="off"
						data-person-name
						hx-get={ fmt.Sprintf("/apps/gallery/api/people/search?exclude=%d", person.ID) }
						hx-trigger="input changed delay:200ms"
						hx-target="next .picker-results"
						hx-include="this"
						hx-params="name"
					/>
					<div class="picker-results"></div>
				</div>
				<p class="form-help">Pick someone from the list to merge their photos with this person's, or a contact to link them.</p>
			</div>
			if person.Name == "" {
				<div
					hx-get={ fmt.Sprintf("/apps/gallery/api/people/%d/suggestions", person.ID) }
					hx-trigger="click once from:[data-modal-open=gallery-name-person]"
					hx-swap="innerHTML"
				></div>
			}
		</div>
		<div class="modal-footer">
			<button type="button" class="btn" data-modal-close>Cancel</button>
			<button type="submit" class="btn btn-primary">Save</button>
		</div>
	</form>
	if person.Name == "" {
		// The suggestions sit inside the name form but belong to this one.
		// Enter in a text field submits through its form's first submit
		// button, and in the name form that must stay Save, not a merge.
		<form method="post" id="gallery-merge-person" hidden>
			<input type="hidden" name="csrf_token" value={ csrfToken }/>
			<input type="hidden" name="source_id" value={ strconv.FormatInt(person.ID, 10) }/>
		</form>
	}
}

// personSuggestions offers the named people who look like the person being
// named. Each submits the merge form to merge them into that person, so a
// likely match takes one click.
templ personSuggestions(people []Person) {
	if len(people) > 0 {
		<p class="gallery-suggestions-label">Looks like</p>
		<div class="gallery-suggestions-list">
			for _, p := range people {
				<button
					type="submit"
					form="gallery-merge-person"
					class="gallery-suggestion"
					formaction={ templ.SafeURL(fmt.Sprintf("/apps/gallery/people/%d/merge", p.ID)) }
					title={ "Merge with " + p.Name }
				>
					if p.BestFaceID != nil {
						<img src={ faceThumbURL(*p.BestFaceID) } alt=""/>
					}
					<span class="gallery-suggestion-name">{ p.Name }</span>
				</button>
			}
		</div>
	}
}

templ personFaceGrid(person *Person, faces []FaceWithMedia, csrfToken string) {
	<div class="gallery-grid">
		for _, f := range faces {
			<div class="gallery-tile">
				<a href={ templ.SafeURL(photoURL(f.MediaID)) } class="gallery-thumb">
					<img src={ faceThumbURL(f.ID) } alt="" loading="lazy" onerror="this.parentElement.classList.add('is-missing')"/>
				</a>
				<form
					class="gallery-tile-action"
					method="post"
					action={ templ.SafeURL(fmt.Sprintf("/apps/gallery/people/%d/remove-face", person.ID)) }
					data-confirm={ "This photo is not of " + person.DisplayName() + "? It moves to a new, unnamed person." }
					data-confirm-title="Not this person"
					data-confirm-action="Remove"
				>
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					<input type="hidden" name="face_id" value={ strconv.FormatInt(f.ID, 10) }/>
					<button type="submit" class="gallery-tile-remove" aria-label={ "Not " + person.DisplayName() } title={ "Not " + person.DisplayName() }>
						@ui.Icon("x")
					</button>
				</form>
			</div>
		}
	</div>
}

// --- Tags ---
templ tagsPage(activePath string, tags []Tag, admin bool) {
	@galleryLayout(activePath) {
		@ui.PageHeader("Tags", nil)
		if len(tags) == 0 {
			<div class="card">
				@recognitionEmpty("No tags yet", "image recognition", admin)
			</div>
		} else {
			<ul class="chip-group gallery-tags">
				for _, t := range tags {
					<li>
						<a href={ templ.SafeURL("/apps/gallery/tag/" + url.PathEscape(t.Name)) } class="chip">
							{ t.Name }
							<span class="count">{ strconv.Itoa(t.Count) }</span>
						</a>
					</li>
				}
			</ul>
		}
	}
}

templ tagViewPage(activePath string, name string, media []Media) {
	@galleryLayout(activePath) {
		@ui.PageHeader(name, []ui.Crumb{{Label: "Tags", URL: "/apps/gallery/tags"}})
		if len(media) == 0 {
			<div class="card">
				@ui.EmptyState("No photos with this tag", "")
			</div>
		} else {
			@photoGrid(media)
		}
	}
}

// --- Videos and starred ---
templ videosPage(media []Media) {
	@galleryLayout("/apps/gallery/videos") {
		@ui.PageHeader("Videos", nil)
		if len(media) == 0 {
			<div class="card">
				@ui.EmptyState("No videos yet", "Videos you upload to Files show up here once the gallery has scanned them.")
			</div>
		} else {
			@photoGrid(media)
		}
	}
}

templ starredPage(media []Media) {
	@galleryLayout("/apps/gallery/starred") {
		@ui.PageHeader("Starred", nil)
		if len(media) == 0 {
			<div class="card">
				@ui.EmptyState("No starred photos", "Star a photo to keep it here.")
			</div>
		} else {
			@photoGrid(media)
		}
	}
}

// --- Duplicates ---
templ duplicatesPage(activePath string, groups []DuplicateGroup) {
	@galleryLayout(activePath) {
		@ui.PageHeader("Duplicates", nil) {
			if len(groups) > 0 {
				<span class="badge badge-neutral">{ plural(len(groups), "group", "groups") }</span>
			}
		}
		if len(groups) == 0 {
			<div class="card">
				@ui.EmptyState("No duplicates found", "Photos that look the same show up here after a scan.")
			</div>
		} else {
			<div class="gallery-albums">
				for _, g := range groups {
					<a href={ templ.SafeURL(fmt.Sprintf("/apps/gallery/duplicates/%d", g.ID)) } class="gallery-album">
						<span class="gallery-thumb">
							<img src={ thumbURL(g.CoverMediaID, 256) } alt="" loading="lazy" onerror="this.parentElement.classList.add('is-missing')"/>
						</span>
						<span class="gallery-album-name">{ plural(g.MemberCount, "similar photo", "similar photos") }</span>
					</a>
				}
			</div>
		}
	}
}

func othersCount(members []DuplicateMember) int {
	n := 0
	for _, m := range members {
		if !m.IsKeep {
			n++
		}
	}
	return n
}

templ duplicateGroupViewPage(activePath string, groupID int64, members []DuplicateMember, csrfToken string) {
	@galleryLayout(activePath) {
		@ui.PageHeader("Duplicate group", []ui.Crumb{{Label: "Duplicates", URL: "/apps/gallery/duplicates"}}) {
			<form method="post" action={ templ.SafeURL(fmt.Sprintf("/apps/gallery/duplicates/%d/dismiss", groupID)) }>
				<input type="hidden" name="csrf_token" value={ csrfToken }/>
				<button type="submit" class="btn">Not duplicates</button>
			</form>
			if othersCount(members) > 0 {
				<form
					method="post"
					action={ templ.SafeURL(fmt.Sprintf("/apps/gallery/duplicates/%d/delete", groupID)) }
					data-confirm={ "Move " + plural(othersCount(members), "photo", "photos") + " to the trash and keep the one marked Keep?" }
					data-confirm-title="Delete the others"
				>
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					<button type="submit" class="btn btn-danger">
						@ui.Icon("trash")
						{ "Delete " + plural(othersCount(members), "other", "others") }
					</button>
				</form>
			}
			<div class="dropdown">
				<button type="button" class="btn btn-square" data-dropdown-toggle aria-expanded="false" aria-controls="dupe-menu" aria-label="More actions">
					@ui.Icon("more")
				</button>
				<div class="dropdown-menu" id="dupe-menu">
					<button type="button" class="danger" data-modal-open="gallery-delete-all">
						@ui.Icon("trash")
						Delete all, including the kept one…
					</button>
				</div>
			</div>
		}
		<div class="gallery-dupes">
			for _, m := range members {
				<div class={ "card gallery-dupe", templ.KV("is-keep", m.IsKeep) }>
					<a href={ templ.SafeURL(photoURL(m.Media.ID)) } class="gallery-thumb">
						<img src={ thumbURL(m.Media.ID, 256) } alt={ m.Media.FileName() } loading="lazy" onerror="this.parentElement.classList.add('is-missing')"/>
					</a>
					<div class="gallery-dupe-body">
						if m.IsKeep {
							<span class="badge badge-success">
								@ui.Icon("check-circle")
								Keep
							</span>
						}
						<dl class="gallery-meta">
							<dt>File</dt>
							<dd>{ m.Media.FileName() }</dd>
							<dt>Size</dt>
							<dd>{ strconv.Itoa(m.Media.Width) } × { strconv.Itoa(m.Media.Height) }</dd>
							if m.Distance > 0 {
								<dt>Difference</dt>
								<dd>{ fmt.Sprintf("%.0f", m.Distance) }</dd>
							}
						</dl>
						<div class="gallery-dupe-actions">
							if !m.IsKeep {
								<form method="post" action={ templ.SafeURL(fmt.Sprintf("/apps/gallery/duplicates/%d/keep", groupID)) }>
									<input type="hidden" name="csrf_token" value={ csrfToken }/>
									<input type="hidden" name="media_id" value={ strconv.FormatInt(m.Media.ID, 10) }/>
									<button type="submit" class="btn btn-sm">Keep this one</button>
								</form>
							}
							<form method="post" action={ templ.SafeURL(fmt.Sprintf("/apps/gallery/duplicates/%d/unmark", groupID)) }>
								<input type="hidden" name="csrf_token" value={ csrfToken }/>
								<input type="hidden" name="media_id" value={ strconv.FormatInt(m.Media.ID, 10) }/>
								<button type="submit" class="btn btn-sm">Not a duplicate</button>
							</form>
							<form
								class="ml-auto"
								method="post"
								action={ templ.SafeURL(fmt.Sprintf("/apps/gallery/duplicates/%d/delete-member", groupID)) }
								data-confirm={ "Move “" + m.Media.FileName() + "” to the trash?" }
								data-confirm-title="Delete photo"
							>
								<input type="hidden" name="csrf_token" value={ csrfToken }/>
								<input type="hidden" name="media_id" value={ strconv.FormatInt(m.Media.ID, 10) }/>
								<button type="submit" class="btn-icon btn-icon-sm btn-icon-danger" aria-label={ "Delete " + m.Media.FileName() } title="Delete">
									@ui.Icon("trash")
								</button>
							</form>
						</div>
					</div>
				</div>
			}
		</div>
		@ui.Modal("gallery-delete-all", "Delete every photo in this group") {
			<form method="post" action={ templ.SafeURL(fmt.Sprintf("/apps/gallery/duplicates/%d/delete-all", groupID)) }>
				<input type="hidden" name="csrf_token" value={ csrfToken }/>
				<div class="modal-body">
					<p>{ "This moves all " + plural(len(members), "photo", "photos") + " to the trash, including the one marked Keep. None of them stays in the gallery." }</p>
					<div class="form-group mb-0 mt-2">
						<label for="gallery-delete-all-confirm">Type <strong>delete</strong> to confirm</label>
						<input class="form-control" id="gallery-delete-all-confirm" type="text" required pattern="[Dd][Ee][Ll][Ee][Tt][Ee]" autocomplete="off"/>
					</div>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn" data-modal-close>Cancel</button>
					<button type="submit" class="btn btn-danger">Delete all</button>
				</div>
			</form>
		}
	}
}

// --- Settings (per user) ---
templ settingsPage(db *sql.DB, total int, csrfToken string) {
	@galleryLayout("/apps/gallery/settings") {
		@ui.PageHeader("Gallery Settings", nil)
		<div class="card">
			<div class="card-header">
				<h2 class="card-title">Library</h2>
				<form method="post" action="/apps/gallery/settings/scan">
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					<button type="submit" class="btn">Scan now</button>
				</form>
			</div>
			<p>{ plural(total, "photo or video", "photos and videos") } indexed.</p>
		</div>
		@ui.Card("Folders to scan") {
			<form method="post" action="/apps/gallery/settings/folders">
				<input type="hidden" name="csrf_token" value={ csrfToken }/>
				<div class="form-group">
					<label for="gallery-folders">Folder patterns</label>
					<textarea id="gallery-folders" name="folders" class="form-control mono" rows="4" required placeholder="Photos/" aria-describedby="gallery-folders-help">{ SettingScanFolders.MustGet(db) }</textarea>
					<p class="form-help" id="gallery-folders-help">
						One pattern per line. A trailing <code>/</code> takes everything in that folder; globs such as <code>Camera/*.jpg</code> work too.
					</p>
				</div>
				<div class="form-actions mt-0">
					<button type="submit" class="btn btn-primary">Save</button>
					<button
						type="button"
						class="btn"
						hx-get="/apps/gallery/api/scan-folders-preview"
						hx-include="closest form"
						hx-params="folders"
						hx-target="#folder-preview"
					>Preview matches</button>
				</div>
				<p class="form-error" data-preview-error hidden role="alert">The preview could not be loaded. Try again.</p>
				<div id="folder-preview" class="gallery-folder-preview" aria-live="polite"></div>
			</form>
		}
		@ui.Card("Rename files") {
			<form method="get" action="/apps/gallery/rename/preview">
				<div class="form-group">
					<label for="gallery-rename-pattern">Pattern</label>
					<input
						type="text"
						id="gallery-rename-pattern"
						name="pattern"
						class="form-control mono"
						value={ RenamePattern(db) }
						placeholder={ DefaultRenamePattern(db) }
						required
						aria-describedby="gallery-rename-help"
					/>
					<p class="form-help" id="gallery-rename-help">A Go template, from the top of your files. Keep it inside a scan folder, or the gallery loses the photos it moves. Available fields:</p>
					<ul class="chip-group gallery-fields">
						for _, f := range []string{"Year", "Month", "Day", "Hour", "Minute", "Second", "Camera", "Lens", "Original", "Ext", "Place", "Country"} {
							<li><code>{ "{{." + f + "}}" }</code></li>
						}
					</ul>
				</div>
				@renameConflictsField(SettingRenameConflicts.MustGet(db))
				<div class="form-actions mt-0">
					<button type="submit" class="btn btn-primary" data-testid="rename-preview">Preview rename</button>
				</div>
			</form>
			<div class="card-subtitle">Undo</div>
			<form method="post" action="/apps/gallery/rename/undo" class="gallery-undo" data-confirm="Put every file the last rename moved back where it was?" data-confirm-title="Undo last rename" data-confirm-action="Undo">
				<input type="hidden" name="csrf_token" value={ csrfToken }/>
				<p class="text-sm text-muted">Puts back the files the last rename moved.</p>
				<button type="submit" class="btn">Undo last rename</button>
			</form>
		}
	}
}

// --- Scan Folders Preview Partial ---
templ scanFoldersPreview(folders []string, total int) {
	if total == 0 {
		<p class="text-sm text-muted">No photos or videos match these patterns.</p>
	} else {
		<p class="text-sm"><strong>{ plural(total, "matching file", "matching files") }</strong> in:</p>
		<ul class="gallery-folder-list">
			for _, f := range folders {
				<li>{ f }</li>
			}
		</ul>
	}
}

// --- System Settings Page (admin, rendered via RegisterSettingsPage) ---
templ systemSettingsPage(db *sql.DB, stats RecognitionStats, scan ScanStatus, progress ScanProgress, workers workersView, viewer, csrfToken string) {
	<header class="page-header">
		<div class="page-heading">
			<h1>Gallery Settings</h1>
			<p class="page-subtitle">These settings apply to all users.</p>
		</div>
	</header>
	@scanStatusCard(stats, scan, progress, viewer, csrfToken)
	@workersCard(workers, csrfToken)
	@ui.Card("Tag classification") {
		<form method="post" action="/admin/plugins/gallery">
			<input type="hidden" name="csrf_token" value={ csrfToken }/>
			<input type="hidden" name="_section" value="tags"/>
			<div class="form-group">
				<label for="tag_backend">Backend</label>
				<select id="tag_backend" name="tag_backend" class="form-control" data-tag-backend>
					<option value="none" selected?={ GetSetting(db, "tag_backend", "none") == "none" }>None (disabled)</option>
					<option value="onnx" selected?={ GetSetting(db, "tag_backend", "none") == "onnx" }>ONNX (local)</option>
					<option value="ollama" selected?={ GetSetting(db, "tag_backend", "none") == "ollama" }>Ollama</option>
					<option value="openai" selected?={ GetSetting(db, "tag_backend", "none") == "openai" }>OpenAI-compatible</option>
				</select>
			</div>
			<div class="form-group" id="tag-model-group">
				<label for="tag_model">ONNX tag model</label>
				<select id="tag_model" name="tag_model" class="form-control">
					<option value="joytag" selected?={ GetSetting(db, "tag_model", "joytag") == "joytag" }>JoyTag (multi-label, photos)</option>
					<option value="wd14" selected?={ GetSetting(db, "tag_model", "joytag") == "wd14" }>WD14 (multi-label, general)</option>
					<option value="mobilenet" selected?={ GetSetting(db, "tag_model", "joytag") == "mobilenet" }>MobileNet (ImageNet, legacy)</option>
				</select>
				<p class="form-help">Only used when the backend is ONNX.</p>
			</div>
			<div class="form-group">
				<label for="tag_min_confidence">Minimum confidence</label>
				<input type="number" id="tag_min_confidence" name="tag_min_confidence" class="form-control w-xs" value={ GetSetting(db, "tag_min_confidence", "0.5") } step="0.05" min="0" max="1"/>
				<p class="form-help">Tags below this confidence are discarded. Default: 0.5</p>
			</div>
			<button type="submit" class="btn btn-primary">Save</button>
			<script>
				(function () {
					var sel = document.querySelector("[data-tag-backend]");
					var group = document.getElementById("tag-model-group");
					function update() {
						group.hidden = sel.value !== "onnx";
					}
					sel.addEventListener("change", update);
					update();
				})();
			</script>
		</form>
	}
	@ui.Card("Face detection") {
		<form method="post" action="/admin/plugins/gallery">
			<input type="hidden" name="csrf_token" value={ csrfToken }/>
			<input type="hidden" name="_section" value="faces"/>
			<div class="form-group">
				<label for="face_backend">Backend</label>
				<select id="face_backend" name="face_backend" class="form-control">
					<option value="none" selected?={ GetSetting(db, "face_backend", "none") == "none" }>None (disabled)</option>
					<option value="onnx" selected?={ GetSetting(db, "face_backend", "none") == "onnx" }>ONNX (SCRFD + ArcFace)</option>
					<option value="pigo" selected?={ GetSetting(db, "face_backend", "none") == "pigo" }>Pigo (detection only, no embeddings)</option>
				</select>
			</div>
			<div class="form-row">
				<div class="form-group">
					<label for="face_min_confidence">Minimum confidence</label>
					<input type="number" id="face_min_confidence" name="face_min_confidence" class="form-control" value={ GetSetting(db, "face_min_confidence", "0.7") } step="0.05" min="0" max="1"/>
					<p class="form-help">Faces below this confidence are discarded. Default: 0.7</p>
				</div>
				<div class="form-group">
					<label for="cluster_threshold">Cluster threshold</label>
					<input type="number" id="cluster_threshold" name="cluster_threshold" class="form-control" value={ GetSetting(db, "cluster_threshold", "0.35") } step="0.01" min="0.01" max="1.0"/>
					<p class="form-help">Cosine distance for grouping faces into people (lower is stricter). Default: 0.35</p>
				</div>
			</div>
			<button type="submit" class="btn btn-primary">Save</button>
		</form>
	}
	@ui.Card("Duplicate detection") {
		<form method="post" action="/admin/plugins/gallery">
			<input type="hidden" name="csrf_token" value={ csrfToken }/>
			<input type="hidden" name="_section" value="duplicates"/>
			<div class="form-group">
				<label class="form-check">
					<input type="checkbox" name="duplicate_detection_enabled" value="true" checked?={ GetSetting(db, "duplicate_detection_enabled", "true") == "true" }/>
					Find duplicate photos
				</label>
			</div>
			<div class="form-row">
				<div class="form-group">
					<label for="duplicate_algorithm">Algorithm</label>
					<select id="duplicate_algorithm" name="duplicate_algorithm" class="form-control">
						<option value="difference" selected?={ GetSetting(db, "duplicate_algorithm", "difference") == "difference" }>Difference hash</option>
						<option value="average" selected?={ GetSetting(db, "duplicate_algorithm", "difference") == "average" }>Average hash</option>
						<option value="phash" selected?={ GetSetting(db, "duplicate_algorithm", "difference") == "phash" }>Perceptual hash (pHash)</option>
						<option value="median" selected?={ GetSetting(db, "duplicate_algorithm", "difference") == "median" }>Median hash</option>
						<option value="blockmean" selected?={ GetSetting(db, "duplicate_algorithm", "difference") == "blockmean" }>Block mean hash</option>
					</select>
				</div>
				<div class="form-group">
					<label for="duplicate_distance">Distance threshold</label>
					<input type="number" id="duplicate_distance" name="duplicate_distance" class="form-control" value={ GetSetting(db, "duplicate_distance", "5") } min="0" max="64"/>
					<p class="form-help">Largest Hamming distance still counted as a duplicate (lower is stricter). Default: 5</p>
				</div>
			</div>
			<button type="submit" class="btn btn-primary">Save</button>
		</form>
	}
	@ui.Card("Text recognition (OCR)") {
		<form method="post" action="/admin/plugins/gallery">
			<input type="hidden" name="csrf_token" value={ csrfToken }/>
			<input type="hidden" name="_section" value="ocr"/>
			<div class="form-group">
				<label class="form-check">
					<input type="checkbox" name="ocr_enabled" value="true" checked?={ GetSetting(db, "ocr_enabled", "true") == "true" }/>
					Extract text from photos
				</label>
				<p class="form-help">Needs tesseract installed on the server.</p>
			</div>
			<button type="submit" class="btn btn-primary">Save</button>
		</form>
	}
	@ui.Card("Processing") {
		<form method="post" action="/admin/plugins/gallery">
			<input type="hidden" name="csrf_token" value={ csrfToken }/>
			<input type="hidden" name="_section" value="processing"/>
			<div class="form-group">
				<label class="form-check">
					<input type="checkbox" name="preview_generation_enabled" value="true" checked?={ GetSetting(db, "preview_generation_enabled", "true") == "true" }/>
					Make thumbnails while scanning
				</label>
				<label class="form-check">
					<input type="checkbox" name="quality_scoring_enabled" value="true" checked?={ GetSetting(db, "quality_scoring_enabled", "true") == "true" }/>
					Score image quality (sharpness)
				</label>
			</div>
			<button type="submit" class="btn btn-primary">Save</button>
		</form>
	}
	@ui.Card("Backend connection") {
		<form method="post" action="/admin/plugins/gallery">
			<input type="hidden" name="csrf_token" value={ csrfToken }/>
			<input type="hidden" name="_section" value="backend"/>
			<p class="card-desc">Shared by the tag classification and face detection backends.</p>
			<div class="form-group">
				<label for="onnx_library_path">ONNX Runtime library path</label>
				<input type="text" id="onnx_library_path" name="onnx_library_path" class="form-control mono" value={ GetSetting(db, "onnx_library_path", "") } placeholder="/usr/lib/libonnxruntime.so"/>
				<p class="form-help">Leave blank to detect it.</p>
			</div>
			<div class="form-group">
				<label for="onnx_models_dir">ONNX models directory</label>
				<input type="text" id="onnx_models_dir" name="onnx_models_dir" class="form-control mono" value={ GetSetting(db, "onnx_models_dir", "") } placeholder="(the data directory)"/>
			</div>
			<div class="form-group">
				<label for="recognition_url">Ollama / OpenAI URL</label>
				<input type="url" id="recognition_url" name="recognition_url" class="form-control" value={ GetSetting(db, "recognition_url", "") } placeholder="http://localhost:11434"/>
			</div>
			<div class="form-row">
				<div class="form-group">
					<label for="recognition_api_key">API key</label>
					<input type="password" id="recognition_api_key" name="recognition_api_key" class="form-control" value={ GetSetting(db, "recognition_api_key", "") } placeholder="sk-…" autocomplete="off"/>
				</div>
				<div class="form-group">
					<label for="recognition_model">Model</label>
					<input type="text" id="recognition_model" name="recognition_model" class="form-control" value={ GetSetting(db, "recognition_model", "") } placeholder="llava:13b"/>
				</div>
			</div>
			<button type="submit" class="btn btn-primary">Save</button>
		</form>
	}
}

templ workersCard(v workersView, csrfToken string) {
	<div id="workers">
		@ui.Card("Workers") {
			<p class="card-desc">Other machines can analyse photos for this server: faces, tags, fingerprints and text. Each signs in with its own token and takes photos when it is up; the server goes on analysing without them.</p>
			if len(v.Workers) > 0 {
				<div class="table-wrap">
					<table class="table table-sm mb-2">
						<thead>
							<tr>
								<th>Name</th>
								<th>Status</th>
								<th>Machine</th>
								<th class="text-right">Speed</th>
								<th class="text-right">Photos</th>
								<th></th>
							</tr>
						</thead>
						<tbody>
							for _, w := range v.Workers {
								<tr>
									<td class="nowrap">{ w.Name }</td>
									<td>
										if w.Online(v.Now) {
											<span class="badge badge-success">Online</span>
											if w.Info.LastFailure != "" {
												<div class="text-xs text-warning">{ w.Info.LastFailure }</div>
											}
										} else if w.LastSeen.IsZero() {
											<span class="text-muted">Never seen</span>
										} else {
											<span class="text-muted nowrap">Last seen { w.LastSeen.Format("Jan 2 3:04 PM") }</span>
										}
									</td>
									<td>
										if w.Info.CPU != "" {
											<div class="nowrap">{ shortCPU(w.Info.CPU) }</div>
											<div class="text-xs text-muted nowrap">{ strconv.Itoa(w.Info.Threads) } threads · { w.Info.Version }</div>
										}
									</td>
									<td class="text-right nowrap">
										if w.Info.PerPhoto > 0 && w.Online(v.Now) {
											{ strconv.FormatFloat(w.Info.PerPhoto, 'f', 2, 64) } s/photo
										}
									</td>
									<td class="text-right">{ strconv.FormatInt(w.Done, 10) }</td>
									<td class="nowrap">
										<form method="post" action="/admin/plugins/gallery/workers">
											<input type="hidden" name="csrf_token" value={ csrfToken }/>
											<input type="hidden" name="id" value={ strconv.FormatInt(w.ID, 10) }/>
											<button type="submit" name="op" value="regenerate" class="btn btn-sm btn-outline">New token</button>
											<button type="submit" name="op" value="delete" class="btn btn-sm btn-outline-danger">Remove</button>
										</form>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
			<form method="post" action="/admin/plugins/gallery/workers" class="form-row mb-2">
				<input type="hidden" name="csrf_token" value={ csrfToken }/>
				<input type="hidden" name="op" value="create"/>
				<div class="form-group">
					<label for="worker_name">New worker</label>
					<input type="text" id="worker_name" name="name" class="form-control" placeholder="desktop" required/>
				</div>
				<div class="form-group">
					<label>&nbsp;</label>
					<button type="submit" class="btn btn-primary">Add worker</button>
				</div>
			</form>
		}
	</div>
}

// scanStatusCard renders the background scan status card (used as full-page component and HTMX partial).
templ scanStatusCard(stats RecognitionStats, scan ScanStatus, progress ScanProgress, viewer, csrfToken string) {
	<div
		id="scan-status"
		if scan.Running || progress.Active() {
			hx-get="/apps/gallery/api/scan-status"
			hx-trigger="every 2s"
			hx-swap="outerHTML"
		}
	>
		@ui.Card("Background scan") {
			if progress.Active() {
				<div class="mb-2">
					<div class="progress mb-1" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow={ strconv.Itoa(int(progress.Percent())) }>
						<div class="progress-bar" style={ "width:" + strconv.FormatFloat(progress.Percent(), 'f', 1, 64) + "%" }></div>
					</div>
					<div class="text-sm">
						{ strconv.Itoa(progress.Done()) } of { strconv.Itoa(progress.Total) } photos analysed ({ strconv.Itoa(int(progress.Percent())) }%)
						· going for { shortDuration(progress.Elapsed) }
						if progress.ETA > 0 {
							· about { shortDuration(progress.ETA) } left
						} else {
							· estimating time left…
						}
					</div>
				</div>
			}
			<dl class="kv mb-2">
				<dt>Status</dt>
				<dd>
					if scan.Running {
						<span class="badge badge-primary">Running</span>
					} else {
						Idle
					}
				</dd>
				if !scan.LastRun.IsZero() {
					<dt>Last run</dt>
					<dd>{ scan.LastRun.Format("Jan 2, 2006 3:04:05 PM") }</dd>
				}
				if scan.LastError != nil {
					<dt>Last error</dt>
					<dd class="text-danger">{ scan.LastError.Error() }</dd>
				}
				if len(scan.Warnings) > 0 {
					<dt>Warnings</dt>
					<dd class="text-warning">
						for _, w := range scan.Warnings {
							<div>{ w }</div>
						}
					</dd>
				}
				<dt>Total images</dt>
				<dd><strong>{ strconv.Itoa(stats.TotalImages) }</strong></dd>
				<dt>Recognised</dt>
				<dd>{ strconv.Itoa(stats.Done) }</dd>
				<dt>Waiting</dt>
				<dd>{ strconv.Itoa(stats.Pending) }</dd>
				if stats.Failed > 0 {
					<dt>Failed</dt>
					<dd>
						<span class="text-danger">{ strconv.Itoa(stats.Failed) }</span>
						for _, f := range stats.Failures {
							<div class="text-sm">
								if f.User == viewer {
									<a href={ templ.SafeURL(photoURL(f.MediaID)) }>{ f.Path }</a>
								} else {
									{ f.User }: { f.Path }
								}
								<span class="text-muted" title={ f.Error }>{ firstLine(f.Error) }</span>
							</div>
						}
					</dd>
				}
			</dl>
			if len(stats.Users) > 0 {
				<table class="table table-sm mb-2">
					<thead>
						<tr>
							<th>Waiting for</th>
							<th>Metadata</th>
							<th>Sharpness</th>
							<th>Fingerprint</th>
							<th>OCR</th>
							<th>Recognition</th>
							<th>Failed</th>
						</tr>
					</thead>
					<tbody>
						for _, u := range stats.Users {
							<tr>
								<td>{ u.Username }</td>
								<td>{ strconv.Itoa(u.Metadata) }</td>
								<td>{ strconv.Itoa(u.Quality) }</td>
								<td>{ strconv.Itoa(u.Fingerprint) }</td>
								<td>{ strconv.Itoa(u.OCR) }</td>
								<td>{ strconv.Itoa(u.Recognition) }</td>
								<td>{ strconv.Itoa(u.Failed) }</td>
							</tr>
						}
					</tbody>
				</table>
			}
			<div class="btn-group">
				<form method="post" action="/admin/plugins/gallery/scan">
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					<button type="submit" class="btn btn-primary" disabled?={ scan.Running }>
						if scan.Running {
							Scanning…
						} else {
							Scan all users
						}
					</button>
				</form>
				if (stats.Done > 0 || stats.Errored > 0) && !scan.Running {
					<button type="button" class="btn btn-outline-danger" data-modal-open="gallery-purge">Purge recognitions…</button>
				}
			</div>
		}
		if (stats.Done > 0 || stats.Errored > 0) && !scan.Running {
			@ui.Modal("gallery-purge", "Purge recognitions") {
				<form method="post" action="/admin/plugins/gallery/purge-recognitions">
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					<div class="modal-body">
						<p>Delete every user's tags, faces and people, and queue all images for recognition again?</p>
					</div>
					<div class="modal-footer">
						<button type="button" class="btn" data-modal-close>Cancel</button>
						<button type="submit" class="btn btn-danger">Purge</button>
					</div>
				</form>
			}
		}
	</div>
}

// --- Rename Preview Page ---
// renameConflictsField chooses what a rename does when a new name is taken.
templ renameConflictsField(policy ConflictPolicy) {
	<div class="form-group">
		<label for="gallery-rename-conflicts">When the new name is taken</label>
		<select id="gallery-rename-conflicts" name="conflicts" class="form-control">
			<option value={ string(ConflictNumber) } selected?={ policy == ConflictNumber }>Add a number (_1, _2, …)</option>
			<option value={ string(ConflictSkip) } selected?={ policy == ConflictSkip }>Leave the file where it is</option>
		</select>
	</div>
}

templ renameKinds(sum RenameSummary) {
	<p class="card-desc">{ "Too many to list one by one, so here they are by kind, with an example of each: " }<span class="mono">#</span> is any number, <span class="mono">*</span> any folder, and <span class="mono">{ "{name}" }</span> the file's own name.</p>
	<table class="table table-stack gallery-rename-table">
		<thead>
			<tr>
				<th>Now</th>
				<th>After</th>
				<th class="text-right">Files</th>
			</tr>
		</thead>
		<tbody>
			for _, k := range sum.Kinds {
				<tr>
					<td data-label="Now" class="mono">
						{ k.From }
						<div class="text-xs text-muted">{ k.Example.OldPath }</div>
					</td>
					<td data-label="After" class="mono">
						{ k.To }
						<div class="text-xs text-muted">{ k.Example.NewPath }</div>
					</td>
					<td data-label="Files" class="text-right">
						{ strconv.Itoa(k.Count) }
						if k.Numbered > 0 {
							<div class="text-xs text-muted" title="Another file has the name the pattern gives, so a number is added">{ strconv.Itoa(k.Numbered) } numbered</div>
						}
					</td>
				</tr>
			}
			if sum.Other > 0 {
				<tr>
					<td colspan="2">{ "Of other kinds, past the first " + strconv.Itoa(renameDetailLimit) }</td>
					<td data-label="Files" class="text-right">{ strconv.Itoa(sum.Other) }</td>
				</tr>
			}
		</tbody>
	</table>
}

templ renamePreviewPage(pattern string, policy ConflictPolicy, plan *RenamePlan, patternErr string, csrfToken string) {
	@galleryLayout("/apps/gallery/settings") {
		@ui.PageHeader("Rename preview", []ui.Crumb{{Label: "Settings", URL: "/apps/gallery/settings"}})
		<form method="get" action="/apps/gallery/rename/preview" class="card">
			<div class="form-group">
				<label for="gallery-rename-pattern">Pattern</label>
				<input type="text" id="gallery-rename-pattern" name="pattern" class="form-control mono" value={ pattern } required aria-invalid={ strconv.FormatBool(patternErr != "") }/>
			</div>
			@renameConflictsField(policy)
			<div class="form-actions mt-0">
				<button type="submit" class="btn">Preview</button>
			</div>
		</form>
		if patternErr != "" {
			@ui.Alert("error", patternErr)
		} else {
			if plan.Unscanned > 0 {
				@ui.Alert("info", unscannedNote(plan.Unscanned))
			}
			if len(plan.Renames) == 0 {
				<div class="card">
					@ui.EmptyState("Nothing to rename", "Every file already has the name this pattern gives it, or is listed below as left alone.")
				</div>
			} else {
				<div class="card">
					<h2 class="card-title">{ plural(len(plan.Renames), "file", "files") + " will be renamed" }</h2>
					<p class="card-desc">Folders the rename leaves empty are removed, short of the scan folders themselves. A folder with anything else in it stays.</p>
					if len(plan.Renames) > renameDetailLimit {
						@renameKinds(SummarizeRenames(plan.Renames, renameDetailLimit))
					} else {
						<table class="table table-stack gallery-rename-table">
							<thead>
								<tr>
									<th>Now</th>
									<th>After</th>
								</tr>
							</thead>
							<tbody>
								for _, p := range plan.Renames {
									<tr>
										<td data-label="Now" class="mono">{ p.OldPath }</td>
										<td data-label="After" class="mono">
											{ p.NewPath }
											if p.Numbered {
												<span class="badge badge-outline" title="Another file has the name the pattern gives">numbered</span>
											}
										</td>
									</tr>
								}
							</tbody>
						</table>
					}
				</div>
				<form method="post" action="/apps/gallery/rename/apply" class="form-actions">
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					<input type="hidden" name="pattern" value={ pattern }/>
					<input type="hidden" name="conflicts" value={ string(policy) }/>
					<button type="submit" class="btn btn-primary">{ "Rename " + plural(len(plan.Renames), "file", "files") }</button>
					<a href="/apps/gallery/settings" class="btn">Cancel</a>
				</form>
			}
			if len(plan.Skipped) > 0 {
				<div class="card">
					<h2 class="card-title">{ plural(len(plan.Skipped), "file", "files") + " left alone" }</h2>
					if len(plan.Skipped) > renameDetailLimit {
						<table class="table table-stack gallery-rename-table">
							<thead>
								<tr>
									<th>Why</th>
									<th class="text-right">Files</th>
								</tr>
							</thead>
							<tbody>
								for _, k := range SummarizeSkips(plan.Skipped) {
									<tr>
										<td data-label="Why">
											{ k.Reason }
											<div class="text-xs text-muted"><span class="mono">{ k.Example.Path }</span>: { k.Example.Reason }</div>
										</td>
										<td data-label="Files" class="text-right">{ strconv.Itoa(k.Count) }</td>
									</tr>
								}
							</tbody>
						</table>
					} else {
						<table class="table table-stack gallery-rename-table">
							<thead>
								<tr>
									<th>File</th>
									<th>Why</th>
								</tr>
							</thead>
							<tbody>
								for _, s := range plan.Skipped {
									<tr>
										<td data-label="File" class="mono">{ s.Path }</td>
										<td data-label="Why">{ s.Reason }</td>
									</tr>
								}
							</tbody>
						</table>
					}
				</div>
			}
		}
	}
}
