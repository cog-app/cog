package gallery

import (
	"database/sql"
	"fmt"
	"strconv"
	"strings"
	"time"

	"git.duckfam.us/jj-software/cog/ui"
)

// --- Gallery Sidebar ---
templ gallerySidebar(activePath string, total int, starredCount int) {
	<nav class="sidebar" id="gallery-sidebar">
		<a href="/apps/gallery/" class={ sidebarClass(activePath, "/apps/gallery/") }>
			Timeline
			if total > 0 {
				<span class="badge">{ strconv.Itoa(total) }</span>
			}
		</a>
		<a href="/apps/gallery/starred" class={ sidebarClass(activePath, "/apps/gallery/starred") }>
			Starred
			if starredCount > 0 {
				<span class="badge">{ strconv.Itoa(starredCount) }</span>
			}
		</a>
		<a href="/apps/gallery/albums" class={ sidebarClass(activePath, "/apps/gallery/albums") }>
			Albums
		</a>
		<a href="/apps/gallery/people" class={ sidebarClass(activePath, "/apps/gallery/people") }>
			People
		</a>
		<a href="/apps/gallery/tags" class={ sidebarClass(activePath, "/apps/gallery/tags") }>
			Tags
		</a>
		<a href="/apps/gallery/videos" class={ sidebarClass(activePath, "/apps/gallery/videos") }>
			Videos
		</a>
		<a href="/apps/gallery/duplicates" class={ sidebarClass(activePath, "/apps/gallery/duplicates") }>
			Duplicates
		</a>
		<div class="sidebar-divider"></div>
		<a href="/apps/gallery/settings" class={ sidebarClass(activePath, "/apps/gallery/settings") }>
			Settings
		</a>
		<div
			hx-get="/apps/gallery/api/user-scan-status"
			hx-trigger="load, every 5s"
			hx-swap="innerHTML"
		></div>
	</nav>
}

templ userScanBanner(scan ScanStatus) {
	if scan.Running {
		<div class="scan-banner">
			<span class="spinner-sm"></span>
			Scanning...
		</div>
	}
}

func duplicateCardStyle(isKeep bool) string {
	if isKeep {
		return "border:2px solid var(--color-success)"
	}
	return ""
}

func sidebarClass(activePath, itemPath string) string {
	if activePath == itemPath || (itemPath != "/apps/gallery/" && strings.HasPrefix(activePath, itemPath)) {
		return "sidebar-item active"
	}
	return "sidebar-item"
}

// --- Photo Grid ---
templ photoGrid(media []Media) {
	<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:6px">
		for _, m := range media {
			<a
				href={ templ.SafeURL(fmt.Sprintf("/apps/gallery/photo/%d", m.ID)) }
				class="thumb-loading"
				style="aspect-ratio:1;overflow:hidden;border-radius:4px;position:relative;display:block"
			>
				<img
					src={ fmt.Sprintf("/apps/gallery/api/media/%d/thumbnail?size=256", m.ID) }
					alt={ m.FileName() }
					style="width:100%;height:100%;object-fit:cover;position:relative"
					loading="lazy"
				/>
				if m.IsVideo() {
					<span style="position:absolute;bottom:4px;right:4px;background:rgba(0,0,0,0.6);color:#fff;padding:2px 6px;border-radius:3px;font-size:0.75rem">
						{ formatDuration(m.DurationMs) }
					</span>
				}
			</a>
		}
	</div>
}

func faceTitle(f Face) string {
	name := "Unknown"
	if f.Name != "" {
		name = f.Name
	}
	parts := name
	if f.EstimatedAge >= 0 {
		parts += fmt.Sprintf(", age ~%d", int(f.EstimatedAge+0.5))
	}
	if f.Confidence > 0 {
		parts += fmt.Sprintf(", %.0f%%", f.Confidence*100)
	}
	return parts
}

func faceBoxStyle(f Face) string {
	return fmt.Sprintf(
		"position:absolute;left:%.2f%%;top:%.2f%%;width:%.2f%%;height:%.2f%%",
		f.X*100, f.Y*100, f.W*100, f.H*100,
	)
}

func overlayBoxStyle(o FaceOverlay) string {
	border := "2px solid rgba(255,255,255,0.3)"
	if o.IsCurrentPerson {
		border = "2px solid rgba(59,130,246,0.8)"
	}
	return fmt.Sprintf(
		"position:absolute;left:%s;top:%s;width:%s;height:%s;border:%s;border-radius:2px;pointer-events:none",
		o.Left, o.Top, o.Width, o.Height, border,
	)
}

func formatDuration(ms *int64) string {
	if ms == nil {
		return ""
	}
	secs := *ms / 1000
	if secs < 60 {
		return fmt.Sprintf("0:%02d", secs)
	}
	return fmt.Sprintf("%d:%02d", secs/60, secs%60)
}

// --- Timeline Page ---
templ timelinePage(activePath string, days []TimelineDay, media []Media, total int) {
	<div class="sidebar-layout">
		@gallerySidebar(activePath, total, 0)
		<div class="sidebar-content">
			<h1>Timeline</h1>
			if len(media) == 0 {
				@ui.Card("") {
					<p class="text-muted">No photos yet. Upload some images to your file storage to get started.</p>
				}
			} else {
				@photoGrid(media)
			}
		</div>
	</div>
}

// --- Albums Page ---
templ albumsPage(activePath string, albums []Album) {
	<div class="sidebar-layout">
		@gallerySidebar(activePath, 0, 0)
		<div class="sidebar-content">
			<div class="flex items-center gap-1 mb-2" style="justify-content:space-between">
				<h1 style="margin:0">Albums</h1>
			</div>
			if len(albums) == 0 {
				@ui.Card("") {
					<p class="text-muted">No albums yet.</p>
				}
			} else {
				<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:12px">
					for _, a := range albums {
						<a
							href={ templ.SafeURL(fmt.Sprintf("/apps/gallery/album/%d", a.ID)) }
							class="card"
							style="text-decoration:none"
						>
							<div style="padding:1rem">
								<div style="font-weight:600">{ a.Name }</div>
								<div class="text-muted" style="font-size:0.85rem">
									{ strconv.Itoa(a.MediaCount) } items
									if a.AlbumType > 0 {
										<span>· { a.AlbumTypeName() }</span>
									}
								</div>
							</div>
						</a>
					}
				</div>
			}
		</div>
	</div>
}

// --- Album View Page ---
templ albumViewPage(activePath string, album *Album, media []Media, csrfToken string) {
	<div class="sidebar-layout">
		@gallerySidebar(activePath, 0, 0)
		<div class="sidebar-content">
			<div class="flex items-center gap-1 mb-2" style="justify-content:space-between">
				<h1 style="margin:0">{ album.Name }</h1>
				if album.AlbumType == AlbumManual {
					<form
						method="post"
						action={ templ.SafeURL(fmt.Sprintf("/apps/gallery/albums/%d", album.ID)) }
						style="display:inline"
					>
						<input type="hidden" name="csrf_token" value={ csrfToken }/>
						<button
							type="submit"
							class="btn btn-danger btn-sm"
							hx-delete={ fmt.Sprintf("/apps/gallery/albums/%d", album.ID) }
							hx-confirm="Delete this album?"
						>
							Delete
						</button>
					</form>
				}
			</div>
			if album.Description != "" {
				<p class="text-muted">{ album.Description }</p>
			}
			if len(media) == 0 {
				@ui.Card("") {
					<p class="text-muted">This album is empty.</p>
				}
			} else {
				@photoGrid(media)
			}
		</div>
	</div>
}

// --- Photo View Page ---
templ photoViewPage(activePath string, m *Media, tags []Tag, faces []Face, csrfToken string, isFavorite bool) {
	<div class="sidebar-layout">
		@gallerySidebar(activePath, 0, 0)
		<div class="sidebar-content">
			<div class="flex items-center gap-1 mb-2">
				<h1 style="margin:0">{ m.FileName() }</h1>
				@ui.Star(isFavorite, fmt.Sprintf("/apps/gallery/media/%d/star", m.ID))
			</div>
			<div style="display:grid;grid-template-columns:1fr 300px;gap:1rem">
				<div>
					if m.IsVideo() {
						<video controls style="max-width:100%;border-radius:4px">
							<source src={ fmt.Sprintf("/api/files/download?path=%s", m.FilePath) } type={ m.MimeType }/>
						</video>
					} else {
						<div class="face-container" style={ fmt.Sprintf("position:relative;max-width:100%%;aspect-ratio:%d/%d", m.Width, m.Height) }>
							<img
								src={ fmt.Sprintf("/apps/gallery/api/media/%d/thumbnail?size=1024", m.ID) }
								alt={ m.FileName() }
								style="width:100%;height:100%;border-radius:4px;display:block;cursor:zoom-in"
								data-full-src={ fmt.Sprintf("/api/files/download?path=%s", m.FilePath) }
								onclick="openLightbox(this)"
							/>
							for _, f := range faces {
								if f.PersonID != nil {
									<a
										href={ templ.SafeURL(fmt.Sprintf("/apps/gallery/person/%d", *f.PersonID)) }
										class="face-box"
										title={ faceTitle(f) }
										style={ faceBoxStyle(f) }
									></a>
								} else {
									<div
										class="face-box"
										title={ faceTitle(f) }
										style={ faceBoxStyle(f) }
									></div>
								}
							}
						</div>
						<script>
						function openLightbox(img) {
							var src = img.getAttribute('data-full-src');
							var overlay = document.createElement('div');
							overlay.className = 'lightbox';
							var lbImg = document.createElement('img');
							lbImg.src = src;
							lbImg.alt = '';
							var closeBtn = document.createElement('button');
							closeBtn.className = 'lightbox-close';
							closeBtn.setAttribute('aria-label', 'Close');
							closeBtn.innerHTML = '&times;';
							overlay.appendChild(closeBtn);
							overlay.appendChild(lbImg);

							function closeLightbox() {
								overlay.remove();
								document.removeEventListener('keydown', keyHandler);
							}

							lbImg.addEventListener('click', function(e) {
								e.stopPropagation();
								overlay.classList.toggle('lightbox-full');
							});

							overlay.addEventListener('click', function(e) {
								if (e.target === overlay || e.target === closeBtn) {
									closeLightbox();
								}
							});

							function keyHandler(e) {
								if (e.key === 'Escape') closeLightbox();
							}
							document.addEventListener('keydown', keyHandler);
							document.body.appendChild(overlay);
						}
						</script>
					}
				</div>
				<div>
					@ui.Card("Details") {
						<table style="width:100%;font-size:0.85rem">
							<tr>
								<td class="text-muted">Filename</td>
								<td>{ m.FileName() }</td>
							</tr>
							<tr>
								<td class="text-muted">Size</td>
								<td>{ strconv.Itoa(m.Width) }×{ strconv.Itoa(m.Height) }</td>
							</tr>
							if m.DateTaken != nil {
								<tr>
									<td class="text-muted">Date</td>
									<td>{ time.Unix(*m.DateTaken, 0).Format("Jan 2, 2006 3:04 PM") }</td>
								</tr>
							}
							if m.CameraModel != "" {
								<tr>
									<td class="text-muted">Camera</td>
									<td>{ strings.TrimSpace(m.CameraMake + " " + m.CameraModel) }</td>
								</tr>
							}
							if m.LensModel != "" {
								<tr>
									<td class="text-muted">Lens</td>
									<td>{ m.LensModel }</td>
								</tr>
							}
							if m.FNumber != nil {
								<tr>
									<td class="text-muted">Aperture</td>
									<td>f/{ fmt.Sprintf("%.1f", *m.FNumber) }</td>
								</tr>
							}
							if m.ExposureTime != "" {
								<tr>
									<td class="text-muted">Shutter</td>
									<td>{ m.ExposureTime }</td>
								</tr>
							}
							if m.ISO != nil {
								<tr>
									<td class="text-muted">ISO</td>
									<td>{ strconv.Itoa(*m.ISO) }</td>
								</tr>
							}
							if m.FocalLength != nil {
								<tr>
									<td class="text-muted">Focal Length</td>
									<td>{ fmt.Sprintf("%.0fmm", *m.FocalLength) }</td>
								</tr>
							}
							if m.PlaceName != "" {
								<tr>
									<td class="text-muted">Location</td>
									<td>{ m.PlaceName }</td>
								</tr>
							}
							if m.IsVideo() && m.DurationMs != nil {
								<tr>
									<td class="text-muted">Duration</td>
									<td>{ formatDuration(m.DurationMs) }</td>
								</tr>
								if m.VideoCodec != "" {
									<tr>
										<td class="text-muted">Codec</td>
										<td>{ m.VideoCodec }</td>
									</tr>
								}
							}
							if m.Fingerprint != "" && m.Fingerprint != "-" {
								<tr>
									<td class="text-muted">Fingerprint</td>
									<td><code style="font-size:0.75rem">{ m.Fingerprint }</code></td>
								</tr>
							}
						</table>
					}
					@ui.Card("Tags") {
						<div style="display:flex;flex-wrap:wrap;gap:4px;margin-bottom:0.5rem">
							for _, t := range tags {
								<form
									method="post"
									action={ templ.SafeURL(fmt.Sprintf("/apps/gallery/media/%d/remove-tag", m.ID)) }
									style="display:inline"
								>
									<input type="hidden" name="csrf_token" value={ csrfToken }/>
									<input type="hidden" name="tag_id" value={ strconv.FormatInt(t.ID, 10) }/>
									<button type="submit" class="badge" style="cursor:pointer;border:none;background:var(--color-bg-secondary)" title={ fmt.Sprintf("%.0f%% confidence", t.Confidence*100) }>
										{ t.Name } ×
									</button>
								</form>
							}
						</div>
						<form
							method="post"
							action={ templ.SafeURL(fmt.Sprintf("/apps/gallery/media/%d/tags", m.ID)) }
							style="display:flex;gap:4px"
						>
							<input type="hidden" name="csrf_token" value={ csrfToken }/>
							<input type="text" name="tag_name" placeholder="Add tag..." class="input input-sm" style="flex:1"/>
							<button type="submit" class="btn btn-sm">Add</button>
						</form>
					}
					@ui.Card("Faces") {
						if len(faces) > 0 {
							<div style="display:flex;flex-direction:column;gap:6px">
								for _, f := range faces {
									<div style="display:flex;align-items:center;gap:8px">
										<img
											src={ fmt.Sprintf("/apps/gallery/api/face/%d/thumbnail", f.ID) }
											alt={ faceTitle(f) }
											style="width:32px;height:32px;border-radius:50%;object-fit:cover;flex-shrink:0"
										/>
										if f.PersonID != nil {
											<a href={ templ.SafeURL(fmt.Sprintf("/apps/gallery/person/%d", *f.PersonID)) } style="text-decoration:none;font-size:0.85rem;flex:1;min-width:0">
												{ faceTitle(f) }
											</a>
										} else {
											<form
												method="post"
												action={ templ.SafeURL(fmt.Sprintf("/apps/gallery/faces/%d/new-person", f.ID)) }
												style="display:inline;flex:1;min-width:0"
											>
												<input type="hidden" name="csrf_token" value={ csrfToken }/>
												<button type="submit" class="badge" style="cursor:pointer;border:none;background:var(--color-bg);font-size:0.85rem" title="Create person from this face">
													Unknown +
												</button>
											</form>
										}
										<form
											method="post"
											action={ templ.SafeURL(fmt.Sprintf("/apps/gallery/media/%d/delete-face", m.ID)) }
											style="display:inline;flex-shrink:0"
										>
											<input type="hidden" name="csrf_token" value={ csrfToken }/>
											<input type="hidden" name="face_id" value={ strconv.FormatInt(f.ID, 10) }/>
											<button type="submit" class="btn btn-sm" style="padding:0 4px;font-size:0.7rem;line-height:1" title="Delete face">×</button>
										</form>
									</div>
								}
							</div>
						} else {
							<p class="text-muted" style="margin:0;font-size:0.85rem">No faces detected.</p>
						}
					}
					if strings.TrimSpace(m.OCRText) != "" {
						@ui.Card("Text (OCR)") {
							<pre style="white-space:pre-wrap;font-size:0.85rem;margin:0">{ strings.TrimSpace(m.OCRText) }</pre>
						}
					}
				</div>
			</div>
		</div>
	</div>
}

// --- People Page ---
templ peoplePage(activePath string, people []Person) {
	<div class="sidebar-layout">
		@gallerySidebar(activePath, 0, 0)
		<div class="sidebar-content">
			<h1>People</h1>
			if len(people) == 0 {
				@ui.Card("") {
					<p class="text-muted">No people recognized yet. Enable image recognition in settings.</p>
				}
			} else {
				<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:12px">
					for _, p := range people {
						<a
							href={ templ.SafeURL(fmt.Sprintf("/apps/gallery/person/%d", p.ID)) }
							class="card"
							style="text-decoration:none;text-align:center;padding:0.5rem"
						>
							if p.BestFaceID != nil {
								<div class="thumb-loading" style="width:100%;aspect-ratio:1;border-radius:50%;overflow:hidden;margin-bottom:0.5rem">
									<img
										src={ fmt.Sprintf("/apps/gallery/api/face/%d/thumbnail", *p.BestFaceID) }
										alt={ p.DisplayName() }
										style="width:100%;height:100%;object-fit:cover;position:relative"
										loading="lazy"
									/>
								</div>
							}
							<div style="font-weight:600">{ p.DisplayName() }</div>
							<div class="text-muted" style="font-size:0.85rem">
								{ strconv.Itoa(p.FaceCount) } photos
							</div>
						</a>
					}
				</div>
			}
		</div>
	</div>
}

// --- Person View Page ---
templ personViewPage(activePath string, person *Person, faces []FaceWithMedia, csrfToken string) {
	<div class="sidebar-layout">
		@gallerySidebar(activePath, 0, 0)
		<div class="sidebar-content">
			<div class="flex items-center gap-1 mb-2" style="justify-content:space-between">
				<h1 style="margin:0">{ person.DisplayName() }</h1>
				<div class="flex gap-1">
					@personNameForm(person, csrfToken)
					<form
						method="post"
						action={ templ.SafeURL(fmt.Sprintf("/apps/gallery/people/%d/hide", person.ID)) }
						style="display:inline"
					>
						<input type="hidden" name="csrf_token" value={ csrfToken }/>
						<button type="submit" class="btn btn-sm" title="Hide this person">Hide</button>
					</form>
				</div>
			</div>
			if len(faces) == 0 {
				@ui.Card("") {
					<p class="text-muted">No photos of this person.</p>
				}
			} else {
				@personFaceGrid(person.ID, faces, csrfToken)
			}
		</div>
	</div>
}

templ personNameForm(person *Person, csrfToken string) {
	<form
		method="post"
		action={ templ.SafeURL(fmt.Sprintf("/apps/gallery/people/%d/name", person.ID)) }
		style="display:flex;gap:4px"
	>
		<input type="hidden" name="csrf_token" value={ csrfToken }/>
		<input type="hidden" name="merge_into" value="" class="merge-target"/>
		<input type="hidden" name="contact_uid" value="" class="contact-target"/>
		<div class="picker" style="flex:1">
			<input
				type="text"
				name="name"
				value={ person.Name }
				placeholder="Name this person"
				class="form-control search-input person-name-input"
				autocomplete="off"
				hx-get={ fmt.Sprintf("/apps/gallery/api/people/search?exclude=%d", person.ID) }
				hx-trigger="input changed delay:200ms"
				hx-target="next .picker-results"
				hx-include="this"
				hx-params="name"
			/>
			<div class="picker-results"></div>
		</div>
		<button type="submit" class="btn btn-primary btn-sm">Save</button>
		<script>
		(function() {
			var form = document.currentScript.parentElement;
			var input = form.querySelector('.person-name-input');
			var results = form.querySelector('.picker-results');
			var mergeField = form.querySelector('.merge-target');
			var contactField = form.querySelector('.contact-target');

			// Close when clicking outside.
			document.addEventListener('click', function(e) {
				if (!form.contains(e.target)) results.innerHTML = '';
			});

			// Handle result click — merge into person or link to contact.
			results.addEventListener('click', function(e) {
				var opt = e.target.closest('.picker-option');
				if (!opt) return;
				var id = opt.dataset.id;
				if (id.indexOf('contact:') === 0) {
					contactField.value = id.substring(8);
					mergeField.value = '';
				} else {
					mergeField.value = id;
					contactField.value = '';
				}
				input.value = opt.dataset.name;
				results.innerHTML = '';
			});

			// Clear merge/contact targets when user edits name manually.
			input.addEventListener('input', function() {
				mergeField.value = '';
				contactField.value = '';
			});

			// Keyboard navigation.
			input.addEventListener('keydown', function(e) {
				var opts = results.querySelectorAll('.picker-option');
				if (!opts.length) return;
				var cur = results.querySelector('.picker-option.active');
				var idx = cur ? Array.prototype.indexOf.call(opts, cur) : -1;
				if (e.key === 'ArrowDown') {
					e.preventDefault();
					if (cur) cur.classList.remove('active');
					idx = (idx + 1) % opts.length;
					opts[idx].classList.add('active');
				} else if (e.key === 'ArrowUp') {
					e.preventDefault();
					if (cur) cur.classList.remove('active');
					idx = idx <= 0 ? opts.length - 1 : idx - 1;
					opts[idx].classList.add('active');
				} else if (e.key === 'Enter' && cur) {
					e.preventDefault();
					cur.click();
				} else if (e.key === 'Escape') {
					results.innerHTML = '';
				}
			});
		})();
		</script>
	</form>
}

templ personFaceGrid(personID int64, faces []FaceWithMedia, csrfToken string) {
	<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:6px">
		for _, f := range faces {
			<div style="position:relative">
				<a
					href={ templ.SafeURL(fmt.Sprintf("/apps/gallery/photo/%d", f.MediaID)) }
					class="thumb-loading"
					style="display:block;aspect-ratio:1;overflow:hidden;border-radius:4px"
				>
					<img
						src={ fmt.Sprintf("/apps/gallery/api/face/%d/thumbnail", f.ID) }
						alt=""
						style="width:100%;height:100%;object-fit:cover;position:relative"
						loading="lazy"
					/>
				</a>
				<form
					method="post"
					action={ templ.SafeURL(fmt.Sprintf("/apps/gallery/people/%d/remove-face", personID)) }
					style="position:absolute;top:4px;right:4px"
				>
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					<input type="hidden" name="face_id" value={ strconv.FormatInt(f.ID, 10) }/>
					<button type="submit" class="btn btn-sm" style="min-width:44px;min-height:44px;padding:0;font-size:1.25rem;line-height:1;background:rgba(0,0,0,0.6);color:#fff;border:none;border-radius:6px;cursor:pointer" title="Remove from this person">×</button>
				</form>
			</div>
		}
	</div>
}

// --- Tags Page ---
templ tagsPage(activePath string, tags []Tag) {
	<div class="sidebar-layout">
		@gallerySidebar(activePath, 0, 0)
		<div class="sidebar-content">
			<h1>Tags</h1>
			if len(tags) == 0 {
				@ui.Card("") {
					<p class="text-muted">No tags yet. Enable image recognition in settings.</p>
				}
			} else {
				<div style="display:flex;flex-wrap:wrap;gap:8px">
					for _, t := range tags {
						<a href={ templ.SafeURL("/apps/gallery/tag/" + t.Name) } class="badge" style="font-size:0.9rem;padding:6px 12px;text-decoration:none">
							{ t.Name }
							<span class="text-muted" style="margin-left:4px">{ strconv.Itoa(t.Count) }</span>
						</a>
					}
				</div>
			}
		</div>
	</div>
}

// --- Tag View Page ---
templ tagViewPage(activePath string, name string, media []Media) {
	<div class="sidebar-layout">
		@gallerySidebar(activePath, 0, 0)
		<div class="sidebar-content">
			<h1>Tag: { name }</h1>
			if len(media) == 0 {
				@ui.Card("") {
					<p class="text-muted">No photos with this tag.</p>
				}
			} else {
				@photoGrid(media)
			}
		</div>
	</div>
}

// --- Videos Page ---
templ videosPage(media []Media) {
	<div class="sidebar-layout">
		@gallerySidebar("/apps/gallery/videos", 0, 0)
		<div class="sidebar-content">
			<h1>Videos</h1>
			if len(media) == 0 {
				@ui.Card("") {
					<p class="text-muted">No videos found.</p>
				}
			} else {
				@photoGrid(media)
			}
		</div>
	</div>
}

// --- Starred Page ---
templ starredPage(media []Media, starredCount int) {
	<div class="sidebar-layout">
		@gallerySidebar("/apps/gallery/starred", 0, starredCount)
		<div class="sidebar-content">
			<h1>Starred</h1>
			if len(media) == 0 {
				@ui.Card("") {
					<p class="text-muted">No starred photos. Star a photo to see it here.</p>
				}
			} else {
				@photoGrid(media)
			}
		</div>
	</div>
}

// --- Duplicates Page ---
templ duplicatesPage(activePath string, groups []DuplicateGroup) {
	<div class="sidebar-layout">
		@gallerySidebar(activePath, 0, 0)
		<div class="sidebar-content">
			<h1>
				Duplicates
				if len(groups) > 0 {
					<span class="badge">{ strconv.Itoa(len(groups)) } groups</span>
				}
			</h1>
			if len(groups) == 0 {
				@ui.Card("") {
					<p class="text-muted">No duplicate photos detected.</p>
				}
			} else {
				<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:12px">
					for _, g := range groups {
						<a
							href={ templ.SafeURL(fmt.Sprintf("/apps/gallery/duplicates/%d", g.ID)) }
							class="card"
							style="text-decoration:none;padding:0;overflow:hidden"
						>
							<div class="thumb-loading" style="aspect-ratio:1;overflow:hidden">
								<img
									src={ fmt.Sprintf("/apps/gallery/api/media/%d/thumbnail?size=256", g.CoverMediaID) }
									alt=""
									style="width:100%;height:100%;object-fit:cover;position:relative"
									loading="lazy"
								/>
							</div>
							<div style="padding:0.5rem;text-align:center">
								<span class="text-muted" style="font-size:0.85rem">{ strconv.Itoa(g.MemberCount) } duplicates</span>
							</div>
						</a>
					}
				</div>
			}
		</div>
	</div>
}

// --- Duplicate Group View Page ---
templ duplicateGroupViewPage(activePath string, groupID int64, members []DuplicateMember, csrfToken string) {
	<div class="sidebar-layout">
		@gallerySidebar(activePath, 0, 0)
		<div class="sidebar-content">
			<div class="flex items-center gap-1 mb-2" style="justify-content:space-between">
				<h1 style="margin:0">
					<a href="/apps/gallery/duplicates" style="text-decoration:none">&larr;</a>
					Duplicate Group
				</h1>
				<div style="display:flex;gap:4px">
					<form
						method="post"
						action={ templ.SafeURL(fmt.Sprintf("/apps/gallery/duplicates/%d/dismiss", groupID)) }
						style="display:inline"
					>
						<input type="hidden" name="csrf_token" value={ csrfToken }/>
						<button type="submit" class="btn btn-sm">Not Duplicates</button>
					</form>
					<form
						method="post"
						action={ templ.SafeURL(fmt.Sprintf("/apps/gallery/duplicates/%d/delete", groupID)) }
						style="display:inline"
						onsubmit="return confirm('Delete non-keep files? They will be moved to trash.')"
					>
						<input type="hidden" name="csrf_token" value={ csrfToken }/>
						<button type="submit" class="btn btn-danger btn-sm">Delete Non-Keep</button>
					</form>
					<form
						method="post"
						action={ templ.SafeURL(fmt.Sprintf("/apps/gallery/duplicates/%d/delete-all", groupID)) }
						style="display:inline"
						onsubmit="return confirm('Delete ALL files in this group including the kept one? They will be moved to trash.')"
					>
						<input type="hidden" name="csrf_token" value={ csrfToken }/>
						<button type="submit" class="btn btn-danger btn-sm">Delete All</button>
					</form>
				</div>
			</div>
			<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:12px">
				for _, m := range members {
					<div class="card" style={ duplicateCardStyle(m.IsKeep) }>
						<a href={ templ.SafeURL(fmt.Sprintf("/apps/gallery/photo/%d", m.Media.ID)) } style="display:block;margin:-1.5rem -1.5rem 0.75rem;overflow:hidden;border-radius:6px 6px 0 0">
							<div class="thumb-loading" style="aspect-ratio:1">
								<img
									src={ fmt.Sprintf("/apps/gallery/api/media/%d/thumbnail?size=256", m.Media.ID) }
									alt={ m.Media.FileName() }
									style="width:100%;height:100%;object-fit:cover;position:relative"
									loading="lazy"
								/>
							</div>
						</a>
						if m.IsKeep {
							<div style="margin-bottom:0.5rem"><span class="badge" style="background:var(--color-success);color:#fff">Keep</span></div>
						}
						<table style="font-size:0.8rem;width:100%;margin-bottom:0.5rem">
							<tr>
								<td class="text-muted">Size</td>
								<td>{ strconv.Itoa(m.Media.Width) }×{ strconv.Itoa(m.Media.Height) }</td>
							</tr>
							<tr>
								<td class="text-muted">Path</td>
								<td style="word-break:break-all">{ m.Media.FileName() }</td>
							</tr>
							if m.Distance > 0 {
								<tr>
									<td class="text-muted">Distance</td>
									<td>{ fmt.Sprintf("%.0f", m.Distance) }</td>
								</tr>
							}
						</table>
						<div style="display:flex;gap:4px;flex-wrap:wrap">
							if !m.IsKeep {
								<form method="post" action={ templ.SafeURL(fmt.Sprintf("/apps/gallery/duplicates/%d/keep", groupID)) } style="display:inline">
									<input type="hidden" name="csrf_token" value={ csrfToken }/>
									<input type="hidden" name="media_id" value={ strconv.FormatInt(m.Media.ID, 10) }/>
									<button type="submit" class="btn btn-sm">Set as Keep</button>
								</form>
							}
							<form method="post" action={ templ.SafeURL(fmt.Sprintf("/apps/gallery/duplicates/%d/unmark", groupID)) } style="display:inline">
								<input type="hidden" name="csrf_token" value={ csrfToken }/>
								<input type="hidden" name="media_id" value={ strconv.FormatInt(m.Media.ID, 10) }/>
								<button type="submit" class="btn btn-sm">Not a Duplicate</button>
							</form>
							<form
								method="post"
								action={ templ.SafeURL(fmt.Sprintf("/apps/gallery/duplicates/%d/delete-member", groupID)) }
								style="display:inline"
								onsubmit="return confirm('Delete this file? It will be moved to trash.')"
							>
								<input type="hidden" name="csrf_token" value={ csrfToken }/>
								<input type="hidden" name="media_id" value={ strconv.FormatInt(m.Media.ID, 10) }/>
								<button type="submit" class="btn btn-danger btn-sm">Delete</button>
							</form>
						</div>
					</div>
				}
			</div>
		</div>
	</div>
}

// --- Settings Page (per-user) ---
templ settingsPage(db *sql.DB, total int, csrfToken string) {
	<div class="sidebar-layout">
		@gallerySidebar("/apps/gallery/settings", 0, 0)
		<div class="sidebar-content">
			<h1>Gallery Settings</h1>
			@ui.Card("Status") {
				<p>Indexed photos: <strong>{ strconv.Itoa(total) }</strong></p>
				<form method="post" action="/apps/gallery/settings/scan">
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					<button type="submit" class="btn btn-primary btn-sm">Scan Now</button>
				</form>
			}
			@ui.Card("Scan Folders") {
				<p class="text-muted" style="margin-bottom:0.75rem">
					One folder pattern per line. A trailing <code>/</code> matches everything in that folder.
					Glob patterns like <code>Camera/*.jpg</code> are also supported.
				</p>
				<form method="post" action="/apps/gallery/settings/folders">
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					<div class="form-group" style="margin-bottom:0.75rem">
						<label>Folder Patterns</label>
						<textarea name="folders" class="input" rows="4" required placeholder="Photos/">{ SettingScanFolders.MustGet(db) }</textarea>
					</div>
					<div style="display:flex;gap:8px;align-items:center">
						<button type="submit" class="btn btn-primary btn-sm">Save</button>
						<button type="button" class="btn btn-sm" hx-post="/apps/gallery/api/scan-folders-preview" hx-include="closest form" hx-target="#folder-preview">Preview</button>
					</div>
				</form>
				<div id="folder-preview" style="margin-top:0.75rem"></div>
			}
			@ui.Card("File Rename") {
				<p class="text-muted" style="margin-bottom:0.75rem">
					Rename files using a Go template pattern. Available variables:
					<code>Year, Month, Day, Hour, Minute, Second, Camera, Lens, Original, Ext, Place, Country</code>
				</p>
				<form method="post" action="/apps/gallery/rename/preview">
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					<div class="form-group" style="margin-bottom:0.75rem">
						<label>Pattern</label>
						<input
							type="text"
							name="pattern"
							class="input"
							value={ GetSetting(db, "rename_pattern", "{{.Year}}/{{.Month}}/{{.Year}}-{{.Month}}-{{.Day}}_{{.Hour}}{{.Minute}}{{.Second}}{{.Ext}}") }
							placeholder="{{.Year}}/{{.Month}}-{{.Day}}/{{.Original}}{{.Ext}}"
						/>
					</div>
					<button type="submit" class="btn btn-primary btn-sm">Preview Rename</button>
				</form>
				<form method="post" action="/apps/gallery/rename/undo" style="margin-top:0.5rem">
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					<button type="submit" class="btn btn-sm">Undo Last Rename</button>
				</form>
			}
		</div>
	</div>
}

// --- Scan Folders Preview Partial ---
templ scanFoldersPreview(folders []string, total int) {
	if total == 0 {
		<p class="text-muted" style="font-size:0.85rem">No matching media files found.</p>
	} else {
		<div class="text-muted" style="font-size:0.85rem">
			<strong>{ strconv.Itoa(total) }</strong> matching files:
			<ul style="margin:0.25rem 0 0;padding-left:1.25rem">
				for _, f := range folders {
					<li>{ f }</li>
				}
			</ul>
		</div>
	}
}

// --- System Settings Page (admin, rendered via RegisterSettingsPage) ---
templ systemSettingsPage(db *sql.DB, stats RecognitionStats, scan ScanStatus, csrfToken string) {
	<h1>Gallery Settings</h1>
	<p class="text-muted" style="margin-bottom:1rem">
		These settings apply to all users.
	</p>
	@scanStatusCard(stats, scan, csrfToken)
	@ui.Card("Tag Classification") {
		<form method="post" action="/admin/plugins/gallery">
			<input type="hidden" name="csrf_token" value={ csrfToken }/>
			<input type="hidden" name="_section" value="tags"/>
			<div class="form-group" style="margin-bottom:0.75rem">
				<label>Backend</label>
				<select name="tag_backend" class="input">
					<option value="none" selected?={ GetSetting(db, "tag_backend", "none") == "none" }>None (disabled)</option>
					<option value="onnx" selected?={ GetSetting(db, "tag_backend", "none") == "onnx" }>ONNX (local)</option>
					<option value="ollama" selected?={ GetSetting(db, "tag_backend", "none") == "ollama" }>Ollama</option>
					<option value="openai" selected?={ GetSetting(db, "tag_backend", "none") == "openai" }>OpenAI-compatible</option>
				</select>
			</div>
			<div class="form-group" style="margin-bottom:0.75rem" id="tag-model-group">
				<label>ONNX Tag Model</label>
				<select name="tag_model" class="input">
					<option value="joytag" selected?={ GetSetting(db, "tag_model", "joytag") == "joytag" }>JoyTag (multi-label, photos)</option>
					<option value="wd14" selected?={ GetSetting(db, "tag_model", "joytag") == "wd14" }>WD14 (multi-label, general)</option>
					<option value="mobilenet" selected?={ GetSetting(db, "tag_model", "joytag") == "mobilenet" }>MobileNet (ImageNet, legacy)</option>
				</select>
				<small class="text-muted">Only used when backend is ONNX.</small>
			</div>
			<div class="form-group" style="margin-bottom:0.75rem">
				<label>Minimum Confidence</label>
				<input type="number" name="tag_min_confidence" class="input" value={ GetSetting(db, "tag_min_confidence", "0.5") } step="0.05" min="0" max="1"/>
				<small class="text-muted">Tags below this confidence are discarded. Default: 0.5</small>
			</div>
			<button type="submit" class="btn btn-primary btn-sm">Save</button>
			<script>
			(function() {
				var sel = document.querySelector('select[name="tag_backend"]');
				var group = document.getElementById('tag-model-group');
				function update() { group.style.display = sel.value === 'onnx' ? '' : 'none'; }
				sel.addEventListener('change', update);
				update();
			})();
			</script>
		</form>
	}
	@ui.Card("Face Detection") {
		<form method="post" action="/admin/plugins/gallery">
			<input type="hidden" name="csrf_token" value={ csrfToken }/>
			<input type="hidden" name="_section" value="faces"/>
			<div class="form-group" style="margin-bottom:0.75rem">
				<label>Backend</label>
				<select name="face_backend" class="input">
					<option value="none" selected?={ GetSetting(db, "face_backend", "none") == "none" }>None (disabled)</option>
					<option value="onnx" selected?={ GetSetting(db, "face_backend", "none") == "onnx" }>ONNX (SCRFD + ArcFace)</option>
					<option value="pigo" selected?={ GetSetting(db, "face_backend", "none") == "pigo" }>Pigo (detection only, no embeddings)</option>
				</select>
			</div>
			<div class="form-group" style="margin-bottom:0.75rem">
				<label>Minimum Confidence</label>
				<input type="number" name="face_min_confidence" class="input" value={ GetSetting(db, "face_min_confidence", "0.7") } step="0.05" min="0" max="1"/>
				<small class="text-muted">Faces below this confidence are discarded. Default: 0.7</small>
			</div>
			<div class="form-group" style="margin-bottom:0.75rem">
				<label>Cluster Threshold</label>
				<input type="number" name="cluster_threshold" class="input" value={ GetSetting(db, "cluster_threshold", "0.35") } step="0.01" min="0.01" max="1.0"/>
				<small class="text-muted">Cosine distance threshold for grouping faces into people (lower = stricter). Default: 0.35</small>
			</div>
			<button type="submit" class="btn btn-primary btn-sm">Save</button>
		</form>
	}
	@ui.Card("Duplicate Detection") {
		<form method="post" action="/admin/plugins/gallery">
			<input type="hidden" name="csrf_token" value={ csrfToken }/>
			<input type="hidden" name="_section" value="duplicates"/>
			<div class="form-group" style="margin-bottom:0.75rem">
				<label>
					<input type="checkbox" name="duplicate_detection_enabled" value="true" checked?={ GetSetting(db, "duplicate_detection_enabled", "true") == "true" }/>
					Enable duplicate detection
				</label>
			</div>
			<div class="form-group" style="margin-bottom:0.75rem">
				<label>Algorithm</label>
				<select name="duplicate_algorithm" class="input">
					<option value="difference" selected?={ GetSetting(db, "duplicate_algorithm", "difference") == "difference" }>Difference Hash</option>
					<option value="average" selected?={ GetSetting(db, "duplicate_algorithm", "difference") == "average" }>Average Hash</option>
					<option value="phash" selected?={ GetSetting(db, "duplicate_algorithm", "difference") == "phash" }>Perceptual Hash (pHash)</option>
					<option value="median" selected?={ GetSetting(db, "duplicate_algorithm", "difference") == "median" }>Median Hash</option>
					<option value="blockmean" selected?={ GetSetting(db, "duplicate_algorithm", "difference") == "blockmean" }>Block Mean Hash</option>
				</select>
			</div>
			<div class="form-group" style="margin-bottom:0.75rem">
				<label>Distance Threshold</label>
				<input type="number" name="duplicate_distance" class="input" value={ GetSetting(db, "duplicate_distance", "5") } min="0" max="64"/>
				<small class="text-muted">Maximum Hamming distance to consider images duplicates (lower = stricter). Default: 5</small>
			</div>
			<button type="submit" class="btn btn-primary btn-sm">Save</button>
		</form>
	}
	@ui.Card("OCR") {
		<form method="post" action="/admin/plugins/gallery">
			<input type="hidden" name="csrf_token" value={ csrfToken }/>
			<input type="hidden" name="_section" value="ocr"/>
			<div class="form-group" style="margin-bottom:0.75rem">
				<label>
					<input type="checkbox" name="ocr_enabled" value="true" checked?={ GetSetting(db, "ocr_enabled", "true") == "true" }/>
					Enable OCR text extraction
				</label>
				<small class="text-muted">Requires tesseract to be installed on the system.</small>
			</div>
			<button type="submit" class="btn btn-primary btn-sm">Save</button>
		</form>
	}
	@ui.Card("Processing") {
		<form method="post" action="/admin/plugins/gallery">
			<input type="hidden" name="csrf_token" value={ csrfToken }/>
			<input type="hidden" name="_section" value="processing"/>
			<div class="form-group" style="margin-bottom:0.75rem">
				<label>
					<input type="checkbox" name="preview_generation_enabled" value="true" checked?={ GetSetting(db, "preview_generation_enabled", "true") == "true" }/>
					Pre-generate thumbnails during scan
				</label>
			</div>
			<div class="form-group" style="margin-bottom:0.75rem">
				<label>
					<input type="checkbox" name="quality_scoring_enabled" value="true" checked?={ GetSetting(db, "quality_scoring_enabled", "true") == "true" }/>
					Compute image quality scores (sharpness)
				</label>
			</div>
			<button type="submit" class="btn btn-primary btn-sm">Save</button>
		</form>
	}
	@ui.Card("Backend Configuration") {
		<form method="post" action="/admin/plugins/gallery">
			<input type="hidden" name="csrf_token" value={ csrfToken }/>
			<input type="hidden" name="_section" value="backend"/>
			<p class="text-muted" style="margin-bottom:0.75rem;font-size:0.85rem">Shared connection settings for tag classification and face detection backends.</p>
			<div class="form-group" style="margin-bottom:0.75rem">
				<label>ONNX Runtime Library Path</label>
				<input type="text" name="onnx_library_path" class="input" value={ GetSetting(db, "onnx_library_path", "") } placeholder="/usr/lib/libonnxruntime.so"/>
				<small class="text-muted">Leave blank to auto-detect.</small>
			</div>
			<div class="form-group" style="margin-bottom:0.75rem">
				<label>ONNX Models Directory</label>
				<input type="text" name="onnx_models_dir" class="input" value={ GetSetting(db, "onnx_models_dir", "") } placeholder="(auto: data dir)"/>
			</div>
			<div class="form-group" style="margin-bottom:0.75rem">
				<label>Ollama / OpenAI URL</label>
				<input type="text" name="recognition_url" class="input" value={ GetSetting(db, "recognition_url", "") } placeholder="http://localhost:11434"/>
			</div>
			<div class="form-group" style="margin-bottom:0.75rem">
				<label>API Key</label>
				<input type="password" name="recognition_api_key" class="input" value={ GetSetting(db, "recognition_api_key", "") } placeholder="sk-..."/>
			</div>
			<div class="form-group" style="margin-bottom:0.75rem">
				<label>Model</label>
				<input type="text" name="recognition_model" class="input" value={ GetSetting(db, "recognition_model", "") } placeholder="llava:13b"/>
			</div>
			<button type="submit" class="btn btn-primary btn-sm">Save</button>
		</form>
	}
}

// scanStatusCard renders the background scan status card (used as full-page component and HTMX partial).
templ scanStatusCard(stats RecognitionStats, scan ScanStatus, csrfToken string) {
	<div
		id="scan-status"
		if scan.Running {
			hx-get="/apps/gallery/api/scan-status"
			hx-trigger="every 2s"
			hx-swap="outerHTML"
		}
	>
		@ui.Card("Background Scan") {
			<table style="font-size:0.9rem;margin-bottom:0.75rem">
				<tr>
					<td class="text-muted" style="padding-right:1rem">Status</td>
					<td>
						if scan.Running {
							<span class="badge" style="background:var(--color-primary);color:#fff">Running</span>
						} else {
							<span>Idle</span>
						}
					</td>
				</tr>
				if !scan.LastRun.IsZero() {
					<tr>
						<td class="text-muted" style="padding-right:1rem">Last run</td>
						<td>{ scan.LastRun.Format("Jan 2, 2006 3:04:05 PM") }</td>
					</tr>
				}
				if scan.LastError != nil {
					<tr>
						<td class="text-muted" style="padding-right:1rem">Last error</td>
						<td style="color:var(--color-danger)">{ scan.LastError.Error() }</td>
					</tr>
				}
				if len(scan.Warnings) > 0 {
					<tr>
						<td class="text-muted" style="padding-right:1rem;vertical-align:top">Warnings</td>
						<td style="color:var(--color-warning)">
							for _, w := range scan.Warnings {
								<div>{ w }</div>
							}
						</td>
					</tr>
				}
				<tr>
					<td class="text-muted" style="padding-right:1rem">Total images</td>
					<td><strong>{ strconv.Itoa(stats.TotalImages) }</strong></td>
				</tr>
				<tr>
					<td class="text-muted" style="padding-right:1rem">Recognition done</td>
					<td>{ strconv.Itoa(stats.Done) }</td>
				</tr>
				<tr>
					<td class="text-muted" style="padding-right:1rem">Pending</td>
					<td>{ strconv.Itoa(stats.Pending) }</td>
				</tr>
				if stats.Errored > 0 {
					<tr>
						<td class="text-muted" style="padding-right:1rem;vertical-align:top">Errored</td>
						<td style="color:var(--color-danger)">
							{ strconv.Itoa(stats.Errored) }
							if len(stats.Errors) > 0 {
								for _, e := range stats.Errors {
									<div style="font-size:0.85rem">{ e }</div>
								}
							}
						</td>
					</tr>
				}
			</table>
			<div style="display:flex;gap:0.5rem">
				<form method="post" action="/admin/plugins/gallery/scan">
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					<button type="submit" class="btn btn-primary btn-sm" disabled?={ scan.Running }>
						if scan.Running {
							Scanning...
						} else {
							Scan All Users
						}
					</button>
				</form>
				if (stats.Done > 0 || stats.Errored > 0) && !scan.Running {
					<form method="post" action="/admin/plugins/gallery/purge-recognitions" onsubmit="return confirm('Purge all recognition data? Tags, faces, and people will be deleted and images re-queued for recognition.')">
						<input type="hidden" name="csrf_token" value={ csrfToken }/>
						<button type="submit" class="btn btn-danger btn-sm">
							Purge Recognitions
						</button>
					</form>
				}
			</div>
		}
	</div>
}

// --- Rename Preview Page ---
templ renamePreviewPage(pattern string, previews []RenamePreview, csrfToken string) {
	<div class="sidebar-layout">
		@gallerySidebar("/apps/gallery/settings", 0, 0)
		<div class="sidebar-content">
			<h1>Rename Preview</h1>
			<p>Pattern: <code>{ pattern }</code></p>
			if len(previews) == 0 {
				@ui.Card("") {
					<p class="text-muted">No files would be renamed with this pattern.</p>
				}
			} else {
				<p>{ strconv.Itoa(len(previews)) } files will be renamed:</p>
				@ui.Card("") {
					<table style="width:100%;font-size:0.85rem">
						<thead>
							<tr>
								<th>Current Path</th>
								<th>New Path</th>
							</tr>
						</thead>
						<tbody>
							for _, p := range previews {
								<tr>
									<td>{ p.OldPath }</td>
									<td>{ p.NewPath }</td>
								</tr>
							}
						</tbody>
					</table>
				}
				<form method="post" action="/apps/gallery/rename/apply" style="margin-top:1rem">
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					<input type="hidden" name="pattern" value={ pattern }/>
					<button type="submit" class="btn btn-primary">Apply Rename</button>
					<a href="/apps/gallery/settings" class="btn" style="margin-left:0.5rem">Cancel</a>
				</form>
			}
		</div>
	</div>
}
