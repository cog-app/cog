package gallery

import (
	"database/sql"
	"fmt"
	"strconv"
	"strings"
	"time"

	"git.duckfam.us/jj-software/cog/ui"
)

// --- Gallery Sidebar ---
templ gallerySidebar(activePath string, total int) {
	<nav class="sidebar" id="gallery-sidebar">
		<a href="/apps/gallery/" class={ sidebarClass(activePath, "/apps/gallery/") }>
			Timeline
			if total > 0 {
				<span class="badge">{ strconv.Itoa(total) }</span>
			}
		</a>
		<a href="/apps/gallery/albums" class={ sidebarClass(activePath, "/apps/gallery/albums") }>
			Albums
		</a>
		<a href="/apps/gallery/people" class={ sidebarClass(activePath, "/apps/gallery/people") }>
			People
		</a>
		<a href="/apps/gallery/tags" class={ sidebarClass(activePath, "/apps/gallery/tags") }>
			Tags
		</a>
		<a href="/apps/gallery/videos" class={ sidebarClass(activePath, "/apps/gallery/videos") }>
			Videos
		</a>
		<div class="sidebar-divider"></div>
		<a href="/apps/gallery/settings" class={ sidebarClass(activePath, "/apps/gallery/settings") }>
			Settings
		</a>
	</nav>
}

func sidebarClass(activePath, itemPath string) string {
	if activePath == itemPath || (itemPath != "/apps/gallery/" && strings.HasPrefix(activePath, itemPath)) {
		return "sidebar-item active"
	}
	return "sidebar-item"
}

// --- Photo Grid ---
templ photoGrid(media []Media) {
	<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:6px">
		for _, m := range media {
			<a
				href={ templ.SafeURL(fmt.Sprintf("/apps/gallery/photo/%d", m.ID)) }
				style="aspect-ratio:1;overflow:hidden;border-radius:4px;position:relative"
			>
				<img
					src={ fmt.Sprintf("/apps/gallery/api/media/%d/thumbnail?size=256", m.ID) }
					alt={ m.FileName() }
					style="width:100%;height:100%;object-fit:cover"
					loading="lazy"
				/>
				if m.IsVideo() {
					<span style="position:absolute;bottom:4px;right:4px;background:rgba(0,0,0,0.6);color:#fff;padding:2px 6px;border-radius:3px;font-size:0.75rem">
						{ formatDuration(m.DurationMs) }
					</span>
				}
			</a>
		}
	</div>
}

func formatDuration(ms *int64) string {
	if ms == nil {
		return ""
	}
	secs := *ms / 1000
	if secs < 60 {
		return fmt.Sprintf("0:%02d", secs)
	}
	return fmt.Sprintf("%d:%02d", secs/60, secs%60)
}

// --- Timeline Page ---
templ timelinePage(activePath string, days []TimelineDay, media []Media, total int) {
	<div class="sidebar-layout">
		@gallerySidebar(activePath, total)
		<div class="sidebar-content">
			<h1>Timeline</h1>
			if len(media) == 0 {
				@ui.Card("") {
					<p class="text-muted">No photos yet. Upload some images to your file storage to get started.</p>
				}
			} else {
				@photoGrid(media)
			}
		</div>
	</div>
}

// --- Albums Page ---
templ albumsPage(activePath string, albums []Album) {
	<div class="sidebar-layout">
		@gallerySidebar(activePath, 0)
		<div class="sidebar-content">
			<div class="flex items-center gap-1 mb-2" style="justify-content:space-between">
				<h1 style="margin:0">Albums</h1>
			</div>
			if len(albums) == 0 {
				@ui.Card("") {
					<p class="text-muted">No albums yet.</p>
				}
			} else {
				<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:12px">
					for _, a := range albums {
						<a
							href={ templ.SafeURL(fmt.Sprintf("/apps/gallery/album/%d", a.ID)) }
							class="card"
							style="text-decoration:none"
						>
							<div style="padding:1rem">
								<div style="font-weight:600">{ a.Name }</div>
								<div class="text-muted" style="font-size:0.85rem">
									{ strconv.Itoa(a.MediaCount) } items
									if a.AlbumType > 0 {
										<span>· { a.AlbumTypeName() }</span>
									}
								</div>
							</div>
						</a>
					}
				</div>
			}
		</div>
	</div>
}

// --- Album View Page ---
templ albumViewPage(activePath string, album *Album, media []Media, csrfToken string) {
	<div class="sidebar-layout">
		@gallerySidebar(activePath, 0)
		<div class="sidebar-content">
			<div class="flex items-center gap-1 mb-2" style="justify-content:space-between">
				<h1 style="margin:0">{ album.Name }</h1>
				if album.AlbumType == AlbumManual {
					<form
						method="post"
						action={ templ.SafeURL(fmt.Sprintf("/apps/gallery/albums/%d", album.ID)) }
						style="display:inline"
					>
						<input type="hidden" name="csrf_token" value={ csrfToken }/>
						<button
							type="submit"
							class="btn btn-danger btn-sm"
							hx-delete={ fmt.Sprintf("/apps/gallery/albums/%d", album.ID) }
							hx-confirm="Delete this album?"
						>
							Delete
						</button>
					</form>
				}
			</div>
			if album.Description != "" {
				<p class="text-muted">{ album.Description }</p>
			}
			if len(media) == 0 {
				@ui.Card("") {
					<p class="text-muted">This album is empty.</p>
				}
			} else {
				@photoGrid(media)
			}
		</div>
	</div>
}

// --- Photo View Page ---
templ photoViewPage(activePath string, m *Media, tags []Tag) {
	<div class="sidebar-layout">
		@gallerySidebar(activePath, 0)
		<div class="sidebar-content">
			<div style="display:grid;grid-template-columns:1fr 300px;gap:1rem">
				<div>
					if m.IsVideo() {
						<video controls style="max-width:100%;border-radius:4px">
							<source src={ fmt.Sprintf("/api/files/download?path=%s", m.FilePath) } type={ m.MimeType }/>
						</video>
					} else {
						<img
							src={ fmt.Sprintf("/apps/gallery/api/media/%d/thumbnail?size=1024", m.ID) }
							alt={ m.FileName() }
							style="max-width:100%;border-radius:4px"
						/>
					}
				</div>
				<div>
					@ui.Card("Details") {
						<table style="width:100%;font-size:0.85rem">
							<tr>
								<td class="text-muted">Filename</td>
								<td>{ m.FileName() }</td>
							</tr>
							<tr>
								<td class="text-muted">Size</td>
								<td>{ strconv.Itoa(m.Width) }×{ strconv.Itoa(m.Height) }</td>
							</tr>
							if m.DateTaken != nil {
								<tr>
									<td class="text-muted">Date</td>
									<td>{ time.Unix(*m.DateTaken, 0).Format("Jan 2, 2006 3:04 PM") }</td>
								</tr>
							}
							if m.CameraModel != "" {
								<tr>
									<td class="text-muted">Camera</td>
									<td>{ strings.TrimSpace(m.CameraMake + " " + m.CameraModel) }</td>
								</tr>
							}
							if m.LensModel != "" {
								<tr>
									<td class="text-muted">Lens</td>
									<td>{ m.LensModel }</td>
								</tr>
							}
							if m.FNumber != nil {
								<tr>
									<td class="text-muted">Aperture</td>
									<td>f/{ fmt.Sprintf("%.1f", *m.FNumber) }</td>
								</tr>
							}
							if m.ExposureTime != "" {
								<tr>
									<td class="text-muted">Shutter</td>
									<td>{ m.ExposureTime }</td>
								</tr>
							}
							if m.ISO != nil {
								<tr>
									<td class="text-muted">ISO</td>
									<td>{ strconv.Itoa(*m.ISO) }</td>
								</tr>
							}
							if m.FocalLength != nil {
								<tr>
									<td class="text-muted">Focal Length</td>
									<td>{ fmt.Sprintf("%.0fmm", *m.FocalLength) }</td>
								</tr>
							}
							if m.PlaceName != "" {
								<tr>
									<td class="text-muted">Location</td>
									<td>{ m.PlaceName }</td>
								</tr>
							}
							if m.IsVideo() && m.DurationMs != nil {
								<tr>
									<td class="text-muted">Duration</td>
									<td>{ formatDuration(m.DurationMs) }</td>
								</tr>
								if m.VideoCodec != "" {
									<tr>
										<td class="text-muted">Codec</td>
										<td>{ m.VideoCodec }</td>
									</tr>
								}
							}
						</table>
					}
					if len(tags) > 0 {
						@ui.Card("Tags") {
							<div style="display:flex;flex-wrap:wrap;gap:4px">
								for _, t := range tags {
									<span class="badge">{ t.Name }</span>
								}
							</div>
						}
					}
					if strings.TrimSpace(m.OCRText) != "" {
						@ui.Card("Text (OCR)") {
							<pre style="white-space:pre-wrap;font-size:0.85rem;margin:0">{ strings.TrimSpace(m.OCRText) }</pre>
						}
					}
				</div>
			</div>
		</div>
	</div>
}

// --- People Page ---
templ peoplePage(activePath string, people []Person) {
	<div class="sidebar-layout">
		@gallerySidebar(activePath, 0)
		<div class="sidebar-content">
			<h1>People</h1>
			if len(people) == 0 {
				@ui.Card("") {
					<p class="text-muted">No people recognized yet. Enable image recognition in settings.</p>
				}
			} else {
				<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:12px">
					for _, p := range people {
						<a
							href={ templ.SafeURL(fmt.Sprintf("/apps/gallery/person/%d", p.ID)) }
							class="card"
							style="text-decoration:none;text-align:center;padding:1rem"
						>
							<div style="font-weight:600">{ p.DisplayName() }</div>
							<div class="text-muted" style="font-size:0.85rem">
								{ strconv.Itoa(p.FaceCount) } photos
							</div>
						</a>
					}
				</div>
			}
		</div>
	</div>
}

// --- Person View Page ---
templ personViewPage(activePath string, person *Person, media []Media, csrfToken string) {
	<div class="sidebar-layout">
		@gallerySidebar(activePath, 0)
		<div class="sidebar-content">
			<div class="flex items-center gap-1 mb-2" style="justify-content:space-between">
				<h1 style="margin:0">{ person.DisplayName() }</h1>
				<div class="flex gap-1">
					<form
						method="post"
						action={ templ.SafeURL(fmt.Sprintf("/apps/gallery/people/%d/name", person.ID)) }
						style="display:flex;gap:4px"
					>
						<input type="hidden" name="csrf_token" value={ csrfToken }/>
						<input type="text" name="name" value={ person.Name } placeholder="Name this person" class="input input-sm"/>
						<button type="submit" class="btn btn-primary btn-sm">Save</button>
					</form>
				</div>
			</div>
			if len(media) == 0 {
				@ui.Card("") {
					<p class="text-muted">No photos of this person.</p>
				}
			} else {
				@photoGrid(media)
			}
		</div>
	</div>
}

// --- Tags Page ---
templ tagsPage(activePath string, tags []Tag) {
	<div class="sidebar-layout">
		@gallerySidebar(activePath, 0)
		<div class="sidebar-content">
			<h1>Tags</h1>
			if len(tags) == 0 {
				@ui.Card("") {
					<p class="text-muted">No tags yet. Enable image recognition in settings.</p>
				}
			} else {
				<div style="display:flex;flex-wrap:wrap;gap:8px">
					for _, t := range tags {
						<span class="badge" style="font-size:0.9rem;padding:6px 12px">
							{ t.Name }
							<span class="text-muted" style="margin-left:4px">{ strconv.Itoa(t.Count) }</span>
						</span>
					}
				</div>
			}
		</div>
	</div>
}

// --- Videos Page ---
templ videosPage(media []Media) {
	<div class="sidebar-layout">
		@gallerySidebar("/apps/gallery/videos", 0)
		<div class="sidebar-content">
			<h1>Videos</h1>
			if len(media) == 0 {
				@ui.Card("") {
					<p class="text-muted">No videos found.</p>
				}
			} else {
				@photoGrid(media)
			}
		</div>
	</div>
}

// --- Settings Page (per-user) ---
templ settingsPage(db *sql.DB, total int, csrfToken string) {
	<div class="sidebar-layout">
		@gallerySidebar("/apps/gallery/settings", 0)
		<div class="sidebar-content">
			<h1>Gallery Settings</h1>
			@ui.Card("Status") {
				<p>Indexed photos: <strong>{ strconv.Itoa(total) }</strong></p>
				<form method="post" action="/apps/gallery/settings/scan">
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					<button type="submit" class="btn btn-primary btn-sm">Scan Now</button>
				</form>
			}
			@ui.Card("File Rename") {
				<p class="text-muted" style="margin-bottom:0.75rem">
					Rename files using a Go template pattern. Available variables:
					<code>Year, Month, Day, Hour, Minute, Second, Camera, Lens, Original, Ext, Place, Country</code>
				</p>
				<form method="post" action="/apps/gallery/rename/preview">
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					<div class="form-group" style="margin-bottom:0.75rem">
						<label>Pattern</label>
						<input
							type="text"
							name="pattern"
							class="input"
							value={ GetSetting(db, "rename_pattern", "{{.Year}}/{{.Month}}/{{.Year}}-{{.Month}}-{{.Day}}_{{.Hour}}{{.Minute}}{{.Second}}{{.Ext}}") }
							placeholder="{{.Year}}/{{.Month}}-{{.Day}}/{{.Original}}{{.Ext}}"
						/>
					</div>
					<button type="submit" class="btn btn-primary btn-sm">Preview Rename</button>
				</form>
				<form method="post" action="/apps/gallery/rename/undo" style="margin-top:0.5rem">
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					<button type="submit" class="btn btn-sm">Undo Last Rename</button>
				</form>
			}
		</div>
	</div>
}

// --- System Settings Page (admin, rendered via RegisterSettingsPage) ---
templ systemSettingsPage(db *sql.DB, stats RecognitionStats, scan ScanStatus, csrfToken string) {
	<h1>Gallery Settings</h1>
	<p class="text-muted" style="margin-bottom:1rem">
		These settings apply to all users.
	</p>
	@scanStatusCard(stats, scan, csrfToken)
	@ui.Card("Image Recognition") {
		<form method="post" action="/admin/plugins/gallery">
			<input type="hidden" name="csrf_token" value={ csrfToken }/>
			<div class="form-group" style="margin-bottom:0.75rem">
				<label>
					<input
						type="checkbox"
						name="recognition_enabled"
						value="true"
						checked?={ GetSetting(db, "recognition_enabled", "false") == "true" }
					/>
					Enable image recognition
				</label>
			</div>
			<div class="form-group" style="margin-bottom:0.75rem">
				<label>Backend</label>
				<select name="recognition_backend" class="input">
					<option value="none" selected?={ GetSetting(db, "recognition_backend", "none") == "none" }>None</option>
					<option value="pigo" selected?={ GetSetting(db, "recognition_backend", "none") == "pigo" }>Pigo (local face detection)</option>
					<option value="ollama" selected?={ GetSetting(db, "recognition_backend", "none") == "ollama" }>Ollama</option>
					<option value="openai" selected?={ GetSetting(db, "recognition_backend", "none") == "openai" }>OpenAI-compatible</option>
					<option value="onnx" selected?={ GetSetting(db, "recognition_backend", "none") == "onnx" }>ONNX (local)</option>
				</select>
			</div>
			<div class="form-group" style="margin-bottom:0.75rem">
				<label>URL</label>
				<input
					type="text"
					name="recognition_url"
					class="input"
					value={ GetSetting(db, "recognition_url", "") }
					placeholder="http://localhost:11434"
				/>
			</div>
			<div class="form-group" style="margin-bottom:0.75rem">
				<label>API Key (for OpenAI)</label>
				<input
					type="password"
					name="recognition_api_key"
					class="input"
					value={ GetSetting(db, "recognition_api_key", "") }
					placeholder="sk-..."
				/>
			</div>
			<div class="form-group" style="margin-bottom:0.75rem">
				<label>Model</label>
				<input
					type="text"
					name="recognition_model"
					class="input"
					value={ GetSetting(db, "recognition_model", "") }
					placeholder="llava:13b"
				/>
			</div>
			<div class="form-group" style="margin-bottom:0.75rem">
				<label>ONNX Runtime Library Path</label>
				<input
					type="text"
					name="onnx_library_path"
					class="input"
					value={ GetSetting(db, "onnx_library_path", "") }
					placeholder="/usr/lib/libonnxruntime.so"
				/>
				<small class="text-muted">Required for ONNX backend. Leave blank to auto-detect.</small>
			</div>
			<div class="form-group" style="margin-bottom:0.75rem">
				<label>ONNX Models Directory</label>
				<input
					type="text"
					name="onnx_models_dir"
					class="input"
					value={ GetSetting(db, "onnx_models_dir", "") }
					placeholder="(auto: data dir)"
				/>
				<small class="text-muted">Where to store ONNX model files. Leave blank for default.</small>
			</div>
			<button type="submit" class="btn btn-primary btn-sm">Save</button>
		</form>
	}
}

// scanStatusCard renders the background scan status card (used as full-page component and HTMX partial).
templ scanStatusCard(stats RecognitionStats, scan ScanStatus, csrfToken string) {
	<div
		id="scan-status"
		if scan.Running {
			hx-get="/apps/gallery/api/scan-status"
			hx-trigger="every 2s"
			hx-swap="outerHTML"
		}
	>
		@ui.Card("Background Scan") {
			<table style="font-size:0.9rem;margin-bottom:0.75rem">
				<tr>
					<td class="text-muted" style="padding-right:1rem">Status</td>
					<td>
						if scan.Running {
							<span class="badge" style="background:var(--color-primary);color:#fff">Running</span>
						} else {
							<span>Idle</span>
						}
					</td>
				</tr>
				if !scan.LastRun.IsZero() {
					<tr>
						<td class="text-muted" style="padding-right:1rem">Last run</td>
						<td>{ scan.LastRun.Format("Jan 2, 2006 3:04:05 PM") }</td>
					</tr>
				}
				if scan.LastError != nil {
					<tr>
						<td class="text-muted" style="padding-right:1rem">Last error</td>
						<td style="color:var(--color-danger)">{ scan.LastError.Error() }</td>
					</tr>
				}
				if len(scan.Warnings) > 0 {
					<tr>
						<td class="text-muted" style="padding-right:1rem;vertical-align:top">Warnings</td>
						<td style="color:var(--color-warning)">
							for _, w := range scan.Warnings {
								<div>{ w }</div>
							}
						</td>
					</tr>
				}
				<tr>
					<td class="text-muted" style="padding-right:1rem">Total images</td>
					<td><strong>{ strconv.Itoa(stats.TotalImages) }</strong></td>
				</tr>
				<tr>
					<td class="text-muted" style="padding-right:1rem">Recognition done</td>
					<td>{ strconv.Itoa(stats.Done) }</td>
				</tr>
				<tr>
					<td class="text-muted" style="padding-right:1rem">Pending</td>
					<td>{ strconv.Itoa(stats.Pending) }</td>
				</tr>
				if stats.Errored > 0 {
					<tr>
						<td class="text-muted" style="padding-right:1rem">Errored</td>
						<td>{ strconv.Itoa(stats.Errored) }</td>
					</tr>
				}
			</table>
			<form method="post" action="/admin/plugins/gallery/scan">
				<input type="hidden" name="csrf_token" value={ csrfToken }/>
				<button type="submit" class="btn btn-primary btn-sm" disabled?={ scan.Running }>
					if scan.Running {
						Scanning...
					} else {
						Scan All Users
					}
				</button>
			</form>
		}
	</div>
}

// --- Rename Preview Page ---
templ renamePreviewPage(pattern string, previews []RenamePreview, csrfToken string) {
	<div class="sidebar-layout">
		@gallerySidebar("/apps/gallery/settings", 0)
		<div class="sidebar-content">
			<h1>Rename Preview</h1>
			<p>Pattern: <code>{ pattern }</code></p>
			if len(previews) == 0 {
				@ui.Card("") {
					<p class="text-muted">No files would be renamed with this pattern.</p>
				}
			} else {
				<p>{ strconv.Itoa(len(previews)) } files will be renamed:</p>
				@ui.Card("") {
					<table style="width:100%;font-size:0.85rem">
						<thead>
							<tr>
								<th>Current Path</th>
								<th>New Path</th>
							</tr>
						</thead>
						<tbody>
							for _, p := range previews {
								<tr>
									<td>{ p.OldPath }</td>
									<td>{ p.NewPath }</td>
								</tr>
							}
						</tbody>
					</table>
				}
				<form method="post" action="/apps/gallery/rename/apply" style="margin-top:1rem">
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					<input type="hidden" name="pattern" value={ pattern }/>
					<button type="submit" class="btn btn-primary">Apply Rename</button>
					<a href="/apps/gallery/settings" class="btn" style="margin-left:0.5rem">Cancel</a>
				</form>
			}
		</div>
	</div>
}
