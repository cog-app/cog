package calendar

import (
	"fmt"
	"time"

	"git.duckfam.us/jj-software/cog/ui"
)

templ eventsWidget(events []EventWithCalendar, now time.Time) {
	if len(events) == 0 {
		@ui.WidgetEmpty("Nothing coming up.", "Open calendar", "/apps/calendar/")
	} else {
		<ul class="widget-list">
			for _, ev := range events {
				<li class="cal-widget-row">
					<span class="color-dot" style={ "background:" + widgetColor(ev) }></span>
					<div class="cal-widget-text">
						<a class="cal-widget-title" href={ templ.SafeURL(fmt.Sprintf("/apps/calendar/?date=%s&event=%d", widgetDate(ev), ev.ID)) }>{ ev.Summary }</a>
						<div class="text-sm text-muted">{ formatEventTime(ev.DTStart, ev.DTEnd, ev.IsAllDay, ev.Zone(), now) }</div>
					</div>
				</li>
			}
		</ul>
	}
}

// widgetDate is the day an event starts, which the calendar opens on.
func widgetDate(ev EventWithCalendar) string {
	t := time.Unix(ev.DTStart, 0)
	if ev.IsAllDay {
		return t.UTC().Format("2006-01-02")
	}
	return t.In(ev.Zone()).Format("2006-01-02")
}

func widgetColor(ev EventWithCalendar) string {
	if ev.Color != "" {
		return ev.Color
	}
	return ev.CalendarColor
}
