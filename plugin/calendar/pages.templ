package calendar

import (
	"fmt"
	"git.duckfam.us/jj-software/cog/ui"
	"strconv"
	"time"
)

templ calSidebar(calendars []Calendar, activePath string, csrfToken string) {
	<nav class="sidebar">
		<a href="/apps/calendar/" class={ sidebarClass(activePath, "/apps/calendar/") }>All Events</a>
		<div class="sidebar-divider"></div>
		<div style="padding:0.25rem 0.75rem;font-size:0.8rem;font-weight:600;text-transform:uppercase;color:var(--color-muted, #888)">Calendars</div>
		for _, cal := range calendars {
			<label class="sidebar-item" style="display:flex;align-items:center;gap:0.5rem;cursor:pointer">
				<input
					type="checkbox"
					class="cal-toggle"
					data-calendar-id={ strconv.FormatInt(cal.ID, 10) }
					checked
					style="accent-color:var(--cal-color);--cal-color:inherit"
				/>
				<span style={ fmt.Sprintf("display:inline-block;width:10px;height:10px;border-radius:50%%;background:%s;flex-shrink:0", cal.Color) }></span>
				{ cal.Name }
			</label>
		}
		<div class="sidebar-divider"></div>
		<a href="/apps/calendar/settings" class={ sidebarClass(activePath, "/apps/calendar/settings") }>Settings</a>
	</nav>
}

templ calIndexPage(calendars []Calendar, csrfToken string) {
	<script src={ ui.Static.URL("vendor/fullcalendar.min.js") }></script>
	<div class="sidebar-layout">
		@calSidebar(calendars, "/apps/calendar/", csrfToken)
		<div class="sidebar-content">
			<div id="calendar" style="min-height:600px"></div>
		</div>
	</div>
	<!-- Event detail modal -->
	<div id="event-modal" class="modal-overlay" style="display:none" onclick="if(event.target===this)this.style.display='none'">
		<div class="modal-content" id="event-modal-body"></div>
	</div>
	<!-- Create event modal -->
	<div id="create-modal" class="modal-overlay" style="display:none" onclick="if(event.target===this)this.style.display='none'">
		<div class="modal-content">
			<h2 style="margin-top:0">New Event</h2>
			<form method="post" action="/apps/calendar/events" id="create-event-form" onsubmit="clearColorIfUnchecked('ce-color-enable','ce-color')">
				<input type="hidden" name="csrf_token" value={ csrfToken }/>
				<input type="hidden" name="tz" data-browser-tz/>
				<div class="form-group">
					<label for="ce-calendar">Calendar</label>
					<select class="form-control" id="ce-calendar" name="calendar_id" onchange="syncCalColor(this,'ce-color','ce-color-enable')">
						for _, cal := range calendars {
							<option value={ strconv.FormatInt(cal.ID, 10) } data-color={ cal.Color }>{ cal.Name }</option>
						}
					</select>
				</div>
				<div class="form-group">
					<label for="ce-summary">Title</label>
					<input class="form-control" type="text" id="ce-summary" name="summary" required/>
				</div>
				<div class="form-group">
					<label>
						<input type="checkbox" id="ce-allday" name="all_day"/> All day
					</label>
				</div>
				<div id="ce-datetime-fields">
					<div class="form-group">
						<label for="ce-start">Start</label>
						<input class="form-control" type="datetime-local" id="ce-start" name="datetime_start" required/>
					</div>
					<div class="form-group">
						<label for="ce-end">End</label>
						<input class="form-control" type="datetime-local" id="ce-end" name="datetime_end"/>
					</div>
				</div>
				<div id="ce-date-fields" style="display:none">
					<div class="form-group">
						<label for="ce-date-start">Start Date</label>
						<input class="form-control" type="date" id="ce-date-start" name="date_start"/>
					</div>
					<div class="form-group">
						<label for="ce-date-end">End Date</label>
						<input class="form-control" type="date" id="ce-date-end" name="date_end"/>
					</div>
				</div>
				<div class="form-group">
					<label for="ce-location">Location</label>
					<input class="form-control" type="text" id="ce-location" name="location"/>
				</div>
				<div class="form-group">
					<label for="ce-description">Description</label>
					<textarea class="form-control" id="ce-description" name="description" rows="3"></textarea>
				</div>
				<div class="form-group">
					<label for="ce-freq">Repeat</label>
					<select class="form-control" id="ce-freq" name="rrule_freq" onchange="toggleRecurrenceOpts('ce')">
						<option value="NONE" selected>None</option>
						<option value="DAILY">Daily</option>
						<option value="WEEKLY">Weekly</option>
						<option value="MONTHLY">Monthly</option>
						<option value="YEARLY">Yearly</option>
						<option value="CUSTOM">Custom…</option>
					</select>
				</div>
				<div id="ce-rrule-opts" style="display:none">
					<div class="form-group">
						<label for="ce-interval">Every</label>
						<input class="form-control" type="number" id="ce-interval" name="rrule_interval" value="1" min="1" style="max-width:100px"/>
					</div>
					<div id="ce-byday" class="form-group" style="display:none">
						<label>On days</label>
						<div class="flex gap-1" style="flex-wrap:wrap">
							@emByDayCheckbox("ce", "MO", "Mon", false)
							@emByDayCheckbox("ce", "TU", "Tue", false)
							@emByDayCheckbox("ce", "WE", "Wed", false)
							@emByDayCheckbox("ce", "TH", "Thu", false)
							@emByDayCheckbox("ce", "FR", "Fri", false)
							@emByDayCheckbox("ce", "SA", "Sat", false)
							@emByDayCheckbox("ce", "SU", "Sun", false)
						</div>
					</div>
					<div class="form-group">
						<label for="ce-until">Until (optional)</label>
						<input class="form-control" type="date" id="ce-until" name="rrule_until" style="max-width:200px"/>
					</div>
				</div>
				<div id="ce-rrule-custom" style="display:none">
					<div class="form-group">
						<label for="ce-rrule">Custom RRULE</label>
						<input class="form-control" type="text" id="ce-rrule" name="rrule" placeholder="e.g. FREQ=WEEKLY;BYDAY=MO,WE,FR;COUNT=10" hx-get="/apps/calendar/rrule-preview" hx-trigger="input changed delay:300ms" hx-target="#ce-rrule-desc"/>
						<div id="ce-rrule-desc" class="text-muted" style="font-size:0.85rem;margin-top:0.25rem"></div>
					</div>
				</div>
				<div class="form-group">
					<label>Attendees</label>
					<div id="ce-attendees"></div>
					<button type="button" class="btn btn-sm" onclick="addAttendeeRow('ce-attendees')">Add attendee</button>
				</div>
				<div class="form-group">
					<label for="ce-color">Event Color</label>
					<div class="flex gap-1 items-center">
						<input class="form-control" type="color" id="ce-color" name="color" value="#0082c9" style="width:60px;padding:2px"/>
						<label style="font-size:0.8rem;font-weight:normal"><input type="checkbox" id="ce-color-enable" onchange="handleColorToggle(this,'ce-color','ce-calendar')"/> Custom color</label>
					</div>
				</div>
				<div class="flex gap-1" style="justify-content:flex-end">
					<button type="button" class="btn" onclick="document.getElementById('create-modal').style.display='none'">Cancel</button>
					<button type="submit" class="btn btn-primary">Create</button>
				</div>
			</form>
		</div>
	</div>
	<script>
		function addAttendeeRow(containerId) {
			var container = document.getElementById(containerId);
			var row = document.createElement("div");
			row.className = "flex gap-1 items-center";
			row.style.marginBottom = "0.25rem";
			row.innerHTML =
				'<input class="form-control" type="email" name="attendee_email" placeholder="email@example.com" style="flex:1"/>' +
				'<input class="form-control" type="text" name="attendee_name" placeholder="Name" style="flex:1"/>' +
				'<select class="form-control" name="attendee_role" style="width:auto">' +
				'<option value="REQ-PARTICIPANT" selected>Required</option>' +
				'<option value="OPT-PARTICIPANT">Optional</option>' +
				'<option value="CHAIR">Chair</option></select>' +
				'<button type="button" class="btn btn-sm" onclick="this.parentElement.remove()">Remove</button>';
			container.appendChild(row);
		}
		function toggleRecurrenceOpts(prefix) {
			var freq = document.getElementById(prefix + "-freq").value;
			var opts = document.getElementById(prefix + "-rrule-opts");
			var custom = document.getElementById(prefix + "-rrule-custom");
			var byday = document.getElementById(prefix + "-byday");
			if (freq === "NONE") {
				if (opts) opts.style.display = "none";
				if (custom) custom.style.display = "none";
			} else if (freq === "CUSTOM") {
				if (opts) opts.style.display = "none";
				if (custom) custom.style.display = "";
			} else {
				if (opts) opts.style.display = "";
				if (custom) custom.style.display = "none";
				if (byday) byday.style.display = freq === "WEEKLY" ? "" : "none";
			}
		}
		// Fill fields that depend on the browser's zone: [data-browser-tz] gets
		// the IANA zone name, [data-unix] datetime inputs get local wall time.
		function fillBrowserTimes(root) {
			var tz = Intl.DateTimeFormat().resolvedOptions().timeZone || "";
			root.querySelectorAll("[data-browser-tz]").forEach(function (el) {
				if (!el.value) el.value = tz;
			});
			root.querySelectorAll("input[data-unix]").forEach(function (el) {
				var d = new Date(Number(el.dataset.unix) * 1000);
				var pad = function (n) {
					return String(n).padStart(2, "0");
				};
				el.value =
					d.getFullYear() + "-" + pad(d.getMonth() + 1) + "-" + pad(d.getDate()) +
					"T" + pad(d.getHours()) + ":" + pad(d.getMinutes());
			});
		}
		// The markup above is already parsed; this also works after an
		// hx-boost navigation, when DOMContentLoaded has long since fired.
		fillBrowserTimes(document);
		function clearColorIfUnchecked(cbId, colorId) {
			var cb = document.getElementById(cbId);
			if (cb && !cb.checked) document.getElementById(colorId).value = "";
		}
		// Color picker: sync with calendar default when toggling custom off
		function syncCalColor(sel, colorId, checkboxId) {
			var opt = sel.options[sel.selectedIndex];
			var color = opt.getAttribute("data-color") || "#0082c9";
			var cb = document.getElementById(checkboxId);
			if (!cb || !cb.checked) {
				document.getElementById(colorId).value = color;
			}
		}
		function handleColorToggle(cb, colorId, calSelId) {
			if (!cb.checked) {
				var sel = document.getElementById(calSelId);
				var opt = sel.options[sel.selectedIndex];
				document.getElementById(colorId).value =
					opt.getAttribute("data-color") || "#0082c9";
			}
		}
		function handleColorToggleEdit(cb, colorId) {
			// For edit modal, unchecking resets to calendar default (stored in data attr)
			if (!cb.checked) {
				var picker = document.getElementById(colorId);
				picker.value = picker.getAttribute("data-default") || "#0082c9";
			}
		}
		(function () {
			var calEl = document.getElementById("calendar");
			var params = new URLSearchParams(window.location.search);
			var initDate = params.get("date");
			var calOpts = {
				initialView: "dayGridMonth",
				headerToolbar: {
					left: "prev,next today",
					center: "title",
					right: "dayGridMonth,timeGridWeek,timeGridDay",
				},
				events: "/apps/calendar/events.json",
				editable: false,
				selectable: true,
				datesSet: function (info) {
					var d = info.view.currentStart.toISOString().slice(0, 10);
					history.replaceState(null, "", "/apps/calendar/?date=" + d);
				},
				eventClick: function (info) {
					info.jsEvent.preventDefault();
					var id = info.event.id;
					fetch("/apps/calendar/events/" + id, {
						headers: {
							"X-CSRF-Token": document.querySelector("[name=csrf_token]").value,
						},
					})
						.then(function (r) {
							return r.text();
						})
						.then(function (html) {
							var body = document.getElementById("event-modal-body");
							body.innerHTML = html;
							fillBrowserTimes(body);
							htmx.process(body);
							document.getElementById("event-modal").style.display = "flex";
						});
				},
				dateClick: function (info) {
					var modal = document.getElementById("create-modal");
					var isAllDay = info.allDay;
					if (isAllDay) {
						document.getElementById("ce-allday").checked = true;
						document.getElementById("ce-datetime-fields").style.display =
							"none";
						document.getElementById("ce-date-fields").style.display = "";
						document.getElementById("ce-date-start").value = info.dateStr;
					} else {
						document.getElementById("ce-allday").checked = false;
						document.getElementById("ce-datetime-fields").style.display = "";
						document.getElementById("ce-date-fields").style.display = "none";
						document.getElementById("ce-start").value = info.dateStr.slice(
							0,
							16,
						);
					}
					modal.style.display = "flex";
					document.getElementById("ce-summary").focus();
				},
				height: "auto",
			};
			if (initDate) {
				calOpts.initialDate = initDate;
			}
			var calendar = new FullCalendar.Calendar(calEl, calOpts);
			calendar.render();
			// Calendar toggle checkboxes
			document.querySelectorAll(".cal-toggle").forEach(function (cb) {
				cb.addEventListener("change", function () {
					var calId = parseInt(this.dataset.calendarId);
					calendar.getEvents().forEach(function (ev) {
						if (ev.extendedProps.calendarId === calId) {
							ev.setProp("display", cb.checked ? "auto" : "none");
						}
					});
				});
			});
			// Init create modal: sync color to first calendar's default
			(function () {
				var sel = document.getElementById("ce-calendar");
				if (sel && sel.options.length)
					syncCalColor(sel, "ce-color", "ce-color-enable");
			})();
			// All-day toggle in create modal
			document
				.getElementById("ce-allday")
				.addEventListener("change", function () {
					document.getElementById("ce-datetime-fields").style.display = this
						.checked
						? "none"
						: "";
					document.getElementById("ce-date-fields").style.display = this.checked
						? ""
						: "none";
				});
		})();
	</script>
}

templ calEventModal(csrfToken string, ev *Event, cal *Calendar, calendars []Calendar, attendees []Attendee) {
	<h2 style="margin-top:0">{ ev.Summary }</h2>
	<div class="text-muted" style="margin-bottom:1rem">
		{ formatEventTime(ev.DTStart, ev.DTEnd, ev.IsAllDay) }
		if ev.Location != "" {
			<span>· { ev.Location }</span>
		}
	</div>
	if ev.Description != "" {
		<p>{ ev.Description }</p>
	}
	if eventRRule(ev) != "" {
		<p class="text-muted" style="font-size:0.85rem">Repeats: { eventRRule(ev) }</p>
	}
	if cal != nil {
		<p class="text-muted" style="font-size:0.85rem">
			<span style={ fmt.Sprintf("display:inline-block;width:10px;height:10px;border-radius:50%%;background:%s;vertical-align:middle", cal.Color) }></span>
			{ " " + cal.Name }
		</p>
	}
	if len(attendees) > 0 {
		<div style="margin-top:0.75rem">
			<strong style="font-size:0.85rem">Attendees</strong>
			<ul style="list-style:none;padding:0;margin:0.25rem 0">
				for _, att := range attendees {
					<li style="padding:0.25rem 0;font-size:0.85rem">
						if att.DisplayName != "" {
							{ att.DisplayName }
						} else {
							{ att.Email }
						}
						<span class="text-muted">
							({ att.Email }) —
							if att.Status == "ACCEPTED" {
								<span style="color:green">Accepted</span>
							} else if att.Status == "DECLINED" {
								<span style="color:red">Declined</span>
							} else if att.Status == "TENTATIVE" {
								<span style="color:orange">Tentative</span>
							} else {
								<span>Pending</span>
							}
						</span>
					</li>
				}
			</ul>
		</div>
	}
	<div class="sidebar-divider" style="margin:1rem 0"></div>
	<h3>Edit Event</h3>
	<form method="post" action={ templ.SafeURL(fmt.Sprintf("/apps/calendar/events/%d", ev.ID)) } onsubmit="clearColorIfUnchecked('em-color-enable','em-color')">
		<input type="hidden" name="csrf_token" value={ csrfToken }/>
		<div class="form-group">
			<label for="em-calendar">Calendar</label>
			<select class="form-control" id="em-calendar" name="calendar_id">
				for _, c := range calendars {
					if c.ID == ev.CalendarID {
						<option value={ strconv.FormatInt(c.ID, 10) } selected>{ c.Name }</option>
					} else {
						<option value={ strconv.FormatInt(c.ID, 10) }>{ c.Name }</option>
					}
				}
			</select>
		</div>
		<div class="form-group">
			<label for="em-summary">Title</label>
			<input class="form-control" type="text" id="em-summary" name="summary" value={ ev.Summary } required/>
		</div>
		<div class="form-group">
			<label>
				if ev.IsAllDay {
					<input type="checkbox" name="all_day" checked/> All day
				} else {
					<input type="checkbox" name="all_day"/> All day
				}
			</label>
		</div>
		if ev.IsAllDay {
			<div class="form-group">
				<label for="em-date-start">Start Date</label>
				<input class="form-control" type="date" id="em-date-start" name="date_start" value={ time.Unix(ev.DTStart, 0).UTC().Format("2006-01-02") }/>
			</div>
			<div class="form-group">
				<label for="em-date-end">End Date</label>
				<input class="form-control" type="date" id="em-date-end" name="date_end" value={ time.Unix(ev.DTEnd, 0).UTC().Format("2006-01-02") }/>
			</div>
		} else {
			if z := eventEditZone(ev, cal); z != nil {
				<input type="hidden" name="tz" value={ z.String() }/>
				<div class="form-group">
					<label for="em-start">Start</label>
					<input class="form-control" type="datetime-local" id="em-start" name="datetime_start" value={ time.Unix(ev.DTStart, 0).In(z).Format("2006-01-02T15:04") }/>
				</div>
				<div class="form-group">
					<label for="em-end">End</label>
					<input class="form-control" type="datetime-local" id="em-end" name="datetime_end" value={ time.Unix(ev.DTEnd, 0).In(z).Format("2006-01-02T15:04") }/>
				</div>
				<p class="text-muted" style="font-size:0.85rem;margin-top:-0.5rem">Times in { z.String() }</p>
			} else {
				<input type="hidden" name="tz" data-browser-tz/>
				<div class="form-group">
					<label for="em-start">Start</label>
					<input class="form-control" type="datetime-local" id="em-start" name="datetime_start" data-unix={ strconv.FormatInt(ev.DTStart, 10) }/>
				</div>
				<div class="form-group">
					<label for="em-end">End</label>
					<input class="form-control" type="datetime-local" id="em-end" name="datetime_end" data-unix={ strconv.FormatInt(ev.DTEnd, 10) }/>
				</div>
			}
		}
		<div class="form-group">
			<label for="em-location">Location</label>
			<input class="form-control" type="text" id="em-location" name="location" value={ ev.Location }/>
		</div>
		<div class="form-group">
			<label for="em-description">Description</label>
			<textarea class="form-control" id="em-description" name="description" rows="3">{ ev.Description }</textarea>
		</div>
		<div class="form-group">
			<label for="em-freq">Repeat</label>
			<select class="form-control" id="em-freq" name="rrule_freq" onchange="toggleRecurrenceOpts('em')">
				@emFreqOption("NONE", "None", eventRRuleFreq(ev))
				@emFreqOption("DAILY", "Daily", eventRRuleFreq(ev))
				@emFreqOption("WEEKLY", "Weekly", eventRRuleFreq(ev))
				@emFreqOption("MONTHLY", "Monthly", eventRRuleFreq(ev))
				@emFreqOption("YEARLY", "Yearly", eventRRuleFreq(ev))
				@emFreqOption("CUSTOM", "Custom…", eventRRuleFreq(ev))
			</select>
		</div>
		if eventRRuleIsSimple(ev) && eventRRuleFreq(ev) != "NONE" {
			<div id="em-rrule-opts">
				<div class="form-group">
					<label for="em-interval">Every</label>
					<input class="form-control" type="number" id="em-interval" name="rrule_interval" value={ eventRRuleInterval(ev) } min="1" style="max-width:100px"/>
				</div>
				if eventRRuleFreq(ev) == "WEEKLY" {
					<div id="em-byday" class="form-group">
						<label>On days</label>
						<div class="flex gap-1" style="flex-wrap:wrap">
							@emByDayCheckbox("em", "MO", "Mon", hasByDay(eventRRuleByDay(ev), "MO"))
							@emByDayCheckbox("em", "TU", "Tue", hasByDay(eventRRuleByDay(ev), "TU"))
							@emByDayCheckbox("em", "WE", "Wed", hasByDay(eventRRuleByDay(ev), "WE"))
							@emByDayCheckbox("em", "TH", "Thu", hasByDay(eventRRuleByDay(ev), "TH"))
							@emByDayCheckbox("em", "FR", "Fri", hasByDay(eventRRuleByDay(ev), "FR"))
							@emByDayCheckbox("em", "SA", "Sat", hasByDay(eventRRuleByDay(ev), "SA"))
							@emByDayCheckbox("em", "SU", "Sun", hasByDay(eventRRuleByDay(ev), "SU"))
						</div>
					</div>
				} else {
					<div id="em-byday" class="form-group" style="display:none">
						<label>On days</label>
						<div class="flex gap-1" style="flex-wrap:wrap">
							@emByDayCheckbox("em", "MO", "Mon", false)
							@emByDayCheckbox("em", "TU", "Tue", false)
							@emByDayCheckbox("em", "WE", "Wed", false)
							@emByDayCheckbox("em", "TH", "Thu", false)
							@emByDayCheckbox("em", "FR", "Fri", false)
							@emByDayCheckbox("em", "SA", "Sat", false)
							@emByDayCheckbox("em", "SU", "Sun", false)
						</div>
					</div>
				}
				<div class="form-group">
					<label for="em-until">Until (optional)</label>
					<input class="form-control" type="date" id="em-until" name="rrule_until" value={ eventRRuleUntil(ev) } style="max-width:200px"/>
				</div>
			</div>
			<div id="em-rrule-custom" style="display:none">
				<div class="form-group">
					<label for="em-rrule">Custom RRULE</label>
					<input class="form-control" type="text" id="em-rrule" name="rrule" placeholder="e.g. FREQ=WEEKLY;BYDAY=MO,WE,FR;COUNT=10" hx-get="/apps/calendar/rrule-preview" hx-trigger="input changed delay:300ms" hx-target="#em-rrule-desc"/>
					<div id="em-rrule-desc" class="text-muted" style="font-size:0.85rem;margin-top:0.25rem"></div>
				</div>
			</div>
		} else if eventRRuleFreq(ev) == "CUSTOM" {
			<div id="em-rrule-opts" style="display:none">
				<div class="form-group">
					<label for="em-interval">Every</label>
					<input class="form-control" type="number" id="em-interval" name="rrule_interval" value="1" min="1" style="max-width:100px"/>
				</div>
				<div id="em-byday" class="form-group" style="display:none">
					<label>On days</label>
					<div class="flex gap-1" style="flex-wrap:wrap">
						@emByDayCheckbox("em", "MO", "Mon", false)
						@emByDayCheckbox("em", "TU", "Tue", false)
						@emByDayCheckbox("em", "WE", "Wed", false)
						@emByDayCheckbox("em", "TH", "Thu", false)
						@emByDayCheckbox("em", "FR", "Fri", false)
						@emByDayCheckbox("em", "SA", "Sat", false)
						@emByDayCheckbox("em", "SU", "Sun", false)
					</div>
				</div>
				<div class="form-group">
					<label for="em-until">Until (optional)</label>
					<input class="form-control" type="date" id="em-until" name="rrule_until" style="max-width:200px"/>
				</div>
			</div>
			<div id="em-rrule-custom">
				<div class="form-group">
					<label for="em-rrule">Custom RRULE</label>
					<input class="form-control" type="text" id="em-rrule" name="rrule" value={ eventRRuleRaw(ev) } placeholder="e.g. FREQ=WEEKLY;BYDAY=MO,WE,FR;COUNT=10" hx-get="/apps/calendar/rrule-preview" hx-trigger="input changed delay:300ms" hx-target="#em-rrule-desc"/>
					<div id="em-rrule-desc" class="text-muted" style="font-size:0.85rem;margin-top:0.25rem">{ eventRRule(ev) }</div>
				</div>
			</div>
		} else {
			<div id="em-rrule-opts" style="display:none">
				<div class="form-group">
					<label for="em-interval">Every</label>
					<input class="form-control" type="number" id="em-interval" name="rrule_interval" value="1" min="1" style="max-width:100px"/>
				</div>
				<div id="em-byday" class="form-group" style="display:none">
					<label>On days</label>
					<div class="flex gap-1" style="flex-wrap:wrap">
						@emByDayCheckbox("em", "MO", "Mon", false)
						@emByDayCheckbox("em", "TU", "Tue", false)
						@emByDayCheckbox("em", "WE", "Wed", false)
						@emByDayCheckbox("em", "TH", "Thu", false)
						@emByDayCheckbox("em", "FR", "Fri", false)
						@emByDayCheckbox("em", "SA", "Sat", false)
						@emByDayCheckbox("em", "SU", "Sun", false)
					</div>
				</div>
				<div class="form-group">
					<label for="em-until">Until (optional)</label>
					<input class="form-control" type="date" id="em-until" name="rrule_until" style="max-width:200px"/>
				</div>
			</div>
			<div id="em-rrule-custom" style="display:none">
				<div class="form-group">
					<label for="em-rrule">Custom RRULE</label>
					<input class="form-control" type="text" id="em-rrule" name="rrule" placeholder="e.g. FREQ=WEEKLY;BYDAY=MO,WE,FR;COUNT=10" hx-get="/apps/calendar/rrule-preview" hx-trigger="input changed delay:300ms" hx-target="#em-rrule-desc"/>
					<div id="em-rrule-desc" class="text-muted" style="font-size:0.85rem;margin-top:0.25rem"></div>
				</div>
			</div>
		}
		<div class="form-group">
			<label>Attendees</label>
			<div id="em-attendees">
				for _, att := range attendees {
					<div class="flex gap-1 items-center" style="margin-bottom:0.25rem">
						<input class="form-control" type="email" name="attendee_email" value={ att.Email } placeholder="email@example.com" style="flex:1"/>
						<input class="form-control" type="text" name="attendee_name" value={ att.DisplayName } placeholder="Name" style="flex:1"/>
						<select class="form-control" name="attendee_role" style="width:auto">
							if att.Role == "CHAIR" {
								<option value="REQ-PARTICIPANT">Required</option>
								<option value="OPT-PARTICIPANT">Optional</option>
								<option value="CHAIR" selected>Chair</option>
							} else if att.Role == "OPT-PARTICIPANT" {
								<option value="REQ-PARTICIPANT">Required</option>
								<option value="OPT-PARTICIPANT" selected>Optional</option>
								<option value="CHAIR">Chair</option>
							} else {
								<option value="REQ-PARTICIPANT" selected>Required</option>
								<option value="OPT-PARTICIPANT">Optional</option>
								<option value="CHAIR">Chair</option>
							}
						</select>
						<button type="button" class="btn btn-sm" onclick="this.parentElement.remove()">Remove</button>
					</div>
				}
			</div>
			<button type="button" class="btn btn-sm" onclick="addAttendeeRow('em-attendees')">Add attendee</button>
		</div>
		<div class="form-group">
			<label for="em-color">Event Color</label>
			<div class="flex gap-1 items-center">
				<input class="form-control" type="color" id="em-color" name="color" value={ eventColorOrDefault(ev, cal) } data-default={ calDefaultColor(cal) } style="width:60px;padding:2px"/>
				if ev.Color != "" {
					<label style="font-size:0.8rem;font-weight:normal"><input type="checkbox" id="em-color-enable" checked onchange="handleColorToggleEdit(this,'em-color')"/> Custom color</label>
				} else {
					<label style="font-size:0.8rem;font-weight:normal"><input type="checkbox" id="em-color-enable" onchange="handleColorToggleEdit(this,'em-color')"/> Custom color</label>
				}
			</div>
		</div>
		<div class="flex gap-1" style="justify-content:space-between">
			<button
				type="button"
				class="btn btn-danger"
				hx-delete={ fmt.Sprintf("/apps/calendar/events/%d", ev.ID) }
				hx-confirm="Delete this event?"
				hx-on::after-request="document.getElementById('event-modal').style.display='none';location.reload()"
			>Delete</button>
			<div class="flex gap-1">
				<button type="button" class="btn" onclick="document.getElementById('event-modal').style.display='none'">Cancel</button>
				<button type="submit" class="btn btn-primary">Save</button>
			</div>
		</div>
	</form>
}

templ emFreqOption(value, label, selected string) {
	if value == selected {
		<option value={ value } selected>{ label }</option>
	} else {
		<option value={ value }>{ label }</option>
	}
}

templ emByDayCheckbox(prefix, day, label string, checked bool) {
	<label style="font-size:0.85rem;font-weight:normal">
		if checked {
			<input type="checkbox" name="rrule_byday" value={ day } checked/> { label }
		} else {
			<input type="checkbox" name="rrule_byday" value={ day }/> { label }
		}
	</label>
}

func eventColorOrDefault(ev *Event, cal *Calendar) string {
	if ev.Color != "" {
		return ev.Color
	}
	return calDefaultColor(cal)
}
func calDefaultColor(cal *Calendar) string {
	if cal != nil && cal.Color != "" {
		return cal.Color
	}
	return "#0082c9"
}

templ calSettingsPage(calendars []Calendar, csrfToken string) {
	<div class="sidebar-layout">
		@calSidebar(calendars, "/apps/calendar/settings", csrfToken)
		<div class="sidebar-content">
			<h1>Calendar Settings</h1>
			@ui.Card("Create Calendar") {
				<form method="post" action="/apps/calendar/calendars" class="flex gap-1 items-end">
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					<div class="form-group" style="margin-bottom:0">
						<label for="name">Name</label>
						<input class="form-control" type="text" id="name" name="name" placeholder="Work" required/>
					</div>
					<div class="form-group" style="margin-bottom:0">
						<label for="uid">URL slug</label>
						<input class="form-control" type="text" id="uid" name="uid" placeholder="work"/>
					</div>
					<div class="form-group" style="margin-bottom:0">
						<label for="color">Color</label>
						<input class="form-control" type="color" id="color" name="color" value="#0082c9"/>
					</div>
					<div class="form-group" style="margin-bottom:0">
						<label for="timezone">Timezone</label>
						<input class="form-control" type="text" id="timezone" name="timezone" list="cal-timezones" placeholder="America/Denver" data-browser-tz/>
					</div>
					<button class="btn btn-primary" type="submit">Create</button>
				</form>
			}
			@ui.Card("Calendars") {
				if len(calendars) == 0 {
					<p class="text-muted">No calendars.</p>
				} else {
					<table class="table">
						<thead>
							<tr>
								<th>Color</th>
								<th>Name</th>
								<th>Timezone</th>
								<th>UID</th>
								<th class="text-right">Actions</th>
							</tr>
						</thead>
						<tbody>
							for _, cal := range calendars {
								<tr id={ fmt.Sprintf("cal-%d", cal.ID) }>
									<td>
										<input class="form-control" type="color" name="color" value={ cal.Color } form={ fmt.Sprintf("cal-edit-%d", cal.ID) } aria-label="Color" style="width:3rem;padding:0.1rem"/>
									</td>
									<td>
										<input class="form-control" type="text" name="name" value={ cal.Name } form={ fmt.Sprintf("cal-edit-%d", cal.ID) } aria-label="Name" required/>
									</td>
									<td>
										<input class="form-control" type="text" name="timezone" value={ cal.Timezone } list="cal-timezones" placeholder="UTC" form={ fmt.Sprintf("cal-edit-%d", cal.ID) } aria-label="Timezone"/>
									</td>
									<td>{ cal.UID }</td>
									<td class="text-right" style="display:flex;gap:0.25rem;justify-content:flex-end">
										<form id={ fmt.Sprintf("cal-edit-%d", cal.ID) } method="post" action={ templ.SafeURL(fmt.Sprintf("/apps/calendar/calendars/%d", cal.ID)) }>
											<input type="hidden" name="csrf_token" value={ csrfToken }/>
											<button class="btn btn-sm btn-primary" type="submit">Save</button>
										</form>
										<cog-share-button resource="dav:collection" resource-id={ strconv.FormatInt(cal.ID, 10) }>Share</cog-share-button>
										<button
											class="btn btn-sm"
											hx-delete={ fmt.Sprintf("/apps/calendar/calendars/%d", cal.ID) }
											hx-target={ fmt.Sprintf("#cal-%d", cal.ID) }
											hx-swap="outerHTML"
											hx-confirm="Delete this calendar and everything in it, tasks included?"
										>Delete</button>
									</td>
								</tr>
								<tr>
									<td colspan="5" id={ fmt.Sprintf("cal-share-%d", cal.ID) }></td>
								</tr>
							}
						</tbody>
					</table>
				}
			}
			<datalist id="cal-timezones">
				for _, tz := range commonTimezones {
					<option value={ tz }></option>
				}
			</datalist>
			<script>
				(function () {
					var tz = Intl.DateTimeFormat().resolvedOptions().timeZone || "";
					document.querySelectorAll("[data-browser-tz]").forEach(function (el) {
						if (!el.value) el.value = tz;
					});
				})();
			</script>
			@ui.Card("CalDAV Access") {
				<p class="text-muted">
					Configure your CalDAV client with:
				</p>
				<ul>
					<li><strong>Server:</strong> <code>your-server-url</code></li>
					<li><strong>Path:</strong> <code>/remote.php/dav</code></li>
					<li><strong>Username/Password:</strong> your Cog credentials or an app password</li>
				</ul>
			}
		</div>
	</div>
}

func sidebarClass(activePath, itemPath string) string {
	if activePath == itemPath {
		return "sidebar-item active"
	}
	return "sidebar-item"
}
func formatEventTime(dtstart, dtend int64, isAllDay bool) string {
	if dtstart == 0 {
		return ""
	}
	start := time.Unix(dtstart, 0)
	if isAllDay {
		return start.Format("Mon, Jan 2 2006")
	}
	end := time.Unix(dtend, 0)
	now := time.Now()
	if start.Year() == now.Year() && start.YearDay() == now.YearDay() {
		return fmt.Sprintf("Today %s – %s", start.Format("15:04"), end.Format("15:04"))
	}
	if start.Year() == now.Year() {
		return fmt.Sprintf("%s %s – %s", start.Format("Mon, Jan 2"), start.Format("15:04"), end.Format("15:04"))
	}
	return fmt.Sprintf("%s %s – %s", start.Format("2006-01-02"), start.Format("15:04"), end.Format("15:04"))
}
