root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
indent_style = tab
indent_size = 4

[*.templ]
indent_style = tab
indent_size = 4

[*.sql]
indent_style = tab
indent_size = 4

[*.tmpl]
indent_style = tab
indent_size = 4

[*.proto]
indent_style = space
indent_size = 2

[*.{css,js}]
indent_style = space
indent_size = 2

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.{json,toml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
