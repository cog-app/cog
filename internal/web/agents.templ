package web

import "git.duckfam.us/jj-software/cog/ui"

templ settingsAgentsPage(pd ui.PageData, flash string, flashKind string, agents []agentView) {
	@ui.SidebarPage(pd, settingsSidebar("agents")) {
		@ui.PageHeader("Agents", nil)
		@ui.Alert(flashKind, flash)
		@agentsBody(pd, agents, "", "")
	}
}

templ settingsAgentsPageWithToken(pd ui.PageData, agents []agentView, agentName string, token string) {
	@ui.SidebarPage(pd, settingsSidebar("agents")) {
		@ui.PageHeader("Agents", nil)
		@agentsBody(pd, agents, agentName, token)
	}
}

templ agentsBody(pd ui.PageData, agents []agentView, tokenFor string, token string) {
	if token != "" {
		@ui.Card("New token for " + tokenFor) {
			<p class="card-desc">Copy it now; it is not shown again. The app signs in with the agent's name and this token, as a password or a bearer token.</p>
			<code class="token-display break-anywhere">{ token }</code>
		}
	}
	@ui.Card("Your agents") {
		<p class="card-desc">An agent is an account of its own. Share folders, calendars or contacts with it and it reaches those alone; what it changes carries its name. It cannot sign in with a password, share, or change settings.</p>
		if len(agents) == 0 {
			<p class="text-muted">No agents yet.</p>
		}
		for _, a := range agents {
			<div class="list-row">
				<div class="flex items-center justify-between gap-2">
					<div>
						<strong>{ a.Username }</strong>
						<span class="text-sm text-muted">{ a.CreatedAt.Format("2006-01-02") }</span>
					</div>
					<form method="post" action={ templ.SafeURL("/settings/agents/" + a.ID + "/delete") } onsubmit="return confirm('Delete this agent, its tokens and the shares made with it?')">
						<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
						<button class="btn btn-ghost text-danger" type="submit">Delete agent</button>
					</form>
				</div>
				if len(a.Tokens) > 0 {
					<ul class="list-plain">
						for _, t := range a.Tokens {
							<li class="flex items-center justify-between gap-2">
								<span>{ t.Name } <span class="text-sm text-muted">{ t.CreatedAt.Format("2006-01-02") }</span></span>
								<form method="post" action={ templ.SafeURL("/settings/agents/" + a.ID + "/tokens/" + t.ID + "/delete") }>
									<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
									<button class="btn btn-ghost btn-sm" type="submit">Revoke</button>
								</form>
							</li>
						}
					</ul>
				}
				<form class="flex items-center gap-2" method="post" action={ templ.SafeURL("/settings/agents/" + a.ID + "/tokens") }>
					<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
					<input class="form-control w-md" name="name" placeholder="Token name" autocomplete="off"/>
					<button class="btn btn-secondary btn-sm" type="submit">New token</button>
				</form>
			</div>
		}
	}
	@ui.Card("Add an agent") {
		<form class="flex items-center gap-2" method="post" action="/settings/agents">
			<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
			<input class="form-control w-md" name="name" placeholder="assistant" required autocomplete="off"/>
			<button class="btn btn-primary" type="submit">Create agent</button>
		</form>
		<p class="form-help">The name is a username: it must be free, and it is what the agent's changes show.</p>
	}
}
