package web

import (
	"fmt"
	"git.duckfam.us/jj-software/cog/internal/group"
	"git.duckfam.us/jj-software/cog/internal/logbuf"
	"git.duckfam.us/jj-software/cog/internal/user"
	"git.duckfam.us/jj-software/cog/ui"
	"iter"
	"log/slog"
	"net/url"
	"strconv"
	"strings"
	"time"
)

// --- Users ---
templ adminUsersPage(pd ui.PageData, users iter.Seq2[user.User, error], retired []user.RetiredName, flash string, flashKind string, agentOwners map[string]string, blocked []blockedSignIn) {
	@ui.AdminSidebarPage(pd, "users") {
		@ui.HelpPageHeader("Users", "admin/users-and-groups.html#users", nil) {
			<a class="btn btn-primary" href="/admin/users/new">
				@ui.Icon("plus")
				New user
			</a>
		}
		@ui.Alert(flashKind, flash)
		<div class="card card-flush">
			<div class="table-wrap">
				<table class="table">
					<thead>
						<tr>
							<th class="col-shrink"><span class="sr-only">Avatar</span></th>
							<th>User</th>
							<th class="col-shrink">Role</th>
						</tr>
					</thead>
					<tbody>
						for u, err := range users {
							if err != nil {
								<tr><td colspan="3" class="text-danger">Some users could not be loaded.</td></tr>
								break
							}
							<tr>
								<td><img class="avatar-md" src={ u.AvatarURL() } alt=""/></td>
								<td>
									<a class="row-link break-anywhere" href={ templ.SafeURL("/admin/users/" + u.ID) }>
										if u.DisplayName != "" {
											{ u.DisplayName }
										} else {
											{ u.Username }
										}
									</a>
									if u.DisplayName != "" {
										<div class="text-sm text-muted break-anywhere">{ u.Username }</div>
									}
								</td>
								<td>
									if u.IsAdmin {
										<span class="badge badge-admin">Admin</span>
									} else if u.IsAgent() {
										<span class="text-sm text-muted">Agent of { agentOwners[u.OwnerID] }</span>
									} else {
										<span class="text-sm text-muted">User</span>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
		if len(blocked) > 0 {
			<div class="card">
				<h2 class="card-title">Blocked sign-ins</h2>
				<p class="text-muted">Too many failed attempts in the last 15 minutes. Blocks lift on their own once the attempts are older than that.</p>
				<div class="table-wrap">
					<table class="table">
						<thead>
							<tr>
								<th>Who</th>
								<th>Last failure</th>
							</tr>
						</thead>
						<tbody>
							for _, b := range blocked {
								<tr>
									<td>
										<div>{ b.Kind } <strong class="break-anywhere">{ b.Name }</strong></div>
										<div class="text-sm text-muted">{ b.Effect }</div>
									</td>
									<td>
										<div>{ b.Last.UTC().Format("15:04 UTC") }</div>
										<div class="text-sm text-muted">{ strconv.Itoa(b.Count) } failures</div>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
				<form method="post" action="/admin/sign-in-limits/clear" data-confirm="Clear every sign-in block? Anyone guessing passwords starts again with a full allowance." onsubmit="return confirm(this.dataset.confirm)">
					<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
					<button class="btn btn-outline-danger" type="submit">Clear all blocks</button>
				</form>
			</div>
		}
		if len(retired) > 0 {
			<div class="card card-flush">
				<h2 class="card-title">Retired names</h2>
				<p class="text-muted">These belonged to deleted accounts. Other servers and people may still know someone by them, so no new account can take one until you release it.</p>
				<div class="table-wrap">
					<table class="table">
						<thead>
							<tr>
								<th>Name</th>
								<th>Last email</th>
								<th>Deleted</th>
								<th class="col-shrink"><span class="sr-only">Actions</span></th>
							</tr>
						</thead>
						<tbody>
							for _, n := range retired {
								<tr>
									<td class="break-anywhere">{ n.Username }</td>
									<td class="break-anywhere text-muted">{ n.Email }</td>
									<td class="text-muted">{ n.RetiredAt.Format("2006-01-02") }</td>
									<td>
										<form method="post" action={ templ.SafeURL("/admin/users/retired/" + url.PathEscape(n.Username) + "/release") }>
											<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
											<button class="btn btn-secondary btn-sm" type="submit">Release</button>
										</form>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		}
	}
}

templ adminUserNewPage(pd ui.PageData, errMsg string, form newUserForm) {
	@ui.AdminSidebarPage(pd, "users") {
		@ui.PageHeader("New user", []ui.Crumb{{Label: "Users", URL: "/admin/users"}})
		@ui.Alert("error", errMsg)
		@ui.Card("") {
			<form method="post" action="/admin/users">
				<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
				<div class="form-group">
					<label for="username">Username</label>
					<input class="form-control w-md" type="text" id="username" name="username" value={ form.Username } required autocomplete="off" autocapitalize="none" autofocus?={ form.Username == "" } aria-invalid={ ariaInvalid(errMsg != "") }/>
				</div>
				<div class="form-group">
					<label for="password">Password</label>
					<input class="form-control w-md" type="password" id="password" name="password" required autocomplete="new-password" autofocus?={ form.Username != "" }/>
				</div>
				<div class="form-group">
					<label class="form-check">
						<input type="checkbox" name="is_admin" value="1" checked?={ form.IsAdmin }/>
						Administrator
					</label>
					<p class="form-help">Administrators can manage users, groups, volumes and server settings.</p>
				</div>
				<div class="form-actions">
					<button class="btn btn-primary" type="submit">Create user</button>
					<a class="btn btn-secondary" href="/admin/users">Cancel</a>
				</div>
			</form>
		}
	}
}

templ adminUserEditPage(pd ui.PageData, u *user.User, flash string, flashKind string) {
	@ui.AdminSidebarPage(pd, "users") {
		@ui.PageHeader(u.Username, []ui.Crumb{{Label: "Users", URL: "/admin/users"}})
		@ui.Alert(flashKind, flash)
		@ui.Card("Profile") {
			<form method="post" action={ templ.SafeURL("/admin/users/" + u.ID) }>
				<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
				<div class="flex items-center gap-2 mb-2">
					<img class="avatar-lg" src={ u.AvatarURL() } alt=""/>
					<div class="flex-1">
						@ui.FormField("Display name", "display_name", "text", u.DisplayName, "")
					</div>
				</div>
				@ui.FormField("Email", "email", "email", u.Email, "")
				<div class="form-group">
					<label class="form-check">
						<input type="checkbox" name="is_admin" value="1" checked?={ u.IsAdmin }/>
						Administrator
					</label>
				</div>
				<div class="form-actions">
					<button class="btn btn-primary" type="submit">Save</button>
				</div>
			</form>
		}
		@ui.Card("Reset password") {
			<form method="post" action={ templ.SafeURL("/admin/users/" + u.ID + "/password") }>
				<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
				<div class="form-row">
					<div class="form-group">
						<label for="new_password">New password</label>
						<input class="form-control" type="password" id="new_password" name="new_password" autocomplete="new-password"/>
					</div>
					<button class="btn btn-secondary" type="submit">Reset password</button>
				</div>
			</form>
		}
		<div class="card card-danger">
			<h2 class="card-title">Danger zone</h2>
			<p class="text-muted">Deleting a user removes all their data and cannot be undone. Their username stays reserved until you release it under Users.</p>
			<button
				type="button"
				class="btn btn-danger"
				hx-delete={ "/admin/users/" + u.ID }
				hx-confirm={ "Delete " + u.Username + " and all their data? This cannot be undone." }
				hx-on::after-request="window.location='/admin/users'"
			>Delete user</button>
		</div>
	}
}

// --- Groups ---
templ adminGroupsPage(pd ui.PageData, groups []group.Group, flash string, flashKind string) {
	@ui.AdminSidebarPage(pd, "groups") {
		@ui.HelpPageHeader("Groups", "admin/users-and-groups.html#groups", nil)
		@ui.Alert(flashKind, flash)
		@ui.Card("Create group") {
			<form method="post" action="/admin/groups" class="form-inline">
				<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
				<label class="sr-only" for="new-group-name">Group name</label>
				<input class="form-control" type="text" id="new-group-name" name="name" placeholder="Group name" required/>
				<button class="btn btn-primary" type="submit">Create</button>
			</form>
		}
		@groupList(groups, "/admin/groups/", "No groups yet.")
	}
}

// --- Settings ---
templ adminSettingsPage(pd ui.PageData, publicRegistration bool, inviteExpiryHours string, davTombstoneDays string, env envConfigData, status statusData, flash string, flashKind string, mfaRequired string, fed federationData, pw passwordPolicyData) {
	@ui.AdminSidebarPage(pd, "settings") {
		@ui.PageHeader("General", nil)
		@ui.Alert(flashKind, flash)
		@ui.Card("Status") {
			<dl class="kv">
				<dt>Instance uptime</dt>
				<dd data-uptime>{ FormatDuration(status.InstanceUptime) }</dd>
				<dt>Server uptime</dt>
				<dd data-uptime>{ FormatDuration(status.ServerUptime) }</dd>
				if status.CommitHash != "" {
					<dt>Build</dt>
					<dd><code>{ status.CommitHash }</code> <span class="text-muted">({ status.CommitDate.Format(time.RFC3339) })</span></dd>
				}
			</dl>
		}
		@ui.Card("Environment") {
			<p class="card-desc">Set by environment variables when the server starts. Read-only here.</p>
			<dl class="kv">
				<dt>Listen address</dt>
				<dd>
					@envValue(env.Addr, "default (:8580)")
				</dd>
				<dt>Database path</dt>
				<dd>
					@envValue(env.DBPath, "default")
				</dd>
				<dt>Base URL</dt>
				<dd>
					@envValue(env.BaseURL, "not set")
				</dd>
				<dt>Data directory</dt>
				<dd>
					@envValue(env.DataDir, "not set")
				</dd>
			</dl>
		}
		<form method="post" action="/admin/settings">
			<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
			@ui.Card("Registration") {
				<div class="form-group">
					<label class="form-check">
						<input type="checkbox" name="public_registration" value="1" checked?={ publicRegistration }/>
						Allow public registration
					</label>
					<p class="form-help">When enabled, anyone can create an account from the login page.</p>
				</div>
				<div class="form-group">
					<label class="form-label" for="invite_expiry_hours">Invite link expiry (hours)</label>
					<input class="form-control w-sm" type="number" id="invite_expiry_hours" name="invite_expiry_hours" value={ inviteExpiryHours } min="1"/>
					<p class="form-help">How long group invitation links remain valid. Default: 72 hours.</p>
				</div>
				<div class="form-group mb-0">
					<label class="form-label" for="dav_tombstone_days">Calendar and contact sync history (days)</label>
					<input class="form-control w-sm" type="number" id="dav_tombstone_days" name="dav_tombstone_days" value={ davTombstoneDays } min="1"/>
					<p class="form-help">How long deletions are remembered for CalDAV and CardDAV clients. A client that has not synced for longer downloads everything again. Default: 90 days.</p>
				</div>
			}
			@ui.Card("Security") {
				<div class="form-group mb-0">
					<label class="form-label" for="mfa_required">Require multi-factor authentication</label>
					<select class="form-control w-md" id="mfa_required" name="mfa_required">
						<option value="" selected?={ mfaRequired == "" }>Disabled</option>
						<option value="admins" selected?={ mfaRequired == "admins" }>Admin users only</option>
						<option value="all" selected?={ mfaRequired == "all" }>All users</option>
					</select>
					<p class="form-help">When enabled, users without MFA are sent to set it up when they log in.</p>
				</div>
			}
			@ui.Card("Passwords") {
				<div class="form-group">
					<label class="form-label" for="password_min_length">Minimum length</label>
					<input class="form-control w-sm" type="number" id="password_min_length" name="password_min_length" min="1" max="72" value={ strconv.Itoa(pw.MinLength) }/>
					<p class="form-help">Applies to new passwords: registration, changes, resets and accounts admins create. Length is the rule that helps; there are no character-class rules.</p>
				</div>
				<div class="form-group mb-0">
					<label class="form-check">
						<input type="checkbox" name="password_breach_check" value="1" checked?={ pw.BreachCheck }/> Refuse passwords found in known breaches
					</label>
					<p class="form-help">Checks against Pwned Passwords by k-anonymity: only the first five characters of the password's SHA-1 leave this server. When the service cannot be reached the password is refused rather than set unchecked.</p>
				</div>
			}
			@ui.Card("Federation") {
				<div class="form-group">
					<label class="form-check">
						<input type="checkbox" name="federation_enabled" value="1" checked?={ fed.Enabled }/>
						Share with other servers
					</label>
					<p class="form-help">Lets users share files with people on other Nextcloud-compatible servers, and receive shares from them. Off, this server neither sends shares nor accepts them, and servers it shared with lose access.</p>
				</div>
				<div class="form-group mb-0">
					<label class="form-label" for="federation_peers">Allowed servers</label>
					<textarea class="form-control" id="federation_peers" name="federation_peers" rows="3" placeholder="cloud.example.com">{ fed.Peers }</textarea>
					<p class="form-help">One host name per line. Shares from any other server are refused. A line of <code>*</code> accepts shares from any server that runs federation; anyone can then put a share in a user's pending list.</p>
					if fed.EnvPeers != "" {
						<p class="form-help">Also allowed, by COG_FEDERATION_PEERS: <code>{ fed.EnvPeers }</code></p>
					}
				</div>
			}
			<div class="page-actions-bar">
				<button class="btn btn-primary" type="submit">Save settings</button>
			</div>
		</form>
	}
}

// envValue shows a configuration value, or what applies when it is unset.
templ envValue(v, unset string) {
	if v != "" {
		<code>{ v }</code>
	} else {
		<span class="text-muted">{ unset }</span>
	}
}

// --- Email ---
templ adminEmailPage(pd ui.PageData, smtp smtpSettingsData, overrideHTML string, overrideText string, defaultHTML string, defaultText string, flash string, flashKind string) {
	@ui.AdminSidebarPage(pd, "email") {
		@ui.HelpPageHeader("Email", "admin/email.html", nil)
		@ui.Alert(flashKind, flash)
		<form method="post" action="/admin/email">
			<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
			@ui.Card("SMTP") {
				<p class="card-desc">The mail server used for invitations, password resets and sign-in codes.</p>
				<div class="form-row">
					<div class="form-group">
						<label for="smtp_host">Host</label>
						<input class="form-control" type="text" id="smtp_host" name="smtp_host" value={ smtp.Host } placeholder="smtp.example.com"/>
					</div>
					<div class="form-group form-group-auto">
						<label for="smtp_port">Port</label>
						<input class="form-control w-xs" type="number" id="smtp_port" name="smtp_port" value={ smtp.Port } min="1" max="65535"/>
					</div>
				</div>
				<div class="form-row">
					<div class="form-group">
						<label for="smtp_user">Username</label>
						<input class="form-control" type="text" id="smtp_user" name="smtp_user" value={ smtp.User } autocomplete="off"/>
					</div>
					<div class="form-group">
						<label for="smtp_pass">Password</label>
						<input class="form-control" type="password" id="smtp_pass" name="smtp_pass" value={ smtp.Pass } autocomplete="new-password"/>
					</div>
				</div>
				@ui.FormField("From address", "smtp_from", "email", smtp.From, "noreply@example.com")
				<div class="btn-group">
					<button
						class="btn btn-secondary"
						type="button"
						hx-post="/admin/email/test-smtp"
						hx-target="#smtp-test-result"
						hx-swap="innerHTML"
						hx-headers={ "{\"X-CSRF-Token\":\"" + pd.CSRFToken + "\"}" }
					>Test connection</button>
					<span class="text-sm text-muted">Tests the values above, saved or not.</span>
				</div>
				<div id="smtp-test-result" class="mt-1"></div>
			}
			@ui.Card("HTML template override") {
				<p class="card-desc">
					Override the default HTML email templates using Go <code>html/template</code> syntax. Define blocks to replace: <code>layout</code>, <code>group_invite</code>, <code>password_reset</code>, <code>otp</code>. The layout uses <code>{ "{{content}}" }</code> to render the email body.
				</p>
				<details class="mb-1">
					<summary class="text-sm text-muted">View default HTML template</summary>
					<pre class="code-block mt-1">{ defaultHTML }</pre>
				</details>
				<label class="sr-only" for="override-html">HTML template override</label>
				<textarea class="form-control mono" id="override-html" name="override_html" rows="10" placeholder="Leave empty to use defaults" oninput="schedulePreview()">{ overrideHTML }</textarea>
				<details class="mt-1">
					<summary class="text-sm font-semibold">Preview</summary>
					<div class="mt-1">
						<div class="btn-group mb-1">
							<button class="btn btn-secondary btn-sm" type="button" onclick="showHTMLPreview('group_invite')">Group invite</button>
							<button class="btn btn-secondary btn-sm" type="button" onclick="showHTMLPreview('password_reset')">Password reset</button>
							<button class="btn btn-secondary btn-sm" type="button" onclick="showHTMLPreview('otp')">Sign-in code</button>
						</div>
						<iframe id="preview-html" class="email-preview" title="HTML email preview"></iframe>
					</div>
				</details>
			}
			@ui.Card("Text template override") {
				<p class="card-desc">
					Override the default plain-text email templates using Go <code>text/template</code> syntax. Same block names as HTML.
				</p>
				<details class="mb-1">
					<summary class="text-sm text-muted">View default text template</summary>
					<pre class="code-block mt-1">{ defaultText }</pre>
				</details>
				<label class="sr-only" for="override-text">Text template override</label>
				<textarea class="form-control mono" id="override-text" name="override_text" rows="8" placeholder="Leave empty to use defaults" oninput="schedulePreview()">{ overrideText }</textarea>
				<details class="mt-1">
					<summary class="text-sm font-semibold">Preview</summary>
					<div class="mt-1">
						<div class="btn-group mb-1">
							<button class="btn btn-secondary btn-sm" type="button" onclick="showTextPreview('group_invite')">Group invite</button>
							<button class="btn btn-secondary btn-sm" type="button" onclick="showTextPreview('password_reset')">Password reset</button>
							<button class="btn btn-secondary btn-sm" type="button" onclick="showTextPreview('otp')">Sign-in code</button>
						</div>
						<iframe id="preview-text" class="email-preview" title="Text email preview"></iframe>
					</div>
				</details>
			}
			<div class="page-actions-bar">
				<button class="btn btn-primary" type="submit">Save email settings</button>
			</div>
		</form>
		<script>
			var htmlPreviewName = "password_reset";
			var textPreviewName = "password_reset";
			var previewTimer = null;
			var csrfToken = document.querySelector("input[name=csrf_token]").value;

			function schedulePreview() {
				clearTimeout(previewTimer);
				previewTimer = setTimeout(refreshAllPreviews, 400);
			}

			function refreshAllPreviews() {
				refreshPreview("preview-html", htmlPreviewName, "html");
				refreshPreview("preview-text", textPreviewName, "text");
			}

			function showHTMLPreview(name) {
				htmlPreviewName = name;
				refreshPreview("preview-html", name, "html");
			}

			function showTextPreview(name) {
				textPreviewName = name;
				refreshPreview("preview-text", name, "text");
			}

			function refreshPreview(frameId, name, format) {
				var frame = document.getElementById(frameId);
				if (!frame || !frame.offsetParent) return; // skip if details is closed
				var url = "/admin/email/preview/" + name;
				if (format === "text") url += "?format=text";
				var body = new URLSearchParams();
				body.set("csrf_token", csrfToken);
				body.set(
					"override_html",
					document.getElementById("override-html").value,
				);
				body.set(
					"override_text",
					document.getElementById("override-text").value,
				);
				fetch(url, {
					method: "POST",
					headers: { "Content-Type": "application/x-www-form-urlencoded" },
					body: body.toString(),
				})
					.then(function (r) {
						return r.text();
					})
					.then(function (html) {
						frame.srcdoc = html;
					});
			}

			// Load initial preview when a details element is opened.
			document.querySelectorAll("details").forEach(function (d) {
				d.addEventListener("toggle", function () {
					if (d.open) {
						var frame = d.querySelector("iframe");
						if (frame && !frame.srcdoc) {
							if (frame.id === "preview-html")
								refreshPreview("preview-html", htmlPreviewName, "html");
							if (frame.id === "preview-text")
								refreshPreview("preview-text", textPreviewName, "text");
						}
					}
				});
			});
		</script>
	}
}

templ smtpTestAlert(kind, title, detail string) {
	<div class={ "alert alert-" + kind } role="status">
		<button type="button" class="alert-dismiss" onclick="this.parentElement.remove()" aria-label="Dismiss">&times;</button>
		<div class="alert-title">{ title }</div>
		<p class="text-sm">{ detail }</p>
	</div>
}

// --- Logs ---

func logLevelBadgeClass(level slog.Level) string {
	switch {
	case level >= slog.LevelError:
		return "badge badge-danger"
	case level >= slog.LevelWarn:
		return "badge badge-warn"
	case level >= slog.LevelInfo:
		return "badge badge-admin"
	default:
		return "badge"
	}
}

func logLevelLabel(level slog.Level) string {
	return strings.ToUpper(level.String())
}

templ adminLogsPage(pd ui.PageData, entries []logbuf.Entry, sources []string) {
	@ui.AdminSidebarPage(pd, "logs") {
		@ui.PageHeader("Server logs", nil) {
			<button type="button" id="log-copy" class="btn btn-secondary" onclick="cogCopy(this, logEntriesText)" title="Copy the entries shown, oldest first">Copy</button>
		}
		<form
			id="log-filters"
			class="log-filters"
			hx-get="/admin/logs/entries"
			hx-target="#log-tbody"
			hx-swap="innerHTML"
			hx-trigger="input delay:300ms, submit"
			onsubmit="return false"
		>
			<fieldset>
				<legend class="sr-only">Levels</legend>
				<div class="chip-group">
					for _, l := range []string{"DEBUG", "INFO", "WARN", "ERROR"} {
						<label class="chip">
							<input type="checkbox" name="level" value={ l } checked/>
							{ l }
						</label>
					}
				</div>
			</fieldset>
			<fieldset>
				<legend class="sr-only">Sources</legend>
				<div class="chip-group">
					<label class="chip">
						<input type="checkbox" name="source" value="server" checked/>
						server
					</label>
					for _, src := range sources {
						<label class="chip">
							<input type="checkbox" name="source" value={ src } checked/>
							{ src }
						</label>
					}
				</div>
			</fieldset>
			<label class="sr-only" for="log-regex">Filter messages</label>
			<input type="search" id="log-regex" name="regex" class="form-control" placeholder="Filter messages (regular expression)…"/>
		</form>
		<p class="text-sm text-muted mb-1">{ fmt.Sprintf("%d entries, newest first", len(entries)) }</p>
		<div class="card card-flush">
			<div class="table-wrap log-scroll">
				<table class="table table-sm">
					<thead>
						<tr>
							<th class="col-shrink">Time</th>
							<th class="col-shrink">Level</th>
							<th>Message</th>
						</tr>
					</thead>
					<tbody id="log-tbody">
						@logEntriesPartial(entries)
					</tbody>
				</table>
			</div>
		</div>
		@logEntriesScript()
	}
}

// logEntriesScript defines how this page turns its rows into text. The copying
// itself belongs to cogCopy in cog-share.js; only the scraping is specific to
// the log table.
//
// It reads the DOM rather than re-fetching, so what is copied is what is on the
// screen, filters and all, and it reverses the rows on the way out: the table
// shows newest first, which prints a stack trace spanning thirty entries
// backwards. Chronological is what anyone pasting it elsewhere wants.
templ logEntriesScript() {
	<script>
		function logEntriesText() {
			const rows = Array.from(
				document.querySelectorAll("#log-tbody tr"),
			).reverse();
			return rows
				.map((row) =>
					Array.from(row.querySelectorAll("td"))
						.map((c) => c.innerText.trim())
						.join("\t"),
				)
				.join("\n");
		}
	</script>
}

templ logEntriesPartial(entries []logbuf.Entry) {
	if len(entries) == 0 {
		<tr><td colspan="3" class="empty-state">No entries match these filters.</td></tr>
	}
	for i := len(entries) - 1; i >= 0; i-- {
		<tr>
			<td class="nowrap"><code>{ entries[i].Time.Format("15:04:05.000") }</code></td>
			<td><span class={ logLevelBadgeClass(entries[i].Level) }>{ logLevelLabel(entries[i].Level) }</span></td>
			<td><code class="log-message">{ entries[i].Message }</code></td>
		</tr>
	}
}

// --- Plugins ---
templ adminPluginsPage(pd ui.PageData, plugins []PluginInfo, unsandboxed string) {
	@ui.AdminSidebarPage(pd, "plugins") {
		@ui.PageHeader("Plugins", nil)
		@ui.Alert("warning", unsandboxed)
		<div class="card card-flush">
			<div class="table-wrap">
				<table class="table">
					<thead>
						<tr>
							<th>Plugin</th>
							<th>Status</th>
							<th class="col-actions"><span class="sr-only">Actions</span></th>
						</tr>
					</thead>
					<tbody>
						for _, p := range plugins {
							<tr>
								<td class="font-medium">{ p.ID }</td>
								<td>
									if p.Enabled {
										<span class="badge badge-success">Enabled</span>
									} else {
										<span class="badge badge-neutral">Disabled</span>
									}
								</td>
								<td class="col-actions">
									if p.Protected {
										<span class="badge badge-outline" title="Built in; cannot be disabled">
											@ui.Icon("lock")
											Built in
										</span>
									} else {
										<form method="post" action={ templ.SafeURL("/admin/plugins/" + p.ID + "/toggle") }>
											<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
											if p.Enabled {
												<button class="btn btn-secondary btn-sm" type="submit">Disable</button>
											} else {
												<button class="btn btn-primary btn-sm" type="submit">Enable</button>
											}
										</form>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	}
}
