package web

import (
	"git.duckfam.us/jj-software/cog/ui"
	"git.duckfam.us/jj-software/cog/internal/user"
	"git.duckfam.us/jj-software/cog/internal/group"
	"fmt"
)

// --- Index ---

templ adminIndexPage(pd ui.PageData) {
	@ui.Base(pd) {
		<h1 style="margin-bottom:1rem">Administration</h1>
		<div class="flex gap-1" style="flex-wrap:wrap">
			@ui.Card("Users") {
				<p>Manage user accounts, permissions, and passwords.</p>
				<a class="btn btn-primary" href="/admin/users">Manage Users</a>
			}
			@ui.Card("Groups") {
				<p>Manage groups and group memberships.</p>
				<a class="btn btn-primary" href="/admin/groups">Manage Groups</a>
			}
			@ui.Card("Volumes") {
				<p>Manage storage volumes and backends.</p>
				<a class="btn btn-primary" href="/admin/volumes">Manage Volumes</a>
			}
		</div>
	}
}

// --- Users ---

templ adminUsersPage(pd ui.PageData, users []user.User, flash string, flashKind string) {
	@ui.Base(pd) {
		<div class="flex justify-between items-center" style="margin-bottom:1rem">
			<h1>Users</h1>
			<a class="btn btn-primary" href="/admin/users/new">New User</a>
		</div>
		if flash != "" {
			@ui.Alert(flashKind, flash)
		}
		@ui.Card("") {
			<table class="table">
				<thead>
					<tr>
						<th>Username</th>
						<th>Display Name</th>
						<th>Role</th>
						<th class="text-right">Actions</th>
					</tr>
				</thead>
				<tbody>
					for _, u := range users {
						<tr id={ "user-" + u.ID }>
							<td>{ u.Username }</td>
							<td>{ u.DisplayName }</td>
							<td>
								if u.IsAdmin {
									<span class="badge badge-admin">Admin</span>
								}
							</td>
							<td class="text-right">
								<a class="btn btn-outline btn-sm" href={ templ.SafeURL("/admin/users/" + u.ID) }>Edit</a>
								<button
									class="btn btn-danger btn-sm"
									hx-delete={ "/admin/users/" + u.ID }
									hx-target={ "#user-" + u.ID }
									hx-swap="outerHTML"
									hx-confirm="Delete this user?"
								>Delete</button>
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
	}
}

templ adminUserNewPage(pd ui.PageData, errMsg string) {
	@ui.Base(pd) {
		<h1 style="margin-bottom:1rem">New User</h1>
		if errMsg != "" {
			@ui.Alert("error", errMsg)
		}
		@ui.Card("") {
			<form method="post" action="/admin/users">
				<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
				@ui.FormField("Username", "username", "text", "", "")
				@ui.FormField("Password", "password", "password", "", "")
				<div class="form-group">
					<label class="form-check">
						<input type="checkbox" name="is_admin" value="1"/>
						Admin
					</label>
				</div>
				<button class="btn btn-primary" type="submit">Create User</button>
				<a class="btn btn-outline" href="/admin/users" style="margin-left:0.5rem">Cancel</a>
			</form>
		}
	}
}

templ adminUserEditPage(pd ui.PageData, u *user.User, flash string, flashKind string) {
	@ui.Base(pd) {
		<h1 style="margin-bottom:1rem">Edit User: { u.Username }</h1>
		if flash != "" {
			@ui.Alert(flashKind, flash)
		}
		@ui.Card("Profile") {
			<form method="post" action={ templ.SafeURL("/admin/users/" + u.ID) }>
				<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
				@ui.FormField("Display Name", "display_name", "text", u.DisplayName, "")
				<div class="form-group">
					<label class="form-check">
						if u.IsAdmin {
							<input type="checkbox" name="is_admin" value="1" checked/>
						} else {
							<input type="checkbox" name="is_admin" value="1"/>
						}
						Admin
					</label>
				</div>
				<button class="btn btn-primary" type="submit">Save</button>
				<a class="btn btn-outline" href="/admin/users" style="margin-left:0.5rem">Back</a>
			</form>
		}
		@ui.Card("Reset Password") {
			<form method="post" action={ templ.SafeURL("/admin/users/" + u.ID + "/password") }>
				<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
				@ui.FormField("New Password", "new_password", "password", "", "")
				<button class="btn btn-primary" type="submit">Reset Password</button>
			</form>
		}
	}
}

// --- Groups ---

templ adminGroupsPage(pd ui.PageData, groups []group.Group, flash string, flashKind string) {
	@ui.Base(pd) {
		<div class="flex justify-between items-center" style="margin-bottom:1rem">
			<h1>Groups</h1>
		</div>
		if flash != "" {
			@ui.Alert(flashKind, flash)
		}
		@ui.Card("Create Group") {
			<form method="post" action="/admin/groups" class="flex gap-1 items-center">
				<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
				<input class="form-control" type="text" name="name" placeholder="Group name" required style="max-width:300px"/>
				<button class="btn btn-primary" type="submit">Create</button>
			</form>
		}
		@ui.Card("") {
			<table class="table">
				<thead>
					<tr>
						<th>Name</th>
						<th class="text-right">Actions</th>
					</tr>
				</thead>
				<tbody>
					for _, g := range groups {
						<tr id={ "group-" + g.ID }>
							<td>{ g.Name }</td>
							<td class="text-right">
								<a class="btn btn-outline btn-sm" href={ templ.SafeURL("/admin/groups/" + g.ID) }>Edit</a>
								<button
									class="btn btn-danger btn-sm"
									hx-delete={ "/admin/groups/" + g.ID }
									hx-target={ "#group-" + g.ID }
									hx-swap="outerHTML"
									hx-confirm="Delete this group?"
								>Delete</button>
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
	}
}

templ adminGroupEditPage(pd ui.PageData, g *group.Group, members []group.Member, users []user.User, flash string, flashKind string) {
	@ui.Base(pd) {
		<h1 style="margin-bottom:1rem">Edit Group: { g.Name }</h1>
		if flash != "" {
			@ui.Alert(flashKind, flash)
		}
		@ui.Card("Group Name") {
			<form method="post" action={ templ.SafeURL("/admin/groups/" + g.ID) }>
				<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
				@ui.FormField("Name", "name", "text", g.Name, "")
				<button class="btn btn-primary" type="submit">Save</button>
				<a class="btn btn-outline" href="/admin/groups" style="margin-left:0.5rem">Back</a>
			</form>
		}
		@ui.Card("Members") {
			<form method="post" action={ templ.SafeURL("/admin/groups/" + g.ID + "/members") } class="flex gap-1 items-center mb-2">
				<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
				<select class="form-control" name="member_id" style="max-width:300px">
					for _, u := range users {
						<option value={ u.ID }>{ u.Username }</option>
					}
				</select>
				<input type="hidden" name="member_type" value="USER"/>
				<button class="btn btn-primary" type="submit">Add</button>
			</form>
			<table class="table mb-0">
				<thead>
					<tr>
						<th>Member</th>
						<th>Type</th>
						<th class="text-right">Actions</th>
					</tr>
				</thead>
				<tbody>
					for _, m := range members {
						<tr id={ fmt.Sprintf("member-%s-%s", g.ID, m.MemberID) }>
							<td>{ memberLabel(m, users) }</td>
							<td>{ m.MemberType }</td>
							<td class="text-right">
								<button
									class="btn btn-danger btn-sm"
									hx-delete={ fmt.Sprintf("/admin/groups/%s/members/%s", g.ID, m.MemberID) }
									hx-target={ fmt.Sprintf("#member-%s-%s", g.ID, m.MemberID) }
									hx-swap="outerHTML"
								>Remove</button>
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
	}
}

func memberLabel(m group.Member, users []user.User) string {
	if m.MemberType == "USER" {
		for _, u := range users {
			if u.ID == m.MemberID {
				return u.Username
			}
		}
	}
	return m.MemberID
}
