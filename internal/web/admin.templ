package web

import (
	"fmt"
	"git.duckfam.us/jj-software/cog/internal/group"
	"git.duckfam.us/jj-software/cog/internal/logbuf"
	"git.duckfam.us/jj-software/cog/internal/user"
	"git.duckfam.us/jj-software/cog/ui"
	"iter"
	"log/slog"
	"strconv"
	"strings"
	"time"
)

// --- Users ---
templ adminUsersPage(pd ui.PageData, users iter.Seq2[user.User, error], flash string, flashKind string) {
	@ui.AdminSidebarPage(pd, "users") {
		<div class="flex justify-between items-center" style="margin-bottom:1rem">
			<h1>Users</h1>
			<a class="btn btn-primary" href="/admin/users/new">New User</a>
		</div>
		if flash != "" {
			@ui.Alert(flashKind, flash)
		}
		@ui.Card("") {
			<table class="table">
				<thead>
					<tr>
						<th style="width:2.5rem"></th>
						<th>Username</th>
						<th>Display Name</th>
						<th>Role</th>
					</tr>
				</thead>
				<tbody>
					for u, err := range users {
						if err == nil {
							<tr style="cursor:pointer" onclick={ goTo("/admin/users/" + u.ID) }>
								<td><img src={ u.AvatarURL() } alt="" style="width:2rem;height:2rem;border-radius:50%;vertical-align:middle"/></td>
								<td>{ u.Username }</td>
								<td>{ u.DisplayName }</td>
								<td>
									if u.IsAdmin {
										<span class="badge badge-admin">Admin</span>
									}
								</td>
							</tr>
						}
					}
				</tbody>
			</table>
		}
	}
}

templ adminUserNewPage(pd ui.PageData, errMsg string) {
	@ui.AdminSidebarPage(pd, "users") {
		<h1 style="margin-bottom:1rem">New User</h1>
		if errMsg != "" {
			@ui.Alert("error", errMsg)
		}
		@ui.Card("") {
			<form method="post" action="/admin/users">
				<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
				@ui.FormField("Username", "username", "text", "", "")
				@ui.FormField("Password", "password", "password", "", "")
				<div class="form-group">
					<label class="form-check">
						<input type="checkbox" name="is_admin" value="1"/>
						Admin
					</label>
				</div>
				<button class="btn btn-primary" type="submit">Create User</button>
				<a class="btn btn-outline" href="/admin/users" style="margin-left:0.5rem">Cancel</a>
			</form>
		}
	}
}

templ adminUserEditPage(pd ui.PageData, u *user.User, flash string, flashKind string) {
	@ui.AdminSidebarPage(pd, "users") {
		<h1 style="margin-bottom:1rem">Edit User: { u.Username }</h1>
		if flash != "" {
			@ui.Alert(flashKind, flash)
		}
		@ui.Card("Profile") {
			<div style="margin-bottom:1rem">
				<img src={ u.AvatarURL() } alt="" style="width:4rem;height:4rem;border-radius:50%"/>
			</div>
			<form method="post" action={ templ.SafeURL("/admin/users/" + u.ID) }>
				<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
				@ui.FormField("Display Name", "display_name", "text", u.DisplayName, "")
				<div class="form-group">
					<label class="form-check">
						if u.IsAdmin {
							<input type="checkbox" name="is_admin" value="1" checked/>
						} else {
							<input type="checkbox" name="is_admin" value="1"/>
						}
						Admin
					</label>
				</div>
				<button class="btn btn-primary" type="submit">Save</button>
				<a class="btn btn-outline" href="/admin/users" style="margin-left:0.5rem">Back</a>
			</form>
		}
		@ui.Card("Reset Password") {
			<form method="post" action={ templ.SafeURL("/admin/users/" + u.ID + "/password") }>
				<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
				@ui.FormField("New Password", "new_password", "password", "", "")
				<button class="btn btn-primary" type="submit">Reset Password</button>
			</form>
		}
		@ui.Card("Danger Zone") {
			<p class="text-muted" style="margin-bottom:0.5rem">Deleting a user removes all their data and cannot be undone.</p>
			<button
				class="btn btn-danger"
				hx-delete={ "/admin/users/" + u.ID }
				hx-confirm="Delete this user? This cannot be undone."
				hx-on::after-request="window.location='/admin/users'"
			>Delete User</button>
		}
	}
}

// --- Groups ---
templ adminGroupsPage(pd ui.PageData, groups []group.Group, flash string, flashKind string) {
	@ui.AdminSidebarPage(pd, "groups") {
		<div class="flex justify-between items-center" style="margin-bottom:1rem">
			<h1>Groups</h1>
		</div>
		if flash != "" {
			@ui.Alert(flashKind, flash)
		}
		@ui.Card("Create Group") {
			<form method="post" action="/admin/groups" class="flex gap-1 items-center">
				<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
				<input class="form-control" type="text" name="name" placeholder="Group name" required style="max-width:200px"/>
				<button class="btn btn-primary" type="submit">Create</button>
			</form>
		}
		@ui.Card("") {
			@groupTable(groups, "/admin/groups/")
		}
	}
}

// --- Settings ---
templ adminSettingsPage(pd ui.PageData, publicRegistration bool, inviteExpiryHours string, env envConfigData, status statusData, flash string, flashKind string, mfaRequired string) {
	@ui.AdminSidebarPage(pd, "settings") {
		<h1 style="margin-bottom:1rem">System Settings</h1>
		if flash != "" {
			@ui.Alert(flashKind, flash)
		}
		@ui.Card("Status") {
			<table class="table">
				<tbody>
					<tr><td style="font-weight:600;width:10rem">Instance Uptime</td><td>{ FormatDuration(status.InstanceUptime) }</td></tr>
					<tr><td style="font-weight:600">Server Uptime</td><td>{ FormatDuration(status.ServerUptime) }</td></tr>
					if status.CommitHash != "" {
						<tr><td style="font-weight:600">Build</td><td><code>{ status.CommitHash }</code> ({ status.CommitDate.Format(time.RFC3339) })</td></tr>
					}
				</tbody>
			</table>
		}
		@ui.Card("Environment") {
			<p class="text-muted" style="font-size:0.85rem;margin-bottom:0.75rem">Server configuration from environment variables (read-only).</p>
			<table class="table">
				<tbody>
					<tr><td style="font-weight:600;width:10rem">Listen Address</td><td><code>{ env.Addr }</code></td></tr>
					<tr><td style="font-weight:600">Database Path</td><td><code>{ env.DBPath }</code></td></tr>
					<tr><td style="font-weight:600">Base URL</td><td><code>{ env.BaseURL }</code></td></tr>
					<tr><td style="font-weight:600">Data Directory</td><td><code>{ env.DataDir }</code></td></tr>
				</tbody>
			</table>
		}
		<form method="post" action="/admin/settings">
			<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
			@ui.Card("Registration") {
				<div class="form-group">
					<label class="form-check">
						if publicRegistration {
							<input type="checkbox" name="public_registration" value="1" checked/>
						} else {
							<input type="checkbox" name="public_registration" value="1"/>
						}
						Allow public registration
					</label>
					<p class="text-muted" style="font-size:0.85rem;margin-top:0.25rem">When enabled, anyone can create an account from the login page.</p>
				</div>
				<div class="form-group">
					<label class="form-label" for="invite_expiry_hours">Invite link expiry (hours)</label>
					<input class="form-control" type="number" id="invite_expiry_hours" name="invite_expiry_hours" value={ inviteExpiryHours } min="1" style="max-width:200px"/>
					<p class="text-muted" style="font-size:0.85rem;margin-top:0.25rem">How long group invitation links remain valid. Default: 72 hours.</p>
				</div>
			}
			@ui.Card("Security") {
				<div class="form-group">
					<label class="form-label" for="mfa_required">Require Multi-Factor Authentication</label>
					<select class="form-control" id="mfa_required" name="mfa_required" style="max-width:250px">
						if mfaRequired == "" {
							<option value="" selected>Disabled</option>
						} else {
							<option value="">Disabled</option>
						}
						if mfaRequired == "admins" {
							<option value="admins" selected>Admin users only</option>
						} else {
							<option value="admins">Admin users only</option>
						}
						if mfaRequired == "all" {
							<option value="all" selected>All users</option>
						} else {
							<option value="all">All users</option>
						}
					</select>
					<p class="text-muted" style="font-size:0.85rem;margin-top:0.25rem">When enabled, users without MFA will be redirected to set it up on login.</p>
				</div>
			}
			<button class="btn btn-primary" type="submit">Save Settings</button>
		</form>
	}
}

// --- Email ---

templ adminEmailPage(pd ui.PageData, smtp smtpSettingsData, overrideHTML string, overrideText string, defaultHTML string, defaultText string, flash string, flashKind string) {
	@ui.AdminSidebarPage(pd, "email") {
		<h1 style="margin-bottom:1rem">Email Settings</h1>
		if flash != "" {
			@ui.Alert(flashKind, flash)
		}
		<form method="post" action="/admin/email">
			<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
			@ui.Card("SMTP Configuration") {
				<p class="text-muted" style="font-size:0.85rem;margin-bottom:0.75rem">Configure SMTP for sending invitation and notification emails.</p>
				@ui.FormField("SMTP Host", "smtp_host", "text", smtp.Host, "smtp.example.com")
				<div class="form-group">
					<label for="smtp_port">SMTP Port</label>
					<input class="form-control" type="number" id="smtp_port" name="smtp_port" value={ smtp.Port } min="1" max="65535" style="max-width:200px"/>
				</div>
				@ui.FormField("SMTP Username", "smtp_user", "text", smtp.User, "")
				@ui.FormField("SMTP Password", "smtp_pass", "password", smtp.Pass, "")
				@ui.FormField("From Address", "smtp_from", "email", smtp.From, "noreply@example.com")
				<button
					class="btn btn-outline btn-sm"
					type="button"
					hx-post="/admin/email/test-smtp"
					hx-target="#smtp-test-result"
					hx-swap="innerHTML"
					hx-headers={ "{\"X-CSRF-Token\":\"" + pd.CSRFToken + "\"}" }
					style="margin-top:0.75rem"
				>Test Connection</button>
				<div id="smtp-test-result"></div>
			}
			@ui.Card("HTML Template Override") {
				<p class="text-muted" style="font-size:0.85rem;margin-bottom:0.75rem">
					Override the default HTML email templates using Go <code>html/template</code> syntax. Define blocks to replace: <code>layout</code>, <code>group_invite</code>, <code>password_reset</code>, <code>otp</code>. The layout uses <code>{"{{content}}"}</code> to render the email body.
				</p>
				<details style="margin-bottom:0.75rem">
					<summary class="text-muted" style="cursor:pointer;font-size:0.85rem">View default HTML template</summary>
					<pre style="background:var(--color-bg-alt);padding:0.75rem;border-radius:4px;font-size:0.8rem;margin-top:0.5rem;max-height:300px;overflow:auto">{ defaultHTML }</pre>
				</details>
				<textarea class="form-control" id="override-html" name="override_html" rows="10" placeholder="Leave empty to use defaults" style="font-family:monospace;font-size:0.85rem" oninput="schedulePreview()">{ overrideHTML }</textarea>
				<details style="margin-top:0.75rem">
					<summary style="cursor:pointer;font-size:0.85rem;font-weight:600">Preview</summary>
					<div style="margin-top:0.5rem">
						<div class="flex gap-1" style="margin-bottom:0.5rem">
							<button class="btn btn-outline btn-sm" type="button" onclick="showHTMLPreview('group_invite')">Group Invite</button>
							<button class="btn btn-outline btn-sm" type="button" onclick="showHTMLPreview('password_reset')">Password Reset</button>
							<button class="btn btn-outline btn-sm" type="button" onclick="showHTMLPreview('otp')">OTP Code</button>
						</div>
						<iframe id="preview-html" style="width:100%;height:400px;border:1px solid var(--color-border);border-radius:4px;background:#fff"></iframe>
					</div>
				</details>
			}
			@ui.Card("Text Template Override") {
				<p class="text-muted" style="font-size:0.85rem;margin-bottom:0.75rem">
					Override the default plain-text email templates using Go <code>text/template</code> syntax. Same block names as HTML.
				</p>
				<details style="margin-bottom:0.75rem">
					<summary class="text-muted" style="cursor:pointer;font-size:0.85rem">View default text template</summary>
					<pre style="background:var(--color-bg-alt);padding:0.75rem;border-radius:4px;font-size:0.8rem;margin-top:0.5rem;max-height:300px;overflow:auto">{ defaultText }</pre>
				</details>
				<textarea class="form-control" id="override-text" name="override_text" rows="8" placeholder="Leave empty to use defaults" style="font-family:monospace;font-size:0.85rem" oninput="schedulePreview()">{ overrideText }</textarea>
				<details style="margin-top:0.75rem">
					<summary style="cursor:pointer;font-size:0.85rem;font-weight:600">Preview</summary>
					<div style="margin-top:0.5rem">
						<div class="flex gap-1" style="margin-bottom:0.5rem">
							<button class="btn btn-outline btn-sm" type="button" onclick="showTextPreview('group_invite')">Group Invite</button>
							<button class="btn btn-outline btn-sm" type="button" onclick="showTextPreview('password_reset')">Password Reset</button>
							<button class="btn btn-outline btn-sm" type="button" onclick="showTextPreview('otp')">OTP Code</button>
						</div>
						<iframe id="preview-text" style="width:100%;height:300px;border:1px solid var(--color-border);border-radius:4px;background:#fff"></iframe>
					</div>
				</details>
			}
			<button class="btn btn-primary" type="submit">Save Email Settings</button>
		</form>
		<script>
		var htmlPreviewName = 'password_reset';
		var textPreviewName = 'password_reset';
		var previewTimer = null;
		var csrfToken = document.querySelector('input[name=csrf_token]').value;

		function schedulePreview() {
			clearTimeout(previewTimer);
			previewTimer = setTimeout(refreshAllPreviews, 400);
		}

		function refreshAllPreviews() {
			refreshPreview('preview-html', htmlPreviewName, 'html');
			refreshPreview('preview-text', textPreviewName, 'text');
		}

		function showHTMLPreview(name) {
			htmlPreviewName = name;
			refreshPreview('preview-html', name, 'html');
		}

		function showTextPreview(name) {
			textPreviewName = name;
			refreshPreview('preview-text', name, 'text');
		}

		function refreshPreview(frameId, name, format) {
			var frame = document.getElementById(frameId);
			if (!frame || !frame.offsetParent) return; // skip if details is closed
			var url = '/admin/email/preview/' + name;
			if (format === 'text') url += '?format=text';
			var body = new URLSearchParams();
			body.set('csrf_token', csrfToken);
			body.set('override_html', document.getElementById('override-html').value);
			body.set('override_text', document.getElementById('override-text').value);
			fetch(url, {method:'POST', headers:{'Content-Type':'application/x-www-form-urlencoded'}, body:body.toString()})
				.then(function(r) { return r.text(); })
				.then(function(html) { frame.srcdoc = html; });
		}

		// Load initial preview when a details element is opened.
		document.querySelectorAll('details').forEach(function(d) {
			d.addEventListener('toggle', function() {
				if (d.open) {
					var frame = d.querySelector('iframe');
					if (frame && !frame.srcdoc) {
						if (frame.id === 'preview-html') refreshPreview('preview-html', htmlPreviewName, 'html');
						if (frame.id === 'preview-text') refreshPreview('preview-text', textPreviewName, 'text');
					}
				}
			});
		});
		</script>
	}
}

templ smtpTestAlert(kind, title, detail string) {
	<div class={ "alert alert-" + kind } style="position:relative">
		<button type="button" class="alert-dismiss" onclick="this.parentElement.remove()" aria-label="Close">&times;</button>
		<strong>{ title }</strong>
		<p style="margin:0.25rem 0 0;font-size:0.85rem">{ detail }</p>
	</div>
}

// --- Logs ---

func logLevelBadgeClass(level slog.Level) string {
	switch {
	case level >= slog.LevelError:
		return "badge badge-danger"
	case level >= slog.LevelWarn:
		return "badge badge-warn"
	case level >= slog.LevelInfo:
		return "badge badge-admin"
	default:
		return "badge"
	}
}

func logLevelLabel(level slog.Level) string {
	return strings.ToUpper(level.String())
}

func sourceSelectSize(sources []string) string {
	n := len(sources) + 1 // +1 for "server"
	if n > 6 {
		n = 6
	}
	return strconv.Itoa(n)
}

templ adminLogsPage(pd ui.PageData, entries []logbuf.Entry, sources []string) {
	@ui.AdminSidebarPage(pd, "logs") {
		<div class="flex justify-between items-center" style="margin-bottom:1rem">
			<h1>Server Logs</h1>
			<span class="text-muted" style="font-size:0.85rem">{ fmt.Sprintf("%d entries", len(entries)) }</span>
		</div>
		<div id="log-filters" class="flex items-center gap-1" style="margin-bottom:0.75rem;flex-wrap:wrap">
			<select name="level" multiple class="form-control" size="4" style="font-size:0.85rem;width:auto">
				<option value="DEBUG" selected>DEBUG</option>
				<option value="INFO" selected>INFO</option>
				<option value="WARN" selected>WARN</option>
				<option value="ERROR" selected>ERROR</option>
			</select>
			<select name="source" multiple class="form-control" style="font-size:0.85rem;width:auto" size={ sourceSelectSize(sources) }>
				<option value="server" selected>server</option>
				for _, s := range sources {
					<option value={ s } selected>{ s }</option>
				}
			</select>
			<input type="text" name="regex" class="form-control" placeholder="Filter (regex)..." style="max-width:16rem;font-size:0.85rem"/>
			<button type="button" class="btn btn-outline btn-sm" hx-get="/admin/logs/entries" hx-include="#log-filters" hx-target="#log-tbody" hx-swap="innerHTML">Refresh</button>
		</div>
		@ui.Card("") {
			<div style="max-height:600px;overflow-y:auto">
				<table class="table" style="font-size:0.85rem">
					<thead>
						<tr>
							<th style="width:8rem">Time</th>
							<th style="width:5rem">Level</th>
							<th>Message</th>
						</tr>
					</thead>
					<tbody id="log-tbody">
						@logEntriesPartial(entries)
					</tbody>
				</table>
			</div>
		}
	}
}

templ logEntriesPartial(entries []logbuf.Entry) {
	for i := len(entries) - 1; i >= 0; i-- {
		<tr>
			<td><code>{ entries[i].Time.Format("15:04:05.000") }</code></td>
			<td><span class={ logLevelBadgeClass(entries[i].Level) }>{ logLevelLabel(entries[i].Level) }</span></td>
			<td><code style="white-space:pre-wrap">{ entries[i].Message }</code></td>
		</tr>
	}
}

// --- Plugins ---
templ adminPluginsPage(pd ui.PageData, plugins []PluginInfo) {
	@ui.AdminSidebarPage(pd, "plugins") {
		<div class="flex justify-between items-center" style="margin-bottom:1rem">
			<h1>Plugins</h1>
		</div>
		@ui.Card("") {
			<table class="table">
				<thead>
					<tr>
						<th>Plugin</th>
						<th>Status</th>
						<th class="text-right">Actions</th>
					</tr>
				</thead>
				<tbody>
					for _, p := range plugins {
						<tr>
							<td>{ p.ID }</td>
							<td>
								if p.Enabled {
									<span class="badge badge-admin">Enabled</span>
								} else {
									<span class="badge">Disabled</span>
								}
								if p.Protected {
									<span class="badge" style="margin-left:0.25rem">Protected</span>
								}
							</td>
							<td class="text-right">
								if !p.Protected {
									<form method="post" action={ templ.SafeURL("/admin/plugins/" + p.ID + "/toggle") } style="display:inline">
										<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
										if p.Enabled {
											<button class="btn btn-outline btn-sm" type="submit">Disable</button>
										} else {
											<button class="btn btn-primary btn-sm" type="submit">Enable</button>
										}
									</form>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
	}
}
