package web

import (
	"git.duckfam.us/jj-software/cog/ui"
	"git.duckfam.us/jj-software/cog/internal/user"
	"git.duckfam.us/jj-software/cog/internal/group"
	"fmt"
)

func adminSidebar(active string) []ui.SidebarItem {
	return []ui.SidebarItem{
		{Label: "Overview", URL: "/admin/", Active: active == "index"},
		{Label: "Users", URL: "/admin/users", Active: active == "users"},
		{Label: "Groups", URL: "/admin/groups", Active: active == "groups"},
		{Label: "Volumes", URL: "/admin/volumes", Active: active == "volumes"},
		{Label: "Plugins", URL: "/admin/plugins", Active: active == "plugins"},
		{Label: "Settings", URL: "/admin/settings", Active: active == "settings"},
	}
}

// --- Index ---

templ adminIndexPage(pd ui.PageData) {
	@ui.SidebarPage(pd, adminSidebar("index")) {
		<h1 style="margin-bottom:1rem">Administration</h1>
		<div class="flex gap-1" style="flex-wrap:wrap">
			@ui.Card("Users") {
				<p>Manage user accounts, permissions, and passwords.</p>
				<a class="btn btn-primary" href="/admin/users">Manage Users</a>
			}
			@ui.Card("Groups") {
				<p>Manage groups and group memberships.</p>
				<a class="btn btn-primary" href="/admin/groups">Manage Groups</a>
			}
			@ui.Card("Volumes") {
				<p>Manage storage volumes and backends.</p>
				<a class="btn btn-primary" href="/admin/volumes">Manage Volumes</a>
			}
			@ui.Card("Plugins") {
				<p>Enable or disable installed plugins.</p>
				<a class="btn btn-primary" href="/admin/plugins">Manage Plugins</a>
			}
			@ui.Card("Settings") {
				<p>Configure system settings like registration.</p>
				<a class="btn btn-primary" href="/admin/settings">System Settings</a>
			}
		</div>
	}
}

// --- Users ---

templ adminUsersPage(pd ui.PageData, users []user.User, flash string, flashKind string) {
	@ui.SidebarPage(pd, adminSidebar("users")) {
		<div class="flex justify-between items-center" style="margin-bottom:1rem">
			<h1>Users</h1>
			<a class="btn btn-primary" href="/admin/users/new">New User</a>
		</div>
		if flash != "" {
			@ui.Alert(flashKind, flash)
		}
		@ui.Card("") {
			<table class="table">
				<thead>
					<tr>
						<th>Username</th>
						<th>Display Name</th>
						<th>Role</th>
						<th class="text-right">Actions</th>
					</tr>
				</thead>
				<tbody>
					for _, u := range users {
						<tr id={ "user-" + u.ID }>
							<td>{ u.Username }</td>
							<td>{ u.DisplayName }</td>
							<td>
								if u.IsAdmin {
									<span class="badge badge-admin">Admin</span>
								}
							</td>
							<td class="text-right">
								<a class="btn btn-outline btn-sm" href={ templ.SafeURL("/admin/users/" + u.ID) }>Edit</a>
								<button
									class="btn btn-danger btn-sm"
									hx-delete={ "/admin/users/" + u.ID }
									hx-target={ "#user-" + u.ID }
									hx-swap="outerHTML"
									hx-confirm="Delete this user?"
								>Delete</button>
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
	}
}

templ adminUserNewPage(pd ui.PageData, errMsg string) {
	@ui.SidebarPage(pd, adminSidebar("users")) {
		<h1 style="margin-bottom:1rem">New User</h1>
		if errMsg != "" {
			@ui.Alert("error", errMsg)
		}
		@ui.Card("") {
			<form method="post" action="/admin/users">
				<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
				@ui.FormField("Username", "username", "text", "", "")
				@ui.FormField("Password", "password", "password", "", "")
				<div class="form-group">
					<label class="form-check">
						<input type="checkbox" name="is_admin" value="1"/>
						Admin
					</label>
				</div>
				<button class="btn btn-primary" type="submit">Create User</button>
				<a class="btn btn-outline" href="/admin/users" style="margin-left:0.5rem">Cancel</a>
			</form>
		}
	}
}

templ adminUserEditPage(pd ui.PageData, u *user.User, flash string, flashKind string) {
	@ui.SidebarPage(pd, adminSidebar("users")) {
		<h1 style="margin-bottom:1rem">Edit User: { u.Username }</h1>
		if flash != "" {
			@ui.Alert(flashKind, flash)
		}
		@ui.Card("Profile") {
			<form method="post" action={ templ.SafeURL("/admin/users/" + u.ID) }>
				<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
				@ui.FormField("Display Name", "display_name", "text", u.DisplayName, "")
				<div class="form-group">
					<label class="form-check">
						if u.IsAdmin {
							<input type="checkbox" name="is_admin" value="1" checked/>
						} else {
							<input type="checkbox" name="is_admin" value="1"/>
						}
						Admin
					</label>
				</div>
				<button class="btn btn-primary" type="submit">Save</button>
				<a class="btn btn-outline" href="/admin/users" style="margin-left:0.5rem">Back</a>
			</form>
		}
		@ui.Card("Reset Password") {
			<form method="post" action={ templ.SafeURL("/admin/users/" + u.ID + "/password") }>
				<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
				@ui.FormField("New Password", "new_password", "password", "", "")
				<button class="btn btn-primary" type="submit">Reset Password</button>
			</form>
		}
	}
}

// --- Groups ---

templ adminGroupsPage(pd ui.PageData, groups []group.Group, flash string, flashKind string) {
	@ui.SidebarPage(pd, adminSidebar("groups")) {
		<div class="flex justify-between items-center" style="margin-bottom:1rem">
			<h1>Groups</h1>
		</div>
		if flash != "" {
			@ui.Alert(flashKind, flash)
		}
		@ui.Card("Create Group") {
			<form method="post" action="/admin/groups" class="flex gap-1 items-center">
				<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
				<input class="form-control" type="text" name="name" placeholder="Group name" required style="max-width:200px"/>
				<button class="btn btn-primary" type="submit">Create</button>
			</form>
		}
		@ui.Card("") {
			@groupTable(groups, "/admin/groups/")
		}
	}
}

templ adminGroupEditPage(pd ui.PageData, g *group.Group, members []group.Member, users []user.User, flash string, flashKind string) {
	@ui.SidebarPage(pd, adminSidebar("groups")) {
		<h1 style="margin-bottom:1rem">Edit Group: { g.Name }</h1>
		if flash != "" {
			@ui.Alert(flashKind, flash)
		}
		@ui.Card("Group Settings") {
			<form method="post" action={ templ.SafeURL("/admin/groups/" + g.ID) }>
				<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
				@ui.FormField("Name", "name", "text", g.Name, "")
				<button class="btn btn-primary" type="submit">Save</button>
				<a class="btn btn-outline" href="/admin/groups" style="margin-left:0.5rem">Back</a>
			</form>
		}
		@ui.Card("Members") {
			<form method="post" action={ templ.SafeURL("/admin/groups/" + g.ID + "/members") } class="flex gap-1 items-center mb-2">
				<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
				<select class="form-control" name="member_id" style="max-width:300px">
					for _, u := range users {
						<option value={ u.ID }>{ u.Username }</option>
					}
				</select>
				<input type="hidden" name="member_type" value="USER"/>
				<button class="btn btn-primary" type="submit">Add</button>
			</form>
			<table class="table mb-0">
				<thead>
					<tr>
						<th>Member</th>
						<th>Type</th>
						<th class="text-right">Actions</th>
					</tr>
				</thead>
				<tbody>
					for _, m := range members {
						<tr id={ fmt.Sprintf("member-%s-%s", g.ID, m.MemberID) }>
							<td>{ memberLabel(m, users) }</td>
							<td>{ m.MemberType }</td>
							<td class="text-right">
								<button
									class="btn btn-danger btn-sm"
									hx-delete={ fmt.Sprintf("/admin/groups/%s/members/%s", g.ID, m.MemberID) }
									hx-target={ fmt.Sprintf("#member-%s-%s", g.ID, m.MemberID) }
									hx-swap="outerHTML"
								>Remove</button>
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
		@ui.Card("Danger Zone") {
			<p class="text-muted" style="margin-bottom:0.5rem">Deleting a group removes all members and cannot be undone.</p>
			<form method="post" action={ templ.SafeURL("/admin/groups/" + g.ID + "/delete") } onsubmit="return confirm('Are you sure you want to delete this group?')">
				<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
				<button class="btn btn-danger" type="submit">Delete Group</button>
			</form>
		}
	}
}

func memberLabel(m group.Member, users []user.User) string {
	for _, u := range users {
		if u.ID == m.MemberID {
			return u.Username
		}
	}
	return m.MemberID
}

// --- Settings ---

templ adminSettingsPage(pd ui.PageData, publicRegistration bool, inviteExpiryHours string, flash string, flashKind string) {
	@ui.SidebarPage(pd, adminSidebar("settings")) {
		<h1 style="margin-bottom:1rem">System Settings</h1>
		if flash != "" {
			@ui.Alert(flashKind, flash)
		}
		@ui.Card("Registration") {
			<form method="post" action="/admin/settings">
				<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
				<div class="form-group">
					<label class="form-check">
						if publicRegistration {
							<input type="checkbox" name="public_registration" value="1" checked/>
						} else {
							<input type="checkbox" name="public_registration" value="1"/>
						}
						Allow public registration
					</label>
					<p class="text-muted" style="font-size:0.85rem;margin-top:0.25rem">When enabled, anyone can create an account from the login page.</p>
				</div>
				<div class="form-group">
					<label class="form-label" for="invite_expiry_hours">Invite link expiry (hours)</label>
					<input class="form-control" type="number" id="invite_expiry_hours" name="invite_expiry_hours" value={ inviteExpiryHours } min="1" style="max-width:200px"/>
					<p class="text-muted" style="font-size:0.85rem;margin-top:0.25rem">How long group invitation links remain valid. Default: 72 hours.</p>
				</div>
				<button class="btn btn-primary" type="submit">Save Settings</button>
			</form>
		}
	}
}

// --- Plugins ---

templ adminPluginsPage(pd ui.PageData, plugins []PluginInfo) {
	@ui.SidebarPage(pd, adminSidebar("plugins")) {
		<div class="flex justify-between items-center" style="margin-bottom:1rem">
			<h1>Plugins</h1>
		</div>
		@ui.Card("") {
			<table class="table">
				<thead>
					<tr>
						<th>Plugin</th>
						<th>Status</th>
						<th class="text-right">Actions</th>
					</tr>
				</thead>
				<tbody>
					for _, p := range plugins {
						<tr>
							<td>{ p.ID }</td>
							<td>
								if p.Enabled {
									<span class="badge badge-admin">Enabled</span>
								} else {
									<span class="badge">Disabled</span>
								}
								if p.Protected {
									<span class="badge" style="margin-left:0.25rem">Protected</span>
								}
							</td>
							<td class="text-right">
								if !p.Protected {
									<form method="post" action={ templ.SafeURL("/admin/plugins/" + p.ID + "/toggle") } style="display:inline">
										<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
										if p.Enabled {
											<button class="btn btn-outline btn-sm" type="submit">Disable</button>
										} else {
											<button class="btn btn-primary btn-sm" type="submit">Enable</button>
										}
									</form>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
	}
}
