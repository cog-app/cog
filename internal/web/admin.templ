package web

import (
	"fmt"
	"git.duckfam.us/jj-software/cog/internal/group"
	"git.duckfam.us/jj-software/cog/internal/logbuf"
	"git.duckfam.us/jj-software/cog/internal/user"
	"git.duckfam.us/jj-software/cog/ui"
	"iter"
	"log/slog"
	"strings"
	"time"
)

// --- Users ---
templ adminUsersPage(pd ui.PageData, users iter.Seq2[user.User, error], flash string, flashKind string) {
	@ui.AdminSidebarPage(pd, "users") {
		<div class="flex justify-between items-center" style="margin-bottom:1rem">
			<h1>Users</h1>
			<a class="btn btn-primary" href="/admin/users/new">New User</a>
		</div>
		if flash != "" {
			@ui.Alert(flashKind, flash)
		}
		@ui.Card("") {
			<table class="table">
				<thead>
					<tr>
						<th>Username</th>
						<th>Display Name</th>
						<th>Role</th>
					</tr>
				</thead>
				<tbody>
					for u, err := range users {
						if err == nil {
							<tr style="cursor:pointer" onclick={ goTo("/admin/users/" + u.ID) }>
								<td>{ u.Username }</td>
								<td>{ u.DisplayName }</td>
								<td>
									if u.IsAdmin {
										<span class="badge badge-admin">Admin</span>
									}
								</td>
							</tr>
						}
					}
				</tbody>
			</table>
		}
	}
}

templ adminUserNewPage(pd ui.PageData, errMsg string) {
	@ui.AdminSidebarPage(pd, "users") {
		<h1 style="margin-bottom:1rem">New User</h1>
		if errMsg != "" {
			@ui.Alert("error", errMsg)
		}
		@ui.Card("") {
			<form method="post" action="/admin/users">
				<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
				@ui.FormField("Username", "username", "text", "", "")
				@ui.FormField("Password", "password", "password", "", "")
				<div class="form-group">
					<label class="form-check">
						<input type="checkbox" name="is_admin" value="1"/>
						Admin
					</label>
				</div>
				<button class="btn btn-primary" type="submit">Create User</button>
				<a class="btn btn-outline" href="/admin/users" style="margin-left:0.5rem">Cancel</a>
			</form>
		}
	}
}

templ adminUserEditPage(pd ui.PageData, u *user.User, flash string, flashKind string) {
	@ui.AdminSidebarPage(pd, "users") {
		<h1 style="margin-bottom:1rem">Edit User: { u.Username }</h1>
		if flash != "" {
			@ui.Alert(flashKind, flash)
		}
		@ui.Card("Profile") {
			<form method="post" action={ templ.SafeURL("/admin/users/" + u.ID) }>
				<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
				@ui.FormField("Display Name", "display_name", "text", u.DisplayName, "")
				<div class="form-group">
					<label class="form-check">
						if u.IsAdmin {
							<input type="checkbox" name="is_admin" value="1" checked/>
						} else {
							<input type="checkbox" name="is_admin" value="1"/>
						}
						Admin
					</label>
				</div>
				<button class="btn btn-primary" type="submit">Save</button>
				<a class="btn btn-outline" href="/admin/users" style="margin-left:0.5rem">Back</a>
			</form>
		}
		@ui.Card("Reset Password") {
			<form method="post" action={ templ.SafeURL("/admin/users/" + u.ID + "/password") }>
				<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
				@ui.FormField("New Password", "new_password", "password", "", "")
				<button class="btn btn-primary" type="submit">Reset Password</button>
			</form>
		}
		@ui.Card("Danger Zone") {
			<p class="text-muted" style="margin-bottom:0.5rem">Deleting a user removes all their data and cannot be undone.</p>
			<button
				class="btn btn-danger"
				hx-delete={ "/admin/users/" + u.ID }
				hx-confirm="Delete this user? This cannot be undone."
				hx-on::after-request="window.location='/admin/users'"
			>Delete User</button>
		}
	}
}

// --- Groups ---
templ adminGroupsPage(pd ui.PageData, groups []group.Group, flash string, flashKind string) {
	@ui.AdminSidebarPage(pd, "groups") {
		<div class="flex justify-between items-center" style="margin-bottom:1rem">
			<h1>Groups</h1>
		</div>
		if flash != "" {
			@ui.Alert(flashKind, flash)
		}
		@ui.Card("Create Group") {
			<form method="post" action="/admin/groups" class="flex gap-1 items-center">
				<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
				<input class="form-control" type="text" name="name" placeholder="Group name" required style="max-width:200px"/>
				<button class="btn btn-primary" type="submit">Create</button>
			</form>
		}
		@ui.Card("") {
			@groupTable(groups, "/admin/groups/")
		}
	}
}

// --- Settings ---
templ adminSettingsPage(pd ui.PageData, publicRegistration bool, inviteExpiryHours string, smtp smtpSettingsData, env envConfigData, status statusData, flash string, flashKind string) {
	@ui.AdminSidebarPage(pd, "settings") {
		<h1 style="margin-bottom:1rem">System Settings</h1>
		if flash != "" {
			@ui.Alert(flashKind, flash)
		}
		@ui.Card("Status") {
			<table class="table">
				<tbody>
					<tr><td style="font-weight:600;width:10rem">Instance Uptime</td><td>{ status.InstanceUptime }</td></tr>
					<tr><td style="font-weight:600">Server Uptime</td><td>{ status.ServerUptime }</td></tr>
					if status.CommitHash != "" {
						<tr><td style="font-weight:600">Build</td><td><code>{ status.CommitHash }</code> ({ status.CommitDate.Format(time.RFC3339) })</td></tr>
					}
				</tbody>
			</table>
		}
		@ui.Card("Environment") {
			<p class="text-muted" style="font-size:0.85rem;margin-bottom:0.75rem">Server configuration from environment variables (read-only).</p>
			<table class="table">
				<tbody>
					<tr><td style="font-weight:600;width:10rem">Listen Address</td><td><code>{ env.Addr }</code></td></tr>
					<tr><td style="font-weight:600">Database Path</td><td><code>{ env.DBPath }</code></td></tr>
					<tr><td style="font-weight:600">Base URL</td><td><code>{ env.BaseURL }</code></td></tr>
					<tr><td style="font-weight:600">Data Directory</td><td><code>{ env.DataDir }</code></td></tr>
				</tbody>
			</table>
		}
		<form method="post" action="/admin/settings">
			<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
			@ui.Card("Registration") {
				<div class="form-group">
					<label class="form-check">
						if publicRegistration {
							<input type="checkbox" name="public_registration" value="1" checked/>
						} else {
							<input type="checkbox" name="public_registration" value="1"/>
						}
						Allow public registration
					</label>
					<p class="text-muted" style="font-size:0.85rem;margin-top:0.25rem">When enabled, anyone can create an account from the login page.</p>
				</div>
				<div class="form-group">
					<label class="form-label" for="invite_expiry_hours">Invite link expiry (hours)</label>
					<input class="form-control" type="number" id="invite_expiry_hours" name="invite_expiry_hours" value={ inviteExpiryHours } min="1" style="max-width:200px"/>
					<p class="text-muted" style="font-size:0.85rem;margin-top:0.25rem">How long group invitation links remain valid. Default: 72 hours.</p>
				</div>
			}
			@ui.Card("Email (SMTP)") {
				<p class="text-muted" style="font-size:0.85rem;margin-bottom:0.75rem">Configure SMTP for sending invitation and notification emails.</p>
				@ui.FormField("SMTP Host", "smtp_host", "text", smtp.Host, "smtp.example.com")
				<div class="form-group">
					<label for="smtp_port">SMTP Port</label>
					<input class="form-control" type="number" id="smtp_port" name="smtp_port" value={ smtp.Port } min="1" max="65535" style="max-width:200px"/>
				</div>
				@ui.FormField("SMTP Username", "smtp_user", "text", smtp.User, "")
				@ui.FormField("SMTP Password", "smtp_pass", "password", smtp.Pass, "")
				@ui.FormField("From Address", "smtp_from", "email", smtp.From, "noreply@example.com")
				<button
					class="btn btn-outline btn-sm"
					type="button"
					hx-post="/admin/settings/test-smtp"
					hx-target="#smtp-test-result"
					hx-swap="innerHTML"
					hx-headers={ "{\"X-CSRF-Token\":\"" + pd.CSRFToken + "\"}" }
					style="margin-top:0.75rem"
				>Test Connection</button>
				<div id="smtp-test-result"></div>
			}
			<button class="btn btn-primary" type="submit">Save Settings</button>
		</form>
	}
}

templ smtpTestAlert(kind, title, detail string) {
	<div class={ "alert alert-" + kind } style="position:relative">
		<button type="button" class="alert-dismiss" onclick="this.parentElement.remove()" aria-label="Close">&times;</button>
		<strong>{ title }</strong>
		<p style="margin:0.25rem 0 0;font-size:0.85rem">{ detail }</p>
	</div>
}

// --- Logs ---

func logLevelBadgeClass(level slog.Level) string {
	switch {
	case level >= slog.LevelError:
		return "badge badge-danger"
	case level >= slog.LevelWarn:
		return "badge badge-warn"
	case level >= slog.LevelInfo:
		return "badge badge-admin"
	default:
		return "badge"
	}
}

func logLevelLabel(level slog.Level) string {
	return strings.ToUpper(level.String())
}

templ adminLogsPage(pd ui.PageData, entries []logbuf.Entry) {
	@ui.AdminSidebarPage(pd, "logs") {
		<div class="flex justify-between items-center" style="margin-bottom:1rem">
			<h1>Server Logs</h1>
			<span class="text-muted" style="font-size:0.85rem">{ fmt.Sprintf("%d entries", len(entries)) }</span>
		</div>
		@ui.Card("") {
			<div style="max-height:600px;overflow-y:auto">
				<table class="table" style="font-size:0.85rem">
					<thead>
						<tr>
							<th style="width:8rem">Time</th>
							<th style="width:5rem">Level</th>
							<th>Message</th>
						</tr>
					</thead>
					<tbody hx-get="/admin/logs/entries" hx-trigger="every 3s" hx-swap="innerHTML">
						@logEntriesPartial(entries)
					</tbody>
				</table>
			</div>
		}
	}
}

templ logEntriesPartial(entries []logbuf.Entry) {
	for i := len(entries) - 1; i >= 0; i-- {
		<tr>
			<td><code>{ entries[i].Time.Format("15:04:05.000") }</code></td>
			<td><span class={ logLevelBadgeClass(entries[i].Level) }>{ logLevelLabel(entries[i].Level) }</span></td>
			<td><code style="white-space:pre-wrap">{ entries[i].Message }</code></td>
		</tr>
	}
}

// --- Plugins ---
templ adminPluginsPage(pd ui.PageData, plugins []PluginInfo) {
	@ui.AdminSidebarPage(pd, "plugins") {
		<div class="flex justify-between items-center" style="margin-bottom:1rem">
			<h1>Plugins</h1>
		</div>
		@ui.Card("") {
			<table class="table">
				<thead>
					<tr>
						<th>Plugin</th>
						<th>Status</th>
						<th class="text-right">Actions</th>
					</tr>
				</thead>
				<tbody>
					for _, p := range plugins {
						<tr>
							<td>{ p.ID }</td>
							<td>
								if p.Enabled {
									<span class="badge badge-admin">Enabled</span>
								} else {
									<span class="badge">Disabled</span>
								}
								if p.Protected {
									<span class="badge" style="margin-left:0.25rem">Protected</span>
								}
							</td>
							<td class="text-right">
								if !p.Protected {
									<form method="post" action={ templ.SafeURL("/admin/plugins/" + p.ID + "/toggle") } style="display:inline">
										<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
										if p.Enabled {
											<button class="btn btn-outline btn-sm" type="submit">Disable</button>
										} else {
											<button class="btn btn-primary btn-sm" type="submit">Enable</button>
										}
									</form>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
	}
}
