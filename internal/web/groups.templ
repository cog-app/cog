package web

import (
	"git.duckfam.us/jj-software/cog/ui"
	"git.duckfam.us/jj-software/cog/internal/group"
	"git.duckfam.us/jj-software/cog/internal/mount"
	"git.duckfam.us/jj-software/cog/internal/user"
	"git.duckfam.us/jj-software/cog/internal/volume"
	"fmt"
)

templ settingsGroupsPage(pd ui.PageData, ownedGroups []group.Group, memberGroups []group.Group, flash string, flashKind string) {
	@ui.SidebarPage(pd, settingsSidebar("groups")) {
		<h1 style="margin-bottom:1rem">Groups</h1>
		if flash != "" {
			@ui.Alert(flashKind, flash)
		}
		@ui.Card("Create Group") {
			<form method="post" action="/settings/groups" class="flex gap-1 items-center">
				<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
				<input class="form-control" type="text" name="name" placeholder="Group name" required style="max-width:300px"/>
				<button class="btn btn-primary" type="submit">Create</button>
			</form>
		}
		@ui.Card("My Groups") {
			if len(ownedGroups) > 0 {
				@groupTable(ownedGroups, "/settings/groups/")
			} else {
				<p class="text-muted">You don't own any groups yet.</p>
			}
		}
		@ui.Card("Member Of") {
			if len(memberGroups) > 0 {
				@groupTable(memberGroups, "/settings/groups/")
			} else {
				<p class="text-muted">You're not a member of any other groups.</p>
			}
		}
	}
}

templ settingsGroupDetailPage(pd ui.PageData, g *group.Group, members []group.Member, users []user.User, invitations []group.Invitation, groupMounts []mount.GroupMount, groupVolumes []volume.Volume, accessibleVolumes []volume.Volume, isOwner bool, smtpAvailable bool, baseURL string, flash string, flashKind string, lastInviteURL string) {
	@ui.SidebarPage(pd, settingsSidebar("groups")) {
		<h1 style="margin-bottom:1rem">Group: { g.Name }</h1>
		if flash != "" {
			if lastInviteURL != "" {
				@ui.AlertWithCopy(flashKind, flash, lastInviteURL)
			} else {
				@ui.Alert(flashKind, flash)
			}
		}
		if isOwner {
			@ui.Card("Group Name") {
				<form method="post" action={ templ.SafeURL("/settings/groups/" + g.ID) }>
					<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
					@ui.FormField("Name", "name", "text", g.Name, "")
					<button class="btn btn-primary" type="submit">Save</button>
					<a class="btn btn-outline" href="/settings/groups" style="margin-left:0.5rem">Back</a>
				</form>
			}
		} else {
			<p><a href="/settings/groups">&larr; Back to Groups</a></p>
		}
		@ui.Card("Members") {
			if isOwner {
				<form method="post" action={ templ.SafeURL("/settings/groups/" + g.ID + "/members") } class="flex gap-1 items-center mb-2">
					<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
					<input class="form-control" type="text" name="username" placeholder="Username" required style="max-width:300px"/>
					<button class="btn btn-primary" type="submit">Add Member</button>
				</form>
			}
			<table class="table mb-0">
				<thead>
					<tr>
						<th>Member</th>
						<th>Type</th>
						<th class="text-right">Actions</th>
					</tr>
				</thead>
				<tbody>
					for _, m := range members {
						<tr id={ fmt.Sprintf("member-%s-%s", g.ID, m.MemberID) }>
							<td>{ memberLabel(m, users) }</td>
							<td>
								if isOwner {
									<form method="post" action={ templ.SafeURL(fmt.Sprintf("/settings/groups/%s/members/%s/type", g.ID, m.MemberID)) } style="display:inline">
										<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
										<select class="form-control" name="member_type" style="display:inline-block;width:auto;padding:0.2rem 0.4rem;font-size:0.85rem" onchange="this.form.submit()">
											if m.MemberType == "OWNER" {
												<option value="OWNER" selected>Owner</option>
												<option value="USER">User</option>
											} else {
												<option value="OWNER">Owner</option>
												<option value="USER" selected>User</option>
											}
										</select>
									</form>
								} else {
									{ m.MemberType }
								}
							</td>
							<td class="text-right">
								if isOwner && m.MemberID != pd.User.ID {
									<button
										class="btn btn-danger btn-sm"
										hx-delete={ fmt.Sprintf("/settings/groups/%s/members/%s", g.ID, m.MemberID) }
										hx-target={ fmt.Sprintf("#member-%s-%s", g.ID, m.MemberID) }
										hx-swap="outerHTML"
									>Remove</button>
								}
								if !isOwner && m.MemberType == "USER" && m.MemberID == pd.User.ID {
									<button
										class="btn btn-danger btn-sm"
										hx-delete={ fmt.Sprintf("/settings/groups/%s/members/%s", g.ID, m.MemberID) }
										hx-confirm="Leave this group?"
										hx-target={ fmt.Sprintf("#member-%s-%s", g.ID, m.MemberID) }
										hx-swap="outerHTML"
									>Leave</button>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
		if isOwner {
			@ui.Card("Invitations") {
				<form method="post" action={ templ.SafeURL("/settings/groups/" + g.ID + "/invites") } class="flex gap-1 items-center mb-2">
					<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
					<input class="form-control" type="email" name="email" placeholder={ emailPlaceholder(smtpAvailable) } style="max-width:300px"/>
					<select class="form-control" name="member_type" style="max-width:120px">
						<option value="USER" selected>User</option>
						<option value="OWNER">Owner</option>
					</select>
					<button class="btn btn-primary" type="submit">Create Invite</button>
				</form>
				if smtpAvailable {
					<p class="text-muted" style="font-size:0.85rem">An email will be sent if an address is provided.</p>
				}
				if len(invitations) > 0 {
					<table class="table mb-0">
						<thead>
							<tr>
								<th>Email</th>
								<th>Role</th>
								<th>Link</th>
								<th class="text-right">Actions</th>
							</tr>
						</thead>
						<tbody>
							for _, inv := range invitations {
								<tr id={ "invite-" + inv.ID }>
									<td>
										if inv.Email != "" {
											{ inv.Email }
										} else {
											<span class="text-muted">(link only)</span>
										}
									</td>
									<td>{ inv.MemberType }</td>
									<td>
										<code style="font-size:0.8rem">{ inv.Token[:16] }...</code>
										<button
											class="btn btn-outline btn-sm"
											style="margin-left:0.25rem;padding:0.15rem 0.4rem;font-size:0.75rem"
											onclick={ copyToClipboard(baseURL + "/invite/" + inv.Token) }
										>Copy</button>
									</td>
									<td class="text-right">
										<button
											class="btn btn-danger btn-sm"
											hx-delete={ fmt.Sprintf("/settings/groups/%s/invites/%s", g.ID, inv.ID) }
											hx-target={ "#invite-" + inv.ID }
											hx-swap="outerHTML"
										>Revoke</button>
									</td>
								</tr>
							}
						</tbody>
					</table>
				}
			}
			@ui.Card("Group Storage") {
				<h4>Group Volumes</h4>
				if len(groupVolumes) > 0 {
					<table class="table">
						<thead>
							<tr>
								<th>Name</th>
								<th>URI</th>
								<th class="text-right">Actions</th>
							</tr>
						</thead>
						<tbody>
							for _, v := range groupVolumes {
								<tr>
									<td>{ v.Name }</td>
									<td><code>{ v.URI }</code></td>
									<td class="text-right">
										<a class="btn btn-outline btn-sm" href={ templ.SafeURL("/volumes/" + v.ID + "/browse") }>Browse</a>
									</td>
								</tr>
							}
						</tbody>
					</table>
				} else {
					<p class="text-muted">No group volumes.</p>
				}
				<form method="post" action={ templ.SafeURL("/settings/groups/" + g.ID + "/volumes") } class="flex gap-1 items-center mb-2">
					<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
					<input class="form-control" type="text" name="name" placeholder="Volume name" required style="max-width:200px"/>
					<button class="btn btn-primary" type="submit">Create Volume</button>
				</form>
				<h4 style="margin-top:1rem">Group Mounts</h4>
				if len(groupMounts) > 0 {
					<table class="table">
						<thead>
							<tr>
								<th>Path</th>
								<th>Volume</th>
								<th>Subpath</th>
								<th class="text-right">Actions</th>
							</tr>
						</thead>
						<tbody>
							for _, m := range groupMounts {
								<tr id={ "gmount-" + m.ID }>
									<td>{ m.UserPath }</td>
									<td>{ groupMountVolumeName(m.VolumeID, accessibleVolumes) }</td>
									<td>{ m.VolumeSubpath }</td>
									<td class="text-right">
										<button
											class="btn btn-danger btn-sm"
											hx-delete={ fmt.Sprintf("/settings/groups/%s/mounts/%s", g.ID, m.ID) }
											hx-target={ "#gmount-" + m.ID }
											hx-swap="outerHTML"
										>Remove</button>
									</td>
								</tr>
							}
						</tbody>
					</table>
				} else {
					<p class="text-muted">No group mounts.</p>
				}
				<form method="post" action={ templ.SafeURL("/settings/groups/" + g.ID + "/mounts") } class="flex gap-1 items-end" style="flex-wrap:wrap">
					<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
					<div>
						<label class="form-label">Path</label>
						<input class="form-control" type="text" name="user_path" placeholder="/shared" required style="max-width:200px"/>
					</div>
					<div>
						<label class="form-label">Volume</label>
						<select class="form-control" name="volume_id" required style="max-width:200px">
							for _, v := range accessibleVolumes {
								<option value={ v.ID }>{ v.Name }</option>
							}
						</select>
					</div>
					<div>
						<label class="form-label">Subpath</label>
						<input class="form-control" type="text" name="volume_subpath" placeholder="optional" style="max-width:200px"/>
					</div>
					<button class="btn btn-primary" type="submit">Add Mount</button>
				</form>
			}
		}
	}
}

templ inviteAcceptPage(pd ui.PageData, g *group.Group, inv *group.Invitation, isLoggedIn bool, errMsg string) {
	if isLoggedIn {
		@ui.Base(pd) {
			<div style="max-width:500px;margin:2rem auto;text-align:center">
				@ui.Card("Group Invitation") {
					<p style="margin-bottom:1rem">You've been invited to join the group <strong>{ g.Name }</strong>.</p>
					<form method="post" action={ templ.SafeURL("/invite/" + inv.Token) } style="display:inline">
						<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
						<button class="btn btn-primary" type="submit">Accept</button>
					</form>
					<a class="btn btn-outline" href="/" style="margin-left:0.5rem">Decline</a>
				}
			</div>
		}
	} else {
		<!DOCTYPE html>
		<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Group Invitation — Cog</title>
			<link rel="stylesheet" href="/static/style.css"/>
		</head>
		<body>
			<div class="login-container">
				<div class="card login-card">
					<div class="login-title">Cog</div>
					<p style="text-align:center;margin-bottom:1rem">You've been invited to join the group <strong>{ g.Name }</strong>.</p>
					if errMsg != "" {
						<div class="alert alert-error">{ errMsg }</div>
					}
					<form method="post" action={ templ.SafeURL("/invite/" + inv.Token) }>
						<input type="hidden" name="action" value="register"/>
						<div class="form-group">
							<label for="username">Username</label>
							<input class="form-control" type="text" id="username" name="username" required autofocus/>
						</div>
						<div class="form-group">
							<label for="password">Password</label>
							<input class="form-control" type="password" id="password" name="password" required/>
						</div>
						<div class="form-group">
							<label for="confirm">Confirm Password</label>
							<input class="form-control" type="password" id="confirm" name="confirm" required/>
						</div>
						<button class="btn btn-primary" type="submit" style="width:100%;margin-top:0.5rem">Register &amp; Join Group</button>
					</form>
					<p style="text-align:center;margin-top:1rem">
						Already have an account?
						<a href={ templ.SafeURL("/login?next=/invite/" + inv.Token) }>Log in</a>
					</p>
				</div>
			</div>
		</body>
		</html>
	}
}

// groupTable renders a clickable table of groups with member counts.
// urlPrefix is prepended to the group ID for the row link (e.g. "/settings/groups/" or "/admin/groups/").
templ groupTable(groups []group.Group, urlPrefix string) {
	<table class="table">
		<thead>
			<tr>
				<th>Name</th>
				<th>Members</th>
			</tr>
		</thead>
		<tbody>
			for _, g := range groups {
				<tr style="cursor:pointer" onclick={ goTo(urlPrefix + g.ID) }>
					<td>{ g.Name }</td>
					<td>{ fmt.Sprint(g.MemberCount) }</td>
				</tr>
			}
		</tbody>
	</table>
}

script goTo(url string) {
	window.location = url;
}

script copyToClipboard(text string) {
	var btn = document.activeElement;
	navigator.clipboard.writeText(text).then(function() {
		var orig = btn.textContent;
		btn.textContent = "Copied!";
		setTimeout(function() { btn.textContent = orig; }, 1500);
	});
}

func emailPlaceholder(smtpAvailable bool) string {
	if smtpAvailable {
		return "Email (optional, will send invite)"
	}
	return "Email (optional, SMTP not configured)"
}

func groupMountVolumeName(volumeID string, volumes []volume.Volume) string {
	for _, v := range volumes {
		if v.ID == volumeID {
			return v.Name
		}
	}
	return volumeID
}
