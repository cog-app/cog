package web

import (
	"fmt"
	"git.duckfam.us/jj-software/cog/internal/group"
	"git.duckfam.us/jj-software/cog/internal/user"
	"git.duckfam.us/jj-software/cog/ui"
)

// pendingInvite is an invitation to the current user, with the names to
// show for it.
type pendingInvite struct {
	Invitation group.Invitation
	GroupName  string
	Inviter    string
}

templ settingsGroupsPage(pd ui.PageData, ownedGroups []group.Group, memberGroups []group.Group, invites []pendingInvite, flash string, flashKind string) {
	@ui.SidebarPage(pd, settingsSidebar("groups")) {
		@ui.HelpPageHeader("Groups", "admin/users-and-groups.html#groups", nil)
		@ui.Alert(flashKind, flash)
		if len(invites) > 0 {
			@ui.HelpCard("Invitations", "admin/users-and-groups.html#invitations") {
				<p class="card-desc">Joining a group shares with you whatever is shared with it.</p>
				for _, inv := range invites {
					<div class="flex items-center gap-2 mb-2">
						<div class="flex-1 break-anywhere">{ inv.Inviter } invited you to <strong>{ inv.GroupName }</strong></div>
						<form method="post" action={ templ.SafeURL("/settings/groups/invitations/" + inv.Invitation.ID + "/accept") }>
							<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
							<button class="btn btn-primary btn-sm" type="submit">Join</button>
						</form>
						<form method="post" action={ templ.SafeURL("/settings/groups/invitations/" + inv.Invitation.ID + "/decline") }>
							<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
							<button class="btn btn-secondary btn-sm" type="submit">Decline</button>
						</form>
					</div>
				}
			}
		}
		@ui.Card("Create group") {
			<form method="post" action="/settings/groups" class="form-inline">
				<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
				<label class="sr-only" for="new-group-name">Group name</label>
				<input class="form-control" type="text" id="new-group-name" name="name" placeholder="Group name" required/>
				<button class="btn btn-primary" type="submit">Create</button>
			</form>
		}
		<div class="card card-flush">
			<h2 class="card-title">Your groups</h2>
			if len(ownedGroups) == 0 && len(memberGroups) == 0 {
				@ui.EmptyState("", "You're not in any groups yet. Create one above, or ask someone to invite you.")
			} else {
				<div class="table-wrap">
					<table class="table">
						<thead>
							<tr>
								<th>Name</th>
								<th class="col-shrink">Role</th>
								<th class="col-shrink text-right">Members</th>
							</tr>
						</thead>
						<tbody>
							for _, g := range ownedGroups {
								@groupRow(g, "/settings/groups/", "Owner")
							}
							for _, g := range memberGroups {
								@groupRow(g, "/settings/groups/", "Member")
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	}
}

templ groupRow(g group.Group, urlPrefix, role string) {
	<tr>
		<td><a class="row-link break-anywhere" href={ templ.SafeURL(urlPrefix + g.ID) }>{ g.Name }</a></td>
		if role != "" {
			<td>
				if role == "Owner" {
					<span class="badge badge-admin">Owner</span>
				} else {
					<span class="badge badge-neutral">Member</span>
				}
			</td>
		}
		<td class="text-right">
			if g.MemberCount == 0 {
				<span class="text-sm text-muted">None yet</span>
			} else {
				{ fmt.Sprint(g.MemberCount) }
			}
		</td>
	</tr>
}

// groupList is the admin's table of every group.
templ groupList(groups []group.Group, urlPrefix, empty string) {
	<div class="card card-flush">
		if len(groups) == 0 {
			@ui.EmptyState("", empty)
		} else {
			<div class="table-wrap">
				<table class="table">
					<thead>
						<tr>
							<th>Name</th>
							<th class="col-shrink text-right">Members</th>
						</tr>
					</thead>
					<tbody>
						for _, g := range groups {
							@groupRow(g, urlPrefix, "")
						}
					</tbody>
				</table>
			</div>
		}
	</div>
}

templ settingsGroupDetailPage(pd ui.PageData, gdd groupDetailData) {
	@ui.SidebarPage(pd, settingsSidebar("groups")) {
		@groupDetailContent(pd, gdd)
	}
}

templ adminGroupDetailPage(pd ui.PageData, gdd groupDetailData) {
	@ui.AdminSidebarPage(pd, "groups") {
		@groupDetailContent(pd, gdd)
	}
}

func memberRowID(d groupDetailData, m group.Member) string {
	return fmt.Sprintf("member-%s-%s", d.Group.ID, m.MemberID)
}

templ groupDetailContent(pd ui.PageData, d groupDetailData) {
	@ui.PageHeader(d.Group.Name, []ui.Crumb{{Label: "Groups", URL: d.BasePath}})
	if d.LastInviteURL != "" {
		@ui.AlertWithCopy(d.FlashKind, d.Flash, d.LastInviteURL)
	} else {
		@ui.Alert(d.FlashKind, d.Flash)
	}
	if d.IsOwner {
		@ui.Card("Group name") {
			<form method="post" action={ templ.SafeURL(d.BasePath + "/" + d.Group.ID) } class="form-inline">
				<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
				<label class="sr-only" for="name">Name</label>
				<input class="form-control" type="text" id="name" name="name" value={ d.Group.Name } required/>
				<button class="btn btn-primary" type="submit">Save</button>
			</form>
		}
	}
	@ui.Card("Members") {
		if d.IsOwner {
			<form method="post" action={ templ.SafeURL(d.BasePath + "/" + d.Group.ID + "/members") } class="form-inline mb-1">
				<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
				@ui.Picker("/api/picker/search?type=user", "member_id", "Search users to add…", false)
				<button class="btn btn-primary" type="submit">Add member</button>
			</form>
			<details class="mb-2">
				<summary class="text-sm">Add another group as a member</summary>
				<form method="post" action={ templ.SafeURL(d.BasePath + "/" + d.Group.ID + "/members") } class="form-inline mt-1">
					<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
					<input type="hidden" name="member_type" value="GROUP"/>
					@ui.Picker("/api/picker/search?type=group", "member_id", "Search groups…", false)
					<button class="btn btn-secondary" type="submit">Add group</button>
				</form>
			</details>
		}
		if d.MembersErr != nil {
			<div class="alert alert-error">Some members could not be loaded.</div>
		}
		<div class="table-wrap">
			<table class="table">
				<thead>
					<tr>
						<th>Member</th>
						<th class="col-shrink">Role</th>
						<th class="col-actions"><span class="sr-only">Actions</span></th>
					</tr>
				</thead>
				<tbody>
					for _, m := range d.Members {
						<tr id={ memberRowID(d, m) }>
							<td class="break-anywhere">
								{ m.Username }
								if m.MemberID == pd.User.ID {
									<span class="text-sm text-muted">(you)</span>
								}
							</td>
							<td>
								if m.MemberType == group.GroupMember {
									<span class="badge badge-neutral">Group</span>
								} else if d.IsOwner {
									<form method="post" action={ templ.SafeURL(fmt.Sprintf("%s/%s/members/%s/type", d.BasePath, d.Group.ID, m.MemberID)) }>
										<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
										<label class="sr-only" for={ memberRowID(d, m) + "-role" }>Role of { m.Username }</label>
										<select class="form-control form-control-sm form-control-auto" id={ memberRowID(d, m) + "-role" } name="member_type" onchange="this.form.submit()">
											<option value={ group.Owner } selected?={ m.MemberType == group.Owner }>Owner</option>
											<option value={ group.User } selected?={ m.MemberType != group.Owner }>Member</option>
										</select>
									</form>
								} else if m.MemberType == group.Owner {
									<span class="badge badge-admin">Owner</span>
								} else {
									<span class="badge badge-neutral">Member</span>
								}
							</td>
							<td class="col-actions">
								if m.MemberID == pd.User.ID && (!d.IsOwner || d.OwnerCount > 1) {
									<button
										type="button"
										class="btn btn-outline-danger btn-sm"
										hx-delete={ fmt.Sprintf("%s/%s/members/%s", d.BasePath, d.Group.ID, m.MemberID) }
										hx-confirm={ "Leave " + d.Group.Name + "?" }
										hx-target={ "#" + memberRowID(d, m) }
										hx-swap="outerHTML"
									>Leave</button>
								} else if d.IsOwner && m.MemberID != pd.User.ID {
									<button
										type="button"
										class="btn btn-outline-danger btn-sm"
										hx-delete={ fmt.Sprintf("%s/%s/members/%s", d.BasePath, d.Group.ID, m.MemberID) }
										hx-confirm={ "Remove " + m.Username + " from " + d.Group.Name + "?" }
										hx-target={ "#" + memberRowID(d, m) }
										hx-swap="outerHTML"
									>Remove</button>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
	if d.IsOwner {
		@ui.HelpCard("Invitations", "admin/users-and-groups.html#invitations") {
			<form method="post" action={ templ.SafeURL(d.BasePath + "/" + d.Group.ID + "/invites") }>
				<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
				<div class="form-row">
					<div class="form-group">
						<label for="invite-email">Email (optional)</label>
						<input class="form-control" type="email" id="invite-email" name="email" placeholder="name@example.com"/>
					</div>
					<div class="form-group form-group-auto">
						<label for="invite-role">Role</label>
						<select class="form-control" id="invite-role" name="member_type">
							<option value={ group.User } selected>Member</option>
							<option value={ group.Owner }>Owner</option>
						</select>
					</div>
					<button class="btn btn-primary" type="submit">Create invite</button>
				</div>
				<p class="form-help">
					if d.SMTPAvailable {
						With an address, the invitation is emailed. Without one, you get a link to send yourself.
					} else {
						Email is not set up on this server, so you get a link to send yourself.
					}
				</p>
			</form>
			if len(d.Invitations) > 0 {
				<h3 class="card-subtitle">Pending</h3>
				<div class="table-wrap">
					<table class="table table-stack">
						<thead>
							<tr>
								<th>Invited</th>
								<th class="col-shrink">Role</th>
								<th>Link</th>
								<th class="col-actions"><span class="sr-only">Actions</span></th>
							</tr>
						</thead>
						<tbody>
							for _, inv := range d.Invitations {
								<tr id={ "invite-" + inv.ID }>
									<td class="break-anywhere" data-label="Invited">
										if inv.Email != "" {
											{ inv.Email }
										} else {
											<span class="text-muted">Anyone with the link</span>
										}
									</td>
									<td data-label="Role">
										if inv.MemberType == group.Owner {
											<span class="badge badge-admin">Owner</span>
										} else {
											<span class="badge badge-neutral">Member</span>
										}
									</td>
									<td data-label="Link">
										@ui.ShareLink(d.SiteBaseURL+"/invite/"+inv.Token, inv.Token[:16]+"…")
									</td>
									<td class="col-actions">
										<button
											type="button"
											class="btn btn-outline-danger btn-sm"
											hx-delete={ fmt.Sprintf("%s/%s/invites/%s", d.BasePath, d.Group.ID, inv.ID) }
											hx-confirm="Revoke this invitation? Its link stops working."
											hx-target={ "#invite-" + inv.ID }
											hx-swap="outerHTML"
										>Revoke</button>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		}
	}
	if d.IsAdmin {
		<div class="card card-danger">
			<h2 class="card-title">Danger zone</h2>
			<p class="text-muted">Deleting a group removes all its members and cannot be undone.</p>
			<form method="post" action={ templ.SafeURL(d.BasePath + "/" + d.Group.ID + "/delete") } onsubmit={ confirmSubmit("Delete " + d.Group.Name + "? This cannot be undone.") }>
				<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
				<button class="btn btn-danger" type="submit">Delete group</button>
			</form>
		</div>
	}
}

script confirmSubmit(msg string) {
	if (!confirm(msg)) event.preventDefault();
}

func roleLabel(t group.MemberType) string {
	if t == group.Owner {
		return "an owner"
	}
	return "a member"
}

func inviterName(u *user.User) string {
	if u == nil {
		return "Someone"
	}
	if u.DisplayName != "" {
		return u.DisplayName
	}
	return u.Username
}

templ inviteAcceptPage(pd ui.PageData, g *group.Group, inv *group.Invitation, inviter *user.User, isLoggedIn bool, mayRegister bool, errMsg string) {
	if isLoggedIn {
		@ui.Base(pd) {
			<div class="card content--narrow invite-card">
				<h1 class="card-title">Group invitation</h1>
				<div class="flex items-center gap-2 mb-2">
					if inviter != nil {
						<img class="avatar-lg" src={ inviter.AvatarURL() } alt=""/>
					}
					<p>
						<strong>{ inviterName(inviter) }</strong> invited you to join <strong>{ g.Name }</strong> as { roleLabel(inv.MemberType) }.
						<span class="text-muted">{ fmt.Sprintf("%d %s", g.MemberCount, plural(g.MemberCount, "member", "members")) }.</span>
					</p>
				</div>
				@ui.Alert("error", errMsg)
				<div class="form-actions form-actions-end">
					<a class="btn btn-secondary" href="/">Decline</a>
					<form method="post" action={ templ.SafeURL("/invite/" + inv.Token) }>
						<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
						<button class="btn btn-primary" type="submit">Join { g.Name }</button>
					</form>
				</div>
			</div>
		}
	} else if !mayRegister {
		@ui.AuthPage("Group invitation") {
			<p class="login-lead">
				<strong>{ inviterName(inviter) }</strong> invited you to join <strong>{ g.Name }</strong> on Cog. Log in to accept.
			</p>
			@ui.Alert("error", errMsg)
			<a class="btn btn-primary btn-block" href={ templ.SafeURL("/login?next=/invite/" + inv.Token) }>Log in</a>
		}
	} else {
		@ui.AuthPage("Group invitation") {
			<p class="login-lead">
				<strong>{ inviterName(inviter) }</strong> invited you to join <strong>{ g.Name }</strong> on Cog. Create an account to accept.
			</p>
			@ui.Alert("error", errMsg)
			<form method="post" action={ templ.SafeURL("/invite/" + inv.Token) }>
				<input type="hidden" name="action" value="register"/>
				<input type="hidden" name="invite_token" value={ inv.Token }/>
				<div class="form-group">
					<label for="username">Username</label>
					<input class="form-control" type="text" id="username" name="username" required autofocus autocomplete="username" autocapitalize="none"/>
				</div>
				<div class="form-group">
					<label for="password">Password</label>
					<input class="form-control" type="password" id="password" name="password" required autocomplete="new-password"/>
				</div>
				<div class="form-group">
					<label for="confirm">Confirm password</label>
					<input class="form-control" type="password" id="confirm" name="confirm" required autocomplete="new-password"/>
				</div>
				<button class="btn btn-primary btn-block" type="submit">Create account and join</button>
			</form>
			<p class="login-footer">
				Already have an account?
				<a href={ templ.SafeURL("/login?next=/invite/" + inv.Token) }>Log in</a>
			</p>
		}
	}
}

func plural(n int, one, many string) string {
	if n == 1 {
		return one
	}
	return many
}
