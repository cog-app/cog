package web

import (
	"git.duckfam.us/jj-software/cog/internal/auth"
	"git.duckfam.us/jj-software/cog/internal/mount"
	"git.duckfam.us/jj-software/cog/internal/volume"
	"git.duckfam.us/jj-software/cog/ui"
	"iter"
	"strconv"
	"strings"
)

func settingsSidebar(active string) []ui.SidebarItem {
	return []ui.SidebarItem{
		{Label: "Profile", URL: "/settings/profile", Active: active == "profile"},
		{Label: "Security", URL: "/settings/security", Active: active == "security"},
		{Label: "Storage", URL: "/settings/storage", Active: active == "storage"},
		{Label: "Groups", URL: "/settings/groups", Active: active == "groups"},
	}
}

templ settingsProfilePage(pd ui.PageData, flash string, flashKind string) {
	@ui.SidebarPage(pd, settingsSidebar("profile")) {
		<h1 style="margin-bottom:1rem">Profile</h1>
		if flash != "" {
			@ui.Alert(flashKind, flash)
		}
		@ui.Card("Avatar") {
			<div class="flex gap-1 items-center" style="margin-bottom:1rem">
				<img class="avatar-lg" src={ pd.User.AvatarURL() }/>
				<div>
					@ui.Upload("/settings/avatar", "avatar", "image/jpeg,image/png", pd.CSRFToken, "Upload Avatar", "btn btn-primary btn-sm")
					if pd.User.Avatar != "" {
						<button
							class="btn btn-danger btn-sm"
							style="margin-left:0.5rem"
							hx-delete="/settings/avatar"
							hx-confirm="Remove your avatar?"
						>Remove</button>
					}
				</div>
			</div>
		}
		@ui.Card("Profile") {
			<form method="post" action="/settings/profile">
				<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
				@ui.FormField("Display Name", "display_name", "text", pd.User.DisplayName, "Your display name")
				@ui.FormField("Email", "email", "email", pd.User.Email, "your@email.com")
				<button class="btn btn-primary" type="submit">Save</button>
			</form>
		}
	}
}

templ settingsSecurityPage(pd ui.PageData, flash string, flashKind string, appPasswords []auth.AppPassword, mfaMethod string, backupCodeCount int, smtpConfigured bool, webauthnAvailable bool, webauthnCreds []auth.WebAuthnCredential) {
	@ui.SidebarPage(pd, settingsSidebar("security")) {
		<h1 style="margin-bottom:1rem">Security</h1>
		if flash != "" {
			if flashKind == "success" && len(flash) > 6 && flash[:6] == "token:" {
				@ui.Alert("success", "App password created. Copy this token now — it will not be shown again:")
				<pre style="background:var(--color-bg-alt);padding:1rem;border-radius:var(--radius);margin-bottom:1rem;word-break:break-all">{ flash[6:] }</pre>
			} else if flashKind == "success" && strings.HasPrefix(flash, "totp_enabled:") {
				@ui.Alert("success", "Two-factor authentication enabled. Save these backup codes — they will not be shown again:")
				<div style="background:var(--color-bg-alt);padding:1rem;border-radius:var(--radius);margin-bottom:1rem;font-family:monospace">
					for _, code := range strings.Split(flash[len("totp_enabled:"):], ",") {
						<div>{ code }</div>
					}
				</div>
			} else if flashKind != "totp_setup" {
				@ui.Alert(flashKind, flash)
			}
		}
		@settingsTOTPCard(pd, flash, flashKind, mfaMethod, backupCodeCount, smtpConfigured)
		if webauthnAvailable {
			@settingsWebAuthnCard(pd, mfaMethod, webauthnCreds)
		}
		@ui.Card("Change Password") {
			<form method="post" action="/settings/password">
				<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
				@ui.FormField("Current Password", "current_password", "password", "", "")
				@ui.FormField("New Password", "new_password", "password", "", "")
				@ui.FormField("Confirm New Password", "confirm_password", "password", "", "")
				<button class="btn btn-primary" type="submit">Change Password</button>
			</form>
		}
		@ui.Card("App Passwords") {
			<p class="text-muted" style="margin-bottom:0.75rem">App passwords let third-party clients access your account without your main password.</p>
			if len(appPasswords) > 0 {
				<table class="table" style="margin-bottom:1rem">
					<thead>
						<tr>
							<th>Name</th>
							<th>Created</th>
							<th class="text-right">Actions</th>
						</tr>
					</thead>
					<tbody>
						for _, ap := range appPasswords {
							<tr id={ "apppass-" + ap.ID }>
								<td>{ ap.Name }</td>
								<td>{ ap.CreatedAt.Format("2006-01-02") }</td>
								<td class="text-right">
									<button
										class="btn btn-danger btn-sm"
										hx-delete={ "/settings/app-passwords/" + ap.ID }
										hx-target={ "#apppass-" + ap.ID }
										hx-swap="outerHTML"
										hx-confirm="Revoke this app password?"
									>Revoke</button>
								</td>
							</tr>
						}
					</tbody>
				</table>
			} else {
				<p class="text-muted" style="margin-bottom:0.75rem">No app passwords.</p>
			}
			<h4>Create App Password</h4>
			<form method="post" action="/settings/app-passwords" class="flex gap-1 items-center">
				<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
				<input class="form-control" type="text" name="name" placeholder="Password name" required style="max-width:300px"/>
				<button class="btn btn-primary" type="submit">Create</button>
			</form>
		}
	}
}

templ settingsStoragePage(pd ui.PageData, flash string, flashKind string, mounts iter.Seq2[mount.Mount, error], volumes []volume.Volume, volumeNames map[string]string, ownedVolumes iter.Seq2[volume.Volume, error], hasOwnedVolumes bool, usage storageUsageInfo) {
	@ui.SidebarPage(pd, settingsSidebar("storage")) {
		<h1 style="margin-bottom:1rem">Storage</h1>
		if flash != "" {
			@ui.Alert(flashKind, flash)
		}
		@ui.Card("Usage") {
			<div style="margin-bottom:0.5rem">
				<strong>Used:</strong> { usage.UsedLabel }
				if usage.QuotaLabel != "" {
					<span>of { usage.QuotaLabel }</span>
				} else {
					<span class="text-muted">(unlimited)</span>
				}
			</div>
			if usage.Quota > 0 {
				<div style="background:var(--color-border);border-radius:4px;height:20px;overflow:hidden">
					<div style={ "background:var(--color-primary);height:100%;width:" + percentStr(usage.Percent) + "%" }></div>
				</div>
			}
		}
		@ui.Card("Mounts") {
			<table class="table">
				<thead>
					<tr>
						<th>Path</th>
						<th>Volume</th>
						<th>Subpath</th>
						<th>Read Only</th>
						<th class="text-right">Actions</th>
					</tr>
				</thead>
				<tbody>
					for m, err := range mounts {
						if err == nil {
							<tr id={ "mount-" + m.ID }>
								<td>{ m.UserPath }</td>
								<td>{ volumeNames[m.VolumeID] }</td>
								<td>{ m.VolumeSubpath }</td>
								<td>
									if m.ReadOnly {
										Yes
									} else {
										No
									}
								</td>
								<td class="text-right">
									if m.UserPath != "/" {
										<button
											class="btn btn-danger btn-sm"
											hx-delete={ "/settings/mounts/" + m.ID }
											hx-target={ "#mount-" + m.ID }
											hx-swap="outerHTML"
											hx-confirm="Remove this mount?"
										>Remove</button>
									}
								</td>
							</tr>
						}
					}
				</tbody>
			</table>
			<h4 style="margin-top:1rem">Add Mount</h4>
			<form method="post" action="/settings/mounts">
				<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
				<div class="flex gap-1 items-end" style="flex-wrap:wrap">
					<div>
						<label class="form-label">Path</label>
						<input class="form-control" type="text" name="user_path" placeholder="/mnt/extra" required style="max-width:200px"/>
					</div>
					<div>
						<label class="form-label">Volume</label>
						<select class="form-control" name="volume_id" required style="max-width:200px">
							for _, v := range volumes {
								<option value={ v.ID }>{ v.Name }</option>
							}
						</select>
					</div>
					<div>
						<label class="form-label">Subpath</label>
						<input class="form-control" type="text" name="volume_subpath" placeholder="optional" style="max-width:200px"/>
					</div>
					<button class="btn btn-primary" type="submit">Add</button>
				</div>
			</form>
		}
		@ui.Card("My Volumes") {
			if hasOwnedVolumes {
				<table class="table">
					<thead>
						<tr>
							<th>Name</th>
							<th>URI</th>
							<th class="text-right">Actions</th>
						</tr>
					</thead>
					<tbody>
						for v, err := range ownedVolumes {
							if err == nil {
								<tr id={ "uservol-" + v.ID }>
									<td>{ v.Name }</td>
									<td><code>{ v.URI }</code></td>
									<td class="text-right">
										<a class="btn btn-outline btn-sm" href={ templ.SafeURL("/volumes/" + v.ID + "/browse") }>Browse</a>
										<button
											class="btn btn-outline btn-sm"
											hx-get={ "/api/shares/panel?type=files:volume&id=" + v.ID + "&scope=vol-share-" + v.ID }
											hx-target={ "#vol-share-" + v.ID }
											hx-swap="innerHTML"
										>Share</button>
										<button
											class="btn btn-danger btn-sm"
											hx-delete={ "/settings/volumes/" + v.ID }
											hx-target={ "#uservol-" + v.ID }
											hx-swap="outerHTML"
											hx-confirm="Delete this volume?"
										>Delete</button>
									</td>
								</tr>
								<tr>
									<td colspan="3">
										<div id={ "vol-share-" + v.ID }></div>
									</td>
								</tr>
							}
						}
					</tbody>
				</table>
			} else {
				<p class="text-muted">No user-owned volumes.</p>
			}
			<h4 style="margin-top:1rem">Add WebDAV Volume</h4>
			@volumeForm(volumeFormData{
				Action:           "/settings/volumes",
				CSRFToken:        pd.CSRFToken,
				ConnType:         "webdav",
				SubmitLabel:      "Create Volume",
				ShowTypeSelector: false,
			})
		}
	}
}

templ settingsTOTPCard(pd ui.PageData, flash string, flashKind string, mfaMethod string, backupCodeCount int, smtpConfigured bool) {
	@ui.Card("Two-Factor Authentication") {
		if mfaMethod == "totp" {
			<p style="margin-bottom:0.75rem">
				<span style="color:var(--color-success);font-weight:600">Enabled</span> — TOTP authenticator app.
				<span class="text-muted">{ strconv.Itoa(backupCodeCount) } backup codes remaining.</span>
			</p>
			<div class="flex gap-1" style="flex-wrap:wrap">
				<form method="post" action="/settings/totp/disable" style="display:inline">
					<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
					<input class="form-control" type="password" name="password" placeholder="Current password" required style="max-width:200px;display:inline-block"/>
					<button class="btn btn-danger btn-sm" type="submit">Disable TOTP</button>
				</form>
				<form method="post" action="/settings/totp/backup-codes" style="display:inline">
					<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
					<input class="form-control" type="password" name="password" placeholder="Current password" required style="max-width:200px;display:inline-block"/>
					<button class="btn btn-outline btn-sm" type="submit">Regenerate Backup Codes</button>
				</form>
			</div>
		} else if mfaMethod == "email" {
			<p style="margin-bottom:0.75rem">
				<span style="color:var(--color-success);font-weight:600">Enabled</span> — Email verification code.
				<span class="text-muted">A code will be sent to your email at each login.</span>
			</p>
			<form method="post" action="/settings/email-otp/disable">
				<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
				<input class="form-control" type="password" name="password" placeholder="Current password" required style="max-width:200px;display:inline-block"/>
				<button class="btn btn-danger btn-sm" type="submit">Disable Email OTP</button>
			</form>
		} else if flashKind == "totp_setup" {
			<p style="margin-bottom:0.75rem">Scan this QR code with your authenticator app, then enter the 6-digit code to confirm.</p>
			if pipeIdx := strings.Index(flash, "|"); pipeIdx > 0 {
				<div style="text-align:center;margin-bottom:1rem">
					<img src={ flash[:pipeIdx] } alt="TOTP QR Code" style="max-width:200px"/>
				</div>
				<p class="text-muted" style="margin-bottom:0.75rem;font-size:0.875rem">
					Or enter this secret manually: <code>{ flash[pipeIdx+1:] }</code>
				</p>
			}
			<form method="post" action="/settings/totp/confirm">
				<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
				<div class="flex gap-1 items-center">
					<input class="form-control" type="text" name="code" placeholder="6-digit code" required autocomplete="one-time-code" inputmode="numeric" style="max-width:200px"/>
					<button class="btn btn-primary" type="submit">Verify &amp; Enable</button>
				</div>
			</form>
		} else {
			<p class="text-muted" style="margin-bottom:0.75rem">Add an extra layer of security to your account.</p>
			<div class="flex gap-1" style="flex-wrap:wrap">
				<form method="post" action="/settings/totp/setup">
					<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
					<button class="btn btn-primary" type="submit">Enable TOTP</button>
				</form>
				if smtpConfigured && pd.User.Email != "" {
					<form method="post" action="/settings/email-otp/enable">
						<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
						<button class="btn btn-outline" type="submit">Enable Email OTP</button>
					</form>
				}
			</div>
			if smtpConfigured && pd.User.Email == "" {
				<p class="text-muted" style="margin-top:0.5rem;font-size:0.875rem">Set an email address in your profile to enable email OTP.</p>
			}
		}
	}
}

templ settingsWebAuthnCard(pd ui.PageData, mfaMethod string, creds []auth.WebAuthnCredential) {
	@ui.Card("Passkeys") {
		if len(creds) > 0 {
			<table class="table" style="margin-bottom:1rem">
				<thead>
					<tr>
						<th>Name</th>
						<th>Created</th>
						<th class="text-right">Actions</th>
					</tr>
				</thead>
				<tbody>
					for _, c := range creds {
						<tr id={ "webauthn-" + c.ID }>
							<td>{ c.Name }</td>
							<td>{ c.CreatedAt.Format("2006-01-02") }</td>
							<td class="text-right">
								<button
									class="btn btn-danger btn-sm"
									hx-delete={ "/settings/webauthn/" + c.ID }
									hx-target={ "#webauthn-" + c.ID }
									hx-swap="outerHTML"
									hx-confirm="Remove this passkey?"
								>Remove</button>
							</td>
						</tr>
					}
				</tbody>
			</table>
		} else {
			<p class="text-muted" style="margin-bottom:0.75rem">No passkeys registered.</p>
		}
		<h4>Register Passkey</h4>
		<div class="flex gap-1 items-center">
			<input class="form-control" type="text" id="webauthn-name" placeholder="Passkey name" style="max-width:200px"/>
			<button class="btn btn-primary" type="button" id="webauthn-register-btn" onclick="registerPasskey()">Register</button>
		</div>
		<div id="webauthn-register-status" style="margin-top:0.5rem"></div>
		<script>
			async function registerPasskey() {
				var nameEl = document.getElementById("webauthn-name");
				var status = document.getElementById("webauthn-register-status");
				var btn = document.getElementById("webauthn-register-btn");
				var name = nameEl.value || "Passkey";
				btn.disabled = true;
				status.innerHTML =
					'<span class="text-muted">Waiting for passkey...</span>';
				try {
					var csrf = document.querySelector("body").getAttribute("hx-headers");
					var csrfToken = JSON.parse(csrf)["X-CSRF-Token"];
					var headers = {
						"Content-Type": "application/json",
						"X-CSRF-Token": csrfToken,
					};
					var beginResp = await fetch("/settings/webauthn/register/begin", {
						method: "POST",
						headers: headers,
					});
					if (!beginResp.ok) throw new Error(await beginResp.text());
					var options = await beginResp.json();
					options.publicKey.challenge = base64urlToBuffer(
						options.publicKey.challenge,
					);
					options.publicKey.user.id = base64urlToBuffer(
						options.publicKey.user.id,
					);
					if (options.publicKey.excludeCredentials) {
						options.publicKey.excludeCredentials =
							options.publicKey.excludeCredentials.map(function (c) {
								c.id = base64urlToBuffer(c.id);
								return c;
							});
					}
					var cred = await navigator.credentials.create(options);
					var body = JSON.stringify({
						name: name,
						credential: {
							id: cred.id,
							rawId: bufferToBase64url(cred.rawId),
							type: cred.type,
							response: {
								attestationObject: bufferToBase64url(
									cred.response.attestationObject,
								),
								clientDataJSON: bufferToBase64url(cred.response.clientDataJSON),
							},
						},
					});
					var finishResp = await fetch("/settings/webauthn/register/finish", {
						method: "POST",
						headers: headers,
						body: body,
					});
					if (!finishResp.ok) throw new Error(await finishResp.text());
					window.location.reload();
				} catch (e) {
					status.innerHTML =
						'<span style="color:var(--color-danger)">' +
						(e.message || "Registration failed") +
						"</span>";
					btn.disabled = false;
				}
			}
			function base64urlToBuffer(b) {
				var s = b.replace(/-/g, "+").replace(/_/g, "/");
				while (s.length % 4) s += "=";
				var raw = atob(s);
				var arr = new Uint8Array(raw.length);
				for (var i = 0; i < raw.length; i++) arr[i] = raw.charCodeAt(i);
				return arr.buffer;
			}
			function bufferToBase64url(buf) {
				var arr = new Uint8Array(buf);
				var s = "";
				for (var i = 0; i < arr.length; i++) s += String.fromCharCode(arr[i]);
				return btoa(s)
					.replace(/\+/g, "-")
					.replace(/\//g, "_")
					.replace(/=/g, "");
			}
		</script>
	}
}

func percentStr(p int) string {
	return strconv.Itoa(p)
}
