package web

import (
	"git.duckfam.us/jj-software/cog/internal/auth"
	"git.duckfam.us/jj-software/cog/internal/dav"
	"git.duckfam.us/jj-software/cog/internal/mount"
	"git.duckfam.us/jj-software/cog/internal/volume"
	"git.duckfam.us/jj-software/cog/ui"
	"strconv"
	"strings"
)

func settingsSidebar(active string) []ui.SidebarItem {
	return []ui.SidebarItem{
		{Label: "Profile", URL: "/settings/profile", Active: active == "profile"},
		{Label: "Security", URL: "/settings/security", Active: active == "security"},
		{Label: "Storage", URL: "/settings/storage", Active: active == "storage"},
		{Label: "Groups", URL: "/settings/groups", Active: active == "groups"},
		{Label: "Import and export", URL: "/settings/data", Active: active == "data"},
	}
}

templ settingsProfilePage(pd ui.PageData, flash string, flashKind string) {
	@ui.SidebarPage(pd, settingsSidebar("profile")) {
		@ui.PageHeader("Profile", nil)
		@ui.Alert(flashKind, flash)
		@ui.Card("Avatar") {
			<div class="flex items-center gap-2">
				<img class="avatar-lg" src={ pd.User.AvatarURL() } alt=""/>
				<div>
					<div class="btn-group">
						@ui.Upload("/settings/avatar", "avatar", "image/jpeg,image/png", pd.CSRFToken, "Change avatar", "btn btn-secondary")
						if pd.User.Avatar != "" {
							<button
								type="button"
								class="btn btn-ghost text-danger"
								hx-delete="/settings/avatar"
								hx-confirm="Remove your avatar?"
							>Remove</button>
						}
					</div>
					<p class="form-help">JPG or PNG. A square image works best.</p>
				</div>
			</div>
		}
		@ui.Card("Details") {
			<form method="post" action="/settings/profile">
				<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
				@ui.FormField("Display name", "display_name", "text", pd.User.DisplayName, "Your display name")
				@ui.FormField("Email", "email", "email", pd.User.Email, "your@email.com")
				<div class="form-actions">
					<button class="btn btn-primary" type="submit">Save</button>
				</div>
			</form>
		}
	}
}

// securityFlash is the message a redirect brought back to the security page.
// For is the form it belongs to ("password"), so it shows beside that form
// rather than at the top of the page; Invalid names the field to mark.
type securityFlash struct {
	Message string
	Kind    string
	For     string
	Invalid string
}

func (f securityFlash) top() bool {
	return f.Message != "" && f.For == ""
}

templ settingsSecurityPage(pd ui.PageData, flash securityFlash, appPasswords []auth.AppPassword, mfaMethod string, backupCodeCount int, smtpConfigured bool, webauthnAvailable bool, webauthnCreds []auth.WebAuthnCredential) {
	@ui.SidebarPage(pd, settingsSidebar("security")) {
		@ui.PageHeader("Security", nil)
		if flash.top() {
			if flash.Kind == "success" && strings.HasPrefix(flash.Message, "totp_enabled:") {
				<div class="alert alert-success" role="status">
					<div class="alert-title">Two-factor authentication is on. Save these backup codes now; they will not be shown again.</div>
					<pre class="code-block alert-body">{ strings.ReplaceAll(flash.Message[len("totp_enabled:"):], ",", "\n") }</pre>
				</div>
			} else if flash.Kind != "totp_setup" {
				@ui.Alert(flash.Kind, flash.Message)
			}
		}
		@settingsTOTPCard(pd, flash.Message, flash.Kind, mfaMethod, backupCodeCount, smtpConfigured)
		if webauthnAvailable {
			@settingsWebAuthnCard(pd, mfaMethod, webauthnCreds)
		}
		@ui.Card("Change password") {
			if flash.For == "password" {
				@ui.Alert(flash.Kind, flash.Message)
			}
			<form method="post" action="/settings/password" id="password">
				<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
				<div class="form-group">
					<label for="current_password">Current password</label>
					<input class="form-control w-md" type="password" id="current_password" name="current_password" required autocomplete="current-password" aria-invalid={ ariaInvalid(flash.Invalid == "current_password") }/>
				</div>
				<div class="form-group">
					<label for="new_password">New password</label>
					<input class="form-control w-md" type="password" id="new_password" name="new_password" required autocomplete="new-password" aria-invalid={ ariaInvalid(flash.Invalid == "new_password") }/>
				</div>
				<div class="form-group">
					<label for="confirm_password">Confirm new password</label>
					<input class="form-control w-md" type="password" id="confirm_password" name="confirm_password" required autocomplete="new-password" aria-invalid={ ariaInvalid(flash.Invalid == "confirm_password") }/>
				</div>
				<div class="form-actions">
					<button class="btn btn-primary" type="submit">Change password</button>
				</div>
			</form>
		}
		@ui.Card("App passwords") {
			<p class="card-desc">App passwords let other apps, like the Nextcloud desktop client, sign in without your main password.</p>
			<div id="app-passwords">
				@appPasswordList(appPasswords)
			</div>
			<h3 class="card-subtitle">Create an app password</h3>
			<div id="new-app-pw"></div>
			<form
				hx-post="/settings/app-passwords"
				hx-target="#new-app-pw"
				hx-swap="innerHTML"
				hx-on::after-request="if(event.detail.successful) this.reset()"
				class="form-inline"
			>
				<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
				<label class="sr-only" for="app-password-name">App password name</label>
				<input class="form-control" type="text" id="app-password-name" name="name" placeholder="Name, e.g. Laptop" required/>
				<button class="btn btn-primary" type="submit">Create</button>
			</form>
		}
	}
}

// appPasswordList is the table of app passwords, or a line saying there are
// none. It is also swapped in after a create, so the new one appears.
templ appPasswordList(appPasswords []auth.AppPassword) {
	if len(appPasswords) == 0 {
		<p class="empty-state empty-state-sm">No app passwords yet.</p>
	} else {
		<div class="table-wrap">
			<table class="table">
				<thead>
					<tr>
						<th>Name</th>
						<th class="col-shrink">Created</th>
						<th class="col-actions"><span class="sr-only">Actions</span></th>
					</tr>
				</thead>
				<tbody>
					for _, ap := range appPasswords {
						@appPasswordRow(ap)
					}
				</tbody>
			</table>
		</div>
	}
}

// storageMount is one row of the mounts table.
type storageMount struct {
	mount.Mount
	VolumeName string
}

templ settingsStoragePage(pd ui.PageData, flash string, flashKind string, mounts []storageMount, volumes []volume.Volume, ownedVolumes []volume.Volume, usage storageUsageInfo) {
	@ui.SidebarPage(pd, settingsSidebar("storage")) {
		@ui.PageHeader("Storage", nil)
		@ui.Alert(flashKind, flash)
		@ui.Card("Usage") {
			<p class="mb-1">
				<strong>{ usage.UsedLabel }</strong>
				if usage.QuotaLabel != "" {
					of { usage.QuotaLabel } used
				} else {
					used <span class="text-muted">(no limit)</span>
				}
			</p>
			if usage.Quota > 0 {
				<div class="progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow={ strconv.Itoa(usage.Percent) } aria-label="Storage used">
					<div class="progress-bar" style={ "width:" + strconv.Itoa(usage.Percent) + "%" }></div>
				</div>
			}
		}
		@ui.Card("Mounts") {
			<p class="card-desc">Folders from a volume that appear in your files at the path you choose.</p>
			if len(mounts) == 0 {
				<p class="empty-state empty-state-sm">No mounts yet.</p>
			} else {
				<div class="table-wrap">
					<table class="table">
						<thead>
							<tr>
								<th>Path</th>
								<th>Volume</th>
								<th class="hide-mobile">Subpath</th>
								<th class="col-shrink">Access</th>
								<th class="col-actions"><span class="sr-only">Actions</span></th>
							</tr>
						</thead>
						<tbody>
							for _, m := range mounts {
								<tr id={ "mount-" + m.ID }>
									<td class="break-anywhere"><code>{ m.UserPath }</code></td>
									<td class="break-anywhere">{ m.VolumeName }</td>
									<td class="hide-mobile break-anywhere">
										if m.VolumeSubpath != "" {
											<code>{ m.VolumeSubpath }</code>
										}
									</td>
									<td class="nowrap">
										if m.ReadOnly {
											<span class="badge badge-neutral">Read-only</span>
										} else {
											<span class="text-sm text-muted">Read &amp; write</span>
										}
									</td>
									<td class="col-actions">
										if m.UserPath != "/" {
											<button
												type="button"
												class="btn btn-outline-danger btn-sm"
												hx-delete={ "/settings/mounts/" + m.ID }
												hx-target={ "#mount-" + m.ID }
												hx-swap="outerHTML"
												hx-confirm={ "Remove the mount at " + m.UserPath + "? The files stay on the volume." }
											>Remove</button>
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
			<h3 class="card-subtitle">Add a mount</h3>
			<form method="post" action="/settings/mounts">
				<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
				<div class="form-row mb-0">
					<div class="form-group">
						<label class="form-label" for="mount-path">Path</label>
						<input class="form-control" type="text" id="mount-path" name="user_path" placeholder="/mnt/extra" required/>
					</div>
					<div class="form-group">
						<label class="form-label" for="mount-volume">Volume</label>
						<select class="form-control" id="mount-volume" name="volume_id" required>
							for _, v := range volumes {
								<option value={ v.ID }>{ v.Name }</option>
							}
						</select>
					</div>
					<div class="form-group">
						<label class="form-label" for="mount-subpath">Subpath</label>
						<input class="form-control" type="text" id="mount-subpath" name="volume_subpath" placeholder="optional"/>
					</div>
					<button class="btn btn-primary" type="submit">Add</button>
				</div>
			</form>
		}
		@ui.Card("My volumes") {
			if len(ownedVolumes) == 0 {
				<p class="empty-state empty-state-sm">You haven't added any volumes. Add a WebDAV server below to use its storage here.</p>
			} else {
				<div class="table-wrap">
					<table class="table">
						<thead>
							<tr>
								<th>Name</th>
								<th class="hide-mobile">URI</th>
								<th class="col-actions"><span class="sr-only">Actions</span></th>
							</tr>
						</thead>
						<tbody>
							for _, v := range ownedVolumes {
								<tr id={ "uservol-" + v.ID }>
									<td class="break-anywhere font-medium">{ v.Name }</td>
									<td class="hide-mobile"><code>{ v.URI }</code></td>
									<td class="col-actions">
										<div class="row-actions">
											<a class="btn btn-secondary btn-sm" href={ templ.SafeURL("/volumes/" + v.ID + "/browse") }>Browse</a>
											<button
												type="button"
												class="btn btn-secondary btn-sm"
												hx-get={ "/api/shares/panel?type=files:volume&id=" + v.ID + "&scope=vol-share" }
												hx-target="#vol-share"
												hx-swap="innerHTML"
											>Share</button>
											<button
												type="button"
												class="btn btn-outline-danger btn-sm"
												hx-delete={ "/settings/volumes/" + v.ID }
												hx-target={ "#uservol-" + v.ID }
												hx-swap="outerHTML"
												hx-confirm={ "Delete the volume " + v.Name + "?" }
											>Delete</button>
										</div>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
				<div id="vol-share"></div>
			}
			<h3 class="card-subtitle">Add a WebDAV volume</h3>
			@volumeForm(volumeFormData{
				Action:           "/settings/volumes",
				CSRFToken:        pd.CSRFToken,
				ConnType:         "webdav",
				SubmitLabel:      "Create volume",
				ShowTypeSelector: false,
			})
		}
	}
}

templ settingsTOTPCard(pd ui.PageData, flash string, flashKind string, mfaMethod string, backupCodeCount int, smtpConfigured bool) {
	@ui.Card("Two-factor authentication") {
		if mfaMethod == "totp" {
			<p class="mb-2">
				<span class="badge badge-success">On</span>
				Authenticator app.
				<span class="text-muted">{ strconv.Itoa(backupCodeCount) } backup codes left.</span>
			</p>
			<form method="post" class="form-inline">
				<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
				<label class="sr-only" for="totp-password">Current password</label>
				<input class="form-control" type="password" id="totp-password" name="password" placeholder="Current password" required autocomplete="current-password"/>
				<button class="btn btn-secondary" type="submit" formaction="/settings/totp/backup-codes">New backup codes</button>
				<button class="btn btn-outline-danger" type="submit" formaction="/settings/totp/disable">Turn off</button>
			</form>
			<p class="form-help">Enter your password to get new backup codes or to turn two-factor authentication off.</p>
		} else if mfaMethod == "email" {
			<p class="mb-2">
				<span class="badge badge-success">On</span>
				Email code.
				<span class="text-muted">A code is sent to your email each time you log in.</span>
			</p>
			<form method="post" action="/settings/email-otp/disable" class="form-inline">
				<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
				<label class="sr-only" for="email-otp-password">Current password</label>
				<input class="form-control" type="password" id="email-otp-password" name="password" placeholder="Current password" required autocomplete="current-password"/>
				<button class="btn btn-outline-danger" type="submit">Turn off</button>
			</form>
		} else if flashKind == "totp_setup" {
			<p class="mb-2">Scan this QR code with your authenticator app, then enter the 6-digit code it shows.</p>
			if pipeIdx := strings.Index(flash, "|"); pipeIdx > 0 {
				<div class="text-center mb-2">
					<img src={ flash[:pipeIdx] } alt="QR code for your authenticator app" width="200" height="200"/>
				</div>
				<p class="text-sm text-muted mb-2">
					Can't scan it? Enter this key instead: <code class="break-anywhere">{ flash[pipeIdx+1:] }</code>
				</p>
			}
			<form method="post" action="/settings/totp/confirm" class="form-inline">
				<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
				<label class="sr-only" for="totp-code">6-digit code</label>
				<input class="form-control" type="text" id="totp-code" name="code" placeholder="6-digit code" required autocomplete="one-time-code" inputmode="numeric"/>
				<button class="btn btn-primary" type="submit">Verify and turn on</button>
			</form>
		} else {
			<p class="card-desc">Ask for a second step, a code or a passkey, when you log in.</p>
			<div class="btn-group">
				<form method="post" action="/settings/totp/setup">
					<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
					<button class="btn btn-primary" type="submit">Use an authenticator app</button>
				</form>
				if smtpConfigured && pd.User.Email != "" {
					<form method="post" action="/settings/email-otp/enable">
						<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
						<button class="btn btn-secondary" type="submit">Use email codes</button>
					</form>
				}
			</div>
			if smtpConfigured && pd.User.Email == "" {
				<p class="form-help">To get codes by email, add an email address to <a href="/settings/profile">your profile</a>.</p>
			}
		}
	}
}

templ settingsWebAuthnCard(pd ui.PageData, mfaMethod string, creds []auth.WebAuthnCredential) {
	@ui.Card("Passkeys") {
		if len(creds) > 0 {
			<div class="table-wrap">
				<table class="table">
					<thead>
						<tr>
							<th>Name</th>
							<th class="col-shrink">Created</th>
							<th class="col-actions"><span class="sr-only">Actions</span></th>
						</tr>
					</thead>
					<tbody>
						for _, c := range creds {
							<tr id={ "webauthn-" + c.ID }>
								<td class="break-anywhere">{ c.Name }</td>
								<td class="nowrap">{ c.CreatedAt.Format("2006-01-02") }</td>
								<td class="col-actions">
									<button
										type="button"
										class="btn btn-outline-danger btn-sm"
										hx-delete={ "/settings/webauthn/" + c.ID }
										hx-target={ "#webauthn-" + c.ID }
										hx-swap="outerHTML"
										hx-confirm={ "Remove the passkey " + c.Name + "?" }
									>Remove</button>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		} else {
			<p class="empty-state empty-state-sm">No passkeys yet.</p>
		}
		<h3 class="card-subtitle">Add a passkey</h3>
		<div class="form-inline">
			<label class="sr-only" for="webauthn-name">Passkey name</label>
			<input class="form-control" type="text" id="webauthn-name" placeholder="Name, e.g. Phone"/>
			<button class="btn btn-primary" type="button" id="webauthn-register-btn" onclick="registerPasskey()">Add passkey</button>
		</div>
		<div id="webauthn-register-status" class="mt-1"></div>
		<script>
			async function registerPasskey() {
				var nameEl = document.getElementById("webauthn-name");
				var status = document.getElementById("webauthn-register-status");
				var btn = document.getElementById("webauthn-register-btn");
				var name = nameEl.value || "Passkey";
				btn.disabled = true;
				status.innerHTML =
					'<span class="text-muted">Waiting for passkey...</span>';
				try {
					var csrf = document.querySelector("body").getAttribute("hx-headers");
					var csrfToken = JSON.parse(csrf)["X-CSRF-Token"];
					var headers = {
						"Content-Type": "application/json",
						"X-CSRF-Token": csrfToken,
					};
					var beginResp = await fetch("/settings/webauthn/register/begin", {
						method: "POST",
						headers: headers,
					});
					if (!beginResp.ok) throw new Error(await beginResp.text());
					var options = await beginResp.json();
					options.publicKey.challenge = base64urlToBuffer(
						options.publicKey.challenge,
					);
					options.publicKey.user.id = base64urlToBuffer(
						options.publicKey.user.id,
					);
					if (options.publicKey.excludeCredentials) {
						options.publicKey.excludeCredentials =
							options.publicKey.excludeCredentials.map(function (c) {
								c.id = base64urlToBuffer(c.id);
								return c;
							});
					}
					var cred = await navigator.credentials.create(options);
					var body = JSON.stringify({
						name: name,
						credential: {
							id: cred.id,
							rawId: bufferToBase64url(cred.rawId),
							type: cred.type,
							response: {
								attestationObject: bufferToBase64url(
									cred.response.attestationObject,
								),
								clientDataJSON: bufferToBase64url(cred.response.clientDataJSON),
							},
						},
					});
					var finishResp = await fetch("/settings/webauthn/register/finish", {
						method: "POST",
						headers: headers,
						body: body,
					});
					if (!finishResp.ok) throw new Error(await finishResp.text());
					window.location.reload();
				} catch (e) {
					status.innerHTML =
						'<span class="text-danger">' +
						(e.message || "Registration failed") +
						"</span>";
					btn.disabled = false;
				}
			}
			function base64urlToBuffer(b) {
				var s = b.replace(/-/g, "+").replace(/_/g, "/");
				while (s.length % 4) s += "=";
				var raw = atob(s);
				var arr = new Uint8Array(raw.length);
				for (var i = 0; i < raw.length; i++) arr[i] = raw.charCodeAt(i);
				return arr.buffer;
			}
			function bufferToBase64url(buf) {
				var arr = new Uint8Array(buf);
				var s = "";
				for (var i = 0; i < arr.length; i++) s += String.fromCharCode(arr[i]);
				return btoa(s)
					.replace(/\+/g, "-")
					.replace(/\//g, "_")
					.replace(/=/g, "");
			}
		</script>
	}
}

// appPasswordRow renders one row in the app-passwords table.
templ appPasswordRow(ap auth.AppPassword) {
	<tr id={ "apppass-" + ap.ID }>
		<td class="break-anywhere">{ ap.Name }</td>
		<td class="nowrap">{ ap.CreatedAt.Format("2006-01-02") }</td>
		<td class="col-actions">
			<button
				type="button"
				class="btn btn-outline-danger btn-sm"
				hx-delete={ "/settings/app-passwords/" + ap.ID }
				hx-target={ "#apppass-" + ap.ID }
				hx-swap="outerHTML"
				hx-confirm={ "Revoke " + ap.Name + "? Apps using it will be signed out." }
			>Revoke</button>
		</td>
	</tr>
}

// appPasswordCreatedFragment is the HTMX response after a successful create.
// It returns the freshly minted token (rendered once into the page body, never
// stored in a cookie — audit security.md #21) with a Copy button, plus the
// app-password list swapped out of band so the new one shows in it.
templ appPasswordCreatedFragment(plaintext string, appPasswords []auth.AppPassword) {
	@ui.SecretAlert("App password created. Copy it now; it will not be shown again.", plaintext)
	<div id="app-passwords" hx-swap-oob="true">
		@appPasswordList(appPasswords)
	</div>
}

// appPasswordErrorFragment renders an inline error alert for the HTMX path.
templ appPasswordErrorFragment(msg string) {
	@ui.Alert("error", msg)
}

templ settingsDataPage(pd ui.PageData, flash string, flashKind string, collections []dataCollection, homes []dav.Home) {
	@ui.SidebarPage(pd, settingsSidebar("data")) {
		@ui.PageHeader("Import and export", nil)
		@ui.Alert(flashKind, flash)
		@ui.Card("Export") {
			<p class="card-desc">Download a calendar, task list or address book as an .ics or .vcf file, or everything as a zip.</p>
			<div class="table-wrap">
				<table class="table">
					<thead>
						<tr>
							<th>Name</th>
							<th class="hide-mobile">Holds</th>
							<th class="col-actions"><span class="sr-only">Download</span></th>
						</tr>
					</thead>
					<tbody>
						for _, c := range collections {
							<tr>
								<td class="break-anywhere">
									{ c.Name }
									<div class="show-mobile text-sm text-muted">{ c.Kind }</div>
								</td>
								<td class="hide-mobile">{ c.Kind }</td>
								<td class="col-actions">
									<a class="btn btn-secondary btn-sm" href={ templ.SafeURL("/settings/data/export/" + strconv.FormatInt(c.ID, 10)) } download>
										@ui.Icon("download")
										{ c.Filename }
									</a>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			<div class="form-actions">
				<a class="btn btn-primary" href="/settings/data/export.zip" download>
					@ui.Icon("download")
					Export everything
				</a>
			</div>
		}
		@ui.Card("Import") {
			<p class="card-desc">Upload an .ics or .vcf file. Entries whose UID is already in the collection are replaced, so importing the same file again changes nothing.</p>
			<form method="post" action="/settings/data/import" enctype="multipart/form-data">
				<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
				<div class="form-group">
					<label for="import-file">File</label>
					<input class="form-control" type="file" id="import-file" name="file" accept=".ics,.vcf,text/calendar,text/vcard" required/>
				</div>
				<div class="form-group">
					<label for="import-target">Into</label>
					<select class="form-control w-md" id="import-target" name="target" onchange="document.getElementById('import-name-group').hidden = !this.value.startsWith('new:')">
						for _, c := range collections {
							if !c.ReadOnly {
								<option value={ strconv.FormatInt(c.ID, 10) }>{ c.Name } ({ c.Kind })</option>
							}
						}
						for _, h := range homes {
							if h == dav.HomeCalendars {
								<option value="new:calendars">New calendar…</option>
							} else {
								<option value="new:addressbooks">New address book…</option>
							}
						}
					</select>
				</div>
				<div class="form-group" id="import-name-group" hidden?={ hasWritableCollection(collections) }>
					<label for="import-name">Name of the new one</label>
					<input class="form-control w-md" type="text" id="import-name" name="name" placeholder="Imported"/>
				</div>
				<div class="form-actions">
					<button class="btn btn-primary" type="submit">Import</button>
				</div>
			</form>
		}
	}
}

// hasWritableCollection reports whether the import menu starts on an existing
// collection, in which case the new-collection name field starts hidden.
func hasWritableCollection(cs []dataCollection) bool {
	for _, c := range cs {
		if !c.ReadOnly {
			return true
		}
	}
	return false
}

// ariaInvalid is the value of aria-invalid: assistive technology reads an
// empty value as "false", so the attribute always says which.
func ariaInvalid(invalid bool) string {
	if invalid {
		return "true"
	}
	return "false"
}
