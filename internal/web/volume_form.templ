package web

import (
	"git.duckfam.us/jj-software/cog/internal/volume"
	"git.duckfam.us/jj-software/cog/ui"
)

// volumeFormData holds the data needed to render a volume create/edit form.
type volumeFormData struct {
	Action           string // form POST target
	CSRFToken        string
	Name             string
	Description      string
	ConnType         string // "file", "webdav", "mem"
	FilePath         string // for file:// volumes
	WebDAV           volume.WebDAVConfig
	SubmitLabel      string
	ShowTypeSelector bool
	CancelURL        string
	// ShowKind offers the volume's kind: an admin's choice.
	ShowKind bool
	Kind     volume.Kind
}

script volumeFormToggle() {
	document.querySelectorAll("select[name=conn_type]").forEach(function(sel) {
		sel.addEventListener("change", function() {
			var form = sel.closest("form");
			form.querySelectorAll("[data-conn-type]").forEach(function(el) {
				el.style.display = "none";
			});
			var target = form.querySelector("[data-conn-type='" + sel.value + "']");
			if (target) target.style.display = "";
			// Also handle webdav auth sub-toggle
			var authSel = form.querySelector("select[name=auth_type]");
			if (authSel && sel.value === "webdav") {
				authSel.dispatchEvent(new Event("change"));
			}
		});
	});
	document.querySelectorAll("select[name=auth_type]").forEach(function(sel) {
		sel.addEventListener("change", function() {
			var form = sel.closest("form");
			form.querySelectorAll("[data-auth-type]").forEach(function(el) {
				el.style.display = "none";
			});
			var target = form.querySelector("[data-auth-type='" + sel.value + "']");
			if (target) target.style.display = "";
		});
		// Fire initial state
		sel.dispatchEvent(new Event("change"));
	});
}

// dirPickerScript wires up click and keyboard handling for the directory picker.
// When a directory is selected, it populates the input and re-triggers a search
// so the user can drill deeper.
templ dirPickerScript() {
	<script>
		(function () {
			var el = document.currentScript.closest(".picker");
			var input = el.querySelector(".picker-input");
			var results = el.querySelector(".picker-results");

			document.addEventListener("click", function (e) {
				if (!el.contains(e.target)) results.innerHTML = "";
			});

			results.addEventListener("click", function (e) {
				var opt = e.target.closest(".picker-option");
				if (!opt) return;
				var path = opt.dataset.id;
				// Append trailing slash so the next search lists children.
				if (!path.endsWith("/")) path += "/";
				input.value = path;
				input.focus();
				htmx.trigger(input, "input");
			});

			input.addEventListener("keydown", function (e) {
				var opts = results.querySelectorAll(".picker-option");
				if (!opts.length) return;
				var cur = results.querySelector(".picker-option.active");
				var idx = cur ? Array.prototype.indexOf.call(opts, cur) : -1;
				if (e.key === "ArrowDown") {
					e.preventDefault();
					if (cur) cur.classList.remove("active");
					idx = (idx + 1) % opts.length;
					opts[idx].classList.add("active");
				} else if (e.key === "ArrowUp") {
					e.preventDefault();
					if (cur) cur.classList.remove("active");
					idx = idx <= 0 ? opts.length - 1 : idx - 1;
					opts[idx].classList.add("active");
				} else if (e.key === "Enter" && cur) {
					e.preventDefault();
					cur.click();
				} else if (e.key === "Escape") {
					results.innerHTML = "";
				}
			});
		})();
	</script>
}

templ volumeForm(fd volumeFormData) {
	<form method="post" action={ templ.SafeURL(fd.Action) }>
		<input type="hidden" name="csrf_token" value={ fd.CSRFToken }/>
		@ui.FormField("Name", "name", "text", fd.Name, "Unique volume name")
		@ui.FormField("Description", "description", "text", fd.Description, "Optional description")
		if fd.ShowKind {
			<div class="form-group">
				<label for="volume_kind">Kind</label>
				<select class="form-control w-sm" id="volume_kind" name="kind">
					<option value="raw" selected?={ fd.Kind != volume.Storage }>Raw access</option>
					<option value="storage" selected?={ fd.Kind == volume.Storage }>User storage</option>
				</select>
				<p class="form-help">Raw access: whoever it is shared with can mount all of it. User storage: whoever it is shared with keeps folders of their own in it, and sees nothing else. Switching to user storage keeps existing mounts where they are, as each user's storage.</p>
			</div>
		}
		if fd.ShowTypeSelector {
			<div class="form-group">
				<label for="conn_type">Connection Type</label>
				<select class="form-control w-sm" id="conn_type" name="conn_type">
					<option value="file" selected?={ fd.ConnType == "" || fd.ConnType == "file" }>Local Filesystem</option>
					<option value="webdav" selected?={ fd.ConnType == "webdav" }>WebDAV</option>
					<option value="mem" selected?={ fd.ConnType == "mem" }>In-Memory</option>
				</select>
			</div>
		} else {
			<input type="hidden" name="conn_type" value={ fd.ConnType }/>
		}
		<div data-conn-type="file" style={ connTypeDisplay(fd.ShowTypeSelector, fd.ConnType, "file") }>
			<div class="form-group">
				<label for="file_path">Path</label>
				<div class="picker">
					<input
						type="text"
						class="form-control picker-input"
						id="file_path"
						name="file_path"
						value={ fd.FilePath }
						placeholder="/mnt/data"
						autocomplete="off"
						hx-get="/api/admin/dir-suggest"
						hx-trigger="input changed delay:200ms, focus"
						hx-target="next .picker-results"
						hx-include="this"
					/>
					<div class="picker-results"></div>
					@dirPickerScript()
				</div>
			</div>
		</div>
		<div data-conn-type="webdav" style={ connTypeDisplay(fd.ShowTypeSelector, fd.ConnType, "webdav") }>
			@ui.FormField("Remote URL", "remote_url", "text", fd.WebDAV.URL, "https://nc.example.com/remote.php/dav/files/user")
			<div class="form-group">
				<label for="auth_type">Auth Type</label>
				<select class="form-control w-sm" id="auth_type" name="auth_type">
					<option value="basic" selected?={ fd.WebDAV.AuthType == "" || fd.WebDAV.AuthType == "basic" }>Basic</option>
					<option value="bearer" selected?={ fd.WebDAV.AuthType == "bearer" }>Bearer Token</option>
				</select>
			</div>
			<div data-auth-type="basic" style={ authTypeDisplay(fd.WebDAV.AuthType, "basic") }>
				@ui.FormField("Username", "webdav_username", "text", fd.WebDAV.Username, "")
				@ui.FormField("Password", "webdav_password", "password", fd.WebDAV.Password, "")
			</div>
			<div data-auth-type="bearer" style={ authTypeDisplay(fd.WebDAV.AuthType, "bearer") }>
				@ui.FormField("Token", "webdav_token", "text", fd.WebDAV.Token, "")
			</div>
		</div>
		<div data-conn-type="mem" style={ connTypeDisplay(fd.ShowTypeSelector, fd.ConnType, "mem") }>
			<p class="form-help mb-2">In-memory volumes have no settings. Their data is lost when the server stops.</p>
		</div>
		<div class="form-actions">
			<button class="btn btn-primary" type="submit">{ fd.SubmitLabel }</button>
			if fd.CancelURL != "" && fd.SubmitLabel != "Save" {
				<a class="btn btn-secondary" href={ templ.SafeURL(fd.CancelURL) }>Cancel</a>
			}
		</div>
	</form>
	@volumeFormToggle()
}

func connTypeDisplay(showSelector bool, current, target string) string {
	if !showSelector {
		// When type selector is hidden, only show the matching type
		if current == target {
			return ""
		}
		return "display:none"
	}
	// When selector is shown, default to "file" if empty
	if current == "" {
		current = "file"
	}
	if current == target {
		return ""
	}
	return "display:none"
}

func authTypeDisplay(current, target string) string {
	if current == "" {
		current = "basic"
	}
	if current == target {
		return ""
	}
	return "display:none"
}
