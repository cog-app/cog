package gallery

import (
	"database/sql"
	"fmt"
	"strconv"
	"strings"
	"time"

	"git.duckfam.us/jj-software/cog/ui"
)

// --- Gallery Sidebar ---

templ gallerySidebar(activePath string, total int) {
	<nav class="sidebar" id="gallery-sidebar">
		<a href="/apps/gallery/" class={ sidebarClass(activePath, "/apps/gallery/") }>
			Timeline
			if total > 0 {
				<span class="badge">{ strconv.Itoa(total) }</span>
			}
		</a>
		<a href="/apps/gallery/albums" class={ sidebarClass(activePath, "/apps/gallery/albums") }>
			Albums
		</a>
		<a href="/apps/gallery/people" class={ sidebarClass(activePath, "/apps/gallery/people") }>
			People
		</a>
		<a href="/apps/gallery/tags" class={ sidebarClass(activePath, "/apps/gallery/tags") }>
			Tags
		</a>
		<a href="/apps/gallery/videos" class={ sidebarClass(activePath, "/apps/gallery/videos") }>
			Videos
		</a>
		<div class="sidebar-divider"></div>
		<a href="/apps/gallery/settings" class={ sidebarClass(activePath, "/apps/gallery/settings") }>
			Settings
		</a>
	</nav>
}

func sidebarClass(activePath, itemPath string) string {
	if activePath == itemPath || (itemPath != "/apps/gallery/" && strings.HasPrefix(activePath, itemPath)) {
		return "sidebar-item active"
	}
	return "sidebar-item"
}

// --- Photo Grid ---

templ photoGrid(media []Media) {
	<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:6px">
		for _, m := range media {
			<a href={ templ.SafeURL(fmt.Sprintf("/apps/gallery/photo/%d", m.ID)) }
				style="aspect-ratio:1;overflow:hidden;border-radius:4px;position:relative">
				<img
					src={ fmt.Sprintf("/apps/gallery/api/media/%d/thumbnail?size=256", m.ID) }
					alt={ m.FileName() }
					style="width:100%;height:100%;object-fit:cover"
					loading="lazy"
				/>
				if m.IsVideo() {
					<span style="position:absolute;bottom:4px;right:4px;background:rgba(0,0,0,0.6);color:#fff;padding:2px 6px;border-radius:3px;font-size:0.75rem">
						{ formatDuration(m.DurationMs) }
					</span>
				}
			</a>
		}
	</div>
}

func formatDuration(ms *int64) string {
	if ms == nil {
		return ""
	}
	secs := *ms / 1000
	if secs < 60 {
		return fmt.Sprintf("0:%02d", secs)
	}
	return fmt.Sprintf("%d:%02d", secs/60, secs%60)
}

// --- Timeline Page ---

templ timelinePage(pd ui.PageData, days []TimelineDay, media []Media, total int) {
	@ui.Base(pd) {
		<div class="sidebar-layout">
			@gallerySidebar(pd.RequestPath, total)
			<div class="sidebar-content">
				<h1>Timeline</h1>
				if len(media) == 0 {
					@ui.Card("") {
						<p class="text-muted">No photos yet. Upload some images to your file storage to get started.</p>
					}
				} else {
					@photoGrid(media)
				}
			</div>
		</div>
	}
}

// --- Albums Page ---

templ albumsPage(pd ui.PageData, albums []Album) {
	@ui.Base(pd) {
		<div class="sidebar-layout">
			@gallerySidebar(pd.RequestPath, 0)
			<div class="sidebar-content">
				<div class="flex items-center gap-1 mb-2" style="justify-content:space-between">
					<h1 style="margin:0">Albums</h1>
				</div>
				if len(albums) == 0 {
					@ui.Card("") {
						<p class="text-muted">No albums yet.</p>
					}
				} else {
					<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:12px">
						for _, a := range albums {
							<a href={ templ.SafeURL(fmt.Sprintf("/apps/gallery/album/%d", a.ID)) }
								class="card" style="text-decoration:none">
								<div style="padding:1rem">
									<div style="font-weight:600">{ a.Name }</div>
									<div class="text-muted" style="font-size:0.85rem">
										{ strconv.Itoa(a.MediaCount) } items
										if a.AlbumType > 0 {
											<span> · { a.AlbumTypeName() }</span>
										}
									</div>
								</div>
							</a>
						}
					</div>
				}
			</div>
		</div>
	}
}

// --- Album View Page ---

templ albumViewPage(pd ui.PageData, album *Album, media []Media) {
	@ui.Base(pd) {
		<div class="sidebar-layout">
			@gallerySidebar(pd.RequestPath, 0)
			<div class="sidebar-content">
				<div class="flex items-center gap-1 mb-2" style="justify-content:space-between">
					<h1 style="margin:0">{ album.Name }</h1>
					if album.AlbumType == AlbumManual {
						<form method="post" action={ templ.SafeURL(fmt.Sprintf("/apps/gallery/albums/%d", album.ID)) }
							style="display:inline">
							<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
							<button type="submit" class="btn btn-danger btn-sm"
								hx-delete={ fmt.Sprintf("/apps/gallery/albums/%d", album.ID) }
								hx-confirm="Delete this album?">
								Delete
							</button>
						</form>
					}
				</div>
				if album.Description != "" {
					<p class="text-muted">{ album.Description }</p>
				}
				if len(media) == 0 {
					@ui.Card("") {
						<p class="text-muted">This album is empty.</p>
					}
				} else {
					@photoGrid(media)
				}
			</div>
		</div>
	}
}

// --- Photo View Page ---

templ photoViewPage(pd ui.PageData, m *Media, tags []Tag) {
	@ui.Base(pd) {
		<div class="sidebar-layout">
			@gallerySidebar(pd.RequestPath, 0)
			<div class="sidebar-content">
				<div style="display:grid;grid-template-columns:1fr 300px;gap:1rem">
					<div>
						if m.IsVideo() {
							<video controls style="max-width:100%;border-radius:4px">
								<source src={ fmt.Sprintf("/api/files/download?path=%s", m.FilePath) } type={ m.MimeType }/>
							</video>
						} else {
							<img
								src={ fmt.Sprintf("/apps/gallery/api/media/%d/thumbnail?size=1024", m.ID) }
								alt={ m.FileName() }
								style="max-width:100%;border-radius:4px"
							/>
						}
					</div>
					<div>
						@ui.Card("Details") {
							<table style="width:100%;font-size:0.85rem">
								<tr>
									<td class="text-muted">Filename</td>
									<td>{ m.FileName() }</td>
								</tr>
								<tr>
									<td class="text-muted">Size</td>
									<td>{ strconv.Itoa(m.Width) }×{ strconv.Itoa(m.Height) }</td>
								</tr>
								if m.DateTaken != nil {
									<tr>
										<td class="text-muted">Date</td>
										<td>{ time.Unix(*m.DateTaken, 0).Format("Jan 2, 2006 3:04 PM") }</td>
									</tr>
								}
								if m.CameraModel != "" {
									<tr>
										<td class="text-muted">Camera</td>
										<td>{ strings.TrimSpace(m.CameraMake + " " + m.CameraModel) }</td>
									</tr>
								}
								if m.LensModel != "" {
									<tr>
										<td class="text-muted">Lens</td>
										<td>{ m.LensModel }</td>
									</tr>
								}
								if m.FNumber != nil {
									<tr>
										<td class="text-muted">Aperture</td>
										<td>f/{ fmt.Sprintf("%.1f", *m.FNumber) }</td>
									</tr>
								}
								if m.ExposureTime != "" {
									<tr>
										<td class="text-muted">Shutter</td>
										<td>{ m.ExposureTime }</td>
									</tr>
								}
								if m.ISO != nil {
									<tr>
										<td class="text-muted">ISO</td>
										<td>{ strconv.Itoa(*m.ISO) }</td>
									</tr>
								}
								if m.FocalLength != nil {
									<tr>
										<td class="text-muted">Focal Length</td>
										<td>{ fmt.Sprintf("%.0fmm", *m.FocalLength) }</td>
									</tr>
								}
								if m.PlaceName != "" {
									<tr>
										<td class="text-muted">Location</td>
										<td>{ m.PlaceName }</td>
									</tr>
								}
								if m.IsVideo() && m.DurationMs != nil {
									<tr>
										<td class="text-muted">Duration</td>
										<td>{ formatDuration(m.DurationMs) }</td>
									</tr>
									if m.VideoCodec != "" {
										<tr>
											<td class="text-muted">Codec</td>
											<td>{ m.VideoCodec }</td>
										</tr>
									}
								}
							</table>
						}
						if len(tags) > 0 {
							@ui.Card("Tags") {
								<div style="display:flex;flex-wrap:wrap;gap:4px">
									for _, t := range tags {
										<span class="badge">{ t.Name }</span>
									}
								</div>
							}
						}
					</div>
				</div>
			</div>
		</div>
	}
}

// --- People Page ---

templ peoplePage(pd ui.PageData, people []Person) {
	@ui.Base(pd) {
		<div class="sidebar-layout">
			@gallerySidebar(pd.RequestPath, 0)
			<div class="sidebar-content">
				<h1>People</h1>
				if len(people) == 0 {
					@ui.Card("") {
						<p class="text-muted">No people recognized yet. Enable image recognition in settings.</p>
					}
				} else {
					<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:12px">
						for _, p := range people {
							<a href={ templ.SafeURL(fmt.Sprintf("/apps/gallery/person/%d", p.ID)) }
								class="card" style="text-decoration:none;text-align:center;padding:1rem">
								<div style="font-weight:600">{ p.DisplayName() }</div>
								<div class="text-muted" style="font-size:0.85rem">
									{ strconv.Itoa(p.FaceCount) } photos
								</div>
							</a>
						}
					</div>
				}
			</div>
		</div>
	}
}

// --- Person View Page ---

templ personViewPage(pd ui.PageData, person *Person, media []Media) {
	@ui.Base(pd) {
		<div class="sidebar-layout">
			@gallerySidebar(pd.RequestPath, 0)
			<div class="sidebar-content">
				<div class="flex items-center gap-1 mb-2" style="justify-content:space-between">
					<h1 style="margin:0">{ person.DisplayName() }</h1>
					<div class="flex gap-1">
						<form method="post" action={ templ.SafeURL(fmt.Sprintf("/apps/gallery/people/%d/name", person.ID)) }
							style="display:flex;gap:4px">
							<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
							<input type="text" name="name" value={ person.Name } placeholder="Name this person" class="input input-sm"/>
							<button type="submit" class="btn btn-primary btn-sm">Save</button>
						</form>
					</div>
				</div>
				if len(media) == 0 {
					@ui.Card("") {
						<p class="text-muted">No photos of this person.</p>
					}
				} else {
					@photoGrid(media)
				}
			</div>
		</div>
	}
}

// --- Tags Page ---

templ tagsPage(pd ui.PageData, tags []Tag) {
	@ui.Base(pd) {
		<div class="sidebar-layout">
			@gallerySidebar(pd.RequestPath, 0)
			<div class="sidebar-content">
				<h1>Tags</h1>
				if len(tags) == 0 {
					@ui.Card("") {
						<p class="text-muted">No tags yet. Enable image recognition in settings.</p>
					}
				} else {
					<div style="display:flex;flex-wrap:wrap;gap:8px">
						for _, t := range tags {
							<span class="badge" style="font-size:0.9rem;padding:6px 12px">
								{ t.Name }
								<span class="text-muted" style="margin-left:4px">{ strconv.Itoa(t.Count) }</span>
							</span>
						}
					</div>
				}
			</div>
		</div>
	}
}

// --- Videos Page ---

templ videosPage(pd ui.PageData, media []Media) {
	@ui.Base(pd) {
		<div class="sidebar-layout">
			@gallerySidebar(pd.RequestPath, 0)
			<div class="sidebar-content">
				<h1>Videos</h1>
				if len(media) == 0 {
					@ui.Card("") {
						<p class="text-muted">No videos found.</p>
					}
				} else {
					@photoGrid(media)
				}
			</div>
		</div>
	}
}

// --- Settings Page ---

templ settingsPage(pd ui.PageData, db *sql.DB, total int) {
	@ui.Base(pd) {
		<div class="sidebar-layout">
			@gallerySidebar(pd.RequestPath, 0)
			<div class="sidebar-content">
				<h1>Gallery Settings</h1>
				@ui.Card("Status") {
					<p>Indexed photos: <strong>{ strconv.Itoa(total) }</strong></p>
					<form method="post" action="/apps/gallery/settings/scan">
						<input type="hidden" name="csrf_token" value={ pd.CSRFToken }/>
						<button type="submit" class="btn btn-primary btn-sm">Scan Now</button>
					</form>
				}
			</div>
		</div>
	}
}
