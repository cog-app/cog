package calendar

import (
	"fmt"
	"time"
)

templ eventsWidget(events []EventWithCalendar) {
	if len(events) == 0 {
		<p class="text-muted">No upcoming events.</p>
	} else {
		for _, ev := range events {
			<div style="padding:0.4rem 0;border-bottom:1px solid var(--color-border)">
				<a href={ templ.SafeURL(fmt.Sprintf("/apps/calendar/?date=%s", time.Unix(ev.DTStart, 0).UTC().Format("2006-01-02"))) } style="font-weight:500">
					{ ev.Summary }
				</a>
				<div class="text-muted" style="font-size:0.85rem">
					{ widgetEventTime(ev.Event) }
				</div>
			</div>
		}
	}
}

func widgetEventTime(ev Event) string {
	start := time.Unix(ev.DTStart, 0).UTC()
	if ev.IsAllDay {
		return start.Format("Mon, Jan 2")
	}
	return start.Format("Mon, Jan 2 15:04")
}
