package contacts

templ starredContactsWidget(cards []CardWithBook) {
	if len(cards) == 0 {
		<p class="text-muted">No starred contacts.</p>
	} else {
		for _, c := range cards {
			<div style="padding:0.4rem 0;border-bottom:1px solid var(--color-border)">
				<a href="/apps/contacts/starred" style="font-weight:500">{ c.FN }</a>
				<div class="text-muted" style="font-size:0.85rem">
					{ contactSubtext(c) }
				</div>
			</div>
		}
	}
}

func contactSubtext(c CardWithBook) string {
	if c.Email != "" {
		return c.Email
	}
	return c.Org
}
