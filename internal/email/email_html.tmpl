{{define "layout"}}<!DOCTYPE html>
<html><head><meta charset="utf-8"></head>
<body style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;max-width:600px;margin:0 auto;padding:20px;color:#333">
<div style="margin-bottom:1.5rem">
<a href="{{.BaseURL}}" target="_blank" style="text-decoration:none;color:#333;display:inline-flex;align-items:center;gap:0.4rem">
<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
<span style="font-size:1.1rem;font-weight:600">{{.InstanceName}}</span>
</a>
</div>
{{content}}
<hr style="border:none;border-top:1px solid #eee;margin:2rem 0">
<p style="color:#999;font-size:0.85rem">Sent by <a href="{{.BaseURL}}" target="_blank" style="color:#999">{{.InstanceName}}</a></p>
</body></html>{{end}}

{{define "group_invite"}}<h2 style="margin-top:0">Group Invitation</h2>
<p>{{.Inviter.DisplayName}} has invited you to join <strong>{{.GroupName}}</strong>.</p>
<p><a href="{{.InviteURL}}" target="_blank" style="display:inline-block;padding:0.6rem 1.2rem;background:#0066cc;color:#fff;border-radius:4px;text-decoration:none;font-weight:600">Accept Invitation</a></p>
<p style="color:#666;font-size:0.85rem">This invitation expires in 7 days.</p>{{end}}

{{define "password_reset"}}<h2 style="margin-top:0">Password Reset</h2>
<p>A password reset was requested for your account ({{.User.Username}}).</p>
<p><a href="{{.ResetURL}}" target="_blank" style="display:inline-block;padding:0.6rem 1.2rem;background:#0066cc;color:#fff;border-radius:4px;text-decoration:none;font-weight:600">Reset Password</a></p>
<p style="color:#666;font-size:0.85rem">This link expires in 1 hour. If you didn't request this, you can safely ignore this email.</p>{{end}}

{{define "otp"}}<h2 style="margin-top:0">Verification Code</h2>
<p>Your verification code is:</p>
<p style="font-size:1.75rem;font-weight:bold;letter-spacing:0.3rem;padding:0.75rem 1rem;background:#f5f5f5;display:inline-block;border-radius:6px;font-family:monospace">{{.Code}}</p>
<p style="color:#666;font-size:0.85rem">This code expires in 10 minutes. If you didn't request this, you can safely ignore this email.</p>{{end}}
